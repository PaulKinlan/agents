def _findings_store_path() -> Path:
    """The findings store directory, resolved."""
    return (FACTORY_ROOT / "findings").resolve()


def _target_overlaps_findings(target: Path) -> bool:
    """True when `target` is the findings store, inside it, or an ancestor of it.

    A target whose read-only bind overlaps the findings store would overmount the sandbox's
    findings mask and re-expose other targets' raw scanner matches (agents-4zg round 4). The
    sandbox also masks findings last (lib/sandbox.py), so this is defence-in-depth, not the
    only boundary.
    """
    findings = _findings_store_path()
    return (target == findings or target in findings.parents or findings in target.parents)


def _self_target_hint(target: Path) -> str:
    """Actionable guidance when an operator attempts to audit the factory from its own checkout (agents-3da)."""
    if target.resolve() == FACTORY_ROOT.resolve():
        return (
            " (to audit the software factory itself, run the line from a different "
            "factory root, or point --target at a separate clean clone)"
        )
    return ""


def resolve_target(target_arg: str) -> Tuple[str, Path, Dict[str, Any]]:
    # A named target is a BARE name resolved under FACTORY_ROOT/targets — never a path.
    # pathlib's `/` DISCARDS the left side when the right side is absolute, so
    # FACTORY_ROOT / "targets" / "/tmp/x.yaml" IS /tmp/x.yaml: an adversary controlling
    # argv and environment could plant a manifest (trusted: true, visibility: private,
    # path: anywhere) beside any directory and turn `--target /tmp/x` into an attested
    # unsandboxed run with an arbitrary read scope (review P1, agents-bp0). Only a bare
    # name — no path separator, not absolute, not a parent reference — may load a
    # manifest; everything else is a raw path target, which carries no attestation at
    # all and refuses the unsandboxed opt-in like every other untrusted target.
    is_bare_name = (target_arg not in ("", ".", "..")
                    and not os.path.isabs(target_arg)
                    and os.sep not in target_arg and "/" not in target_arg)
    if is_bare_name:
        target_yaml = FACTORY_ROOT / "targets" / f"{target_arg}.yaml"
        if target_yaml.exists():
            cfg = load_yaml_simple(target_yaml)
            name = cfg.get("name", target_arg)
            raw_path = os.path.expanduser(str(cfg.get("path", "")))
            path = (FACTORY_ROOT / raw_path).resolve() if not os.path.isabs(raw_path) else Path(raw_path).resolve()
            # A named target whose checkout is missing must fail loudly: every pre-pass would
            # otherwise "scan" nothing and the station would report a clean zero (journal-wog).
            if not cfg.get("path") or not path.is_dir():
                raise FileNotFoundError(
                    f"Target '{target_arg}' ({target_yaml.name}) points at {path}, which is not a directory")
            if _target_overlaps_findings(path):
                raise FileNotFoundError(
                    f"Target '{target_arg}' ({target_yaml.name}) points at {path}, which overlaps "
                    f"the factory findings store ({_findings_store_path()}); refusing to scan a "
                    f"raw credential store as a target"
                    + _self_target_hint(path))
            return name, path, cfg

    # Otherwise treat as path
    target_path = Path(os.path.expanduser(target_arg)).resolve()
    if not target_path.is_dir():
        raise FileNotFoundError(f"Target path or named target not found: {target_arg}")
    if _target_overlaps_findings(target_path):
        raise FileNotFoundError(
            f"Target path {target_path} overlaps the factory findings store "
            f"({_findings_store_path()}); refusing to scan a raw credential store as a target"
            + _self_target_hint(target_path))
    name = target_path.name
    return name, target_path, {"name": name, "path": str(target_path), "sink": "file"}

def apply_explicit_visibility(target_cfg: Dict[str, Any],
                             explicit_visibility: Optional[str]) -> Dict[str, Any]:
    """Fold an operator's explicit `--visibility` into a target's configuration (agents-dpt).

    A raw `--target <path>` loads no manifest, so nothing states the target's visibility and
    lib/embargo.py fail-closes on it: every high/critical finding is withheld from the synced
    beads tracker, which is why the factory's own audit filed nothing. `--visibility
    public|private` is the operator's explicit declaration for exactly that case.

    A manifest's own valid `visibility` is authoritative and is never changed by the flag, so
    `targets/<name>.yaml` behaviour is intact and the flag can never widen a declared private
    target. With no flag nothing is added, so missing visibility still embargoes.
    """
    if explicit_visibility not in VALID_VISIBILITIES:
        return target_cfg
    if target_cfg.get("visibility") in VALID_VISIBILITIES:
        return target_cfg
    return {**target_cfg, "visibility": explicit_visibility}

def detect_sink(target_path: Path, target_cfg: Dict[str, Any], explicit_sink: Optional[str]) -> str:
    if explicit_sink:
        return explicit_sink

    # A committed manifest takes precedence over generic target guidance.
    if target_cfg.get("sink"):
        return target_cfg["sink"]
    detected = sinks.detect(target_path)
    if detected:
        return detected

    # No target policy: retain a local file evidence trail.
    return "file"

def choose_engine(requested_engine: str) -> str:
    if requested_engine != "auto":
        return requested_engine

    # Engines whose adapter enforces a tool policy come first (lib/containment.py). antigravity
    # is last: its adapter refuses every policy, so reaching it is an explicit refusal rather
    # than a silent pick over an engine that could have run.
    if shutil.which("pi"):
        return "pi"
    if shutil.which("claude"):
        return "claude"
    if shutil.which("agentapi"):
        return "antigravity"

    return "pi"


# The binary each engine's adapter EXECUTES (agents-28nn round 5, review P0 — a demonstrated
# credential exfiltration). The engine name is not always the binary name: antigravity is
# dispatched headless through `agentapi`. The adapter is the LAST GRANTER BEFORE THE KEY — it
# hands the run's model credentials to whatever binary it executes, so an unpinned engine is
# an EXFILTRATION PATH, not merely an unverified binary: a PATH-planted namesake runs with
# the key in its environment (proven by construction with a fake `pi` that dumped its env).
# Every engine binary is therefore in lib.tool_pins.TRUSTED_TOOLS: the dispatcher resolves and
# pin-verifies it via resolve_tool BEFORE the adapter runs and hands the verified absolute
# path to the adapter as FACTORY_ENGINE_BIN; the adapter refuses to run without it, so a
# by-name PATH lookup can never be handed the credential. The sandbox binder re-verifies the
# same pin at wrap time (lib/sandbox.py _executable_binds) before binding the engine in.
ENGINE_BINARIES = {"pi": "pi", "claude": "claude", "antigravity": "agentapi",
                   "deepseek": "deepseek"}


def _resolve_engine_bin(engine: str) -> Optional[str]:
    """Resolve the engine's executed binary to a pin-verified absolute path, or None.

    Raises ToolPinError when the binary is unpinned, mismatched, or unresolvable — the run
    fails closed rather than handing credentials to an unverified binary. deepseek is the
    one engine whose binary is OPTIONAL: with no `deepseek` CLI installed its adapter falls
    back to the factory's own Python HTTP client, which is station code with no binary to
    pin, so an absent binary resolves to None (no FACTORY_ENGINE_BIN) rather than failing.
    A deepseek binary that IS present but unpinned still fails closed — a resolvable but
    unverifiable binary must never be silently skipped while the adapter could reach it.
    """
    binary = ENGINE_BINARIES.get(engine)
    if binary is None:
        # An engine with no adapter on this station gets no credentials (lib/child_env.py
        # fails closed the same way) and its adapter script will not exist; nothing to pin.
        return None
    if engine == "deepseek" and shutil.which(binary) is None:
        return None
    return resolve_tool(binary)

# Bounds the scan of a pathological output (a truncated report with thousands of braces).
MAX_JSON_DECODE_ATTEMPTS = 20000


def extract_json_from_output(text: str) -> Optional[Dict[str, Any]]:
    """Find the report object in a model's output, tolerating the ways models wrap it.

    The old extractor tried a whole-text parse, then each ```fence``` with a non-greedy
    regex, then first-`{`-to-last-`}`. A report whose strings themselves contain a fence (a
    test-gap skeleton, a THREAT_MODEL.md body), or leading prose plus a trailing note with a
    brace in it, defeated all three, and the station lost its work (fleet-ddd, journal-mid).

    Now every top-level JSON object in the text is decoded with the real JSON decoder (which
    knows where strings end, so fences and braces inside them are harmless), and the report
    is the object that carries `findings` — the largest if several do — else the largest
    object. Returns None only when no JSON object is present at all.
    """
    if not isinstance(text, str):
        return None
    text = text.lstrip("\ufeff")
    try:
        whole = json.loads(text.strip())
        if isinstance(whole, dict):
            return whole
    except Exception:
        pass

    decoder = json.JSONDecoder()
    objects = []
    index = text.find("{")
    attempts = 0
    while index != -1 and attempts < MAX_JSON_DECODE_ATTEMPTS:
        attempts += 1
        try:
            value, end = decoder.raw_decode(text, index)
        except ValueError:
            index = text.find("{", index + 1)
            continue
        if isinstance(value, dict):
            objects.append((end - index, value))
        # Skip past a decoded object: its inner objects are not reports.
        index = text.find("{", end)
    if not objects:
        return None
    with_findings = [o for o in objects if isinstance(o[1].get("findings"), list)]
    pool = with_findings or objects
    return max(pool, key=lambda o: o[0])[1]

_TRANSIENT_DIRS: List[Path] = []
_TRANSIENT_DIR_PREFIXES = ("factory-sock-", "factory-pi-", "factory-pins-")
_TRANSIENT_DIR_MAX_AGE_SECONDS = 24 * 3600  # agents-uxs: far beyond any legitimate run lifetime


def _cleanup_transient_dirs() -> None:
    """Best-effort removal of every transient dir this process created (agents-uxs).

    Registered with atexit so a sys.exit() or an uncaught exception between creation and the
    normal-path cleanup still removes the dirs. SIGKILL runs no handler and no atexit — the
    next run's _sweep_stale_transient_dirs is the backstop for that case.
    """
    while _TRANSIENT_DIRS:
        shutil.rmtree(_TRANSIENT_DIRS.pop(), ignore_errors=True)


def _sweep_stale_transient_dirs(root: Path = Path("/tmp"), now: Optional[float] = None) -> int:
    """Reap /tmp factory transient dirs orphaned by a hard kill (agents-uxs).

    A run the reaper or `timeout` SIGKILLs leaves its factory-sock-*/factory-pi-* mkdtemp dirs
    behind (SIGKILL is not catchable). Each run therefore sweeps, at the point of creating its
    own dirs, any same-prefix directory older than _TRANSIENT_DIR_MAX_AGE_SECONDS. Returns the
    number of directories removed.
    """
    now = time.time() if now is None else now
    removed = 0
    for prefix in _TRANSIENT_DIR_PREFIXES:
        for d in root.glob(f"{prefix}*"):
            try:
                if not d.is_dir():
                    continue
                if now - d.stat().st_mtime <= _TRANSIENT_DIR_MAX_AGE_SECONDS:
                    continue
                shutil.rmtree(d, ignore_errors=True)
                removed += 1
            except OSError:
                continue
    return removed


atexit.register(_cleanup_transient_dirs)


def _make_socket_dir() -> Path:
    """Allocate a short, private, per-run directory for the egress UNIX sockets (agents-x8l).

    The credential broker and egress allowlist proxy listen on UNIX sockets that the sandbox
    reaches through lib/net_forward.py. AF_UNIX's sun_path holds at most 107 bytes, and run_dir
    embeds the full worktree path — long worktrees overflow it. The sockets therefore get their
    own collision-free mktemp directory under /tmp (already 0700), kept private so a concurrent
    run can neither read nor bind them.
    """
    _sweep_stale_transient_dirs()  # agents-uxs: reap hard-kill orphans at the point of creation
    d = Path(tempfile.mkdtemp(prefix="factory-sock-", dir="/tmp"))
    os.chmod(d, 0o700)  # mkdtemp is 0700 by default; be explicit against umask drift
    _TRANSIENT_DIRS.append(d)
    return d


def _make_pins_dir() -> Path:
    """Allocate a short, private, per-run directory for the EFFECTIVE tool pins
    (agents-28nn round 5, review P0 — the TOCTOU on the effective pins).

    PROJECT RULE: A FILE THE PIN RESOLVER TRUSTS MUST NOT BE A FILE THE PINNED PROCESS CAN
    REWRITE — trust is not a property of WHAT is read, it is a property of WHO CAN WRITE
    WHAT IS READ. The merged pins used to be written into the run directory, which the
    sandbox binds READ-WRITE at the same host path, so code running in the child could
    overwrite the file that constrains it and then have resolve_tool validate the
    injected hash (constructed by the round-4 reviewer: a station script wrote a fake git
    hash to the path named by FACTORY_TOOL_PINS before calling resolve_tool("git"), which
    accepted it). The pins therefore get their own per-run directory OUTSIDE the run
    directory; the pre-pass wrap binds the file READ-ONLY through sandbox_command's
    ro_binds — the bind machinery this codebase already has, reused rather than a second
    mechanism — so the kernel, not the file's location by convention, enforces who can
    write it. 0700 and reaped like the socket/pi dirs.
    """
    d = Path(tempfile.mkdtemp(prefix="factory-pins-", dir="/tmp"))
    os.chmod(d, 0o700)
    _TRANSIENT_DIRS.append(d)
    return d


def _make_pi_config_dir() -> Path:
    """Allocate a short, private, per-run directory for pi's provider config (agents-854).

    pi's deepseek base URL is hardcoded to api.deepseek.com; the only override pi honours is a
    models.json in its agent directory (redirected there via PI_CODING_AGENT_DIR). The directory
    is created under /tmp (0700) and bound writable into the engine sandbox (pi opens its
    auth.json credential store for read-write even when auth comes from env); it holds no
    secrets — only the models.json override and an empty auth.json pi may create.
    """
    d = Path(tempfile.mkdtemp(prefix="factory-pi-", dir="/tmp"))
    os.chmod(d, 0o700)
    _TRANSIENT_DIRS.append(d)
    return d


def _write_pi_models_json(config_dir: Path, broker, provider: str) -> None:
    """Write pi's provider override for the keyless broker (agents-854), provider-agnostic.

    pi ignores *_BASE_URL env vars, so the broker swap alone cannot redirect a sandboxed pi:
    its provider baseUrl is hardcoded. pi DOES honour models.json in its agent directory, so
    the dispatcher writes an override for the SELECTED provider — baseUrl from the broker's own
    descriptor (broker.base_url), the broker's per-run placeholder as apiKey (agents-28nn
    round 7: the broker demands that secret back on every request, so models.json must carry
    exactly it), the provider's api type, and the endpoint's model ids (PI_KEYLESS_MODELS).
    The models array is what makes `--model kimi/k3` resolve: the bundled pi registry has no
    provider named `kimi`, so without the explicit model list pi reports "Model not found"
    (agents-0ld). Nothing here is provider-specific: `provider` is whatever the station's
    model resolves to.
    """
    if provider not in broker.providers or provider not in PI_PROVIDER_API:
        # agents-3z8 [P2 latent]: fail-closed if the run's broker does not allow this provider
        # or if the provider is not a supported keyless endpoint.
        return
    config = {
        "providers": {
            provider: {
                "baseUrl": broker.base_url(provider),
                "api": PI_PROVIDER_API[provider],
                "apiKey": broker.placeholder,
                "models": [{"id": model_id, "samplingParams": {"temperature": 0.1}}
                           for model_id in PI_KEYLESS_MODELS.get(provider, [])],
            },
        },
    }
    _write_run_artifact(config_dir / "models.json", json.dumps(config))
    os.chmod(config_dir / "models.json", 0o600)


def create_run_dir(agent_name: str, target_name: str, run_id: str) -> Path:
    """Exclusively allocate a run directory, including on a same-second collision."""
    run_dir = FACTORY_ROOT / "runs" / f"{agent_name}-{target_name}-{run_id}"
    try:
        run_dir.mkdir(parents=True, exist_ok=False)
    except FileExistsError:
        # agents-m2n review P2: the egress sockets, prompt and policy must never be shared.
        run_dir = FACTORY_ROOT / "runs" / f"{agent_name}-{target_name}-{run_id}-{token_hex(4)}"
        run_dir.mkdir(parents=True, exist_ok=False)
    # Raw scanner matches and prompts stay private to the operator (agents-pgr).
    os.chmod(run_dir, 0o700)
    # Mark the run active (agents-ped P2): a concurrent scheduled run must never sweep a
    # still-running run directory, even when fast runs overflow the count bound. The marker
    # mtime is the freshness signal prune_run_dirs checks; it is removed on successful
    # completion, and a crashed/killed run's marker goes stale and is swept after the grace.
    (run_dir / ACTIVE_MARKER_NAME).touch()
    # Bounded retention (agents-ped): run artifacts embed raw scanner matches and model
    # output, so prune old run directories now that this run's directory is in place. The
    # just-allocated directory is excluded, so a mid-run crash never loses the live run.
    retain_count, max_age_seconds = retention_config()
    active_grace = active_grace_seconds()
    for pruned in prune_run_dirs(FACTORY_ROOT / "runs", retain=retain_count,
                                 max_age_seconds=max_age_seconds,
                                 active_grace=active_grace, exclude={run_dir}):
        print(f"[retention] pruned old run directory: {pruned}")
    # Hill-climb proposals are exempt from the run-directory bound (a concurrent run must
    # never sweep a live proposal), but stale ones are swept by their own TTL (agents-0ti).
    hillclimb_ttl = hillclimb_retention_ttl()
    for pruned in prune_hillclimb_dirs(FACTORY_ROOT / "runs", max_age_seconds=hillclimb_ttl):
        print(f"[retention] pruned stale hill-climb proposal: {pruned}")
    return run_dir


def _prepass_argv(prepass_script: Path, read_dir: Path, target_name: str,
                  candidates_file: Path, agent_name: str):
    """Build the deterministic pre-pass argv. `--target-name` is only understood by
    perf-hillclimb's measure_and_context.py (it keeps the ledger keyed by the LOGICAL target
    when run_hillclimb --apply points the read dir at a disposable worktree); every other
    pre-pass keeps its original contract, so injecting an unrecognised flag would make it exit
    at argument parsing (P1-1, agents-nei)."""
    argv = [sys.executable, str(prepass_script), "--target", str(read_dir)]
    if agent_name == "perf-hillclimb":
        argv += ["--target-name", str(target_name)]
    argv += ["--output", str(candidates_file)]
    return argv


def _finding_sort_key(finding: Any) -> Tuple[str, int, str]:
    """Deterministic findings order that tolerates junk items (agents-qw9).

    Schemaless agents (no output.schema) can emit non-dict findings and non-integer
    line_number values; the sort must not crash on them — exactly as the store skips
    non-dicts (lib/findings.py) and the normaliser skips them (lib/report_schema.py).
    Non-dict items sort by their string form with a zero line number, so they land
    after real findings without raising.
    """
    if not isinstance(finding, dict):
        return (str(finding), 0, "")
    line = finding.get("line_number")
    if isinstance(line, bool):
        line = int(line)
    elif isinstance(line, str):
        try:
            line = int(line)
        except ValueError:
            line = 0
    elif not isinstance(line, int):
        line = 0
    return (str(finding.get("path", "")), line, str(finding.get("rule_id", "")))


def run_agent(agent_name: str, target_arg: str, engine_arg: str = "auto", explicit_sink: Optional[str] = None,
              station_only: bool = False, repair_hint: Optional[str] = None, attempt: int = 1,
              read_target_dir: Optional[Path] = None, model_arg: Optional[str] = None,
              visibility_arg: Optional[str] = None, budget_minutes: Optional[float] = None):
    agent_dir = FACTORY_ROOT / "agents" / agent_name
    agent_yaml = agent_dir / "agent.yaml"
    skill_dir = agent_dir
    
    if not agent_yaml.exists():
        sys.stderr.write(f"Agent '{agent_name}' not found in {FACTORY_ROOT / 'agents'}\n")
        sys.exit(1)

    agent_cfg = load_yaml_simple(agent_yaml)
    # containment, capabilities and budget are validated here, not only printed (SF-02,
    # agents-pnu). A declaration the factory cannot honour, or an engine that cannot enforce
    # the granted tool policy, refuses the run before any pre-pass or run directory.
    policy = load_policy(agent_name, agent_cfg)
    # budget.max_minutes is a hard station deadline (SF-06): the pre-pass, engine and findings
    # dispatch share it, and expiry is a station failure rather than a clean scan.
    budget = budget_for(agent_cfg, label=agent_name, override_minutes=budget_minutes)
    target_name, target_dir, target_cfg = resolve_target(target_arg)
    # agents-dpt: a raw --target path carries no manifest, so `--visibility` is the only way an
    # explicit declaration reaches the findings dispatch; a manifest's own value still wins.
    target_cfg = apply_explicit_visibility(target_cfg, visibility_arg)
    # read_dir is the tree the engine and pre-pass actually read. run_hillclimb passes its
    # accumulated disposable worktree here (P2-2, agents-nei) so a later proposal inspects the
    # kept edits instead of re-proposing against the operator's unchanged checkout. The engine
    # policy is unchanged — an optimizer stays read-only — only the READ scope moves. Identity
    # (target_name), sink, visibility and the findings --target-dir stay anchored to the real
    # target.
    read_dir = Path(read_target_dir).resolve() if read_target_dir is not None else target_dir
    sink = detect_sink(target_dir, target_cfg, explicit_sink)
    engine = choose_engine(engine_arg)
    check_engine(policy, engine)

    # The OS sandbox (agents-9n7) is the read-scope boundary for engines that have no
    # equivalent confinement of their own (lib/sandbox.py SANDBOXED_ENGINES — pi's read tool
    # is not path-confined by its flags). If bubblewrap cannot run on this host, REFUSE
    # rather than silently fall back to an unsandboxed run where a prompt-injected session
    # reads any file the operator can (review P0). FACTORY_ALLOW_UNSANDBOXED is the one
    # explicit unsandboxed path — and since agents-bp0 it is an ATTESTATION, not a switch:
    # THREAT_MODEL.md section 7 accepts an unsandboxed run only for a TRUSTED target, so
    # the opt-in additionally requires the target's own manifest to declare `trusted: true`
    # with `visibility: private` (targets/<name>.yaml). The ambient environment alone must
    # never unlock it — anything able to set an environment variable (a compromised
    # schedule entry, a malicious CI step, a wrapper script, a command a doc tells a
    # developer to run) must not be able to make the operator's filesystem the read scope.
    # A public/unknown-visibility target, or a raw --target path with no manifest, always
    # refuses; the banner and policy.json then report the session NOT confined.
    sandbox_ok = sandbox_available()
    # WHY the sandbox is unavailable, for the loud refusal / honest downgrade below: a pin
    # refusal (deployer forgot to regenerate host pins, an unreadable pins file, a
    # mismatched bwrap) must NEVER read like an ordinary bwrap-less host (agents-28nn
    # round 2) — the message names the cause so the failure is a warning, not a trap.
    sandbox_why = None if sandbox_ok else sandbox_unavailable_reason()
    allow_unsandboxed = os.environ.get("FACTORY_ALLOW_UNSANDBOXED", "").strip().lower() \
        in ("1", "true", "yes", "on")
    trusted_opt_in = (allow_unsandboxed
                      and target_cfg.get("trusted") is True
                      and normalize_visibility(target_cfg.get("visibility")) == "private")
    if engine in SANDBOXED_ENGINES and not sandbox_ok and not trusted_opt_in:
        why = ("and the target does not carry the trusted attestation (targets/<name>.yaml "
               "`trusted: true` with `visibility: private`)"
               if allow_unsandboxed else "and no FACTORY_ALLOW_UNSANDBOXED opt-in was given")
        raise ContainmentError(
            f"engine '{engine}' relies on the OS filesystem sandbox to confine its read "
            f"scope to the target, but the OS sandbox is unavailable on this host"
            f"{f' — {sandbox_why}' if sandbox_why else ''} {why}; refusing "
            f"an unsandboxed run (the model's read tool would reach any file the operator "
            f"can read). The opt-in exists only for a target that declares `trusted: true` "
            f"with `visibility: private` in its manifest (THREAT_MODEL.md section 7); the "
            f"banner and policy.json then say NOT confined.")
    unsandboxed_note = (
        # The attestation names the manifest's FILE STEM, not the name: field a manifest
        # self-declares (review P3): the file the operator actually wrote is what was
        # attested. The opt-in only ever fires for a bare-name manifest target.
        f"explicit FACTORY_ALLOW_UNSANDBOXED opt-in on trusted target "
        f"'{Path(target_arg).name}' "
        f"(visibility private; THREAT_MODEL.md section 7): the engine process and the "
        f"pre-pass run as the operator"
        + (f"; the OS sandbox is unavailable because {sandbox_why}" if sandbox_why else "")
        if engine in SANDBOXED_ENGINES and not sandbox_ok else None)

    # agents-ejm: claude is NEVER kernel-sandboxed — its adapter is not in SANDBOXED_ENGINES
    # (its session auth lives in $HOME/.claude, which the sandbox hides by design), so its read
    # scope is only claude's own --restricted tool flags, not a kernel boundary (non-negotiable
    # #2), and its credentials are never brokered (they reach the child env, readable from the
    # engine's own /proc/self/environ). Until claude is verified end-to-end inside the bwrap
    # wrapper with a bind-mounted auth dir, it may run only against a target whose manifest
    # declares `trusted: true` + `visibility: private` — the same per-target attestation an
    # unsandboxed pi run requires (agents-bp0). Public/unknown-visibility targets and raw
    # --target paths refuse, and the banner/policy.json keep reporting the session NOT confined.
    if engine == "claude" and not (
            target_cfg.get("trusted") is True
            and normalize_visibility(target_cfg.get("visibility")) == "private"):
        raise ContainmentError(
            f"engine 'claude' runs without the OS filesystem sandbox (its adapter is not "
            f"sandbox-verified, so its read scope is only claude's --restricted tool flags, "
            f"not a kernel boundary) and its credentials are never brokered; refusing on "
            f"target '{target_name}'. A claude run is allowed only for a target whose manifest "
            f"declares `trusted: true` with `visibility: private` (THREAT_MODEL.md section 7). "
            f"Use a sandboxed engine (pi) for public targets.")

    # Egress control (agents-2x6). The engine session's netns can be isolated only when the
    # engine is sandboxed AND every model-provider key present in the environment maps to a
    # brokered provider: under --unshare-net the engine cannot dial a provider directly, so
    # an unbrokerable key would break its own model calls. Today every pi provider maps
    # (credential_broker.PROVIDERS); the check stays so a future sandboxed engine fails safe
    # to the honest fallback — shared host network, network re-withheld, network-egress kept
    # in not_enforced — instead of silently regressing.
    _brokerable_vars = set()
    for _placeholder_var, _base_url_var, _secret_vars in BROKER_PROVIDERS.values():
        _brokerable_vars.update(_secret_vars)
        _brokerable_vars.add(_placeholder_var)
    egress_active = engine_sandboxed(engine) and all(
        var in _brokerable_vars
        for var in ENGINE_CREDENTIALS.get(engine, ()) if os.environ.get(var))
    sandbox = sandbox_record(engine, egress_filtered=egress_active)
    if not egress_active:
        # Honest per-run downgrade (lib/containment.py): the egress-allowlist proxy is not
        # active for this ENGINE session (no OS sandbox, an adapter not verified to run
        # under it, or an unbrokerable provider), so a declared network could not be held
        # to the tier's hosts. The pre-pass above may still be egress-isolated; this
        # downgrade is about the run's network grant as a whole.
        policy = downgrade_network_to_withheld(policy)

    run_id = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    if attempt > 1:
        # agents-30q: every attempt gets its OWN run directory. pi.sh redirects the engine's
        # output into $RUN_DIR/model_output.txt, so a retry that shared the first attempt's
        # directory would overwrite the rejected first output — defeating the 'raw output
        # kept for human recovery' property the repair-retry exists to provide.
        run_id = f"{run_id}-attempt{attempt}"
    # agents-esx: exclusive allocation (mkdir exist_ok=False, token_hex retry, chmod 0700)
    # lives in the helper; the per-attempt suffix above is applied before it is called.
    run_dir = create_run_dir(agent_name, target_name, run_id)

    # Egress sockets (agents-x8l): run_dir can exceed AF_UNIX's 107-byte sun_path in a long
    # worktree path, so both sockets live in a short per-run dir under /tmp. The sandbox rw-binds
    # that dir (lib/sandbox.py derives it from each egress socket's parent); the broker finally
    # removes it once both listeners have stopped.
    sock_dir = _make_socket_dir()
    proxy_sock = sock_dir / "proxy.sock"
    broker_sock = sock_dir / "broker.sock"
    pi_config_dir = _make_pi_config_dir()

    # Disposable per-session worktree (agents-6ce). A granted write runs the engine in a
    # throwaway git worktree under the run directory — which the OS sandbox already binds
    # read-write — so the model can edit files but only there: the target checkout stays
    # read-only and is never modified, and the session diff collected afterwards IS the
    # proposal. The grant is conditional on the target being a git repo; when it is not,
    # downgrade to read-only and re-withhold write with the specific reason, so the banner and
    # policy.json stay honest and non-git targets keep today's patch-in-report behaviour.
    worktree_dir: Optional[Path] = None
    worktree_gitdir: Optional[Path] = None
    engine_cwd = read_dir
    if policy.tool_policy == WORKTREE_WRITE:
        if not (target_dir / ".git").exists():
            policy = downgrade_write_to_read_only(policy, (
                "the target is not a git repository, so no disposable worktree can be "
                "created; the engine runs read-only and returns patches in its report"))
        elif not engine_sandboxed(engine):
            # Review P1-2 (agents-6ce): the OS sandbox is the ONLY boundary that ro-binds the
            # target. pi's tools are not path-confined by its flags, and claude is not
            # sandbox-verified (not in SANDBOXED_ENGINES), so when the run will not be
            # engine_sandboxed — a bwrap-less host under FACTORY_ALLOW_UNSANDBOXED, or claude
            # anywhere — a granted write is an unconfined write primitive and the adapter's
            # "target bound read-only" claim would be false. Downgrade to read-only (the
            # pre-6ce behaviour for this mode) instead of handing the engine edit/write.
            policy = downgrade_write_to_read_only(policy, (
                "the engine session will not run inside the OS sandbox on this host "
                "(no bubblewrap, or an engine whose adapter is not sandbox-verified), so "
                "nothing kernel-enforces the target staying read-only; the engine runs "
                "read-only and returns patches in its report"))
        else:
            worktree_dir = run_dir / "worktree"
            engine_cwd = worktree_dir

    # Build the sandbox wraps BEFORE the banner, so "Sandbox: enforced" is printed only for
    # a wrapper that actually constructed; a build failure is a station error, never a
    # silent unsandboxed run and never an over-claimed banner (review nit, agents-9n7).
    candidates_file = run_dir / "candidates.json"
    scripts_dir = agent_dir / "scripts"
    prepass_scripts = sorted(scripts_dir.glob("*.py")) if scripts_dir.exists() else []
    prepass_script = prepass_scripts[0] if prepass_scripts else None
    # agents-28nn round 7 (verdict P1): the operator's proxy vars are no longer forwarded
    # to the unsandboxed pre-pass (proxied dropped) — EVERY pre-pass child gets the run's
    # egress-allowlist proxy from the dispatcher below, so the less-confined path no
    # longer receives more network freedom than the more-confined one.
    prepass_env = prepass_environment(agent_cfg)
    prepass_cmd = None
    if prepass_script and prepass_script.exists():
        prepass_cmd = _prepass_argv(prepass_script, read_dir, target_name,
                                    candidates_file, agent_name)
        # agents-28nn round 6 (review P0, the round-5 polarity argument FALSIFIED):
        # WHENEVER A RESOLVER'S OUTPUT DETERMINES WHO RECEIVES A SECRET, THE RESOLVER IS A
        # GRANTING MECHANISM. The round-5 report claimed pins only ever RESTRICT which
        # binaries may run as trusted and never GRANT capability; the round-6 reviewer
        # falsified that by construction — a pin naming `path: /tmp/evil` made
        # resolve_tool(engine) authorise that path, and the evil binary executed and
        # RECEIVED THE CREDENTIALS despite being in no PATH and on no allowlist. So a
        # trusted pin IS an authorisation to hand credentials to the named path — and the
        # pin's granularity is the binary, so a pinned LAUNCHER (a shell, env, an
        # interpreter) confers whatever that launcher can reach; pins decide WHICH FILE
        # RUNS and are silent about WHAT THAT FILE CAN DO. And the two findings COMPOSE:
        # the round-5 read-only bind is a control that depends on a mount namespace, and
        # on the unsandboxed path there is none — the child runs as the operator and can
        # rewrite /tmp/factory-pins-* — so a rewritten pin PLUS a pin being a grant meant
        # the unsandboxed credential handoff was protected by NOTHING but the operator's
        # own environment. That composition, not either half alone, is why this path was
        # the priority.
        #
        # THE RULE this bead works to (stated canonically on lib/sandbox.py's
        # engine_sandboxed — where the next person adding a conditional meets it — and
        # referenced from the credential broker below): THE LESS-CONFINED PATH MUST NOT
        # RECEIVE MORE THAN THE MORE-CONFINED PATH — a control that applies only on the
        # confined path leaves the less-confined path with less control, the inverted
        # polarity. The NAMED, VERIFIABLE instances are four (the round-5 merged pins;
        # the round-6 credential broker; the pre-pass HTTP_PROXY only-if-sandbox_ok,
        # closed in round 7 below by putting the allowlist proxy on EVERY pre-pass
        # child; and the round-8 adapter env's proxied=not engine_sandboxed, closed
        # below at the adapter env build). The bead's own record uses HIGHER ordinals
        # — the round-5 dispatch called the pins hoist the THIRD appearance, the
        # round-6 verdict reported THREE further shapes but named only the broker into
        # the record, and the round-8 verdict called the adapter env the SIXTH, while
        # f1cf323's commit message says the FOURTH — because earlier rounds counted
        # shapes they did not name, and an unnamed shape cannot be enumerated. So this
        # comment asserts no total it cannot verify: searched (agents-28nn round 8
        # attestation) were the bead's verdict and coord comments for "polarity" —
        # yielding the four named instances above, which are the floor, not the count
        # — plus every conditional on engine_sandboxed/sandbox_available/sandbox_ok in
        # factory and lib/, among which NO LIVE inverted instance remains (each is a
        # refusal, a downgrade, or a control mounted on the operation). The one alleged
        # instance the record resolved by FALSIFICATION is kept named too: there is NO
        # adapter proxy gated on egress_active — the adapter's proxy is a UNIX-socket
        # forward for the broker (round-7 verdict). The follow-on shape this file has
        # now met TWICE is the moved
        # control's lost boundary: a control moved off the confined path must be asked
        # WHO CAN REACH IT FROM HERE
        # (the round-6 broker move, whose host loopback round 7 authenticates with the
        # run secret; the round-7 pre-pass proxy move, reachable by any local process
        # but handing out no authority).
        #
        # And the rationale for WHY the unsandboxed half of this fix could not be the
        # round-5 read-only bind: A CONTROL THAT DEPENDS ON A MOUNT NAMESPACE IS ABSENT ON
        # THE PATH THAT HAS NONE.
        #
        # WHAT NOW CONTAINS THE RISK ON THE UNSANDBOXED PATH (it is no longer, and never
        # was, the pin's inability to grant):
        #  1. THE HANDOFF DOES NOT DEPEND ON A FILE THE CHILD CAN WRITE. Every trusted
        #     tool the pre-pass may execute is resolved and pin-verified HOST-SIDE below,
        #     BEFORE the credentials leave, and the verified absolute paths ride the
        #     fork-time env (FACTORY_RESOLVED_TOOL_*, lib.tool_pins.prepass_tool_env);
        #     the scripts execute those paths (lib.tool_pins.prepass_tool). Chosen over
        #     the two alternatives: making the pins file immutable WITHOUT a mount
        #     namespace cannot work (no userspace mechanism keeps a file immutable to a
        #     process running with the operator's own uid — stated in round 5 and still
        #     true); and a sealed memfd inherited by the child (the third option) WOULD
        #     give same-uid immutability on Linux, but it is Linux-only, needs
        #     fd-inheritance plumbed through run_station_command and the wrap, and makes
        #     /proc/self/fd part of the resolver's trust root — a second trust mechanism
        #     where removing the dependency is simpler and platform-independent.
        #  2. NO RE-ENTRY: nothing the pins authorise can write what the resolver reads,
        #     and a pinned tool's output never feeds resolution. On the sandboxed path
        #     the effective pins are ro-bound and $HOME (the host pins) is tmpfs-hidden;
        #     on the unsandboxed path the resolver's inputs are the fork-time env and the
        #     host's own pins, which a pinned child process cannot reach retroactively.
        #     "Pins only restrict" is TRUE of which file runs; NO RE-ENTRY is what makes
        #     that restriction SUFFICIENT rather than merely true.
        #  3. The path exists only behind the explicit FACTORY_ALLOW_UNSANDBOXED=1 opt-in
        #     plus a manifest declaring trusted: true with visibility: private.
        #  4. STATED, NOT CLAIMED AWAY: the unsandboxed pre-pass's extra capability —
        #     operator uid reach, forwarded proxy networking, no mount namespace — is a
        #     FACT ABOUT THE PLATFORM, not a defect anyone failed to prevent; the safety
        #     above is a property of the MECHANISM, not of the path. An unsandboxed
        #     pre-pass is a credential-holding process running as the operator: code
        #     executing inside it already holds the credentials, so this mechanism's
        #     guarantee is scoped — the binary the HANDOFF authenticates is host-verified
        #     and honest code is never fooled by the filesystem. It is not confinement.
        #
        # The merged effective pins are still written for EVERY pre-pass (round 5: the
        # sandboxed child re-verifies against EXACTLY the bytes the host verified; pins
        # are paths and hashes, not secrets) and still live OUTSIDE the rw-bound run dir
        # (the rule on _make_pins_dir). On the sandboxed path the wrap binds them
        # READ-ONLY and FACTORY_PINS_RO_BOUND tells prepass_tool that exec-time
        # re-verification against them is sound (below). On the unsandboxed path the file
        # remains only as the fail-closed backstop for tools outside the pre-resolved
        # set — the grant no longer routes through it.
        effective_pins = write_effective_pins(
            _make_pins_dir() / "tool-pins.effective.yaml")
        prepass_env[HOST_PINS_ENV] = str(effective_pins)
        # Host-side verification of the pre-pass's whole trusted-tool set, on EVERY path
        # (the control is a property of the operation, not of the path taken to it).
        # A PRESENT-BUT-UNAUTHENTICATABLE tool refuses the run here — exactly what the
        # sandboxed path's bind boundary does at wrap time (lib/sandbox.py
        # _executable_binds); a genuinely ABSENT tool is skipped, and the script fails
        # closed or takes its documented fallback, again as the sandboxed path does.
        try:
            prepass_env.update(prepass_tool_env(
                sorted(set(PREPASS_EXECUTABLES) | set(policy.requires))))
        except ToolPinError as e:
            raise StationError(
                f"{agent_name}: a trusted tool the pre-pass may execute is present but "
                f"cannot be authenticated: {e}; refusing the run — the sandboxed path "
                f"refuses this state at the wrap's bind boundary, and the less-confined "
                f"path must not receive more than the more-confined path") from e
        # Egress control applies to the pre-pass on EVERY path (agents-2x6 for the
        # sandboxed half; agents-28nn round 7 for the unsandboxed half — the verdict's
        # P1, the third instance of the polarity shape enumerated above: the control
        # used to exist only under `if sandbox_ok`, so the less-confined pre-pass
        # inherited the operator's own proxy vars and ran with MORE network freedom
        # than the confined one). The control is a property of the pre-pass OPERATION,
        # not of the path taken to it. The sandboxed child's netns is isolated and its
        # only egress is the allowlist proxy, reached through the net_forward relay at
        # the fixed EGRESS_PROXY_PORT — named here because the wrap must be built
        # before the banner. The unsandboxed child gets the SAME allowlist proxy bound
        # on host TCP loopback (lib/egress_proxy.py _EgressTCPServer); its port is
        # dynamic, so its proxy env vars are set in the pre-pass execution block
        # below, the moment they become knowable. The loopback listener needs no
        # authentication: it injects no credential and only ever RESTRICTS where a
        # caller may connect, so a host-local process gains nothing from it that it
        # cannot already dial directly — the exact opposite of the credential broker,
        # whose loopback listener hands out authority and so requires the run secret
        # (round 7 P0). The proxy itself starts later, just before execution; the
        # socket path is deterministic (run_dir, already rw-bound) so the wrap is
        # built here, before the banner, exactly like the sandbox wrap. The proxy env
        # vars are set by the dispatcher (agents-5d9 removed them from
        # child_environment's BASE_ALLOW; a pre-pass never inherits the operator's
        # proxy on EITHER path now).
        if sandbox_ok:
            prepass_env["HTTP_PROXY"] = prepass_env["HTTPS_PROXY"] = \
                f"http://127.0.0.1:{EGRESS_PROXY_PORT}"
            prepass_env["NO_PROXY"] = "localhost,127.0.0.1"
            # The pre-pass scripts re-authenticate their own trusted tools (agents-28nn
            # round 4: a station script's own trusted-tool launch is a census kind of its
            # own — the bind boundary authenticates at WRAP time; the script re-verifies
            # at EXEC time). The host pins file lives under $HOME, tmpfs-hidden inside the
            # wrap, so the child reads the EFFECTIVE pins the host just verified, bound
            # READ-ONLY into the wrap at the same absolute path — a child that rewrites
            # the file it was handed gets EROFS, and resolve_tool keeps validating what
            # the host verified (round 5, the P0 that round's first commit closed).
            # FACTORY_PINS_RO_BOUND (round 6) is what licenses prepass_tool to re-verify
            # against the pins file at exec time: it is set ONLY here, where the kernel
            # enforces the file's integrity — on the unsandboxed path the same file is
            # operator-writable and the handoff rests on the dispatcher-resolved paths
            # instead.
            prepass_env[PINS_RO_BOUND_ENV] = "1"
            try:
                prepass_cmd = sandbox_command(
                    prepass_cmd, target_dir=read_dir, factory_root=FACTORY_ROOT,
                    run_dir=run_dir, env=prepass_env,
                    executables=tuple(PREPASS_EXECUTABLES) + tuple(policy.requires),
                    ro_binds=[str(effective_pins)],
                    egress_forwards=[(EGRESS_PROXY_PORT, str(proxy_sock))])
            except SandboxError as e:
                raise StationError(f"{agent_name}: cannot sandbox the pre-pass: {e}") from e

    adapter_script = FACTORY_ROOT / "lib" / "adapters" / f"{engine}.sh"
    # In worktree-write mode the engine's working directory is the disposable worktree, not
    # the target checkout (agents-6ce); the adapter cds there, so every relative path in the
    # report and the collected diff matches the target while edits land only in the worktree.
    adapter_cmd = [str(adapter_script), agent_name, str(engine_cwd), str(skill_dir), str(run_dir)]
    # The tool policy is set here, explicitly. child_environment is an allowlist, so an
    # ambient FACTORY_TOOL_POLICY in the operator's shell never reaches the adapter.
    # agents-28nn round 8 (verdict P1, the fourth inverted-polarity instance this bead has
    # met — enumerated on the rule comment at the pre-pass pins hoist above): this env used
    # to pass proxied=not engine_sandboxed(engine), forwarding the operator's HTTP_PROXY /
    # HTTPS_PROXY / NO_PROXY to the UNSANDBOXED engine only, so the less-confined path had
    # MORE network configuration freedom than the confined one. The engine's model API
    # traffic goes through the credential broker (host-side) or its own ~/.pi session, never
    # through an inherited operator proxy — the flag is dropped, not re-gated.
    adapter_env = child_environment(engine=engine)
    adapter_env["FACTORY_TOOL_POLICY"] = policy.tool_policy
    # agents-28nn round 5 (review P0 — credential exfiltration): the adapter is the LAST
    # GRANTER BEFORE THE KEY, so the binary it executes is pin-verified HERE, before the
    # credential-bearing env is handed over. The adapter execs ONLY this verified absolute
    # path (it refuses without it); a PATH-planted namesake is never executed, so it can
    # never receive the run's credentials. Failure is a station error naming the pin cause,
    # never a fallback to PATH order.
    try:
        engine_bin = _resolve_engine_bin(engine)
    except ToolPinError as e:
        raise StationError(
            f"{agent_name}: engine '{engine}'s binary cannot be authenticated: {e}; "
            f"refusing to hand the run's credentials to an unverified binary") from e
    if engine_bin is not None:
        adapter_env["FACTORY_ENGINE_BIN"] = engine_bin
    if engine == "pi":
        # agents-3y2: name the model explicitly so a sandboxed pi runs deepseek/deepseek-flash
        # (the keyless BYOK path) instead of falling back to its Anthropic default and asking
        # for ANTHROPIC_API_KEY. --model wins, then the FACTORY_MODEL env, then the default.
        adapter_env["FACTORY_MODEL"] = (
            model_arg or os.environ.get("FACTORY_MODEL") or DEFAULT_PI_MODEL)
    if policy.max_usd is not None:
        # Same explicit-channel rule as the tool policy: the declared cost cap reaches the
        # adapter only from here, and only an adapter with a per-run flag enforces it.
        adapter_env["FACTORY_MAX_BUDGET_USD"] = str(policy.max_usd)
    if engine_sandboxed(engine):
        # The engine session runs inside the OS sandbox: the target is read-only, everything
        # else on the host is invisible, $HOME is an empty tmpfs (auth reaches the engine
        # only as env vars per lib/child_env.py), and a private PID namespace keeps every
        # host process and its environ out of reach — the kernel's boundary, not the model's
        # (non-negotiable #2). FACTORY_SANDBOXED tells the adapter its session config is
        # hidden so it reports auth honestly (review P2).
        adapter_env["FACTORY_SANDBOXED"] = "1"
        # agents-854: pi's provider base URLs are hardcoded (api.deepseek.com etc.); the only
        # override it honours is models.json in its agent directory. Redirect that directory to
        # the per-run config dir (bound writable below: pi needs auth.json there too) holding a
        # broker-routed override.
        adapter_env["PI_CODING_AGENT_DIR"] = str(pi_config_dir)
        try:
            adapter_cmd = sandbox_command(
                adapter_cmd, target_dir=read_dir, factory_root=FACTORY_ROOT,
                run_dir=run_dir, env=adapter_env,
                executables=(engine,) + ENGINE_EXECUTABLES,
                egress_forwards=([(EGRESS_BROKER_PORT, str(broker_sock))]
                                 if egress_active else None),
                rw_binds=[str(pi_config_dir)],
                mask_findings=True)
        except SandboxError as e:
            raise StationError(f"{agent_name}: cannot sandbox engine '{engine}': {e}") from e

    print(f"\n[Software Factory] Run Initialized")
    print(f"  Agent:       {agent_name} ({agent_cfg.get('class', 'observer')})")
    for line in banner_lines(policy, engine, sandbox=sandbox,
                             unsandboxed_note=unsandboxed_note):
        print(line)
    print(f"  Budget:      {budget.minutes:g} min (enforced){budget_note(policy, engine)}")
    print(f"  Target:      {target_name} ({target_dir})")
    print(f"  Visibility:  {normalize_visibility(target_cfg.get('visibility'))} (enforced)")
    print(f"  Engine:      {engine}")
    print(f"  Sink:        {sink}")

    # What was declared, what the session was granted, and what is not enforced — the run's
    # own record, so a finding can be read against the containment it was produced under.
    # Written conservatively BEFORE the pre-pass (a crash still leaves the record).
    # After a credential broker actually starts and swaps the engine env, the captured
    # record is updated. It is REWRITTEN from those captured bytes after the session
    # (agents-7ik): a granted-write session could otherwise tamper with its record.
    policy_record_json = json.dumps(
        policy_record(policy, engine, sandbox=sandbox, unsandboxed_note=unsandboxed_note),
        indent=2)
    _write_run_artifact(run_dir / "policy.json", policy_record_json)

    # 1. Deterministic pre-pass
    candidates_data = []
    candidates_snapshot: Optional[bytes] = None
    model_parse_succeeded = True
    system_directive_text = None  # agents-m2n: lifted from the payload, see below

    if prepass_cmd is not None:
        print(f"\n[Step 1/3] Running deterministic pre-pass ({prepass_script.name})...")
        # The pre-pass is trusted factory code, but it still runs inside the OS sandbox
        # where one exists (agents-9n7, Copilot's point on PR #22): a scanner bug or a
        # malicious package pulled in by a `requires` tool must not gain the operator's
        # filesystem. Its environment remains an allowlist, and it gets a network credential
        # only when the validated capabilities declare network (lib/containment.py,
        # agents-05h). The command was wrapped above, before the banner. The pre-pass gets
        # procfs; the model session does not.
        # Egress allowlist proxy (agents-2x6): started here — after the wrap was built and
        # verified, just before the pre-pass dials — and stopped in the finally, so no
        # listener leaks on any failure. The allowlist is the agent's own requires
        # (lib/containment.py egress_allowlist); an agent that declares no network tools
        # gets an empty allowlist, which under --unshare-net means no egress at all — the
        # t0 promise, now kernel-enforced instead of conventional.
        # agents-28nn round 7 (verdict P1): the SAME proxy also serves the UNSANDBOXED
        # pre-pass, bound on host TCP loopback — the control rides the operation, not the
        # sandbox path. Its port is dynamic, so the unsandboxed child's proxy env vars
        # are set here, the moment they become knowable (the sandboxed child names the
        # relay's fixed EGRESS_PROXY_PORT because its wrap had to be built earlier).
        egress_proxy = EgressProxy(egress_allowlist(policy.requires), str(proxy_sock))
        try:
            egress_proxy.start(tcp_loopback=not sandbox_ok)
        except OSError as e:
            raise StationError(
                f"{agent_name}: cannot start the egress allowlist proxy for the "
                f"pre-pass; refusing to run it with unfiltered egress: {e}") from e
        if not sandbox_ok:
            prepass_env["HTTP_PROXY"] = prepass_env["HTTPS_PROXY"] = \
                f"http://127.0.0.1:{egress_proxy.tcp_port}"
            prepass_env["NO_PROXY"] = "localhost,127.0.0.1"
        try:
            res = run_station_command(prepass_cmd, budget, f"{prepass_script.name} pre-pass",
                                      capture_output=True, text=True, check=False,
                                      env=prepass_env)
        finally:
            egress_proxy.stop()
        if res.returncode != 0:
            # A pre-pass that failed scanned nothing. Carrying on with zero candidates let a
            # short-circuiting station report "Clean scan" (journal-idy, journal-wog).
            print(f"Pre-pass error: {res.stderr}")
            raise StationError(f"{agent_name}: {prepass_script.name} pre-pass exited "
                               f"{res.returncode}; no scan was performed")
        else:
            cand_json = json.loads(candidates_file.read_text(encoding="utf-8"))
            # agents-m2n: a pre-pass may declare a SYSTEM-channel directive (the threat-model
            # nonce directive) alongside its evidence. It must never ride in the user prompt
            # as ordinary Scanner Data — that is exactly the channel confusion the directive
            # guards against — so it is lifted out here, written to the run directory, and
            # handed to the adapter through FACTORY_SYSTEM_DIRECTIVE_FILE for the engine's
            # system channel (lib/adapters/*.sh; engines with no system channel prepend it
            # to the user prompt at maximum salience, honestly commented). candidates.json
            # on disk is unchanged: the findings store consumes it as-is.
            if isinstance(cand_json, dict) \
                    and isinstance(cand_json.get("system_instruction"), str) \
                    and cand_json["system_instruction"].strip():
                system_directive_text = cand_json.pop("system_instruction")
            if isinstance(cand_json, dict) and "candidates" in cand_json:
                candidates_data = cand_json["candidates"]
                print(f"-> Deterministic scanner found {len(candidates_data)} candidate matches.")
            else:
                candidates_data = cand_json
                print(f"-> Deterministic pre-pass produced context payload.")

        # agents-5bn: snapshot the scanner's ground truth BEFORE the engine session. The run
        # directory is rw-bound inside the OS sandbox, so a write-granted session could
        # overwrite candidates.json and forge the agents-nha identity binding; the bytes are
        # re-verified before findings dispatch (_verify_candidates_integrity).
        candidates_snapshot = candidates_file.read_bytes()

    # Short-circuit only if configured and 0 candidates found for an observer scan
    should_short_circuit = agent_cfg.get("short_circuit_empty", False)
    if should_short_circuit and len(candidates_data) == 0:
        print(f"\n[Step 2/3] Zero candidates found by deterministic pre-pass. Short-circuiting model invocation.")
        # agents-x8l: no engine ran, so the broker finally below never fires; remove the short
        # per-run socket dir here (the pre-pass proxy already stopped and unlinked its socket).
        shutil.rmtree(sock_dir, ignore_errors=True)
        shutil.rmtree(pi_config_dir, ignore_errors=True)
        report = {
            "summary": f"Clean scan. Deterministic pre-pass found 0 candidate issues in {target_name}.",
            "scanned_files": 0,
            "findings": []
        }
    else:
        # 2. Model triage invocation via engine adapter
        print(f"\n[Step 2/3] Invoking engine '{engine}' for triage and judgement...")
        if not adapter_script.exists():
            sys.stderr.write(f"Engine adapter script not found: {adapter_script}\n")
            sys.exit(1)

        candidates_slice = candidates_data[:50] if isinstance(candidates_data, list) else candidates_data

        prompt = (
            f"You are the {agent_name} agent. Examine the following context and candidate issues discovered by the "
            f"deterministic scanner in repository '{target_name}'. Follow your SKILL.md instructions, "
            f"triage each item, and output your structured JSON findings.\n\n"
            f"Scanner Data:\n{json.dumps(candidates_slice, indent=2)}\n"
        )
        # Carry the exact output contract in the prompt: a SKILL.md example with `"findings": []`
        # left the model to invent finding field names, and `"id"` for `rule_id` cost a whole
        # threat model (fleet-9wyi).
        try:
            output_schema = declared_schema(agent_dir, agent_cfg)
        except (FileNotFoundError, ValueError):
            output_schema = None
        if output_schema:
            prompt += (
                "\nYour final answer MUST be one JSON object that validates against this JSON "
                "Schema. Use these exact property names (e.g. `rule_id`, not `id`):\n"
                f"{json.dumps(output_schema, indent=2)}\n"
            )
        if repair_hint:
            # agents-noo: a repair-retry tells the model exactly what was rejected, so the second
            # attempt has a real chance of producing a valid report instead of the same garbage.
            prompt += "\n\n" + repair_hint
        prompt_file = run_dir / "prompt.txt"
        _write_run_artifact(prompt_file, prompt)
        os.chmod(prompt_file, 0o600)

        # agents-m2n: the directive file for the adapter's system channel. run_dir is
        # already read-write inside the OS sandbox, and the path reaches the adapter as a
        # dispatcher-set variable (never inherited from the operator's ambient environment,
        # so nothing outside the factory can point an engine at an arbitrary file).
        if system_directive_text is not None:
            directive_file = run_dir / "system_directive.txt"
            _write_run_artifact(directive_file, system_directive_text)
            adapter_env["FACTORY_SYSTEM_DIRECTIVE_FILE"] = str(directive_file)

        # adapter_cmd and adapter_env — and the sandbox wrap when one applies — were built
        # above, before the banner, so "Sandbox: enforced" reflects a wrapper that actually
        # constructed. The prompt is stdin, never argv: it embeds up to 50 raw scanner
        # records, and argv is visible to any local user (agents-pgr).
        # Engine-session lifecycle. Disposable worktree (agents-6ce): in worktree-write mode
        # create the throwaway worktree just before the session (so the sandbox's read-write
        # bind of run_dir picks it up), collect the session diff right after — the engine's
        # edits live only there and the target checkout was never touched — and always discard
        # it. Credential broker (agents-8h4): an engine must NOT carry the operator's real
        # API keys, because bun/pi reads its own /proc/self/environ and a prompt-injected
        # session would reach them. So when a real key is present, start a localhost broker
        # and swap the engine's key vars for a placeholder + the broker base URL; the
        # broker injects the real key host-side and forwards upstream. agents-28nn round 6
        # (review P1, the WORST of the inverted-polarity shapes): the broker used to start
        # ONLY if engine_sandboxed(engine), so the LESS-confined unsandboxed path handed
        # the engine RAW API KEYS where the confined path hands placeholders — an
        # unsandboxed engine's /proc/self/environ is exactly as readable to a
        # prompt-injected session as a sandboxed one's. THE LESS-CONFINED PATH MUST NOT
        # RECEIVE MORE THAN THE MORE-CONFINED PATH (the rule on lib/sandbox.py's
        # engine_sandboxed, also referenced by the hoisted pre-pass pins above): brokering
        # is a property of the engine's CREDENTIAL HANDLING, not of the path taken to it,
        # so the gate is SANDBOXED_ENGINES membership — the engines whose credentials the
        # factory brokers — and the broker starts for them on EVERY path. Under egress
        # control (agents-2x6) the engine's netns is isolated, so the broker listens on a
        # UNIX socket that the in-sandbox net_forward relay — bound at EGRESS_BROKER_PORT
        # on the child's loopback, which base_url() names — forwards to; otherwise the
        # broker keeps its TCP loopback (which an unsandboxed engine shares natively).
        # agents-28nn round 7 (the verdict's P0, a regression round 6 introduced): on the
        # unsandboxed path that TCP loopback is the HOST's — a shared interface any local
        # process can dial — and an unauthenticated broker there is an OPEN PROXY that
        # injects the raw credentials upstream for whoever asks (the verdict constructed
        # it with a plain curl that came back from the real provider authenticated as
        # us). Round 7 authenticated that reachability with the placeholder turned
        # per-run secret — and round 8's verdict falsified the secret as THE boundary,
        # by construction: the unsandboxed engine runs as the operator's uid, the same
        # uid as every process that could abuse the broker, so the placeholder in the
        # engine's environ (or in the models.json the engine reads) is readable by any
        # same-uid process via /proc/<pid>/environ — the reviewer's pre-pass-spawned
        # attacker read exactly that value and authenticated with it. A secret confines
        # by KNOWLEDGE; between processes of one uid there is no knowledge asymmetry.
        # So the broker gates on the kernel's attribution of the connecting PEER — the
        # TCP listener through /proc/net/tcp's inode -> owning pid and then the ppid
        # chain, the UNIX listener through getsockopt(SO_PEERCRED) (agents-28nn round 9)
        # — accepting only this dispatcher's process tree, narrowed to the ENGINE
        # SESSION's tree the moment the engine is spawned (run_station_command's
        # on_spawn below). Round 9's verdict found the UNIX listener UNGATED: its socket
        # FILE is created on the host filesystem before its directory is bind-mounted
        # into the sandbox, so the netns protects nothing there and a same-uid host
        # process could read the placeholder out of the session's environ, read the
        # socket path and dial the host socket directly (constructed: a 502, i.e. past
        # the gate and onto the wire). Both listeners now reach ONE peer decision in
        # lib/credential_broker.py, because two code paths is how one of them came to be
        # exempt from the check the other performed. WHO CAN REACH the broker is a
        # property of the OPERATION, not of the OS environment's uid rules. Chosen over
        # moving the unsandboxed transport to a UNIX socket with SO_PEERCRED: the
        # engine's SDK dials a TCP base URL and cannot dial a UNIX socket, so a relay
        # would sit on the same shared loopback needing this same check — the check is
        # the mechanism. Chosen over failing closed, which remains the posture whenever
        # the peer cannot be attributed at all: the gate refuses, never opens. The
        # default root is this dispatcher's pid and is safe because the pre-pass has
        # been reaped before the broker starts (the line below runs after it) and an
        # orphan re-parents to init, outside the tree. The placeholder stays as the
        # SECOND factor on both listeners; its presence in the engine's environ and in
        # models.json (which pi still needs) no longer confers authority by itself.
        # Both are started here — after the pre-pass — and torn down in the finally, so
        # neither leaks on any failure.
        broker: Optional[CredentialBroker] = None
        try:
            if engine in SANDBOXED_ENGINES:
                broker_creds = credentials_from_env()
                # What stays path-dependent, deliberately: with NO real key in the
                # environment an UNSANDBOXED engine keeps its own session configuration
                # (~/.pi), so no broker is started for it; a SANDBOXED engine has no
                # session config at all ($HOME is tmpfs-hidden), so it gets the keyless
                # managed-endpoint broker even then. A run holding real keys is brokered
                # on BOTH paths — the raw key never reaches the engine's environ.
                real_keys_held = bool(broker_creds)
                # agents-3y2: keyless BYOK providers (the exe.dev managed endpoints) are brokered
                # even with no real key on the host, so a sandboxed engine reaches them through
                # the host-side forwarder. Scope to providers this engine's credential allowlist
                # actually names; a None value means "forward with no injected key".
                engine_secret_vars = set(ENGINE_CREDENTIALS.get(engine, ()))
                for provider in keyless_providers():
                    _placeholder, _base_url, secret_vars = BROKER_PROVIDERS[provider]
                    if any(var in engine_secret_vars for var in secret_vars):
                        broker_creds.setdefault(provider, None)
                # agents-3z8: bind the broker to the specific provider configured for this run's
                # policy so the sandboxed engine cannot use the broker as an unauthorized cross-provider
                # egress proxy for other credentials held by the host.
                allowed_for_run = []
                if engine == "pi":
                    # adapter_env["FACTORY_MODEL"] is the authoritative model set above (line 1102)
                    effective_model = adapter_env.get("FACTORY_MODEL") or DEFAULT_PI_MODEL
                    model_prov = effective_model.split("/", 1)[0].lower()
                    if model_prov in PROVIDERS:
                        allowed_for_run = [model_prov]
                elif engine in ("deepseek", "claude", "antigravity"):
                    engine_prov_map = {"deepseek": "deepseek", "claude": "anthropic", "antigravity": "google"}
                    allowed_for_run = [engine_prov_map[engine]]

                # The broker starts on EVERY path when the run holds real engine keys
                # (agents-28nn round 6), and on the sandboxed path even without them (the
                # keyless managed endpoints are a sandboxed engine's ONLY auth channel).
                if broker_creds and (engine_sandboxed(engine) or real_keys_held):
                    broker = CredentialBroker(broker_creds, allowed_providers=allowed_for_run)
                    try:
                        if egress_active:
                            broker.start(unix_path=str(broker_sock),
                                         child_port=EGRESS_BROKER_PORT)
                        else:
                            broker.start()
                    except Exception as e:  # noqa: BLE001 - fail closed, never leak the key
                        raise StationError(
                            f"{agent_name}: cannot start the credential broker, so the real API "
                            f"key cannot be kept out of the engine's environ; refusing "
                            f"the run rather than leaking it: {e}") from e
                    apply_broker_urls(
                        adapter_env, {p: broker.base_url(p) for p in broker.providers},
                        placeholder=broker.placeholder)
                    # agents-3z8: ensure no real API keys for non-allowed providers cross into
                    # the engine's environment.
                    for prov, (_placeholder, _base_url, secret_vars) in BROKER_PROVIDERS.items():
                        if prov not in broker.providers:
                            for var in secret_vars:
                                adapter_env.pop(var, None)
                    if engine == "pi":
                        # agents-854: pi ignores *_BASE_URL env vars, so the broker swap above
                        # is not enough for pi — write the broker routing into its provider
                        # config, which IS honoured. The provider is whatever the selected
                        # model names, so the next keyless provider works without touching
                        # pi.sh. agents-28nn round 6: redirect pi's agent dir on EVERY
                        # brokered path (not only the sandboxed one), or an unsandboxed pi
                        # keeps reading ~/.pi and the placeholder + broker URL never take
                        # effect — the raw key would be popped above and NOTHING would
                        # authenticate the run.
                        adapter_env["PI_CODING_AGENT_DIR"] = str(pi_config_dir)
                        _write_pi_models_json(
                            pi_config_dir, broker, adapter_env["FACTORY_MODEL"].split("/", 1)[0])
                    # agents-2dj: only now can policy.json claim broker enforcement.
                    # The recorder checks the actual adapter env for every remaining
                    # model key and proxy credential, rather than trusting broker startup
                    # or egress_active as proof that no real key reaches /proc/self/environ.
                    policy_record_json = json.dumps(
                        policy_record(policy, engine, sandbox=sandbox,
                                      unsandboxed_note=unsandboxed_note,
                                      brokered_providers=tuple(broker.providers),
                                      engine_env=adapter_env,
                                      expected_placeholder=broker.placeholder), indent=2)
                    _write_run_artifact(run_dir / "policy.json", policy_record_json)
            if worktree_dir is not None:
                worktree_gitdir = _create_session_worktree(target_dir, worktree_dir)
                # agents-5bn: the run dir is rw-bound inside the sandbox, so a write-granted
                # session could pre-place run_dir/session.patch and be credited with a proposal
                # it never made in the worktree. Unlink before the engine so only
                # _collect_session_diff (host-side, after the session) can produce it.
                (run_dir / "session.patch").unlink(missing_ok=True)
                (run_dir / "session.patch.tmp").unlink(missing_ok=True)
            # agents-28nn round 8: the moment the engine exists, the broker's peer gate
            # narrows from this dispatcher's tree to the ENGINE SESSION's tree — the
            # broker serves exactly the process it was started for and no other
            # descendant of the dispatcher.
            adapter_res = run_station_command(
                adapter_cmd, budget, f"engine '{engine}'",
                input=prompt, capture_output=True, text=True,
                check=False, env=adapter_env,
                on_spawn=((lambda proc: broker.restrict_peer_root(proc.pid))
                          if broker is not None else None))
            # The adapter states what it enforced ("Tool policy: ..."): show the operator the
            # enforcement point's own words, not only the dispatcher's. Adapter stdout is
            # status lines only; the model's output goes to model_output.txt.
            for line in (adapter_res.stdout or "").splitlines():
                if line.startswith("["):
                    print(f"  {line}")
            # agents-7ik: collect the proposal ONLY from a successful session — a failed one
            # leaves partial edits that must not be presented as "the proposal"; they are
            # discarded together with the worktree in the finally below.
            session_succeeded = (adapter_res.returncode == 0
                                 and (run_dir / "model_output.txt").exists())
            if worktree_dir is not None:
                if session_succeeded:
                    patch_file = _collect_session_diff(worktree_dir, run_dir, worktree_gitdir)
                    if patch_file is not None:
                        print(f"  [worktree] Collected the session's edits as {patch_file.name}; "
                              f"the target checkout was not modified.")
                    else:
                        # agents-5bn: no collected edits, so any session.patch still in the run
                        # dir is one the write-granted session wrote itself (it ran with the run
                        # dir rw-bound). Only a patch _collect_session_diff produced is a real
                        # proposal — discard the rest.
                        (run_dir / "session.patch").unlink(missing_ok=True)
                        if _worktree_has_ignored_edits(worktree_dir, worktree_gitdir):
                            # agents-7ik: gitignored edits are real changes on disk that `git
                            # add -A` rightly refuses to stage — "no file edits" would be false.
                            print("  [worktree] The session's only edits are gitignored files — "
                                  "real changes on disk, but not representable as a patch proposal.")
                        else:
                            print("  [worktree] The session made no file edits (empty proposal).")
                else:
                    # agents-5bn: a failed session must not leave a forged session.patch either.
                    (run_dir / "session.patch").unlink(missing_ok=True)
                    print("  [worktree] Session failed; discarding its partial edits "
                          "(no proposal collected).")
        finally:
            # agents-7ik: restore policy.json from the captured dispatcher record. The
            # session just held run_dir read-write (it is the sandbox's rw bind), so its own
            # containment record is rewritten from trusted bytes — whatever the session
            # left there does not survive it (agents-5bn P0: the rewrite must not follow a
            # symlink the session planted at policy.json).
            _write_run_artifact(run_dir / "policy.json", policy_record_json)
            if broker is not None:
                broker.stop()
            # agents-x8l: both egress listeners (broker + proxy) have stopped and unlinked their
            # sockets, so the short per-run socket dir is empty. ignore_errors: a crashed or
            # short-circuited run may leave it without ever binding, and /tmp reaps a stray
            # empty 0700 dir harmlessly.
            shutil.rmtree(sock_dir, ignore_errors=True)
            shutil.rmtree(pi_config_dir, ignore_errors=True)
            if worktree_dir is not None:
                _remove_session_worktree(target_dir, worktree_dir)
        
        output_file = run_dir / "model_output.txt"
        raw_output = output_file.read_text(encoding="utf-8", errors="replace") if output_file.exists() else ""
        if adapter_res.returncode != 0:
            auth_reason = detect_adapter_auth_failure(raw_output, adapter_res.stderr or "", adapter_res.stdout or "")
            if auth_reason:
                sys.stderr.write(f"\n[environment failure] {agent_name}: engine '{engine}' adapter "
                                 f"authentication failed: {auth_reason}\n")
                report = {
                    "summary": f"ENVIRONMENT FAILURE: engine '{engine}' adapter authentication failed: {auth_reason}",
                    "verdict": "environment_failure",
                    "status": "ENV_FAILURE",
                    "error": auth_reason,
                    "scanned_files": len(candidates_data) if isinstance(candidates_data, list) else 1,
                    "findings": []
                }
                report_path = run_dir / "report.json"
                _write_run_artifact(report_path, json.dumps(report, indent=2))
                if not station_only:
                    dispatch_env_failure_report(target_name, agent_name, engine, auth_reason,
                                               findings_dir=FACTORY_ROOT / "findings")
                raise AdapterAuthError(agent_name, engine, adapter_res.returncode, auth_reason,
                                       output_file if output_file.exists() else None)

        if not output_file.exists():
            sys.stderr.write(f"Model output not produced: {adapter_res.stderr}\n")
            sys.exit(1)
        if adapter_res.returncode != 0:
            # The engine failed; whatever it left in model_output.txt is an error transcript,
            # not a verdict.
            sys.stderr.write(f"Engine adapter failed (exit {adapter_res.returncode}): "
                             f"{(adapter_res.stderr or '').strip()[-2000:]}\n")
            raise StationError(f"{agent_name}: engine '{engine}' exited {adapter_res.returncode}; "
                               f"no verdict (see {output_file})")

        raw_output = output_file.read_text(encoding="utf-8", errors="replace")
        report = extract_json_from_output(raw_output)
        if report is not None and not isinstance(report.get("findings"), list):
            # Every report contract requires a findings list. An object without one (a
            # fragment of truncated output, an echoed tool call) is not a verdict; reading
            # its missing findings as [] was a clean PASS/0 nobody earned.
            report = None
        if report is None:
            model_parse_succeeded = False
            no_verdict = "Could not parse a JSON report (with a findings list) from model output"
            print(f"Warning: {no_verdict}. Skipping findings store update to prevent false 'fixed' transitions.")
            report = {
                "summary": "NO VERDICT: model output contained no JSON report.",
                "verdict": "error",
                "scanned_files": len(candidates_data) if isinstance(candidates_data, list) else 1,
                "findings": []
            }
        else:
            # Known field-name synonyms are mapped first (fleet-9wyi): `"id"` for `rule_id`
            # is a usable report, not a missing one. Every mapping is printed and recorded.
            normalised = normalize_agent_report(agent_dir, agent_cfg, report)
            if normalised:
                print(f"Note: normalised {len(normalised)} field name(s)/value(s) in the model "
                      f"report (first: {normalised[0]}); see normalised_fields.json.")
                _write_run_artifact(run_dir / "normalised_fields.json",
                                    json.dumps(normalised, indent=2))
            # The output contract is the deterministic half of the agent (SF-07): a report
            # that violates it is treated exactly like unparseable output — the store never
            # sees it, so no finding transitions on half-formed data.
            schema_errors = validate_agent_report(agent_dir, agent_cfg, report, target_dir=target_dir)
            if schema_errors:
                model_parse_succeeded = False
                rejected = report.get("findings") if isinstance(report.get("findings"), list) else []
                # Say what was lost and where it is, so a rejection never reads as an empty
                # response (fleet-9wyi): the full violation list and the parsed report are kept.
                _write_run_artifact(run_dir / "schema_errors.json",
                                    json.dumps(schema_errors, indent=2))
                _write_run_artifact(run_dir / "rejected_report.json",
                                    json.dumps(report, indent=2))
                no_verdict = (f"Model output violates the declared report schema "
                              f"({len(schema_errors)} violation(s); first: {schema_errors[0]}); "
                              f"{len(rejected)} finding(s) were in the rejected report "
                              f"(kept in {run_dir / 'rejected_report.json'}, violations in "
                              f"schema_errors.json)")
                print(f"Warning: {no_verdict}. "
                      f"Skipping findings store update to prevent false 'fixed' transitions.")
                report = {
                    "summary": "NO VERDICT: model output failed the declared report schema.",
                    "verdict": "error",
                    "scanned_files": len(candidates_data) if isinstance(candidates_data, list) else 1,
                    "findings": []
                }

    if isinstance(report.get("findings"), list):
        report["findings"].sort(key=_finding_sort_key)
    report_path = run_dir / "report.json"
    _write_run_artifact(report_path, json.dumps(report, indent=2))
    if not model_parse_succeeded:
        # No verdict is a station failure, never PASS/0 (fleet-ddd, journal-mid). The raw output
        # stays in the run directory for a human (or a re-import) to recover. The engine ran and
        # returned zero — only its output was unusable — so this is a PLUMBING failure, not a
        # genuine engine failure: NoVerdictError, which run_line repair-retries once then degrades
        # and continues instead of halting every downstream station (agents-noo).
        raise NoVerdictError(f"{agent_name}: {no_verdict}; no verdict (raw output kept in "
                           f"{run_dir / 'model_output.txt'})")

    # If the agent produced THREAT_MODEL.md content, save it. If the agent returned summary
    # and findings on a target that already carries an authoritative THREAT_MODEL.md (in repo,
    # in run dir, or in findings store), preserve that document in the findings store so downstream
    # stations retain context (agents-tawg review).
    # If bootstrapping a target with neither an existing document nor a model-supplied document,
    # synthesize a structured provisional document across all 7 core sections so the target is
    # never left without a THREAT_MODEL.md.
    MAX_BOOTSTRAP_TM_BYTES = 16384
    agent_tm_doc = report.get("threat_model_markdown")
    if agent_tm_doc and agent_name == "threat-model":
        if isinstance(agent_tm_doc, str):
            tm_bytes = len(agent_tm_doc.encode("utf-8"))
            if tm_bytes > MAX_BOOTSTRAP_TM_BYTES:
                _write_run_artifact(run_dir / "rejected_report.json",
                                    json.dumps(report, indent=2))
                raise NoVerdictError(
                    f"{agent_name}: the synthesised document exceeded the bounded slot "
                    f"({tm_bytes} bytes > {MAX_BOOTSTRAP_TM_BYTES} bytes)"
                )
    tm_doc = report.get("threat_model_markdown")
    if not tm_doc and agent_name == "threat-model":
        candidates = [
            target_dir / "THREAT_MODEL.md",
            target_dir / "docs" / "THREAT_MODEL.md",
            run_dir / "THREAT_MODEL.md",
            FACTORY_ROOT / "findings" / f"{target_name}-THREAT_MODEL.md",
        ]
        for cand in candidates:
            if cand.exists():
                try:
                    loaded = cand.read_text(encoding="utf-8", errors="replace")
                    if loaded.strip():
                        tm_doc = loaded
                        break
                except OSError:
                    pass
        if not tm_doc or not tm_doc.strip():
            summary_text = report.get("summary", "Initial provisional threat model bootstrap.")
            findings_list = report.get("findings", [])
            findings_md = ""
            if findings_list:
                findings_md = "\n" + "\n".join(
                    f"- **[{f.get('severity', 'info').upper()}] {f.get('title', 'Gap')}** ({f.get('path', 'unknown')}): {f.get('description', '')}"
                    for f in findings_list if isinstance(f, dict)
                )
            else:
                findings_md = "\n- None identified during initial bootstrap scan."

            tm_doc = (
                f"# THREAT MODEL: {target_name} (Provisional Bootstrap Baseline)\n\n"
                f"> NOTICE: This initial document was generated by factory bootstrap from the threat-model agent's "
                f"structured summary and findings. Trust decisions, attack surfaces, bug-history hints, and invariants "
                f"are provisional verification questions and subject to operator confirmation.\n\n"
                f"## 1. System Overview & Architecture\n{summary_text}\n\n"
                f"## 2. Trust Boundaries & Actors\n"
                f"- [PROVISIONAL / VERIFY] Candidate boundary: Host/Operator environment vs External/Untrusted inputs.\n"
                f"- [VERIFY] Identify actors: System Operator, Local Subprocesses, Remote Network Entities, Third-Party Dependencies.\n\n"
                f"## 3. Explicitly Trusted (Non-Threats)\n"
                f"- [PROVISIONAL / VERIFY] Operator configuration and local administration tooling (verify against deployment model).\n"
                f"- [VERIFY] Determine which local environments and configurations are explicitly trusted.\n\n"
                f"## 4. Untrusted Attack Surfaces\n"
                f"- [PROVISIONAL / VERIFY] Inbound external network requests, unauthenticated data formats, and third-party dependencies.\n"
                f"- [VERIFY] Audit local file inputs originating from external or unauthenticated sources.\n\n"
                f"## 5. Bug-Shape Hints from History\n"
                f"- [PROVISIONAL] Past defect history not yet fully cataloged; inspect repository commit history and issue tracker.\n\n"
                f"## 6. Security Invariants for Auditors\n"
                f"- [PROVISIONAL / VERIFY] Check whether untrusted external inputs undergo schema/type validation before processing.\n"
                f"- [PROVISIONAL / VERIFY] Check whether subprocess execution and network socket binding adhere to least-privilege principles.\n\n"
                f"## 7. Explicit Exclusions (Wontfix / Accepted Risks)\n"
                f"- [PROVISIONAL] None confirmed at bootstrap. Auditors must treat unconfirmed risks as active investigation targets.\n\n"
                f"### Bootstrap Findings & Identified Gaps\n{findings_md}\n"
            )
    if tm_doc:
        tm_run_file = run_dir / "THREAT_MODEL.md"
        _write_run_artifact(tm_run_file, tm_doc)
        tm_findings_file = FACTORY_ROOT / "findings" / f"{target_name}-THREAT_MODEL.md"
        tm_findings_file.parent.mkdir(parents=True, exist_ok=True)
        tm_findings_file.write_text(tm_doc, encoding="utf-8")
        print(f"\n[Threat Model] Document saved to:\n  {tm_findings_file}")

    # 3. Findings Store & Sink Dispatch (only if model output parsed cleanly)
    if model_parse_succeeded:
        if candidates_snapshot is not None:
            _verify_candidates_integrity(candidates_file, candidates_snapshot)
        elif candidates_file.exists():
            # agents-5bn: no pre-pass produced candidates, yet one exists after the session — a
            # write-granted session wrote it. Refuse rather than bind findings against a
            # candidates.json with no trusted origin.
            raise StationError(
                "candidates.json appeared during the engine session without a deterministic "
                "pre-pass to produce it; a write-granted session may have forged scanner ground "
                "truth — refusing to dispatch findings against it")
        print(f"\n[Step 3/3] Processing findings through deduplication and sink adapter...")
        findings_py = FACTORY_ROOT / "lib" / "findings.py"
        findings_cmd = [
            sys.executable, str(findings_py),
            "--target", target_name,
            "--agent", agent_name,
            "--input", str(report_path),
            "--sink", sink,
            "--target-dir", str(target_dir),
            "--run-dir", str(run_dir),
        ]
        fragment_path = run_dir / "delta.json"
        if station_only:
            # One station of a line: the line writes the run's delta report (fleet-810).
            findings_cmd += ["--station-only", "--fragment", str(fragment_path)]
        # agents-eyo: findings file to beads automatically. Resolve the Beads DB from the
        # target manifest's beads_path (never guessed from a checkout remote), falling back to
        # the target checkout itself for a legacy layout.
        if any(s.strip() in ("beads", "both", "all") for s in sink.split(",")):
            beads_root = target_cfg.get("beads_path") or str(target_dir)
            findings_cmd += ["--beads-dir", str(Path(os.path.expanduser(str(beads_root))).resolve())]
        # Preserve the difference between an explicit public declaration and a missing
        # visibility: the latter must never authorise high/critical publication.
        if target_cfg.get("visibility") in ("public", "private"):
            findings_cmd += ["--visibility", target_cfg["visibility"]]
        if target_cfg.get("repo"):
            findings_cmd += ["--repo", str(target_cfg["repo"])]
        # Bind the model's rule_id/path to the scanner's candidates when a pre-pass produced
        # them: the model's strings are untrusted, the scanner's are not (agents-nha).
        if candidates_snapshot is not None:
            findings_cmd += ["--candidates", str(candidates_file)]
        sink_options = {k: v for k, v in target_cfg.items()
                        if isinstance(k, str) and k.startswith("sink_")}
        for key, value in sink_options.items():
            if isinstance(value, (str, int, float)) and not isinstance(value, bool):
                findings_cmd += ["--sink-option", f"{key}={value}"]
        # The findings child resolves `bd` (and `gh`) itself through lib.sinks, so it needs the
        # same trusted-tool pin source the parent just verified against (agents-dpt).
        dispatch_env = child_environment(sink=sink, sink_options=sink_options, trusted_tools=True)
        # agents-7bj: when the sink is the synced beads tracker the findings child resolves
        # `bd` by name; give it a PATH rebuilt from only that tool's install tree (plus the
        # system bin dirs a wrapped/shimmed bd's shebang needs), so it can never pick up a
        # trojaned binary from an unrelated directory earlier on PATH. Resolution itself is
        # pinned (lib.tool_pins) and fails closed on a missing or mismatched tool. The `file`
        # sink resolves no trusted tool, so its PATH is untouched. On a pin/resolution failure
        # we leave the PATH intact and let the findings child's own pinned resolution fail
        # closed with the finding retained — we never crash before findings.py runs (P0-1).
        if any(s.strip() in ("beads", "both", "all") for s in sink.split(",")):
            try:
                dispatch_env["PATH"] = allowlisted_path(("bd",), dispatch_env.get("PATH", ""))
            except ToolPinError as e:
                print(f"Warning: findings dispatch PATH not constrained ({e}); "
                      "findings.py will resolve bd itself and fail closed")
        run_station_command(findings_cmd, budget, "findings dispatch", check=True, env=dispatch_env)
    print(f"\nRun complete. Artifacts saved to:\n  {run_dir}\n")
    fragment = run_dir / "delta.json"
    # Run finished successfully: drop the active marker so this directory is eligible for
    # retention on a later run (agents-ped P2). A failed or killed run leaves its marker,
    # which the active grace eventually sweeps; the just-written artifacts are still kept.
    try:
        (run_dir / ACTIVE_MARKER_NAME).unlink(missing_ok=True)
    except OSError:
        pass
    return {
        "run_id": run_id,
        "run_dir": run_dir,
        "report": report,
        "report_path": report_path,
        "target_name": target_name,
        "fragment": str(fragment) if fragment.exists() else None,
    }

def count_criticals(findings: Any) -> int:
    """The line's critical count, from the same severity source as the findings store.

    The andon used to compare the raw label (`== "critical"`, case-sensitive) while the store
    recorded the fail-closed routing value, so one run said 4 criticals and the store said 14
    (journal-y5m). Both now use `reported_severity`, which never counts a triaged false
    positive or an unlabelled finding as critical.
    """
    if not isinstance(findings, list):
        return 0
    return sum(1 for f in findings if isinstance(f, dict) and reported_severity(f) == "critical")


def run_station_with_repair_retry(st_agent: Any, target_arg: str, st_engine: str,
                                  explicit_sink: Optional[str],
                                  model_arg: Optional[str] = None,
                                  visibility_arg: Optional[str] = None,
                                  budget_minutes: Optional[float] = None) -> Any:
    """Run one station, giving a no-verdict PLUMBING failure ONE bounded repair-retry (agents-noo).

    A GENUINE failure — a StationError that is not a NoVerdictError (a failed pre-pass or engine)
    or a SystemExit (fail-closed) — propagates immediately and is never retried: the station could
    not run, so the line must halt. A no-verdict (the engine ran and returned zero but its output
    was unparseable or schema-invalid) is retried ONCE with a hint telling the model what was
    rejected; if the retry also produces no verdict, the NoVerdictError propagates so run_line
    degrades the station to ERROR and continues the line as INCOMPLETE rather than halting."""
    try:
        return run_agent(st_agent, target_arg, st_engine, explicit_sink, station_only=True,
                         model_arg=model_arg, visibility_arg=visibility_arg,
                         budget_minutes=budget_minutes)
    except NoVerdictError as e:
        print(f"\n  🔧 [repair-retry] Station '{st_agent}' produced no verdict: {e}")
        print(f"     Retrying ONCE, telling the model its previous output was rejected...")
        hint = (f"Your previous output produced NO VERDICT and was rejected: {e}. Respond with "
                f"ONLY one valid JSON object that validates against the declared report schema — "
                f"no prose, no code fences, no tool calls.")
        return run_agent(st_agent, target_arg, st_engine, explicit_sink, station_only=True,
                         repair_hint=hint, attempt=2, model_arg=model_arg,
                         visibility_arg=visibility_arg, budget_minutes=budget_minutes)


def run_line(line_name: str, target_arg: str, engine_arg: str = "auto", explicit_sink: Optional[str] = None,
             model_arg: Optional[str] = None, visibility_arg: Optional[str] = None,
             budget_minutes: Optional[float] = None):
    line_yaml = FACTORY_ROOT / "lines" / f"{line_name}.yaml"
    if not line_yaml.exists():
        sys.stderr.write(f"Factory line '{line_name}' not found in {FACTORY_ROOT / 'lines'}\n")
        sys.exit(1)

    line_cfg = load_yaml_simple(line_yaml)
    stations = line_cfg.get("stations", [])
    station_engines = line_cfg.get("station_engines", {})
    station_budgets = line_cfg.get("station_budgets", {})
    halt_on_critical = line_cfg.get("andon_halt_on_critical", True)
    halt_on_failure = line_cfg.get("andon_halt_on_failure", True)
    andon_stations = line_cfg.get("andon_stations", ["secret-scan", "vuln-triage"])

    print("\n" + "=" * 70)
    print(f"🏭 FACTORY LINE STARTED: {line_name.upper()}")
    print(f"   Target:   {target_arg}")
    print(f"   Stations: {len(stations)} stations queued")
    print(f"   Andon:    Halt on critical = {halt_on_critical} (gates: {', '.join(andon_stations)})")
    print("=" * 70 + "\n")

    scorecard = []
    line_halted = False
    target_name = None
    try:
        target_name = resolve_target(target_arg)[0]
    except Exception as e:
        # Reported per station below (each fails the same way); the line report needs a name.
        print(f"🚨 Target unavailable: {e}")

    def station_name(station: Any) -> Any:
        return station if isinstance(station, str) else station.get("agent")

    for idx, station in enumerate(stations, start=1):
        st_agent = station_name(station)
        st_summary = station.get("summary", "") if isinstance(station, dict) else ""
        # A line can pin a station's engine, so verification need not share discovery's model
        # family (SF-08, non-negotiable #3). `station_engines: {<agent>: <engine>}`.
        st_engine = station_engines.get(st_agent, engine_arg) if isinstance(station_engines, dict) else engine_arg
        print(f"\n▶ [Station {idx}/{len(stations)}] Commencing: {st_agent} [{st_engine}] -- {st_summary}")
        st_budget = budget_minutes or (station_budgets.get(st_agent) if isinstance(station_budgets, dict) else None)
        try:
            res = run_station_with_repair_retry(st_agent, target_arg, st_engine, explicit_sink,
                                                 model_arg=model_arg, visibility_arg=visibility_arg,
                                                 budget_minutes=st_budget)
            report = res.get("report", {}) if res else {}
            findings = [f for f in report.get("findings", []) if isinstance(f, dict) and not is_false_positive(f)]
            criticals = count_criticals(findings)

            status = "PASS" if not criticals else "ALERT"
            scorecard.append({
                "station": st_agent,
                "status": status,
                "findings_count": len(findings),
                "criticals": criticals,
                "fragment": res.get("fragment") if res else None,
                "run_dir": str(res.get("run_dir")) if res else None,
            })

            # Check Andon Cord only at designated gate stations (or all if "*" in andon_stations)
            station_gated = ("*" in andon_stations) or (st_agent in andon_stations)
            if halt_on_critical and station_gated and criticals > 0:
                print(f"\n🚨 [ANDON CORD PULLED] Line halted at gate station '{st_agent}'!")
                print(f"   Discovered {criticals} critical finding(s). Downstream stations aborted.")
                line_halted = True
                break
        except AdapterAuthError as e:
            # An environment/auth failure: the adapter could not authenticate (agents-zrn).
            # Record it as ENV_FAILURE with unknown counts, never PASS and never clean 0.
            print(f"\n🚨 [ENVIRONMENT FAILURE] Station '{st_agent}' adapter authentication failed: {e}")
            scorecard.append({
                "station": st_agent,
                "status": "ENV_FAILURE",
                "findings_count": None,
                "criticals": None,
                "error": f"adapter auth failure: {e.reason}",
            })
            if halt_on_failure:
                line_halted = True
                break
        except NoVerdictError as e:
            # Both the original attempt and the ONE bounded repair-retry produced no verdict
            # (agents-noo). This is a PLUMBING failure — the engine ran and returned zero, only its
            # output was unparseable or schema-invalid — NOT a genuine engine failure. So degrade
            # the station to ERROR (no verdict) and CONTINUE the line; do NOT halt and skip every
            # downstream station. The line is INCOMPLETE and returns failure, so the missing
            # verdict is never read as a clean PASS (fleet-ddd).
            print(f"\n  ⚠️ [degrade] Station '{st_agent}' produced no verdict even after the repair-retry.")
            print(f"     Marking it ERROR (no verdict) and CONTINUING; the line is INCOMPLETE, not halted.")
            scorecard.append({"station": st_agent, "status": "ERROR", "findings_count": None,
                              "criticals": None, "error": f"no verdict after repair-retry: {e}"})
            # No break: fall through to the next station.
        except StationTimeout as e:
            # A station exceeded its declared budget (agents-7ms).
            # If the station is an Andon gate, halt the line; otherwise record TIMEOUT
            # and CONTINUE so downstream independent stations are not starved.
            # The line is marked INCOMPLETE and fails, never reading as clean PASS.
            station_gated = ("*" in andon_stations) or (st_agent in andon_stations)
            if halt_on_failure and station_gated:
                print(f"\n🚨 [ANDON CORD PULLED] Gate station '{st_agent}' timed out: {e}")
                scorecard.append({"station": st_agent, "status": "TIMEOUT", "findings_count": None,
                                  "criticals": None, "error": str(e)})
                line_halted = True
                break
            else:
                print(f"\n  ⏱️ [timeout] Station '{st_agent}' timed out: {e}")
                print(f"     Marking it TIMEOUT and CONTINUING; the line is INCOMPLETE, not halted.")
                scorecard.append({"station": st_agent, "status": "TIMEOUT", "findings_count": None,
                                  "criticals": None, "error": str(e)})
                # No break: fall through to the next station.
        except SystemExit as e:
            # A station that fails closed calls sys.exit (run_agent does it when an adapter
            # produces no model output). SystemExit is not an Exception, so without this branch
            # the process aborted mid-line: no scorecard, no Andon, no halt_on_failure
            # (agents-p2c).
            code = e.code
            detail = f"exited with code {code}" if code not in (None, 0) else "exited unexpectedly"
            print(f"\n🚨 [ANDON CORD PULLED] Station '{st_agent}' {detail}.")
            # No verdict: the counts are unknown, not zero (journal-idy).
            scorecard.append({"station": st_agent, "status": "ERROR", "findings_count": None,
                              "criticals": None, "error": detail})
            if halt_on_failure:
                line_halted = True
                break
        except Exception as e:
            print(f"\n🚨 [ANDON CORD PULLED] Station '{st_agent}' failed with error: {e}")
            scorecard.append({"station": st_agent, "status": "ERROR", "findings_count": None,
                              "criticals": None, "error": str(e)})
            if halt_on_failure:
                line_halted = True
                break

    # Stations the halt prevented are listed, so the report cannot read as covering them.
    halted_at = scorecard[-1]["station"] if line_halted and scorecard else None
    skipped = [station_name(station) for station in stations[len(scorecard):]]
    for name in skipped:
        scorecard.append({"station": name, "status": "SKIPPED",
                          "findings_count": None, "criticals": None,
                          "error": f"not run: line halted at {halted_at}"})
    if skipped:
        # The failure names what it cost, not just the failing station (fleet-9wyi).
        print(f"\n⏭️  Halt at '{halted_at}' SKIPPED {len(skipped)} station(s): {', '.join(skipped)}")

    errored = [sc for sc in scorecard if sc["status"] not in VERDICT_STATUSES]
    print("\n" + "=" * 70)
    state = "HALTED" if line_halted else ("INCOMPLETE" if errored else "COMPLETE")
    print(f"🏁 FACTORY LINE SCORECARD: {line_name.upper()} ({state})")
    print("-" * 70)
    print(f"{'STATION':<25} {'STATUS':<12} {'FINDINGS':<10} {'CRITICALS'}")
    print("-" * 70)
    for sc in scorecard:
        # A station with no verdict has unknown counts: print "-", never a reassuring 0.
        count = sc.get("findings_count")
        crit = sc.get("criticals")
        print(f"{sc['station']:<25} {sc['status']:<12} {'-' if count is None else count:<10} "
              f"{'-' if crit is None else crit}")
    print("=" * 70 + "\n")
    if errored:
        env_fails = [sc for sc in scorecard if sc["status"] == "ENV_FAILURE"]
        if env_fails:
            print(f"🚨 {len(env_fails)} station(s) encountered ENVIRONMENT FAILURE (adapter auth): "
                  f"{', '.join(sc['station'] for sc in env_fails)}.\n")
        timeouts = [sc for sc in scorecard if sc["status"] == "TIMEOUT"]
        if timeouts:
            print(f"⏱️  {len(timeouts)} station(s) TIMED OUT: "
                  f"{', '.join(sc['station'] for sc in timeouts)}.\n")
        other_errored = [sc for sc in errored if sc["status"] != "ENV_FAILURE"]
        if other_errored:
            print(f"⚠️  {len(other_errored)} station(s) produced no verdict: "
                  f"{', '.join(sc['station'] for sc in other_errored)}. This run is not clean.\n")

    # The run's delta report is written once, from every station (fleet-810).
    if target_name:
        try:
            report_file = write_line_report(target_name, line_name, scorecard,
                                            findings_dir=FACTORY_ROOT / "findings")
            print(f"Line delta report written to: {report_file}")
            # Findings/ evidence has no other retention; bound it by a byte budget once per
            # line, after the reports are written (agents-0ti).
            findings_budget = findings_retention_config()
            for pruned in prune_findings(FACTORY_ROOT / "findings", budget_bytes=findings_budget):
                print(f"[retention] pruned old findings report: {pruned}")
        except Exception as e:
            print(f"🚨 Could not write the line delta report: {e}")
            return False
    # A halted line is a failed line: without a non-zero exit the Andon cord has no signal for
    # a caller (CI, a scheduled wrapper, an operator script). So is a line where a station
    # produced no verdict, even when halt_on_failure let it continue.
    return not line_halted and not errored

def run_hillclimb(
    target_arg: str,
    goal_metric: str = "perf_hazard_score",
    goal_value: Optional[float] = None,
    iterations: int = 1,
    apply_edits: bool = False,
    engine_arg: str = "auto",
    explicit_sink: Optional[str] = None,
    visibility_arg: Optional[str] = None
) -> bool:
    """Run the Class C perf hill-climber. Returns True when the run completed (proposals
    recorded, or kept edits persisted as a patch proposal); returns False when --apply could
    not obtain an isolated worktree, so the run refused rather than mutate the operator's
    checkout (non-negotiable #6: propose, don't apply)."""
    from lib.bench.runner import measure_target, append_ledger, read_ledger

    target_name, target_dir, _ = resolve_target(target_arg)

    def _record_blocked(reason: str, baseline_value: float = 0.0,
                        candidate_value: float = 0.0) -> bool:
        append_ledger(target_name, {
            "step": 0,
            "hypothesis": "Isolated apply workspace",
            "files_touched": [],
            "metric": goal_metric,
            "baseline_value": baseline_value,
            "candidate_value": candidate_value,
            "delta": 0,
            "outcome": "BLOCKED",
            "reason": reason,
        })
        print(f"\n🚨 --apply blocked: {reason}")
        print("   The operator's checkout was NOT modified. Fix the cause and re-run "
              "(or run without --apply to record proposals only).")
        return False

    # --apply must run entirely inside a disposable worktree. There is no fallback to editing
    # the operator's checkout: if an isolated workspace cannot be provided, the run fails closed
    # (non-negotiable #6 / agents-6ce) rather than silently escalating to a write on the real
    # tree. The worktree is created ONCE and reused across iterations so a kept win stays on
    # disk and the next iteration measures it (not the untouched target).
    worktree_dir: Optional[Path] = None
    worktree_gitdir: Optional[Path] = None
    proposal_run_dir: Optional[Path] = None
    if apply_edits:
        # P1-2 (agents-nei): refuse a mismatched workspace BEFORE measuring the checkout. The
        # baseline is measured on the operator's checkout while the disposable worktree starts
        # at HEAD; a tracked/untracked change OR an ignored measured asset would make the two
        # disagree and could mint a phantom KEPT win against a baseline not present in HEAD.
        if not (target_dir / ".git").exists():
            return _record_blocked(
                "the target is not a git repository, so no disposable worktree can isolate "
                "the candidate edit from the operator's checkout")
        mismatch = _apply_workspace_mismatch(target_dir)
        if mismatch is not None:
            return _record_blocked(mismatch)
        run_id = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
        proposal_run_dir = FACTORY_ROOT / "runs" / f"hillclimb-{target_name}-{run_id}"
        try:
            proposal_run_dir.mkdir(parents=True, exist_ok=False)
        except FileExistsError:
            proposal_run_dir = FACTORY_ROOT / "runs" / f"hillclimb-{target_name}-{run_id}-{token_hex(4)}"
            proposal_run_dir.mkdir(parents=True, exist_ok=False)
        os.chmod(proposal_run_dir, 0o700)
        worktree_dir = proposal_run_dir / "worktree"
        try:
            worktree_gitdir = _create_session_worktree(target_dir, worktree_dir)
        except StationError as e:
            # P2-1 (agents-nei): _create_session_worktree can raise AFTER `git worktree add`
            # succeeded (e.g. rev-parse fails), leaving a registered admin worktree under the
            # target's .git. Run the cleanup helper (idempotent, best-effort) before deleting
            # the run dir so no leftover registration survives. Guard on the worktree dir so a
            # pure add-failure (nothing was created) skips the noisy remove attempt.
            if worktree_dir.exists():
                _remove_session_worktree(target_dir, worktree_dir)
            # agents-dm8n round 2 (review finding 2): this removal deletes under the runs
            # root OUTSIDE prune_run_dirs, so it must go through the same recorded-removal
            # choke point - a bare rmtree here was a deleter the tombstone ledger could not
            # see. remove_recorded tombstones the removal (and any partial loss, at file
            # granularity) in the ledger beside the runs root.
            remove_recorded(proposal_run_dir, reason="apply-worktree-failure")
            return _record_blocked(f"cannot create the disposable apply worktree: {e}")

    baseline = measure_target(target_dir)

    if goal_metric == "perf_hazard_score" and baseline.get("perf_hazard_score", 0) == 0:
        goal_metric = "total_gzip_bytes"

    current_val = float(baseline.get(goal_metric, baseline["total_gzip_bytes"]))
    target_goal = goal_value if goal_value is not None else (0.0 if goal_metric == "perf_hazard_score" else round(current_val * 0.90, 2))

    print("\n" + "=" * 70)
    print(f"⛰️  CLASS C HILL-CLIMB OPTIMIZER STARTED")
    print(f"   Target:      {target_name} ({target_dir})")
    print(f"   Metric:      {goal_metric}")
    print(f"   Baseline:    {current_val}  -->  Goal: {target_goal}")
    print(f"   Max Steps:   {iterations} (Apply & Verify in Worktree = {apply_edits})")
    print("=" * 70)

    try:
        for step_idx in range(1, iterations + 1):
            if current_val <= target_goal:
                print(f"\n🎯 Goal achieved! ({goal_metric} = {current_val} <= {target_goal})")
                break

            print(f"\n--- [Iteration {step_idx}/{iterations}] Running perf-hillclimb station ---")
            # P2-2: every iteration must read the accumulated worktree (which carries each
            # prior kept edit), not the operator's unchanged checkout — otherwise a later
            # proposal re-proposes an already-kept edit and is rejected as an unmatched
            # snippet. The engine policy stays read-only (run_agent resolves the optimizer's
            # read-only grant); only the READ scope moves.
            res = run_agent("perf-hillclimb", target_arg, engine_arg, explicit_sink,
                            read_target_dir=worktree_dir, visibility_arg=visibility_arg)
            report = res.get("report", {}) if res else {}
            steps = report.get("hillclimb_steps", [])

            if not steps:
                print("No further hill-climb steps proposed by model.")
                break

            top_step = steps[0]
            hypothesis = top_step.get("hypothesis", "Unnamed optimization step")
            rel_file = top_step.get("target_file", "")
            search_snip = top_step.get("search_snippet", "")
            replace_snip = top_step.get("replace_snippet", "")

            if not apply_edits or not rel_file or not search_snip:
                append_ledger(target_name, {
                    "step": step_idx,
                    "hypothesis": hypothesis,
                    "files_touched": [rel_file] if rel_file else [],
                    "metric": goal_metric,
                    "baseline_value": current_val,
                    "candidate_value": current_val,
                    "delta": top_step.get("expected_delta", 0),
                    "outcome": "PROPOSED",
                    "reason": "Proposal recorded (run with --apply to execute in-place verification)"
                })
                print(f"📝 Recorded proposal to ledger: {hypothesis}")
                continue

            # Boundary-check rel_file against the TARGET (defence in depth against path
            # traversal). The edit itself happens only in the isolated worktree.
            target_file_path = (target_dir / rel_file).resolve()
            if not target_file_path.is_relative_to(target_dir.resolve()) or not target_file_path.exists():
                append_ledger(target_name, {
                    "step": step_idx,
                    "hypothesis": hypothesis,
                    "files_touched": [rel_file],
                    "metric": goal_metric,
                    "baseline_value": current_val,
                    "candidate_value": current_val,
                    "delta": 0,
                    "outcome": "REVERTED",
                    "reason": f"Target file {rel_file} is outside target boundary or does not exist"
                })
                continue

            # Read and edit the WORKTREE copy, which carries every kept win from prior
            # iterations. The operator's checkout is never read for the edit or written at all.
            edit_file = (worktree_dir / rel_file).resolve() if apply_edits else target_file_path
            if apply_edits and (not edit_file.is_relative_to(worktree_dir.resolve()) or not edit_file.exists()):
                append_ledger(target_name, {
                    "step": step_idx,
                    "hypothesis": hypothesis,
                    "files_touched": [rel_file],
                    "metric": goal_metric,
                    "baseline_value": current_val,
                    "candidate_value": current_val,
                    "delta": 0,
                    "outcome": "REVERTED",
                    "reason": f"Target file {rel_file} is not present in the apply worktree"
                })
                continue

            original_text = edit_file.read_text(encoding="utf-8")
            if search_snip not in original_text:
                append_ledger(target_name, {
                    "step": step_idx,
                    "hypothesis": hypothesis,
                    "files_touched": [rel_file],
                    "metric": goal_metric,
                    "baseline_value": current_val,
                    "candidate_value": current_val,
                    "delta": 0,
                    "outcome": "REVERTED",
                    "reason": "search_snippet did not match exact file contents"
                })
                continue

            updated_text = original_text.replace(search_snip, replace_snip, 1)
            edit_file.write_text(updated_text, encoding="utf-8")
            new_metrics = measure_target(worktree_dir if apply_edits else target_dir)

            new_val = float(new_metrics.get(goal_metric, current_val))
            delta = round(new_val - current_val, 2)

            if new_val < current_val:
                print(f"✅ WIN VERIFIED! {goal_metric}: {current_val} -> {new_val} (delta: {delta})")
                if apply_edits:
                    # P1-3 (agents-nei): persist the proposal BEFORE the KEPT row becomes
                    # durable. A collection failure here raises before append_ledger, so a KEPT
                    # row can never outlive the patch that records its edit — the worktree is
                    # discarded in the finally and no orphan KEPT survives.
                    _collect_session_diff(worktree_dir, proposal_run_dir, worktree_gitdir)
                append_ledger(target_name, {
                    "step": step_idx,
                    "hypothesis": hypothesis,
                    "files_touched": [rel_file],
                    "metric": goal_metric,
                    "baseline_value": current_val,
                    "candidate_value": new_val,
                    "delta": delta,
                    "outcome": "KEPT",
                    "reason": f"Metric improved by {abs(delta)}"
                })
                # The edit is already persisted in the worktree file above, so advancing
                # current_val matches a value that is now on disk (measure_target would
                # return it on the next iteration).
                current_val = new_val
            else:
                # Revert the worktree file so disk stays exactly at current_val: a rejected
                # step must not drift the accumulated workspace (or the operator's checkout).
                edit_file.write_text(original_text, encoding="utf-8")
                print(f"↩️  REVERTED! {goal_metric}: {current_val} -> {new_val} (did not improve).")
                append_ledger(target_name, {
                    "step": step_idx,
                    "hypothesis": hypothesis,
                    "files_touched": [rel_file],
                    "metric": goal_metric,
                    "baseline_value": current_val,
                    "candidate_value": new_val,
                    "delta": delta,
                    "outcome": "REVERTED",
                    "reason": f"Metric did not improve (delta {delta})"
                })

    except BaseException:
        # P1-3 (agents-nei): a verified KEPT already persisted its proposal before the ledger
        # row was appended, so an interruption can simply re-raise — session.patch (if any) is
        # already on disk and the finally discards only the worktree, never the proposal.
        if apply_edits and proposal_run_dir is not None \
                and (proposal_run_dir / "session.patch").exists():
            print(f"\n🧾 Preserved the hill-climb's kept edits as "
                  f"{proposal_run_dir / 'session.patch'} before the interrupted run was "
                  f"discarded; the target checkout was NOT modified.")
        raise
    else:
        # Normal completion: every KEPT row already persisted the accumulated proposal as
        # session.patch before it was recorded (P1-3), so there is no final collection that
        # could fail after a durable KEPT row.
        if apply_edits and proposal_run_dir is not None:
            patch_file = proposal_run_dir / "session.patch"
            if patch_file.exists():
                print(f"\n🧾 Collected the hill-climb's kept edits as {patch_file}; "
                      f"the target checkout was NOT modified. Apply that patch to persist the wins.")
            else:
                print("\n🧾 The hill-climb made no kept edits (empty proposal); "
                      "the target checkout was NOT modified.")
        return True
    finally:
        if apply_edits and worktree_dir is not None:
            _remove_session_worktree(target_dir, worktree_dir)


def install_pre_commit_hook(target_arg: Optional[str] = None, all_targets: bool = False):
    """Install a sub-second deterministic secret-scan git pre-commit hook (Rule 8 compliant)."""
    targets_to_install: List[Tuple[str, Path]] = []
    if all_targets:
        targets_dir = FACTORY_ROOT / "targets"
        for t_file in sorted(targets_dir.glob("*.yaml")):
            name, path, _ = resolve_target(t_file.stem)
            if path.exists():
                targets_to_install.append((name, path))
    elif target_arg:
        name, path, _ = resolve_target(target_arg)
        targets_to_install.append((name, path))
    else:
        raise ValueError("Specify --target <name|path> or --all")

    scan_script = FACTORY_ROOT / "agents" / "secret-scan" / "scripts" / "scan.py"
    marker_start = "# --- SOFTWARE FACTORY PRE-COMMIT START ---"
    marker_end = "# --- SOFTWARE FACTORY PRE-COMMIT END ---"

    for name, target_path in targets_to_install:
        git_dir = target_path / ".git"
        if not git_dir.exists():
            print(f"[hook] Skipping {name} ({target_path}): no .git directory found.")
            continue

        hooks_dir = git_dir / "hooks"
        hooks_dir.mkdir(parents=True, exist_ok=True)
        hook_file = hooks_dir / "pre-commit"

        hook_block = f"""{marker_start}
# Deterministic sub-second secret scan gate (Rule 8: zero model calls)
SF_OUT=$(python3 "{scan_script}" --target "{target_path}" 2>/dev/null)
SF_COUNT=$(printf "%s" "$SF_OUT" | python3 -c 'import json,sys; d=json.loads(sys.stdin.read() or "{{}}"); print(d.get("candidate_count", 0))' 2>/dev/null || echo 0)
if [ "$SF_COUNT" -gt 0 ]; then
  echo "❌ [Software Factory: secret-scan] Blocked commit in {name}: $SF_COUNT potential secret(s) detected."
  printf "%s" "$SF_OUT" | python3 -c 'import json,sys; d=json.loads(sys.stdin.read() or "{{}}"); [print(f"  - {{f.get(\\"rule_id\\")}}: {{f.get(\\"path\\")}}:{{f.get(\\"line_number\\", f.get(\\"start_line\\"))}}") for f in d.get("candidates", d.get("findings", []))]'
  exit 1
fi
{marker_end}"""

        if hook_file.exists():
            existing = hook_file.read_text(encoding="utf-8", errors="ignore")
            if marker_start in existing and marker_end in existing:
                pattern = re.compile(re.escape(marker_start) + r".*?" + re.escape(marker_end), re.DOTALL)
                updated = pattern.sub(hook_block, existing)
                hook_file.write_text(updated, encoding="utf-8")
            else:
                hook_file.write_text(existing.rstrip() + "\n\n" + hook_block + "\n", encoding="utf-8")
        else:
            hook_file.write_text("#!/usr/bin/env bash\nset -e\n\n" + hook_block + "\n", encoding="utf-8")

        hook_file.chmod(0o755)
        print(f"✅ Installed deterministic pre-commit hook in {name} ({hook_file})")


def install_skills():
    """Symlink all Software Factory agents into local interactive CLI plugin/skill directories."""
    agents_dir = FACTORY_ROOT / "agents"
    home = Path.home()

    # 1. Gemini / Antigravity plugin skills directory
    gemini_plugin_dir = home / ".gemini" / "config" / "plugins" / "software-factory-plugin"
    gemini_skills_link = gemini_plugin_dir / "skills"
    gemini_plugin_dir.mkdir(parents=True, exist_ok=True)
    if gemini_skills_link.is_symlink() or gemini_skills_link.exists():
        if gemini_skills_link.is_symlink():
            gemini_skills_link.unlink()
    if not gemini_skills_link.exists():
        gemini_skills_link.symlink_to(agents_dir)
    print(f"✅ Linked Software Factory skills plugin -> {gemini_skills_link}")

    # 2. Per-skill symlink targets: Claude Code (~/.claude/skills), pi (~/.pi/agent/skills), and shared (~/.agents/skills)
    skill_hubs = [
        ("pi", home / ".pi" / "agent" / "skills"),
        ("Claude", home / ".claude" / "skills"),
        ("Shared (.agents)", home / ".agents" / "skills"),
    ]
    for label, hub_dir in skill_hubs:
        hub_dir.mkdir(parents=True, exist_ok=True)
        linked_count = 0
        for agent_folder in sorted(agents_dir.iterdir()):
            if agent_folder.is_dir() and (agent_folder / "SKILL.md").exists():
                dest = hub_dir / agent_folder.name
                if dest.is_symlink():
                    dest.unlink()
                if not dest.exists():
                    dest.symlink_to(agent_folder)
                    linked_count += 1
        print(f"✅ Linked {linked_count} Software Factory skills ({label}) -> {hub_dir}")


def print_agent_instructions(section: str = "all") -> None:
    """Print machine-actionable integration guide for AI agents and automation scripts."""
    doc_path = FACTORY_ROOT / "docs" / "INTEGRATION.md"
    if not doc_path.exists():
        print("# Software Factory Integration\n\nSee https://github.com/PaulKinlan/agents/blob/main/docs/INTEGRATION.md")
        return

    content = doc_path.read_text(encoding="utf-8")
    if section == "all":
        print(content)
        return

    section_map = {
        "github-actions": ("## 1. CI/CD Plane: GitHub Actions", "## 2. Pre-Commit Plane"),
        "pre-commit": ("## 2. Pre-Commit Plane (Layer 1: Deterministic Gate)", "## 3. Target Enrolment Plane"),
        "target": ("## 3. Target Enrolment Plane (Local Fleet & Scheduler)", "## 4. Interactive Skills Plane"),
        "skills": ("## 4. Interactive Skills Plane (Local Agent Tools)", "## 5. Agent Fleet Reference & CI Compatibility"),
        "agents": ("## 5. Agent Fleet Reference & CI Compatibility", "## 6. Autonomous Agent Execution Checklist"),
    }
    if section in section_map:
        start_marker, end_marker = section_map[section]
        start_idx = content.find(start_marker)
        if start_idx != -1:
            end_idx = content.find(end_marker, start_idx)
            if end_idx != -1:
                print(content[start_idx:end_idx].strip())
            else:
                print(content[start_idx:].strip())
            return

    print(content)


def promote_public_issue(target_name: str, issue_url: str) -> None:
    """Explicit issue -> bead action; never called from a run or line publisher."""
    if (target_name in ("", ".", "..") or "/" in target_name or os.sep in target_name
            or not (FACTORY_ROOT / "targets" / f"{target_name}.yaml").is_file()):
        raise ValueError("promotion requires a configured named target, not a raw path")
    resolved_name, target_dir, cfg = resolve_target(target_name)
    if cfg.get("visibility") != "public" or not cfg.get("repo") or not cfg.get("beads_path"):
        raise ValueError("promotion requires explicit public visibility, repo and beads_path")
    beads_dir = Path(os.path.expanduser(str(cfg["beads_path"]))).resolve()
    if not beads_dir.is_dir() or not (beads_dir / ".beads").is_dir():
        raise ValueError("beads_path must name an initialized project Beads DB")
    cmd = [sys.executable, str(FACTORY_ROOT / "lib" / "findings.py"),
           "--target", resolved_name, "--target-dir", str(target_dir),
           "--repo", str(cfg["repo"]), "--visibility", "public",
           "--beads-dir", str(beads_dir), "--promote-issue", issue_url]
    # agents-7bj (P1-4): the promotion child resolves both gh and bd by name; apply the same
    # pinned, allowlisted PATH as the findings dispatch so it cannot pick up a trojaned binary
    # from PATH order. On a pin failure we leave the PATH intact and let the child fail closed.
    env = child_environment(sink="github-issues", trusted_tools=True)
    try:
        env["PATH"] = allowlisted_path(("gh", "bd"), env.get("PATH", ""))
    except ToolPinError as e:
        print(f"Warning: promotion PATH not constrained ({e}); findings.py will resolve "
              "gh/bd itself and fail closed")
    res = subprocess.run(cmd, cwd=str(FACTORY_ROOT), capture_output=True, text=True,
                         check=False, timeout=180, env=env)
    if res.returncode != 0:
        # The child may have created a bead before its GitHub backlink failed. Retrying
        # queries the repo-scoped external ref and repairs the link, never auto-creates two.
        raise RuntimeError(f"promotion refused (exit {res.returncode}); inspect state or retry "
                           "the same explicit command to repair a partial link")
    print(res.stdout.strip())


def build_parser(prog: Optional[str] = None) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=prog or "factory", description="The Software Factory (factory)")
    parser.add_argument("--agent", action="store_true", dest="agent_guide", help="Print machine-actionable instructions and recipes for AI agents to integrate the factory")
    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")

    # integrate
    integrate_parser = subparsers.add_parser("integrate", help="Print integration instructions and recipes for AI agents and CI/CD")
    integrate_parser.add_argument("--agent", action="store_true", dest="agent_mode", help="Format specifically for AI agents (machine-actionable markdown)")
    integrate_parser.add_argument("--section", choices=["all", "github-actions", "pre-commit", "target", "skills", "agents"], default="all", help="Specific integration section to output")

    # list
    subparsers.add_parser("list", help="List all available agents")

    # promote (separate human-approved operation, never part of a publication run)
    promote_parser = subparsers.add_parser("promote", help="Promote a human-approved public issue to one linked bead")
    promote_parser.add_argument("--target", required=True, help="Configured named public target")
    promote_parser.add_argument("--issue", required=True, help="Approved public issue URL in the configured repo")

    # run
    run_parser = subparsers.add_parser("run", help="Run an agent against a target")
    run_parser.add_argument("agent", help="Name of the agent to run (e.g. secret-scan)")
    run_parser.add_argument("--target", required=True, help="Target project name (from targets/) or path")
    run_parser.add_argument("--engine", default="auto", choices=["auto", "pi", "claude", "antigravity", "deepseek"], help="Engine to execute agent with")
    run_parser.add_argument("--model", default=None, help="Model for the pi engine (default deepseek/deepseek-flash)")
    run_parser.add_argument("--sink", help="Override sink (file, beads, command; comma-separated for several)")
    run_parser.add_argument("--budget-minutes", type=float, default=None,
                            help="Override station budget deadline in minutes")
    run_parser.add_argument("--visibility", choices=["public", "private"],
                            help="Explicit target visibility for a raw --target path (a named "
                                 "target's manifest wins); missing still withholds high/critical "
                                 "from a synced tracker")

    # line
    line_parser = subparsers.add_parser("line", help="Execute an ordered Factory Line composed of multiple stations")
    line_parser.add_argument("line", help="Name of the line to run (e.g. project-audit)")
    line_parser.add_argument("--target", required=True, help="Target project name (from targets/) or path")
    line_parser.add_argument("--engine", default="auto", choices=["auto", "pi", "claude", "antigravity", "deepseek"], help="Engine to execute agents with")
    line_parser.add_argument("--model", default=None, help="Model for the pi engine (default deepseek/deepseek-flash)")
    line_parser.add_argument("--sink", help="Override sink (file, beads, command; comma-separated for several)")
    line_parser.add_argument("--budget-minutes", type=float, default=None,
                             help="Override station budget deadline in minutes for all stations in the line")
    line_parser.add_argument("--visibility", choices=["public", "private"],
                             help="Explicit target visibility for a raw --target path (a named "
                                  "target's manifest wins); missing still withholds high/critical "
                                  "from a synced tracker")

    # hillclimb
    hc_parser = subparsers.add_parser("hillclimb", help="Run Class C goal-directed performance hill-climber with ledger")
    hc_parser.add_argument("--target", required=True, help="Target project name or path")
    hc_parser.add_argument("--metric", default="perf_hazard_score", help="Metric to optimize (perf_hazard_score, total_gzip_bytes, custom_bench_ms)")
    hc_parser.add_argument("--goal", type=float, help="Target numeric goal value")
    hc_parser.add_argument("--iterations", type=int, default=1, help="Number of hill-climb iterations")
    hc_parser.add_argument("--apply", action="store_true", help="Apply candidate edits in worktree, re-measure, keep wins, revert losses")
    hc_parser.add_argument("--engine", default="auto", choices=["auto", "pi", "claude", "antigravity", "deepseek"], help="Engine to execute agent with")
    hc_parser.add_argument("--sink", help="Override sink (file, beads, command; comma-separated for several)")
    hc_parser.add_argument("--visibility", choices=["public", "private"],
                           help="Explicit target visibility for a raw --target path (a named "
                                "target's manifest wins); missing still withholds high/critical "
                                "from a synced tracker")

    # hook
    hook_parser = subparsers.add_parser("hook", help="Manage deterministic git pre-commit hooks (Rule 8 compliant)")
    hook_subs = hook_parser.add_subparsers(dest="hook_command", help="Hook action")
    hook_inst = hook_subs.add_parser("install", help="Install sub-second secret-scan pre-commit hook")
    hook_inst.add_argument("--target", help="Target project name or path")
    hook_inst.add_argument("--all", action="store_true", help="Install across all configured targets in targets/")

    # skills
    skills_parser = subparsers.add_parser("skills", help="Manage interactive CLI skills symlinks")
    skills_subs = skills_parser.add_subparsers(dest="skills_command", help="Skills action")
    # agents-074: compute the station count from agents/*/agent.yaml so the help text cannot
    # drift from the real catalog (the count was previously a hardcoded literal). The count is
    # best-effort: if agents/ is absent the help must still render (count 0), not crash every
    # command at parser-build time.
    agents_dir = FACTORY_ROOT / "agents"
    try:
        station_count = sum(
            1 for _p in sorted(agents_dir.iterdir())
            if _p.is_dir() and (_p / "agent.yaml").exists()
        )
    except OSError:
        station_count = 0
    skills_subs.add_parser(
        "install",
        help=f"Symlink all {station_count} factory skills into ~/.gemini and ~/.claude",
    )

    # schedule
    sched_parser = subparsers.add_parser("schedule", help="Manage launchd (macOS) and systemd (Linux) scheduled runs")
    sched_parser.add_argument("--list", action="store_true", help="List all scheduled agents and status")
    sched_parser.add_argument("--generate", action="store_true", help="Generate schedule unit files into schedules/")
    sched_parser.add_argument("--install", action="store_true", help="Install and enable scheduled agent")
    sched_parser.add_argument("--uninstall", action="store_true", help="Disable and remove scheduled agent")
    sched_parser.add_argument("--trigger", action="store_true", help="Trigger immediate run of scheduled service")
    sched_parser.add_argument("--target", help="Target name")
    sched_parser.add_argument("--agent", help="Agent name")
    sched_parser.add_argument("--all", action="store_true", help="Operate on all explicitly scheduled target-agent pairs")
    sched_parser.add_argument("--platform", choices=["auto", "launchd", "systemd", "darwin", "linux", "all"], default="auto", help="Scheduler platform")

    sched_subs = sched_parser.add_subparsers(dest="sched_command", help="Schedule action")
    
    list_p = sched_subs.add_parser("list", help="List all scheduled agents and launchd/systemd status")
    list_p.add_argument("--platform", choices=["auto", "launchd", "systemd", "darwin", "linux"], default="auto")

    gen_p = sched_subs.add_parser("generate", help="Generate schedule units into schedules/")
    gen_p.add_argument("--target", help="Target name")
    gen_p.add_argument("--agent", help="Agent name")
    gen_p.add_argument("--platform", choices=["auto", "launchd", "systemd", "darwin", "linux", "all"], default="auto")

    inst_p = sched_subs.add_parser("install", help="Install and load scheduled agent")
    inst_p.add_argument("--target", help="Target name")
    inst_p.add_argument("--agent", help="Agent name")
    inst_p.add_argument("--all", action="store_true", help="Install all explicitly scheduled target-agent pairs")
    inst_p.add_argument("--platform", choices=["auto", "launchd", "systemd", "darwin", "linux"], default="auto")

    uninst_p = sched_subs.add_parser("uninstall", help="Unload/disable and remove scheduled agent")
    uninst_p.add_argument("--target", help="Target name")
    uninst_p.add_argument("--agent", help="Agent name")
    uninst_p.add_argument("--all", action="store_true", help="Uninstall all scheduled target-agent pairs")
    uninst_p.add_argument("--platform", choices=["auto", "launchd", "systemd", "darwin", "linux"], default="auto")

    trig_p = sched_subs.add_parser("trigger", help="Trigger immediate run of scheduled agent")
    trig_p.add_argument("--target", required=True, help="Target name")
    trig_p.add_argument("--agent", required=True, help="Agent name")
    trig_p.add_argument("--platform", choices=["auto", "launchd", "systemd", "darwin", "linux"], default="auto")

    return parser


def main():
    parser = build_parser()

    args = parser.parse_args()
    if getattr(args, "agent_guide", False):
        print_agent_instructions("all")
        sys.exit(0)

    if args.command == "integrate":
        print_agent_instructions(getattr(args, "section", "all"))
        sys.exit(0)
    elif args.command == "list":
        list_agents()
    elif args.command == "promote":
        promote_public_issue(args.target, args.issue)
    elif args.command == "run":
        run_agent(agent_name=args.agent, target_arg=args.target, engine_arg=args.engine,
                  explicit_sink=args.sink, model_arg=getattr(args, "model", None),
                  visibility_arg=args.visibility,
                  budget_minutes=getattr(args, "budget_minutes", None))
    elif args.command == "line":
        if not run_line(line_name=args.line, target_arg=args.target, engine_arg=args.engine,
                        explicit_sink=args.sink, model_arg=getattr(args, "model", None),
                        visibility_arg=args.visibility,
                        budget_minutes=getattr(args, "budget_minutes", None)):
            sys.exit(1)
    elif args.command == "hillclimb":
        if not run_hillclimb(
            target_arg=args.target,
            goal_metric=args.metric,
            goal_value=args.goal,
            iterations=args.iterations,
            apply_edits=args.apply,
            engine_arg=args.engine,
            explicit_sink=args.sink,
            visibility_arg=args.visibility
        ):
            sys.exit(1)
    elif args.command == "hook":
        install_pre_commit_hook(target_arg=getattr(args, "target", None), all_targets=getattr(args, "all", False))
    elif args.command == "skills":
        install_skills()
    elif args.command == "schedule":
        # Import scheduler functions
        from lib.scheduler import (
            list_schedules, generate_plist, generate_systemd_units,
            install_schedule, uninstall_schedule, trigger_schedule,
            get_scheduled_candidates, normalize_platform,
            load_yaml_simple as sched_load_yaml
        )
        action = getattr(args, "sched_command", None)
        if not action:
            if getattr(args, "install", False):
                action = "install"
            elif getattr(args, "uninstall", False):
                action = "uninstall"
            elif getattr(args, "generate", False):
                action = "generate"
            elif getattr(args, "trigger", False):
                action = "trigger"
            elif getattr(args, "list", False):
                action = "list"
            else:
                action = "list"

        plat = getattr(args, "platform", "auto")

        if action == "list":
            list_schedules(platform=plat)
        elif action == "generate":
            target_plat = normalize_platform(plat)
            candidates = get_scheduled_candidates(args.target, args.agent)
            for c in candidates:
                if target_plat == "all":
                    p1 = generate_plist(c["target"], c["agent"], c["cadence"])
                    p2, p3 = generate_systemd_units(c["target"], c["agent"], c["cadence"])
                    print(f"Generated (launchd): {p1}")
                    print(f"Generated (systemd): {p2}, {p3}")
                elif target_plat == "darwin":
                    p = generate_plist(c["target"], c["agent"], c["cadence"])
                    print(f"Generated (launchd): {p}")
                else:
                    s_path, t_path = generate_systemd_units(c["target"], c["agent"], c["cadence"])
                    print(f"Generated (systemd): {s_path}, {t_path}")
        elif action == "install":
            success = True
            if getattr(args, "all", False):
                for t_file in sorted((FACTORY_ROOT / "targets").glob("*.yaml")):
                    t_cfg = sched_load_yaml(t_file)
                    t_name = t_cfg.get("name", t_file.stem)
                    sched_map = t_cfg.get("schedule", {})
                    if isinstance(sched_map, dict):
                        for ag_name in sched_map.keys():
                            if not install_schedule(t_name, ag_name, platform=plat):
                                success = False
            elif args.target and args.agent:
                if not install_schedule(args.target, args.agent, platform=plat):
                    success = False
            else:
                print("Specify --target <name> --agent <name> or --all")
                success = False
            if not success:
                sys.exit(1)
        elif action == "uninstall":
            success = True
            if getattr(args, "all", False):
                for t_file in sorted((FACTORY_ROOT / "targets").glob("*.yaml")):
                    t_cfg = sched_load_yaml(t_file)
                    t_name = t_cfg.get("name", t_file.stem)
                    sched_map = t_cfg.get("schedule", {})
                    if isinstance(sched_map, dict):
                        for ag_name in sched_map.keys():
                            if not uninstall_schedule(t_name, ag_name, platform=plat):
                                success = False
            elif args.target and args.agent:
                if not uninstall_schedule(args.target, args.agent, platform=plat):
                    success = False
            else:
                print("Specify --target <name> --agent <name> or --all")
                success = False
            if not success:
                sys.exit(1)
        elif action == "trigger":
            if args.target and args.agent:
                if not trigger_schedule(args.target, args.agent, platform=plat):
                    sys.exit(1)
            else:
                print("Specify --target <name> --agent <name>")
                sys.exit(1)
    else:
        parser.print_help()

if __name__ == "__main__":
    try:
        main()
    except AdapterAuthError as e:
        sys.stderr.write(f"\n[environment failure] {e}\n")
        sys.exit(2)
    except (StationTimeout, StationError) as e:
        sys.stderr.write(f"\n[station failure] {e}\n")
        sys.exit(2)
    except ContainmentError as e:
        # Refused before any station work: nothing was scanned, so never a clean run.
        sys.stderr.write(f"\n[containment] Refusing the run: {e}\n")
        sys.exit(3)
    except ToolPinError as e:
        # A trusted tool (bwrap/gh/bd/git/…) could not be authenticated — refuse rather
        # than execute an unverified binary, and NAME the pin failure (agents-28nn).
        sys.stderr.write(f"\n[tool pin] Refusing the run: {e}\n")
        sys.exit(3)


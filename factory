class StationError(RuntimeError):
    """A station failed and produced no verdict — never a clean scan (fleet-ddd, journal-idy).

    Raised for a GENUINE failure: a failed pre-pass or a failed engine (the station could not
    run). A genuine failure halts the line (andon); `factory run` exits non-zero and the line
    records ERROR. Model output that merely cannot be parsed or violates the report schema is a
    PLUMBING failure (agents-noo) — that is NoVerdictError, which degrades the station and lets
    the line continue rather than halting every downstream station.
    """


class NoVerdictError(StationError):
    """A station ran (its engine exited zero) but its output was unparseable or schema-invalid
    (agents-noo). A PLUMBING failure, not a genuine one: run_line gives it ONE bounded
    repair-retry, then degrades the station to ERROR (no verdict) and CONTINUES the line as
    INCOMPLETE rather than halting and skipping every downstream station. Subclasses StationError
    so any existing `except StationError` still catches it; run_line matches the specific type to
    branch (degrade vs halt) instead of parsing the message string.
    """


class EnvironmentFailureError(StationError):
    """An engine adapter failed due to missing, invalid, or inaccessible credentials (agents-zrn).

    This is an ENVIRONMENT failure (e.g. no API key in the sandbox, unauthenticated
    session), distinct from a scanning error or absent verdict. It must never be rendered
    as PASS or a clean 0-findings run.
    """

    def __init__(self, agent: str, engine: str, returncode: int, reason: str,
                 output_file: Optional[Path] = None):
        self.agent = agent
        self.engine = engine
        self.returncode = returncode
        self.reason = reason
        self.output_file = output_file
        detail = f" (see {output_file})" if output_file else ""
        super().__init__(
            f"{agent}: engine '{engine}' adapter authentication failure: {reason}{detail}"
        )


AdapterAuthError = EnvironmentFailureError

KNOWN_AUTH_PROVIDERS = frozenset({
    "anthropic", "openai", "gemini", "antigravity", "google",
    "deepseek", "qwen", "zai", "kimi", "groq", "bedrock", "vertex",
})


def _format_no_key_reason(m: re.Match) -> str:
    provider = (m.group(1) or "").strip().rstrip(".").lower()
    if provider in KNOWN_AUTH_PROVIDERS:
        return f"No API key found for {provider}"
    return "No API key found for the selected model"


AUTH_ERROR_PATTERNS = (
    (re.compile(r"no api key found for the selected model", re.IGNORECASE),
     lambda m: "No API key found for the selected model"),
    (re.compile(r"no api key found for\s+([a-zA-Z0-9._/-]+)", re.IGNORECASE),
     _format_no_key_reason),
    (re.compile(r"no api key found", re.IGNORECASE),
     lambda m: "No API key found for the selected model"),
    (re.compile(r"use /login to log into a provider", re.IGNORECASE),
     lambda m: "Provider login required (use /login or set API key)"),
    (re.compile(r"no claude credentials", re.IGNORECASE),
     lambda m: "No Claude credentials configured"),
    (re.compile(r"claude code returned invalid authentication status", re.IGNORECASE),
     lambda m: "Invalid Claude authentication status"),
    (re.compile(r"claude code must be logged in", re.IGNORECASE),
     lambda m: "Claude Code must be logged in"),
    (re.compile(r"deepseek_api_key is not configured", re.IGNORECASE),
     lambda m: "DEEPSEEK_API_KEY is not configured"),
    (re.compile(r"authentication\s+(?:failure|failed|error)", re.IGNORECASE),
     lambda m: "Model provider authentication failed"),
    (re.compile(r"(?:invalid|missing)\s+(?:api[_-]?key|auth[_-]?token)", re.IGNORECASE),
     lambda m: "Invalid or missing API key"),
    (re.compile(r"\b401\s+unauthorized\b", re.IGNORECASE),
     lambda m: "Model API returned HTTP 401 Unauthorized"),
    (re.compile(r"(?:status(?:\s*code)?|http(?:\s*status|\s*error)?)\s*[:=]?\s*401\b", re.IGNORECASE),
     lambda m: "Model API returned HTTP 401 Unauthorized"),
)


def detect_adapter_auth_failure(raw_output: str, stderr: str, stdout: str = "") -> Optional[str]:
    """Check output and stderr for known engine authentication failure patterns.

    Returns a sanitized reason description, never raw diagnostic lines that might contain
    request headers or credentials (agents-zrn).
    """
    combined = f"{raw_output}\n{stderr}\n{stdout}"
    for line in combined.splitlines():
        line_clean = line.strip()
        if not line_clean:
            continue
        for pat, desc_fn in AUTH_ERROR_PATTERNS:
            m = pat.search(line_clean)
            if m:
                return desc_fn(m)
    return None

# Local git plumbing in the hill-climb path is fast when healthy; a wedged git (lock contention,
# a huge tree) must not hold the run. Fixed cap: these calls are not stations and have no agent
# budget in scope. Expiry is a non-zero (124) result, which the existing branches handle.
GIT_TIMEOUT_SECONDS = 120


def _run_git(args, cwd):
    """Run local git plumbing with a hard timeout; expiry is a non-zero (124) result.

    `args` EXCLUDE the binary name: the git executable is resolved and authenticated by
    lib.tool_pins.resolve_tool on EVERY call (agents-28nn round 2, review P1) — git is in
    TRUSTED_TOOLS, so a by-name invocation would run whichever git the operator's PATH
    orders first, unverified, and a trust list that some call sites ignore is a comment
    (the bwrap lesson generalised). A pin failure raises ToolPinError BEFORE any git
    executes; re-resolving per call (a few MB hashed) keeps a post-probe binary swap from
    being executed under a stale verification.
    """
    cmd = [resolve_tool("git"), *args]
    try:
        return subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True,
                              check=False, timeout=GIT_TIMEOUT_SECONDS, env=child_environment())
    except subprocess.TimeoutExpired as e:
        stdout = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode("utf-8", "replace")
        stderr = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode("utf-8", "replace")
        return subprocess.CompletedProcess(
            cmd, 124, stdout,
            f"{stderr}\n[factory] git command timed out after {GIT_TIMEOUT_SECONDS}s",
        )


def _create_session_worktree(target_dir: Path, worktree_dir: Path) -> Path:
    """Create the disposable detached git worktree of the target's HEAD (agents-6ce) and return
    the admin gitdir git assigned it. Raises StationError on failure: a granted write must never
    silently fall back to editing the target's own checkout, so if the writable workspace cannot
    be provided, the station fails rather than running the write policy against the operator's
    tree.

    The returned gitdir (<target>/.git/worktrees/<name>) is captured HERE, before the engine
    runs, so it is trusted. The worktree's own .git marker is a FILE under the writable run_dir,
    so a write-enabled model could repoint it at the target's real .git; host-side git
    (_collect_session_diff) pins --git-dir to this captured value and validates the marker
    against it, so a tampered marker can never redirect git at the operator's repo/index
    (review P1-1, agents-6ce round 2)."""
    import time
    worktree_dir.parent.mkdir(parents=True, exist_ok=True)

    # P3 resilience (agents-janc): retry on transient git lock contention or stale registrations
    max_attempts = 3
    res = None
    for attempt in range(1, max_attempts + 1):
        res = _run_git(["worktree", "add", "--detach", str(worktree_dir)], target_dir)
        if res.returncode == 0:
            break
        stderr = (res.stderr or "").strip()
        # If failure is due to a stale worktree registration, prune and retry immediately
        if "already registered worktree" in stderr or "use 'prune'" in stderr:
            _run_git(["worktree", "prune"], target_dir)
        elif "lock" in stderr.lower() and attempt < max_attempts:
            time.sleep(0.05 * (2 ** (attempt - 1)))
        else:
            break

    if res is None or res.returncode != 0:
        raise StationError(
            f"cannot create the disposable session worktree at {worktree_dir}: git worktree "
            f"add exited {getattr(res, 'returncode', 'unknown')}: {(getattr(res, 'stderr', '') or '').strip()}")
    gitdir = _run_git(["rev-parse", "--absolute-git-dir"], worktree_dir)
    if gitdir.returncode != 0 or not gitdir.stdout.strip():
        raise StationError(
            f"cannot resolve the session worktree's admin gitdir at {worktree_dir}: git "
            f"rev-parse exited {gitdir.returncode}: {(gitdir.stderr or '').strip()}")
    return Path(gitdir.stdout.strip())


def _validate_worktree_marker(worktree_dir: Path, expected_gitdir: Path) -> None:
    """Refuse host-side git unless the worktree's .git marker still points at the admin gitdir
    git assigned at creation. The marker is a file under the writable run_dir, so a
    write-enabled model could replace it with `gitdir: <target>/.git` and redirect an unpinned
    `git add -A` at the operator's real index (review P1-1, agents-6ce round 2). Pinning in
    _collect_session_diff already makes the redirect ineffective; this validation additionally
    fails the run loudly so the attempt is visible rather than silently ignored."""
    marker = worktree_dir / ".git"
    try:
        content = marker.read_text(encoding="utf-8").strip()
    except OSError as e:
        raise StationError(
            f"cannot read the session worktree's .git marker at {marker}: {e}") from e
    except UnicodeDecodeError as e:
        # agents-7ik: a non-UTF-8 marker (a binary blob written into .git's place) is a
        # ValueError, not an OSError — it must fail closed as a clean StationError, not
        # escape as an unhandled traceback.
        raise StationError(
            f"the session worktree's .git marker at {marker} is not UTF-8 text "
            f"({e}); refusing to run host-side git against it") from e
    if not content.startswith("gitdir:"):
        raise StationError(
            f"the session worktree's .git marker at {marker} is not a gitdir pointer (got "
            f"{content!r}); refusing to run host-side git against it")
    pointed = Path(content.split("gitdir:", 1)[1].strip())
    if not pointed.is_absolute():
        pointed = worktree_dir / pointed
    try:
        resolved = pointed.resolve()
    except OSError as e:
        raise StationError(
            f"cannot resolve the session worktree's .git marker target {pointed}: {e}") from e
    if resolved != expected_gitdir.resolve():
        raise StationError(
            f"the session worktree's .git marker at {marker} points at {resolved}, not the "
            f"admin gitdir git assigned at creation ({expected_gitdir.resolve()}); a "
            f"write-enabled model may have redirected it at the target's real repo — "
            f"refusing host-side git")


def _collect_session_diff(worktree_dir: Path, run_dir: Path, gitdir: Path) -> Optional[Path]:
    """Collect the engine's edits inside the worktree as run_dir/session.patch (agents-6ce):
    record every path with intent-to-add (so new/untracked files appear in the diff,
    respecting the target's .gitignore) and diff the worktree against its detached HEAD.
    Returns the patch path, or None when the engine changed nothing trackable. This patch IS
    the proposal — the target checkout was never touched.

    `gitdir` is the admin gitdir captured at worktree creation (trusted). The marker is
    validated against it and every git call is PINNED with --git-dir/--work-tree, so a model
    that repointed the worktree's .git marker (it lives in the writable run_dir) cannot
    redirect host-side git at the operator's real repo/index (review P1-1 round 2). Both calls
    also check the returncode (review P1-1 round 1): a staging failure — e.g. a stale
    index.lock, which makes staging exit 128 while `git diff` returns an empty rc0 diff —
    must RAISE, not be reported as "no edits" and silently drop the proposal.

    agents-7ik fidelity: (a) staging uses --intent-to-add, which records paths WITHOUT
    writing their content blobs into the target's shared .git/objects — a plain
    `git add -A` used to leave one unreferenced content blob per new/modified file in
    the operator's object store on every run (working tree and HEAD identical, nothing
    to GC-anchor them); intent-to-add's only footprint is the canonical empty blob
    (e69de29...), 14 bytes, once per repo lifetime, and the diff is taken against HEAD
    + worktree so new files still carry full content. (b) The patch carries a
    `base-commit:` header (the trailer git itself uses) so a proposal can never be
    applied blind against a moved HEAD; `git apply` skips it, verified."""
    _validate_worktree_marker(worktree_dir, gitdir)
    pinned = [f"--git-dir={gitdir}", f"--work-tree={worktree_dir}"]
    add = _run_git(pinned + ["add", "-A", "--intent-to-add"], worktree_dir)
    if add.returncode != 0:
        raise StationError(
            f"cannot stage the session worktree edits at {worktree_dir}: git add exited "
            f"{add.returncode}: {(add.stderr or '').strip()}")
    diff = _run_git(pinned + ["diff", "HEAD", "--binary"], worktree_dir)
    if diff.returncode != 0:
        raise StationError(
            f"cannot diff the session worktree edits at {worktree_dir}: git diff exited "
            f"{diff.returncode}: {(diff.stderr or '').strip()}")
    patch = diff.stdout or ""
    if not patch.strip():
        return None
    base = _run_git(pinned + ["rev-parse", "HEAD"], worktree_dir)
    if base.returncode != 0:
        # agents-5bn: a patch without a resolvable base is a proposal that can only ever be
        # applied blind. Fail closed like the add/diff checks above instead of emitting an
        # untagged patch whose base cannot be verified.
        raise StationError(
            f"cannot resolve the session worktree's HEAD at {worktree_dir}: git rev-parse "
            f"exited {base.returncode}: {(base.stderr or '').strip()}; refusing to collect a "
            "patch whose base cannot be verified")
    header = f"base-commit: {base.stdout.strip()}\n"
    patch_file = run_dir / "session.patch"
    # agents-nei P1-2: each kept win rewrites the SAME session.patch in place. If a later
    # write is interrupted (disk full / error), an in-place write_text could truncate the
    # previous good patch and leave an earlier durable KEPT row with no usable proposal. Write
    # to a sibling temp file and atomically replace only after a complete write, so a failed
    # write can never corrupt a previously collected patch.
    tmp_file = patch_file.with_name(patch_file.name + ".tmp")
    try:
        # agents-5bn: the run dir is rw-bound inside the sandbox, so a write-granted session
        # could plant a symlink at session.patch.tmp pointing at an arbitrary operator-writable
        # host file; host-side write_text would follow it and overwrite the target. The session
        # has already ended (no concurrent writer), so unlink the name first — the write then
        # creates a fresh regular file, never following a planted link.
        tmp_file.unlink(missing_ok=True)
        tmp_file.write_text(header + patch, encoding="utf-8")
        os.chmod(tmp_file, 0o600)
    except BaseException:
        # agents-nei P2-1 (round 5): if the write or chmod fails, the sibling temp file must
        # not leak. session.patch is untouched (os.replace has not run yet), so just remove
        # the partial temp and re-raise the original error.
        try:
            tmp_file.unlink(missing_ok=True)
        except OSError:
            pass
        raise
    os.replace(tmp_file, patch_file)
    # agents-5bn: the patch IS the proposal, so its base-commit trailer must name the
    # worktree's detached HEAD — the only base it may ever be applied against. Assert it back
    # (fail closed) so a collected patch can never be consumed under a base it does not match.
    if _patch_base_commit(patch_file) != base.stdout.strip():
        raise StationError(
            f"collected session.patch at {patch_file} does not carry the worktree HEAD "
            f"{base.stdout.strip()} as its base-commit; refusing to present a proposal whose "
            "base cannot be verified")
    return patch_file


def _patch_base_commit(patch_file: Path) -> Optional[str]:
    """The base-commit trailer a collected session.patch must carry, or None when absent."""
    try:
        with patch_file.open("r", encoding="utf-8") as fh:
            first = fh.readline().rstrip("\n")
    except OSError:
        return None
    prefix = "base-commit: "
    return first[len(prefix):].strip() if first.startswith(prefix) else None


def _verify_candidates_integrity(candidates_file: Path, snapshot: bytes) -> None:
    """Fail closed if the write-granted engine session changed candidates.json (agents-5bn).

    candidates.json is the deterministic scanner's ground truth (agents-nha) that binds the
    triage model's rule_id/path at findings dispatch — which runs AFTER the engine session. The
    run directory is rw-bound inside the OS sandbox, so a prompt-injected write-granted session
    (its worktree lives at run_dir/worktree, under that same rw run dir) can overwrite
    candidates.json and forge the binding: a forged rule_id/path set would let it re-book real
    vulnerabilities or mint phantom ones in the findings store and the public sink, defeating the
    noise-control fingerprint. Snapshot the trusted bytes before the session and refuse the
    dispatch on any change (the mirror of the policy.json restore control).
    """
    try:
        current = candidates_file.read_bytes()
    except OSError as e:
        raise StationError(
            f"candidates.json is unreadable after the engine session ({e}); a write-granted "
            "session may have deleted or replaced the scanner ground truth — refusing to "
            "dispatch findings against unverified candidates") from e
    if current != snapshot:
        raise StationError(
            "candidates.json changed during the engine session; a write-granted session may "
            "have tampered with the scanner ground truth that binds findings identity — "
            "refusing to dispatch findings against unverified candidates")


def _write_run_artifact(path: Path, data: str) -> None:
    """Write a run-dir artifact without following a symlink a session may have planted.

    The run directory is rw-bound inside the OS sandbox, so a write-granted session (or a
    prompt-injected one) can plant a symlink at any run-dir path while it runs; a later
    host-side write_text would follow that symlink and overwrite an arbitrary operator-writable
    host file (agents-5bn P0 — the session.patch.tmp unlink fixed only that one path). Unlink the
    name first — the session has already ended, so there is no concurrent writer, and unlink
    removes the link itself, never the target — so the write creates a fresh regular file. A path
    the session replaced with a directory fails closed (unlink raises) rather than writing
    through it. Every run-dir artifact is a direct child of the run directory, whose mount point
    a session cannot replace, so there is no symlinked parent directory to resolve.
    """
    try:
        path.unlink(missing_ok=True)
    except OSError as e:
        raise StationError(
            f"cannot clear {path} before writing the run artifact (a session may have planted "
            f"a symlink or directory there): {e}") from e
    path.write_text(data, encoding="utf-8")


def _worktree_has_ignored_edits(worktree_dir: Path, gitdir: Path) -> bool:
    """agents-7ik: did the session write anything gitignored? `git add -A` respects the
    target's .gitignore, so edits that land ONLY in ignored paths produce an empty diff
    ("no file edits") while files DID change. Used for the honest message — the ignored
    files themselves are still not proposal content."""
    pinned = [f"--git-dir={gitdir}", f"--work-tree={worktree_dir}"]
    status = _run_git(pinned + ["status", "--porcelain", "--ignored=matching",
                                "--untracked-files=all"], worktree_dir)
    if status.returncode != 0:
        return False  # a status failure must not invent a claim either way
    return any(line.startswith("!!") for line in status.stdout.splitlines())


def _remove_session_worktree(target_dir: Path, worktree_dir: Path) -> None:
    """Discard the disposable worktree (agents-6ce). Best-effort and idempotent: prune any
    bookkeeping a crashed run left under the target's .git/worktrees. Cleanup never raises, so
    it cannot mask the run's real outcome — but a failure IS reported (review P1-1 round 2):
    a leaked worktree under the operator's .git is a real mess to leave silent. Git runs from
    target_dir, so it uses the target's own .git, never the worktree's (possibly model-tampered)
    .git marker; if the git remove still fails, the directory is deleted directly (it is under
    the run dir) and pruned, so no leak survives."""
    try:
        res = _run_git(["worktree", "remove", "--force", str(worktree_dir)], target_dir)
        if res.returncode != 0:
            sys.stderr.write(
                f"[factory] worktree cleanup 'remove' exited {res.returncode}: "
                f"{(res.stderr or '').strip()}\n")
    except Exception as e:  # noqa: BLE001 - cleanup is best-effort, never masks the verdict
        sys.stderr.write(f"[factory] worktree cleanup 'remove' raised: {e}\n")
    if worktree_dir.exists():
        # The git remove did not take (e.g. a tampered marker confused it). The directory is
        # under the run dir, so removing it directly is safe; prune then clears the admin entry.
        shutil.rmtree(worktree_dir, ignore_errors=True)
    try:
        prune = _run_git(["worktree", "prune"], target_dir)
        if prune.returncode != 0:
            sys.stderr.write(
                f"[factory] worktree cleanup 'prune' exited {prune.returncode}: "
                f"{(prune.stderr or '').strip()}\n")
    except Exception as e:  # noqa: BLE001
        sys.stderr.write(f"[factory] worktree cleanup 'prune' raised: {e}\n")


def _apply_workspace_mismatch(target_dir: Path) -> Optional[str]:
    """agents-nei P1-2: --apply must refuse a checkout whose measured asset set differs from
    the HEAD worktree it will optimize. Two cases: (a) tracked/staged/untracked changes, and
    (b) ignored files that measure_target would still measure — an ignored assets/slow.html is
    in the operator's checkout but not the HEAD worktree, so a checkout-measured baseline would
    disagree with the worktree and could mint a phantom KEPT win. `git status --porcelain`
    misses ignored files; `git ls-files --others --ignored --exclude-standard` lists them
    individually (unlike `--ignored=matching`, which collapses ignored directories)."""
    from lib.bench.runner import ASSET_EXTS, IGNORE_DIRS

    status = _run_git(["status", "--porcelain", "--untracked-files=all"], target_dir)
    if status.returncode != 0:
        return "could not read the target's git status (fail closed rather than assume a clean tree)"
    if status.stdout.strip():
        return ("the target checkout has uncommitted changes (dirty worktree); --apply "
                "measures the baseline on that checkout but the disposable worktree starts "
                "at HEAD, so a dirty tree would disagree with the worktree and could mint a "
                "phantom KEPT win — commit or stash the changes first")

    # -z emits NUL-delimited raw paths: `git ls-files` quotes a path containing a newline
    # ("assets/slow\n.html"), which would otherwise be parsed with a trailing quote and a
    # mismatched suffix — an ignored measured asset would slip past the refusal below.
    ignored = _run_git(["ls-files", "-z", "--others", "--ignored", "--exclude-standard"],
                       target_dir)
    if ignored.returncode != 0:
        return "could not enumerate the target's ignored files (fail closed rather than assume a clean tree)"
    for rel in ignored.stdout.split("\0"):
        if not rel:
            continue
        path = Path(rel)
        if any(part in IGNORE_DIRS for part in path.parts):
            continue
        if path.suffix.lower() in ASSET_EXTS:
            return (f"the checkout has an ignored measured asset ({rel}) that is absent from "
                    f"the HEAD worktree; measuring the baseline on the checkout would disagree "
                    f"with the worktree and could mint a phantom KEPT win — commit or remove "
                    f"the ignored asset first")
    return None


def _parse_scalar(val: str) -> Any:
    if val.lower() == "true":
        return True
    if val.lower() == "false":
        return False
    if val.isdigit():
        return int(val)
    try:
        if "." in val and all(p.isdigit() for p in val.split(".", 1)):
            return float(val)
    except Exception:
        pass
    return val.strip("'\"")


def load_yaml_simple(path: Path) -> Dict[str, Any]:
    """Indentation-aware YAML parser for simple key-value, list, and nested map manifests."""
    result: Dict[str, Any] = {}
    stack: list = [(-1, result)]

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0]
        line_clean = line.strip()
        if not line_clean:
            continue

        indent = len(line) - len(line.lstrip(" "))
        while len(stack) > 1 and indent <= stack[-1][0]:
            stack.pop()

        parent = stack[-1][1]

        # List item
        if line_clean.startswith("- "):
            val = line_clean[2:].strip()
            if isinstance(parent, dict) and len(parent) == 0 and len(stack) >= 2:
                outer_dict = stack[-2][1]
                if isinstance(outer_dict, dict):
                    for k in reversed(list(outer_dict.keys())):
                        if outer_dict[k] is parent:
                            new_list = [_parse_scalar(val)]
                            outer_dict[k] = new_list
                            stack[-1] = (stack[-1][0], new_list)
                            break
            elif isinstance(parent, list):
                parent.append(_parse_scalar(val))
            continue

        if ":" in line_clean:
            key, val = [p.strip() for p in line_clean.split(":", 1)]
            if not isinstance(parent, dict):
                continue

            if not val:
                new_map: Dict[str, Any] = {}
                parent[key] = new_map
                stack.append((indent, new_map))
            elif val.startswith("[") and val.endswith("]"):
                items = [_parse_scalar(x.strip()) for x in val[1:-1].split(",") if x.strip()]
                parent[key] = items
            elif val.startswith("{") and val.endswith("}"):
                inner_map: Dict[str, Any] = {}
                for pair in val[1:-1].split(","):
                    if ":" in pair:
                        ik, iv = [x.strip() for x in pair.split(":", 1)]
                        inner_map[ik] = _parse_scalar(iv)
                parent[key] = inner_map
            else:
                parent[key] = _parse_scalar(val)
    return result


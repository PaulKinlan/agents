{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VulnTriageReport",
  "type": "object",
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "total_input_findings": { "type": "integer" },
    "deduplicated_count": { "type": "integer" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "path", "severity", "title", "description"],
        "properties": {
          "rule_id": { "type": "string" },
          "path": { "type": "string" },
          "line_number": { "type": ["integer", "null"] },
          "snippet": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "reachability": { "type": "string", "enum": ["reachable", "conditional", "unreachable"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "remediation": { "type": "string" },
          "affected_locations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}

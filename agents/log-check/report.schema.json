{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LogCheckReport",
  "type": "object",
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "scanned_log_files": { "type": "integer" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "path", "severity", "title", "description"],
        "properties": {
          "rule_id": { "type": "string" },
          "path": { "type": "string" },
          "line_number": { "type": ["integer", "null"] },
          "snippet": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerfReviewReport",
  "type": "object",
  "required": ["summary", "target", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "target": { "type": "string" },
    "reviewed_commits": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "path", "snippet", "severity", "title", "description", "remediation"],
        "properties": {
          "rule_id": { "type": "string" },
          "path": { "type": "string" },
          "line_number": { "type": "integer" },
          "touched_in_recent_commits": { "type": "boolean" },
          "snippet": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "remediation": { "type": "string" },
          "proposed_fix_diff": { "type": "string" }
        }
      }
    }
  }
}

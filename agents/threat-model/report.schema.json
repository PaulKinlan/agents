{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThreatModelReport",
  "type": "object",
  "required": [
    "summary",
    "target",
    "threat_model_markdown",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Executive summary of the repository threat model and attack surface analysis"
    },
    "target": {
      "type": "string",
      "description": "Target repository identifier"
    },
    "threat_model_markdown": {
      "type": "string",
      "description": "Full GitHub Flavored Markdown document for THREAT_MODEL.md"
    },
    "findings": {
      "type": "array",
      "description": "Specific threat modeling observations or gaps in defenses",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "title", "description"],
        "properties": {
          "rule_id": { "type": "string" },
          "path": { "type": "string" },
          "line_number": { "type": "integer" },
          "snippet": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}

diff --git a/bin/fleet-park b/bin/fleet-park
index 03c110d..3bde903 100755
--- a/bin/fleet-park
+++ b/bin/fleet-park
@@ -2,7 +2,9 @@
 # fleet-park <branch> "<reason>" [bead]   record a deliberate decision NOT to land a branch (yet)
 # fleet-park --unpark <branch>            make it a landing candidate again
 # Parked branches leave the merge queue (and the watchdog's nudges/escalations) and show as "parked"
-# with the reason on the dashboard. Labelling the owning bead merge-blocked or parked has the same effect.
+# with the reason on the dashboard. The readable parked state is the bead label (parked, merge-blocked,
+# or hub-delivery); fleet-park records the branch-level decision in ~/.fleet/parked and, when a bead is
+# given, labels the bead `parked` so the dashboard and watchdog see it immediately.
 set -euo pipefail
 orig_port="${FLEET_INBOX_PORT:-}"
 FLEET_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
@@ -10,12 +12,40 @@ FLEET_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 [ -f "$HOME/.fleet/local.conf" ] && source "$HOME/.fleet/local.conf"
 port="${orig_port:-${FLEET_INBOX_PORT:-7777}}"
 
+resolve_bead_dir() {
+  local target_bead="$1"
+  local dbs_file="${HOME}/.fleet/beads-dbs"
+  if [ -f "$dbs_file" ]; then
+    while read -r name dpath; do
+      [ -z "$name" ] || [[ "$name" =~ ^# ]] && continue
+      dpath="${dpath/#\~/$HOME}"
+      if [ -d "$dpath/.beads" ] && command -v bd >/dev/null 2>&1; then
+        if (cd "$dpath" && bd show "$target_bead" >/dev/null 2>&1); then
+          echo "$dpath"
+          return 0
+        fi
+      fi
+    done < "$dbs_file"
+  fi
+  if [ -d ".beads" ] && command -v bd >/dev/null 2>&1; then
+    if bd show "$target_bead" >/dev/null 2>&1; then
+      echo "$PWD"
+      return 0
+    fi
+  fi
+  return 1
+}
+
+prev_bead=""
 if [ "${1:-}" = --unpark ]; then
   branch="${2:-}"
   if [ -z "$branch" ]; then
     echo "fleet-park: error: branch required for --unpark" >&2
     exit 1
   fi
+  if [ -f "$HOME/.fleet/parked" ]; then
+    prev_bead=$(jq -r --arg b "$branch" '.[$b].bead // empty' "$HOME/.fleet/parked" 2>/dev/null || true)
+  fi
   body=$(jq -nc --arg b "$branch" --arg l "${FLEET_LANE:-cli}" '{branch:$b,unpark:true,lane:$l}')
 else
   branch="${1:-}"
@@ -40,4 +70,23 @@ if [ "$code" != "200" ]; then
   exit 1
 fi
 
+# Maintain readable bead state for dashboard and watchdog.
+if [ "${1:-}" = --unpark ]; then
+  if [ -n "${prev_bead:-}" ]; then
+    if bdir=$(resolve_bead_dir "$prev_bead"); then
+      (cd "$bdir" && bd update "$prev_bead" --remove-label parked >/dev/null 2>&1) || \
+        echo "fleet-park: warning: could not remove 'parked' label from bead $prev_bead" >&2
+    fi
+  fi
+else
+  if [ -n "${bead:-}" ]; then
+    if bdir=$(resolve_bead_dir "$bead"); then
+      (cd "$bdir" && bd update "$bead" --add-label parked >/dev/null 2>&1) || \
+        echo "fleet-park: warning: could not label bead $bead as 'parked'" >&2
+    else
+      echo "fleet-park: warning: bead $bead database not resolved in ~/.fleet/beads-dbs; bead label not updated" >&2
+    fi
+  fi
+fi
+
 echo "$body_out"

--- a/tests/fleet-check-tree-stability.test.sh
+++ b/tests/fleet-check-tree-stability.test.sh
@@ -40,4 +40,9 @@
 export FLEET_HEAVY_SLOTS=2          # private slots: never contend with (or queue behind) a real gate
-export FLEET_LANE="arx8-test"       # a fixture's notification must not reach a real lane
+# fleet-check requires a lane, and finish() falls back to it for notification recipients.
+# Never inherit the invoking lane; a synthetic name alone does NOT isolate the network POST.
+unset FLEET_LANE
+export FLEET_LANE=arx8-test
+# Defence in depth if a future runner bypasses the curl stand-in: never target the live inbox.
+export FLEET_INBOX_PORT=9
-
+
 # fleet-c050: A curl STAND-IN THAT CAN HOLD THE NOTIFICATION POST OPEN, so the ORDER in which bin/fleet-check
@@ -49,17 +54,18 @@
 # is why the arm it broke failed variably and passed when run alone: a fixed sleep in a test is a coin flip on
-# a busy machine. With FLEET_CHECK_TEST_HOLD set the POST blocks until this fixture releases it, so the window
-# is open for exactly as long as the assertion needs and no longer. Unset, the stub forwards to the real curl,
-# so every other arm behaves exactly as before.
+# a busy machine. With FLEET_CHECK_TEST_HOLD set the synthetic POST blocks until this fixture releases it,
+# so the window is open for exactly as long as the assertion needs and no longer. The stub ALWAYS consumes
+# the POST: forwarding a non-held request to /usr/bin/curl reached the live inbox (agents-97kx). This test
+# asserts record order, not remote inbox delivery.
 mkdir -p "$ROOT/bin"
 cat > "$ROOT/bin/curl" <<'STUB'
 #!/usr/bin/env bash
 if [ -n "${FLEET_CHECK_TEST_HOLD:-}" ]; then
   i=0
   # Bounded (20s, 0.1s steps) so a fixture that dies cannot wedge a detached worker forever.
   while [ ! -f "$FLEET_CHECK_TEST_HOLD" ] && [ "$i" -lt 200 ]; do sleep 0.1; i=$((i+1)); done
   exit 0
 fi
-[ -x /usr/bin/curl ] && exec /usr/bin/curl "$@"
+# No network I/O: even a caller-provided inbox port must never receive a test's verdict.
 exit 0
 STUB
 chmod +x "$ROOT/bin/curl"

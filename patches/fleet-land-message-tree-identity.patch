From fe1be89a03aa298c3a6c133b41df31b6092943ca Mon Sep 17 00:00:00 2001
From: agents-factory-hubpatch <agents-factory-hubpatch@exe.xyz>
Date: Mon, 12 Oct 2026 11:51:08 +0000
Subject: [PATCH] fix(fleet-land-message): validate tree identity on no-op
 rebase, emit accepted identity, and verify failure path

---
 bin/fleet-land-message           |  53 ++++++++++++--
 tests/fleet-land-message.test.sh | 115 +++++++++++++++++++++++++++++++
 2 files changed, 162 insertions(+), 6 deletions(-)

diff --git a/bin/fleet-land-message b/bin/fleet-land-message
index c8f86be..e1f535a 100755
--- a/bin/fleet-land-message
+++ b/bin/fleet-land-message
@@ -754,9 +754,38 @@ fi
 
 # ---------- gate ----------
 # Only ever reads the cache: a landing message must not cost a 25-45 minute gate run.
-gatestate=NONE; gatesha=""; gatetree=""; gateran=""; gatetook=""; gatelog=""; gatemore=""
+gatestate=NONE; gatesha=""; gatetree=""; gateran=""; gatetook=""; gatelog=""; gatemore=""; gate_identity=""
+
+commit_has_tree() {
+  local target_commit="$1" wanted_tree="$2" c p2
+  [ -n "$wanted_tree" ] || return 1
+  # Check parent 2 first (merged branch tip in a merge commit)
+  p2=$(git rev-parse --verify -q "${target_commit}^2" 2>/dev/null || echo "")
+  if [ -n "$p2" ] && [ "$(git rev-parse --verify -q "${p2}^{tree}" 2>/dev/null)" = "$wanted_tree" ]; then
+    echo "$p2"
+    return 0
+  fi
+  # Check commits merged into target_commit from the branch (starting from p2, not the merge commit itself)
+  if git rev-parse --verify -q "${target_commit}^1" >/dev/null 2>&1 && [ -n "$p2" ]; then
+    for c in $(git rev-list "$p2" --not "${target_commit}^1" 2>/dev/null); do
+      if [ "$(git rev-parse --verify -q "${c}^{tree}" 2>/dev/null)" = "$wanted_tree" ]; then
+        echo "$c"
+        return 0
+      fi
+    done
+  fi
+  # Fallback for non-merge commits (fast-forward where target_commit is the landed branch tip):
+  # Must only inspect target_commit itself, never historical ancestors on main (fleet-19jh review P1).
+  if ! git rev-parse --verify -q "${target_commit}^2" >/dev/null 2>&1; then
+    if [ "$(git rev-parse --verify -q "${target_commit}^{tree}" 2>/dev/null)" = "$wanted_tree" ]; then
+      echo "$target_commit"
+      return 0
+    fi
+  fi
+  return 1
+}
 
-# Target commit & tree being landed (fleet-agl1, fleet-qscw, fleet-4leo):
+# Target commit & tree being landed (fleet-agl1, fleet-qscw, fleet-4leo, fleet-hubpatch/agents-19jh):
 # If --gate <sha> is given, key off that commit sha and its tree.
 # Otherwise, determine the tree actually being landed:
 # - If HEAD has merged the branch (ancestor check), the landing target is HEAD.
@@ -773,9 +802,16 @@ if [ -n "$GATE_SHA" ]; then
     echo "fleet-land-message: REFUSING: cannot resolve branch $BRANCH in $repo" >&2
     exit 1
   fi
-  # Verify that the commit actually contains the branch being landed.
-  # Never allow a gate for pre-merge main or an unrelated commit to be quoted (fleet-qscw, fleet-4leo).
-  if ! git merge-base --is-ancestor "$target_ref" "$gate_commit" 2>/dev/null; then
+  # Verify that the commit actually contains the branch being landed (fleet-qscw, fleet-4leo, fleet-hubpatch/agents-19jh).
+  # Direct ref ancestry is accepted; if the branch was rebased without changing the tree (no-op rebase),
+  # verify that the merged commit contains an ancestor whose tree matches the branch tip tree.
+  target_ref_tree=$(git rev-parse --verify -q "${target_ref}^{tree}" 2>/dev/null || echo "")
+  matched_c=""
+  if git merge-base --is-ancestor "$target_ref" "$gate_commit" 2>/dev/null; then
+    gate_identity="commit ref $target_ref (ancestor of $gate_commit)"
+  elif [ -n "$target_ref_tree" ] && matched_c=$(commit_has_tree "$gate_commit" "$target_ref_tree"); then
+    gate_identity="tree identity: $target_ref_tree (rebased: tree unchanged, matches merged commit ${matched_c:0:7})"
+  else
     echo "fleet-land-message: REFUSING: --gate $GATE_SHA does not contain $BRANCH ($target_ref)" >&2
     exit 1
   fi
@@ -793,11 +829,13 @@ if [ -n "$GATE_SHA" ]; then
     echo "fleet-land-message: REFUSING: --gate $GATE_SHA tree ($target_tree) does not match landing HEAD tree ($head_tree)" >&2
     exit 1
   fi
+  gate_identity="$gate_identity; tree $target_tree matches landing HEAD tree $head_tree"
   gatesha=$(git rev-parse --short "$gate_commit" 2>/dev/null || echo "$GATE_SHA")
 elif [ -n "$target_ref" ] && git merge-base --is-ancestor "$target_ref" HEAD 2>/dev/null; then
   # HEAD has merged the branch: the tree being landed is HEAD's tree
   gatesha=$(git rev-parse --short HEAD 2>/dev/null || echo "")
   target_tree=$(git rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null || echo "")
+  gate_identity="commit ref $target_ref (ancestor of HEAD; tree $target_tree)"
 else
   # The branch is not merged into HEAD yet (pre-merge message creation or outside merge worktree).
   # The merged tree does not exist yet: never quote a branch-tip verdict as the merged-tree verdict (fleet-agl1).
@@ -896,6 +934,7 @@ if [ "$JSON" = 1 ]; then
     --arg rev_author_model "${rev_author_model:-}" --arg branch_author "${src_who:-}" \
     --arg newer_not_used "${flm_newer_passed:-}" --arg disagreement "${rev_disagree:-}" --arg rev_named_branch "${rev_branch:-}" \
     --argjson rev_author_ignored "${rev_author_ignored:-0}" --arg rev_author_ignored_shas "${rev_author_ignored_shas:-}" \
+    --arg gate_identity "${gate_identity:-}" \
     '{subject:$subject,bead:$bead,title:$title,what:$what,why:$why,effect:$effect,
       summary:{comment_index:($src_idx|if .=="" then null else tonumber end),author:$src_who,at:$src_at,
                rejected_blocks:$rejected,mentions_without_a_block:$mentions},
@@ -906,7 +945,7 @@ if [ "$JSON" = 1 ]; then
               reviewer_model:$rev_reviewer_model,author_model:$rev_author_model,
               author_lane_verdicts_ignored:$rev_author_ignored,author_lane_verdict_shas:$rev_author_ignored_shas,
               newer_not_used:$newer_not_used,disagreement:$disagreement,named_branch:$rev_named_branch},
-      gate:{state:$gate_state,sha:$gate_sha,tree:$gate_tree,lane:$gate_lane,secs:$gate_secs,at:$gate_at,log:$gate_log},
+      gate:{state:$gate_state,sha:$gate_sha,tree:$gate_tree,lane:$gate_lane,secs:$gate_secs,at:$gate_at,log:$gate_log,identity:$gate_identity},
       prompt_budget:$prompt_budget,
       delta:$delta,commits:$commits,release_notes:$relnotes,spun_out:$spun}'
   exit 0
@@ -942,9 +981,11 @@ if [ "$gatestate" != NONE ]; then
   printf 'GATE\n%s for tree %s (cached for commit %s)%s%s%s\n' "$gatestate" "${gatetree:-?}" "${gatesha:-?}" \
     "${gatetook:+ in ${gatetook}s}" "${gateran:+ run by $gateran}" "${gatemore:+ at $gatemore}"
   [ -n "$gatelog" ] && printf 'Log %s\n' "$gatelog"
+  [ -n "$gate_identity" ] && printf 'Identity %s\n' "$gate_identity"
 elif [ -n "$target_tree" ]; then
   printf 'GATE\nno cached verdict for tree %s (commit %s) yet: NOT a pass. The batch gate result goes in this\nsection with\n' "${target_tree:0:12}" "${gatesha:-this commit}"
   printf '  git commit --amend -F <(fleet-land-message --gate <merged-sha> %s %s)\n' "$BEAD" "$BRANCH"
+  [ -n "$gate_identity" ] && printf 'Identity %s\n' "$gate_identity"
 else
   printf 'GATE\nno cached verdict yet (merge tree pending: NOT a pass). The batch gate result goes in this\nsection with\n'
   printf '  git commit --amend -F <(fleet-land-message --gate <merged-sha> %s %s)\n' "$BEAD" "$BRANCH"
diff --git a/tests/fleet-land-message.test.sh b/tests/fleet-land-message.test.sh
index 07038db..daaecb3 100755
--- a/tests/fleet-land-message.test.sh
+++ b/tests/fleet-land-message.test.sh
@@ -289,6 +289,121 @@ out_stale=$(run --allow-stale tk-1 fleet/b2)
 hasnt "$out_stale" "PASS (full gate)" "10g stale local branch does not select HEAD's PASS for unmerged remote"
 has   "$out_stale" "merge tree pending" "10h stale local branch correctly identifies merge tree pending"
 
+# 10w-10z: tree identity on no-op rebase, identity reporting, and deliberate failure control (agents-19jh, agents-yk6m)
+# Setup: a branch fleet/rebased that has been merged into HEAD (m_rebase) with gate cached
+git -C "$ROOT/repo" checkout -q -b fleet/rebased main
+echo "content for rebase" > "$ROOT/repo/rebase.txt"
+git -C "$ROOT/repo" add rebase.txt
+git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "feat: rebase test"
+rebase_c1=$(git -C "$ROOT/repo" rev-parse HEAD)
+rebase_t1=$(git -C "$ROOT/repo" rev-parse 'HEAD^{tree}')
+git -C "$ROOT/repo" checkout -q main
+echo "main addition before merge" > "$ROOT/repo/main_diverge.txt"
+git -C "$ROOT/repo" add main_diverge.txt
+git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "feat: main diverge"
+git -C "$ROOT/repo" merge -q --no-ff fleet/rebased -m "Merge fleet/rebased"
+rebase_merge_sha=$(git -C "$ROOT/repo" rev-parse --short HEAD)
+rebase_merge_tree=$(git -C "$ROOT/repo" rev-parse 'HEAD^{tree}')
+
+# Gate fixture for this merged tree
+jq --arg t "$rebase_merge_tree" --arg s "$rebase_merge_sha" '.tree=$t | .sha=$s' "$ROOT/fix/gate.json" > "$ROOT/fix/gate.tmp" && mv "$ROOT/fix/gate.tmp" "$ROOT/fix/gate.json"
+
+# Now author does a no-op rebase on fleet/rebased (commit amended without changing tree)
+git -C "$ROOT/repo" checkout -q fleet/rebased
+git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit --amend --no-edit -m "feat: rebase test amended"
+rebase_c2=$(git -C "$ROOT/repo" rev-parse HEAD)
+rebase_t2=$(git -C "$ROOT/repo" rev-parse 'HEAD^{tree}')
+git -C "$ROOT/repo" checkout -q main
+
+# Verify test setup: ref moved, tree unchanged
+[ "$rebase_c1" != "$rebase_c2" ] && ok "10w1 branch ref moved after amend" || bad "10w1 branch ref did not move"
+[ "$rebase_t1" = "$rebase_t2" ] && ok "10w2 branch tree unchanged after amend" || bad "10w2 branch tree changed"
+! git -C "$ROOT/repo" merge-base --is-ancestor "$rebase_c2" "$rebase_merge_sha" 2>/dev/null && ok "10w3 new branch ref is not an ancestor of merge commit" || bad "10w3 new branch ref should not be ancestor"
+
+# 10w4-10w6: --gate invocation with no-op rebase succeeds and accepts tree identity
+rc_noop_gate=0
+out_noop_gate=$(run --allow-stale --gate "$rebase_merge_sha" tk-1 fleet/rebased) || rc_noop_gate=$?
+[ "$rc_noop_gate" = 0 ] && ok "10w4 no-op rebase --gate succeeds (rc 0)" || bad "10w4 no-op rebase expected rc 0" "rc=$rc_noop_gate out=$out_noop_gate"
+has "$out_noop_gate" "PASS (full gate)" "10w5 no-op rebase carries PASS"
+has "$out_noop_gate" "Identity tree identity: $rebase_t2 (rebased: tree unchanged" "10w6 message prints tree identity was accepted"
+
+# 10x: JSON output carries gate.identity
+j_noop=$(run --allow-stale --print-json --gate "$rebase_merge_sha" tk-1 fleet/rebased)
+has "$(jq -r '.gate.identity // ""' <<<"$j_noop")" "tree identity" "10x JSON carries tree identity"
+
+# 10y: Genuine tree mismatch (author modified files after merge)
+git -C "$ROOT/repo" checkout -q fleet/rebased
+echo "unmerged addition" >> "$ROOT/repo/rebase.txt"
+git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -am "feat: unmerged addition"
+git -C "$ROOT/repo" checkout -q main
+rc_mismatch=0
+rm -f "$ROOT/fix/mismatch.out" "$ROOT/fix/mismatch.err"
+# Run directly with stdout and stderr separated to files
+GATE_FIXTURE="$ROOT/fix/gate.json" timeout 60 bash "$LM" --repo "$ROOT/repo" --allow-stale --gate "$rebase_merge_sha" tk-1 fleet/rebased >"$ROOT/fix/mismatch.out" 2>"$ROOT/fix/mismatch.err" || rc_mismatch=$?
+out_mismatch_stderr=$(cat "$ROOT/fix/mismatch.err")
+out_mismatch_bytes=$(wc -c < "$ROOT/fix/mismatch.out")
+[ "$rc_mismatch" = 1 ] && ok "10y1 genuine tree mismatch exits 1" || bad "10y1 genuine tree mismatch expected exit 1" "rc=$rc_mismatch"
+has "$out_mismatch_stderr" "REFUSING: --gate $rebase_merge_sha does not contain fleet/rebased" "10y2 refusal explains does not contain branch"
+[ "$out_mismatch_bytes" -eq 0 ] && ok "10y3 stdout is empty on refusal (0 bytes)" || bad "10y3 stdout not empty on refusal" "bytes=$out_mismatch_bytes"
+
+# 10z: Deliberate-failure control: failure path cannot be piped into git commit --amend
+# Prove that feeding the actual failure stdout file directly into git commit --amend aborts without modifying HEAD
+pre_amend_head=$(git -C "$ROOT/repo" rev-parse HEAD)
+amend_rc=0
+amend_err=$(git -C "$ROOT/repo" commit --amend -F "$ROOT/fix/mismatch.out" 2>&1) || amend_rc=$?
+[ "$amend_rc" != 0 ] && ok "10z1 amend with empty message aborts" || bad "10z1 amend should have aborted" "rc=$amend_rc"
+has "$amend_err" "Aborting commit due to empty commit message" "10z2 git aborts due to empty message"
+post_amend_head=$(git -C "$ROOT/repo" rev-parse HEAD)
+[ "$pre_amend_head" = "$post_amend_head" ] && ok "10z3 default branch HEAD untouched after aborted amend" || bad "10z3 HEAD was modified"
+
+# 10za: Unrelated unmerged branch whose tip tree matches the merge union tree (but no branch-side commit) is REFUSED (review P1)
+unrel_merge_c=$(git -C "$ROOT/repo" commit-tree -p HEAD~1 -m "unrelated branch with merge tree" "$rebase_merge_tree")
+git -C "$ROOT/repo" branch -f fleet/unrel-merge "$unrel_merge_c"
+rc_unrel_merge_gate=0
+rm -f "$ROOT/fix/unrel_merge.out" "$ROOT/fix/unrel_merge.err"
+GATE_FIXTURE="$ROOT/fix/gate.json" timeout 60 bash "$LM" --repo "$ROOT/repo" --allow-stale --gate "$rebase_merge_sha" tk-1 fleet/unrel-merge >"$ROOT/fix/unrel_merge.out" 2>"$ROOT/fix/unrel_merge.err" || rc_unrel_merge_gate=$?
+[ "$rc_unrel_merge_gate" = 1 ] && ok "10za1 branch matching merge union tree is refused (rc 1)" || bad "10za1 branch matching merge union tree should be refused" "rc=$rc_unrel_merge_gate"
+has "$(cat "$ROOT/fix/unrel_merge.err")" "REFUSING: --gate $rebase_merge_sha does not contain fleet/unrel-merge" "10za2 refusal error explains does not contain branch"
+[ $(wc -c < "$ROOT/fix/unrel_merge.out") -eq 0 ] && ok "10za3 merge union tree match refusal emits 0 stdout bytes" || bad "10za3 stdout not 0 bytes"
+
+# 10aa: Non-merge history (fast-forward merge) with no-op rebase succeeds
+git -C "$ROOT/repo" checkout -q -b fleet/deep main
+echo "deep file" > "$ROOT/repo/deep.txt"
+git -C "$ROOT/repo" add deep.txt
+git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "deep target commit"
+deep_target_tree=$(git -C "$ROOT/repo" rev-parse 'HEAD^{tree}')
+# Add intermediate commits on the same branch
+for i in $(seq 1 35); do
+  echo "$i" >> "$ROOT/repo/counter.txt"
+  git -C "$ROOT/repo" add counter.txt
+  git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "counter $i"
+done
+deep_head_sha=$(git -C "$ROOT/repo" rev-parse --short HEAD)
+deep_head_tree=$(git -C "$ROOT/repo" rev-parse 'HEAD^{tree}')
+# Point main at this linear tip (fast-forward merge)
+git -C "$ROOT/repo" checkout -q main
+git -C "$ROOT/repo" merge -q --ff-only fleet/deep
+# Author amended the landed tip without changing its tree, moving ref fleet/deep
+git -C "$ROOT/repo" branch -f fleet/deep "$(git -C "$ROOT/repo" commit-tree -p HEAD~1 -m "amended deep tip" "$deep_head_tree")"
+deep_rebased_ref=$(git -C "$ROOT/repo" rev-parse fleet/deep)
+! git -C "$ROOT/repo" merge-base --is-ancestor "$deep_rebased_ref" "$deep_head_sha" 2>/dev/null && ok "10aa1 deep rebased ref is not an ancestor"
+jq --arg t "$deep_head_tree" --arg s "$deep_head_sha" '.tree=$t | .sha=$s' "$ROOT/fix/gate.json" > "$ROOT/fix/gate.tmp" && mv "$ROOT/fix/gate.tmp" "$ROOT/fix/gate.json"
+rc_deep_gate=0
+out_deep_gate=$(run --allow-stale --gate "$deep_head_sha" tk-1 fleet/deep) || rc_deep_gate=$?
+[ "$rc_deep_gate" = 0 ] && ok "10aa2 fast-forward landed branch with no-op rebase succeeds (rc 0)" || bad "10aa2 deep ancestor failed" "rc=$rc_deep_gate out=$out_deep_gate"
+has "$out_deep_gate" "PASS (full gate)" "10aa3 fast-forward landed branch carries PASS"
+has "$out_deep_gate" "Identity tree identity: $deep_head_tree" "10aa4 fast-forward prints tree identity"
+
+# 10ab: Unrelated unmerged branch whose tip tree matches an old historical main commit is REFUSED (review P1)
+unrel_c=$(git -C "$ROOT/repo" commit-tree -p HEAD~36 -m "unrelated branch commit" "$deep_target_tree")
+git -C "$ROOT/repo" branch -f fleet/unrelated "$unrel_c"
+rc_unrel_gate=0
+rm -f "$ROOT/fix/unrel.out" "$ROOT/fix/unrel.err"
+GATE_FIXTURE="$ROOT/fix/gate.json" timeout 60 bash "$LM" --repo "$ROOT/repo" --allow-stale --gate "$deep_head_sha" tk-1 fleet/unrelated >"$ROOT/fix/unrel.out" 2>"$ROOT/fix/unrel.err" || rc_unrel_gate=$?
+[ "$rc_unrel_gate" = 1 ] && ok "10ab1 unrelated branch matching historical main tree is refused (rc 1)" || bad "10ab1 unrelated branch should be refused" "rc=$rc_unrel_gate"
+has "$(cat "$ROOT/fix/unrel.err")" "REFUSING: --gate $deep_head_sha does not contain fleet/unrelated" "10ab2 refusal error explains does not contain branch"
+[ $(wc -c < "$ROOT/fix/unrel.out") -eq 0 ] && ok "10ab3 unrelated refusal emits 0 stdout bytes" || bad "10ab3 stdout not 0 bytes"
+
 echo "11. review verdict verification and tip movement invalidation (fleet-qv84)"
 # Reset comments and updates log
 rm -f "$FIX/bd-updates.log" "$FIX/bd-comments-added.log"
-- 

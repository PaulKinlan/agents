-                m_unknown = re.search(r"^fast-gate:\s*unknown:\s*(.*)$", line)
+                m_unknown = re.search(r"^(?:fast-gate|full-gate):\s*unknown:\s*(.*)$", line)
                 if m_unknown:
                     gate_unknown = True

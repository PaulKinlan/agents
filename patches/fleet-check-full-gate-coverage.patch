diff --git a/bin/fleet-check b/bin/fleet-check
index 260c16e..55ce31c 100755
--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -458,7 +458,8 @@ finish() {
   local cov_attempted=0 cov_rc=0 cov_bytes=-1 cov_err="" cov_ok=0 cov_out=""
   # fleet-opl3: a UNKNOWN run still gets the coverage read, so the record names the changed files that were
   # NOT demonstrated to be exercised rather than leaving the reader with only the state.
-  if [ -n "$fast" ] && [ -f "$cov_script" ] && { [ "$st" = PASS ] || [ "$st" = FAIL ] || [ "$st" = UNKNOWN ]; }; then
+  # Full gates also extract coverage accounting when cov_script is present
+  if [ -f "$cov_script" ] && { [ "$st" = PASS ] || [ "$st" = FAIL ] || [ "$st" = UNKNOWN ]; }; then
     cov_attempted=1
     cov_bytes=$(wc -c < "$log" 2>/dev/null | tr -d " ")
     case "${cov_bytes:-}" in ""|*[!0-9]*) cov_bytes=-1 ;; esac
diff --git a/remote/check-coverage.py b/remote/check-coverage.py
index 8823d5c..46957fa 100755
--- a/remote/check-coverage.py
+++ b/remote/check-coverage.py
@@ -267,7 +267,7 @@ def extract_coverage(log_path, repo_dir, commit_sha, cmd_str=""):
                 #       file names (sixteen "files" on a run that had four, several of them English words).
                 # The gate emits the same marker whichever way the run ended: running:/ran:/passed:/
                 # completed:/failed: name the suites that were dispatched and executed.
-                m_pass = re.search(r"^fast-gate:\s*(?:running|ran|passed|completed|failed):\s*(.*)$", line)
+                m_pass = re.search(r"^(?:fast-gate|full-gate):\s*(?:running|ran|passed|completed|failed):\s*(.*)$", line)
                 if m_pass:
                     runner_evidence = True
                     for raw in m_pass.group(1).split():
@@ -292,7 +292,7 @@ def extract_coverage(log_path, repo_dir, commit_sha, cmd_str=""):
                 if m_hub_done:
                     runner_evidence = True
                     suites.add("tests/" + m_hub_done.group(1) + ".test.sh")
-                m_unm = re.search(r"^fast-gate:\s*unmapped:\s*(.*)$", line)
+                m_unm = re.search(r"^(?:fast-gate|full-gate):\s*unmapped:\s*(.*)$", line)
                 if m_unm:
                     for raw in m_unm.group(1).split():
                         item = raw.strip("\"',;()[]{}")
@@ -301,7 +301,7 @@ def extract_coverage(log_path, repo_dir, commit_sha, cmd_str=""):
                 # The gate's explicit "I could not determine coverage" marker (the project side emits it

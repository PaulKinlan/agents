diff --git a/tests/check-coverage.test.sh b/tests/check-coverage.test.sh
index c0950df..92856ba 100644
--- a/tests/check-coverage.test.sh
+++ b/tests/check-coverage.test.sh
@@ -216,6 +216,17 @@ printf '== tests/other.test.sh\n-- other finished in 1s\n' > "$ROOT/log-hub-othe
 out=$(run "$R7" "$ROOT/log-hub-other.txt" "$SHA7"); u=$(jq_get unmapped <<<"$out")
 case " $u " in *" tests/thing.test.sh "*) ok "7c a changed test file the gate did NOT run is still flagged (the warning keeps its meaning)";; *) bad "7c unexecuted test file must stay unmapped" "[$u]";; esac
 
+echo "8. full-gate markers are recognized identically to fast-gate"
+printf 'full-gate: passed: tests/thing.test.sh\n' > "$ROOT/log-full-marker.txt"
+out=$(run "$R7" "$ROOT/log-full-marker.txt" "$SHA7"); u=$(jq_get unmapped <<<"$out"); su=$(jq_get suites <<<"$out")
+case " $u " in *" tests/thing.test.sh "*) bad "8a full-gate suite marker failed to map" "[$u]";; *) ok "8a full-gate suite marker maps changed test file";; esac
+case " $su " in *" tests/thing.test.sh "*) ok "8b full-gate suite marker captured in executed suites";; *) bad "8b full-gate marker missing from suites" "[$su]";; esac
+
+printf 'full-gate: unknown: harness did not start\n' > "$ROOT/log-full-unknown.txt"
+out=$(run "$R7" "$ROOT/log-full-unknown.txt" "$SHA7"); st=$(jq_field coverage <<<"$out"); why=$(jq_field unknown_reason <<<"$out")
+[ "$st" = "UNKNOWN" ] && ok "8c full-gate unknown marker reports coverage UNKNOWN" || bad "8c expected UNKNOWN, got [$st]" ""
+case "$why" in *harness*) ok "8d full-gate unknown reason preserved";; *) bad "8d reason lost" "[$why]";; esac
+
 if [ "$FAIL" -gt 0 ]; then echo "Failed tests: $FAIL"; fi
 printf '%s passed, %s failed\n' "$PASS" "$FAIL"
 [ "$FAIL" = 0 ]
diff --git a/tests/fleet-gate-check.test.sh b/tests/fleet-gate-check.test.sh
index da641b1..db5dcd5 100755
--- a/tests/fleet-gate-check.test.sh
+++ b/tests/fleet-gate-check.test.sh
@@ -748,17 +748,40 @@ has "$(jq -c .suites "$app_rec" 2>/dev/null)" "tests/vitest.test.ts" "14t vitest
 has "$(jq -c .suites "$app_rec" 2>/dev/null)" "tests/test_cls.py" "14u class-qualified pytest output captured in suites"
 wait_curl "[check] FAST gate for"
 
-# Full check does NOT run coverage extractor or warn on coverage
+# 14v reversal rationale: 14v originally pinned that full-gate records omitted .coverage because fleet-1n0z
+# conceived coverage accounting exclusively as a fast-gate affected-test selection guard under the assumption
+# that full gates always run everything. That deliberate [ -n "$fast" ] gatekeeper left landing verdicts
+# structurally blind to runner evidence (326 full-gate records had .coverage missing, suites=0, unmapped=null).
+# Measured extraction cost on real ~350KB full logs is 8-10s (<1% of full gate execution bound, running
+# asynchronously in the finish worker before inbox notification). 14v now asserts that full-gate records DO
+# carry .coverage, with UNKNOWN recorded when the log lacks runner evidence and complete mapping when suites run.
 rm -f "$CURL_LOG"
 full_rec="$HOME/.fleet/checks/$app_tree.json"
 echo 'CHECK_CMD="echo test ok"; CHECK_TIMEOUT=30' > "$CHECK_CONF"
 ( cd "$COV_REPO" && check )
 wait_check "$full_rec"
-hasnt "$(jq -c . "$full_rec" 2>/dev/null)" '"coverage"' "14v full gate record omits coverage field"
+has "$(jq -c . "$full_rec" 2>/dev/null)" '"coverage"' "14v full gate record carries coverage field (reversal of legacy fleet-1n0z omission)"
+cov_st=$(jq -r .coverage.coverage "$full_rec" 2>/dev/null)
+[ "$cov_st" = "UNKNOWN" ] && ok "14v2 full gate without runner evidence records coverage UNKNOWN" || bad "14v2 expected coverage UNKNOWN" "got $cov_st"
 if wait_curl "[check] full gate for"; then
   hasnt "$(cat "$CURL_LOG" 2>/dev/null)" "COVERAGE WARNING" "14w full gate notification omits coverage warning"
 fi
 
+# Full gate with runner evidence records executed suites and complete mapping
+rm -f "$CURL_LOG"
+( cd "$COV_REPO" && git checkout -q main && git checkout -q -b full-covered \
+  && echo "def findings_v4(): pass" >> lib/findings.py \
+  && git -c user.email=t@t -c user.name=t commit -q -am "covered full change" )
+fc_tree=$(git -C "$COV_REPO" rev-parse 'HEAD^{tree}')
+fc_rec="$HOME/.fleet/checks/$fc_tree.json"
+echo 'CHECK_CMD="python3 -m unittest -v tests.test_findings"; CHECK_TIMEOUT=30' > "$CHECK_CONF"
+( cd "$COV_REPO" && check )
+wait_check "$fc_rec"
+has "$(jq -c .suites "$fc_rec" 2>/dev/null)" "tests.test_findings" "14v3 full gate captures executed suite from runner"
+unm_len=$(jq -r ".unmapped | length" "$fc_rec" 2>/dev/null)
+[ "$unm_len" = "0" ] && ok "14v4 full gate record has 0 unmapped files on covered change" || bad "14v4 expected 0 unmapped" "got $unm_len"
+( cd "$COV_REPO" && git checkout -q feature )
+
 # fast-gate: running: line without test completion must not count as executed
 rm -f "$CURL_LOG"
 cat << 'SH' > "$CHECK_CONF"

diff -ruN a/bin/fleet-check b/bin/fleet-check
--- a/bin/fleet-check	2026-10-12 19:40:42.228471823 +0000
+++ b/bin/fleet-check	2026-10-12 19:40:42.232471840 +0000
@@ -591,7 +591,13 @@
     # Suppress duplicate repeat notification if record was already notified
     local already_notified
     already_notified=$(jq -r '.notified // empty' "$rec" 2>/dev/null || true)
-    if [ -n "$waiters" ] && [ -z "$already_notified" ]; then
+    # A TEST MUST NOT DELIVER RESULTS (agents-94j9). This notifier curls the VM's inbox directly for
+    # every waiter, so ANY test that drives the real fleet-check with a stub gate command sends a REAL
+    # [check] message to whichever lane invoked it, naming that lane - observed live as a synthetic
+    # result carrying the merger's name and a sha from the test's own temp repo. The sender cannot tell
+    # a stub gate from a real one (to it, check.conf is check.conf), so the honest fix is that the test
+    # suppresses the NOTIFICATION without suppressing the RUN.
+    if [ -n "$waiters" ] && [ -z "$already_notified" ] && [ -z "${FLEET_NO_NOTIFY:-}" ]; then
       local asking_lane
       asking_lane=$(jq -r '.lane // empty' "$rec" 2>/dev/null || true)
       [ -z "$asking_lane" ] && asking_lane="${FLEET_LANE:-unknown}"
diff -ruN a/tests/fleet-check-scope.test.sh b/tests/fleet-check-scope.test.sh
--- a/tests/fleet-check-scope.test.sh	2026-10-12 19:40:42.228471823 +0000
+++ b/tests/fleet-check-scope.test.sh	2026-10-12 19:40:42.232471840 +0000
@@ -29,6 +29,12 @@
 # "implementer is refused" case then sees an opted-in process and passes the guard it is meant to test.
 # Measured 2026-10-11: 5/5 standalone, and the suite FAILED inside the gate for exactly this reason.
 unset FLEET_FULL_GATE_OK
+# This suite drives the REAL fleet-check with the stub gate commands written just below, and that run's
+# completion would deliver a REAL [check] message to whichever lane invoked the test - measured, not
+# theorised (agents-94j9: the merger received one, complete with its own name in the asker field and a
+# sha from this test's temp repo, which is why the sha resolved nowhere). Suppress the notification here
+# rather than the run: the run is the subject of the test.
+export FLEET_NO_NOTIFY=1
 mkdir -p "$T/.fleet/checks"
 cd "$T" || exit 1
 git init -q . && git config user.email t@t && git config user.name t

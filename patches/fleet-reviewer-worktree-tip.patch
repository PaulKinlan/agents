From 6421330f7a45bf9e3d691ea4d1e79ec69ca2a2bd Mon Sep 17 00:00:00 2001
From: agents-factory-hubpatch <agents-factory-hubpatch@exe.xyz>
Date: Mon, 12 Oct 2026 17:01:53 +0000
Subject: [PATCH] fix(roles): reviewer worktree must check out reviewed tip on
 boot (agents-6b3k)

Reviewer worktrees spawn at origin/main, not at the tip under review.
If a reviewer runs reproducers directly in its worktree without checking
out the tip, it executes code against main rather than the reviewed commit:
1. In roles/reviewer.md Step 3, instruct reviewers to run
   'git checkout --detach "$tip"' immediately after fetching and pinning
   the delta.
2. In roles/reviewer.md Step 2 of 'What you check', guard reproduction
   with '[ "$(git rev-parse --short HEAD)" = "$tip" ]'.
3. In roles/reviewer.md 'Finish', restore the lane branch ref before retiring.
4. Add tests/reviewer-worktree-tip.test.sh validating both the static role
   contract and behavioural worktree transition from main to tip.

Release-note: Instruct reviewer lanes to check out reviewed tip on boot
---
 roles/reviewer.md                   |  9 ++-
 tests/reviewer-worktree-tip.test.sh | 89 +++++++++++++++++++++++++++++
 2 files changed, 97 insertions(+), 1 deletion(-)
 create mode 100755 tests/reviewer-worktree-tip.test.sh

diff --git a/roles/reviewer.md b/roles/reviewer.md
index 34386fd..48f2621 100644
--- a/roles/reviewer.md
+++ b/roles/reviewer.md
@@ -20,11 +20,12 @@ you find. Reviewing is the same job whether the work is still on `fleet/<x>` or
 2. `bd show ${FLEET_BEAD}` and `bd comments ${FLEET_BEAD}`: read the bead, the author's claimed evidence and any
    earlier verdict. A prior verdict on the same delta is not a review you can copy; if it exists and the delta
    did not change, say so and stop.
-3. `git fetch origin fleet/<x>`, then verify tree hygiene and **pin the delta**:
+3. `git fetch origin fleet/<x>`, then verify tree hygiene, **pin the delta, and check out the reviewed tip**:
    ```bash
    git status --porcelain             # must be empty: clean worktree, no leftover test scripts
    tip=$(git rev-parse --short FETCH_HEAD)
    mb=$(git merge-base origin/${FLEET_DEFAULT_BRANCH} $tip)
+   git checkout --detach "$tip"        # CRITICAL (agents-6b3k): worktrees spawn at main; you must check out the tip before measuring
    git log --oneline $mb..$tip ; git diff --stat $mb..$tip
    ```
    Review `$mb..$tip` and nothing else. **Never diff against origin/${FLEET_DEFAULT_BRANCH}**: shows concurrent landings as deletions and raises false P0s (gendn).
@@ -36,6 +37,11 @@ you find. Reviewing is the same job whether the work is still on `fleet/<x>` or
 2. **The behaviour under review, reproduced.** Reproduce the *specific* behaviour the bead claims — one command or
    one browser run, bounded (`timeout -k 30 <N>`, `nice -n 10`, and close anything you start in the same command
    with a `trap`; a lane that leaves Chrome or a server behind gets reaped and looks like a dead lane). Not a survey.
+   Confirm your worktree is at the reviewed tip before measuring:
+   ```bash
+   [ "$(git rev-parse --short HEAD)" = "$tip" ] || { echo "ERROR: worktree HEAD ($(git rev-parse --short HEAD)) does not match review tip $tip - check out tip before measuring (agents-6b3k)" >&2; exit 1; }
+   ```
+   (agents-6b3k: running reproducers while still on main measures the wrong tree and produces false greens/reds, as measured in rev-dso1 where direct execution ran 4 tests on main instead of 8 at tip).
 3. **The gate verdict for that exact tree.** `fleet-check --status <tip>` (or the merger's merged sha) and quote
    the cached record: state, sha, when, by whom. **Never re-run a suite** - a reviewer re-running the gate is
    memory it does not have.
@@ -114,6 +120,7 @@ Say what you measured, on which sha, and one action. Do not escalate style.
 
 ### Finish
 When the verdict comment and the beads are in, `bd dolt push`:
+- **Restore lane branch:** `git checkout -q "fleet/${FLEET_LANE}" 2>/dev/null || true` so the worktree is restored to its lane branch.
 - **Retirement (fleet-j6xs):** tell coord one line with **"retire this lane"** ONLY if your review queue is empty. If you were queued multiple reviews or still owe a follow-up review, state what you still owe instead of retiring prematurely.
 - Before retiring, verify no beads remain assigned to your lane (`bd list --assignee ${FLEET_LANE}`).
 - A reviewer lane is short-lived by design: once its assigned queue is complete, the VM gets its CPU back.
diff --git a/tests/reviewer-worktree-tip.test.sh b/tests/reviewer-worktree-tip.test.sh
new file mode 100755
index 0000000..7e5388c
--- /dev/null
+++ b/tests/reviewer-worktree-tip.test.sh
@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# Test reviewer role worktree tip materialization and verification contract (agents-6b3k).
+#
+# A reviewer lane's worktree spawns at origin/main, not at the tip under review.
+# roles/reviewer.md must instruct checking out the tip (--detach "$tip") on boot,
+# and asserting worktree HEAD matches $tip before reproducing claimed behavior.
+set -uo pipefail
+
+HERE="$(cd "$(dirname "$0")/.." && pwd)"
+PASS=0 FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; }
+chk() { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1 (expected '$3', got '$2')"; fi; }
+
+echo "1. Static contract: roles/reviewer.md instructs tip checkout and verification"
+ROLE_MD="$HERE/roles/reviewer.md"
+[ -f "$ROLE_MD" ] && ok "1a roles/reviewer.md exists" || bad "1a roles/reviewer.md exists"
+
+grep -q 'git checkout --detach "$tip"' "$ROLE_MD" \
+  && ok "1b roles/reviewer.md instructs git checkout --detach \$tip on boot" \
+  || bad "1b missing git checkout --detach \$tip instruction"
+
+grep -q '\[ "$(git rev-parse --short HEAD)" = "$tip" \]' "$ROLE_MD" \
+  && ok "1c roles/reviewer.md guards reproduction with worktree HEAD verification" \
+  || bad "1c missing worktree HEAD verification guard"
+
+echo "2. Behavioural reproduction: reviewer worktree transitions from main to reviewed tip"
+ROOT="$(mktemp -d)"; trap 'rm -rf "$ROOT"' EXIT
+REPO="$ROOT/repo"
+mkdir -p "$REPO"
+git -C "$REPO" init -q -b main
+git -C "$REPO" config user.email "test@example.com"
+git -C "$REPO" config user.name "Test"
+echo "base" > "$REPO/code.txt"
+git -C "$REPO" add code.txt
+git -C "$REPO" commit -q -m "base commit"
+main_sha=$(git -C "$REPO" rev-parse --short HEAD)
+
+# Implementer feature branch
+git -C "$REPO" checkout -q -b fleet/feat-xyz
+echo "feature modified" > "$REPO/code.txt"
+git -C "$REPO" commit -q -am "feat: modified code"
+tip_sha=$(git -C "$REPO" rev-parse --short HEAD)
+git -C "$REPO" checkout -q main
+
+# Reviewer worktree spawned as lanes.sh does (cut from main)
+REV_WT="$ROOT/worktree-rev"
+git -C "$REPO" worktree add -q -b fleet/rev-xyz "$REV_WT" main
+
+# Prior to running boot checkout, worktree is at main (the hazard)
+initial_wt_sha=$(git -C "$REV_WT" rev-parse --short HEAD)
+chk "2a worktree initially spawns at main" "$initial_wt_sha" "$main_sha"
+
+# Execute the exact documented guard in a subshell on un-detached worktree
+guard_rc=0
+guard_out=$( ( cd "$REV_WT" && [ "$(git rev-parse --short HEAD)" = "$tip_sha" ] || { echo "ERROR: worktree HEAD ($(git rev-parse --short HEAD)) does not match review tip $tip_sha - check out tip before measuring (agents-6b3k)" >&2; exit 1; } ) 2>&1 ) || guard_rc=$?
+
+chk "2b1 guard exits nonzero on mismatch" "$guard_rc" "1"
+if [[ "$guard_out" == *"ERROR: worktree HEAD ($main_sha) does not match review tip $tip_sha"* ]]; then
+  ok "2b2 guard successfully catches and loudly names mismatch ($main_sha vs $tip_sha)"
+else
+  bad "2b2 guard output mismatch: $guard_out"
+fi
+
+# Reviewer executes Step 3 boot sequence
+(
+  cd "$REV_WT"
+  tip=$(git rev-parse --short "$tip_sha")
+  git checkout -q --detach "$tip"
+)
+
+# After boot checkout, worktree is at tip
+new_wt_sha=$(git -C "$REV_WT" rev-parse --short HEAD)
+chk "2c worktree successfully materialized at tip" "$new_wt_sha" "$tip_sha"
+
+# Guard now passes
+if ( cd "$REV_WT" && [ "$(git rev-parse --short HEAD)" = "$tip_sha" ] ); then
+  ok "2d guard passes once tip is checked out"
+else
+  bad "2d guard failed after tip checkout"
+fi
+
+# Content on disk reflects the feature branch
+content=$(cat "$REV_WT/code.txt")
+chk "2e worktree file content matches reviewed feature" "$content" "feature modified"
+
+echo
+printf 'reviewer worktree tip contract: %d passed, %d failed\n' "$PASS" "$FAIL"
+[ "$FAIL" = 0 ]
-- 

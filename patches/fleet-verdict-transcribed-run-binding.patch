@@ -131,12 +132,10 @@ fleet_verdict_model_identity() { printf '%s' "${1:-}" | cut -d: -f1 | tr '[:uppe
 # function did refuse, and broke four legitimate flows; the class it produced is reported, not
 # enforced.
 #
-# LIMIT, STATED RATHER THAN HIDDEN: this proves the run exists, COMPLETED, and is a reviewer run whose

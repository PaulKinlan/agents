+
+# fleet_verdict_extract_run_id <comment-text> [verdict-line]
+# Extract an unambiguous reviewer subagent run UUID from comment text and verdict line.
+# - If verdict line carries (run <uuid>), that cue is authoritative.
+# - If a single UUID exists in comment text, it is accepted directly.
+# - If multiple UUIDs exist, only a UUID unambiguously cued as the reviewer run is accepted.
+# - Competing or ambiguous reviewer citations leave output empty (unknown).
+fleet_verdict_extract_run_id() {
+  local c_text="${1:-}" v_line="${2:-}"
+  local _c_uuids _c_count _c_vline _c_rev _c_rcount
+
+  # If the verdict line itself carries (run <uuid>), that cue is authoritative
+  if [ -n "$v_line" ]; then
+    _c_vline=$(grep -oE "\([[:space:]]*run[[:space:]]+[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[[:space:]]*\)" <<<"$v_line" \
+      | grep -oE "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" \
+      | tr "[:upper:]" "[:lower:]" \
+      | sort -u)
+    if [ "$(grep -c . <<<"$_c_vline" 2>/dev/null || true)" -eq 1 ]; then
+      printf "%s" "$_c_vline"
+      return 0
+    fi
+  fi
+
+  local full_text="$c_text"$'
+'"$v_line"
+  _c_uuids=$(grep -oE "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" <<<"$full_text" | tr "[:upper:]" "[:lower:]" | sort -u)
+  _c_count=$(grep -c . <<<"$_c_uuids" 2>/dev/null || true)
+  [ "$_c_count" -gt 0 ] || return 0
+
+  if [ "$_c_count" -eq 1 ]; then
+    printf "%s" "$_c_uuids"
+    return 0
+  fi
+
+  # In prose with multiple UUIDs, extract UUIDs cued explicitly as the reviewer run.
+  # Plural "reviewer runs" or multiple UUIDs in reviewer context is competing/ambiguous.
+  if ! grep -iqE "(^|[^a-zA-Z0-9_-])(reviewer|review)[[:space:]]+runs([^a-zA-Z0-9_-]|$)" <<<"$full_text"; then
+    local cue_re="(^|[^a-zA-Z0-9_-])(independent[[:space:]]+)?review(er)?([[:space:]]+(subagent|agent|pi))?([[:space:]]*\([[:space:]]*run|[[:space:]]+run([[:space:]]+id)?|[[:space:]]*:)[:[:space:]]*[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
+    _c_rev=$(grep -ioE "$cue_re" <<<"$full_text" \
+      | grep -oE "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" \
+      | tr "[:upper:]" "[:lower:]" \
+      | sort -u)
+    _c_rcount=$(grep -c . <<<"$_c_rev" 2>/dev/null || true)
+    if [ "$_c_rcount" -eq 1 ]; then
+      printf "%s" "$_c_rev"
+      return 0
+    fi
+  fi
+
+  return 0
+}

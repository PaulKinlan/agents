 #
 # WHAT THIS IS FOR, AND WHAT IT IS NOT: it makes a transcribed clearance's PROVENANCE VISIBLE. It does
 # not gate the landing, and it must not: the fleet's own standard (foza) says a transcription that
@@ -131,12 +132,10 @@ fleet_verdict_model_identity() { printf '%s' "${1:-}" | cut -d: -f1 | tr '[:uppe
 # function did refuse, and broke four legitimate flows; the class it produced is reported, not
 # enforced.
 #
-# LIMIT, STATED RATHER THAN HIDDEN: this proves the run exists, COMPLETED, and is a reviewer run whose
-# model matches the named one. It does NOT prove that run reviewed THIS diff - the descriptor records
-# agent and model, not the bead or the branch. A lane willing to point at an unrelated reviewer run
-# would pass. That is a smaller hole than an unbacked model string, and it is the hole that remains.
+# BEAD/BRANCH RELEVANCE: validates that the run's descriptor, events, or output reference
+# the claimed bead or branch. An arbitrary unrelated reviewer run cannot back a foreign verdict claim.
 fleet_verdict_transcribed_run_status() {
-  local rid="${1:-}" named="${2:-}" root="${3:-}" d="" r="" state=""
+  local rid="${1:-}" named="${2:-}" root="${3:-}" bead="${4:-}" branch="${5:-}" d="" r="" state=""
   [ -n "$rid" ] || return 0
   for r in ${root:-${TMPDIR:-/tmp}}/pi-subagents-*/async-subagent-runs; do
     if [ -d "$r/$rid" ]; then d="$r/$rid"; break; fi
@@ -172,6 +171,21 @@ fleet_verdict_transcribed_run_status() {
     printf 'unverified: run %s records model %s, which is not the named reviewer model %s' "$rid" "${model:-<none>}" "$named"
     return 0
   fi
+  # Bead/branch relevance check: verify the run directory references the expected bead or branch.
+  # Whole-identifier word boundaries are required so identifier prefixes do not falsely match.
+  if [ -n "$bead" ] || [ -n "$branch" ]; then
+    local matched=false
+    for logfile in "$d/output-0.log" "$d/recovery-descriptor.json" "$d/events.jsonl"; do
+      if [ -r "$logfile" ]; then
+        if [ -n "$bead" ] && grep -qE "(^|[^a-zA-Z0-9_-])$bead([^a-zA-Z0-9_-]|$)" "$logfile" 2>/dev/null; then matched=true; break; fi
+        if [ -n "$branch" ] && grep -qE "(^|[^a-zA-Z0-9/_-])$branch([^a-zA-Z0-9/_-]|$)" "$logfile" 2>/dev/null; then matched=true; break; fi
+      fi
+    done
+    if [ "$matched" = false ]; then
+      printf 'unverified: run %s does not reference bead %s or branch %s - an unrelated reviewer run cannot back this claim' "$rid" "${bead:-<none>}" "${branch:-<none>}"
+      return 0
+    fi
+  fi
   printf 'verified: run %s is a completed reviewer run on %s' "$rid" "${model:-<unknown model>}"

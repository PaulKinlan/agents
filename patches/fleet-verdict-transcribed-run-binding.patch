diff --git a/bin/fleet-verdict-words.sh b/bin/fleet-verdict-words.sh
index b3f7bb9..c08a6b8 100644
--- a/bin/fleet-verdict-words.sh
+++ b/bin/fleet-verdict-words.sh
@@ -136,7 +136,7 @@ fleet_verdict_model_identity() { printf '%s' "${1:-}" | cut -d: -f1 | tr '[:uppe
 # agent and model, not the bead or the branch. A lane willing to point at an unrelated reviewer run
 # would pass. That is a smaller hole than an unbacked model string, and it is the hole that remains.
 fleet_verdict_transcribed_run_status() {
-  local rid="${1:-}" named="${2:-}" root="${3:-}" d="" r="" state=""
+  local rid="${1:-}" named="${2:-}" root="${3:-}" bead="${4:-}" branch="${5:-}" d="" r="" state=""
   [ -n "$rid" ] || return 0
   for r in ${root:-${TMPDIR:-/tmp}}/pi-subagents-*/async-subagent-runs; do
     if [ -d "$r/$rid" ]; then d="$r/$rid"; break; fi
@@ -172,6 +172,88 @@ fleet_verdict_transcribed_run_status() {
     printf 'unverified: run %s records model %s, which is not the named reviewer model %s' "$rid" "${model:-<none>}" "$named"
     return 0
   fi
+  # Bead/branch relevance check: verify the run directory references the expected bead or branch.
+  # Whole-identifier word boundaries with escaped regex metacharacters prevent false partial matches.
+  local esc_bead="" esc_branch=""
+  [ -n "$bead" ] && esc_bead=$(sed 's/[.[\*^$()+?{}|]/\\&/g' <<<"$bead")
+  [ -n "$branch" ] && esc_branch=$(sed 's/[.[\*^$()+?{}|]/\\&/g' <<<"$branch")
+  if [ -n "$esc_bead" ] || [ -n "$esc_branch" ]; then
+    local matched=false
+    for logfile in "$d/output-0.log" "$d/recovery-descriptor.json" "$d/events.jsonl"; do
+      if [ -r "$logfile" ]; then
+        if [ -n "$esc_bead" ] && grep -qE "(^|[^a-zA-Z0-9_-])${esc_bead}([^a-zA-Z0-9_-]|$)" "$logfile" 2>/dev/null; then matched=true; break; fi
+        if [ -n "$esc_branch" ] && grep -qE "(^|[^a-zA-Z0-9/_-])${esc_branch}([^a-zA-Z0-9/_-]|$)" "$logfile" 2>/dev/null; then matched=true; break; fi
+      fi
+    done
+    if [ "$matched" = false ]; then
+      printf 'unverified: run %s does not reference bead %s or branch %s - an unrelated reviewer run cannot back this claim' "$rid" "${bead:-<none>}" "${branch:-<none>}"
+      return 0
+    fi
+  fi
   printf 'verified: run %s is a completed reviewer run on %s' "$rid" "${model:-<unknown model>}"
 }
 
+# fleet_verdict_extract_run_id <comment-text> [verdict-line]
+# Extract an unambiguous reviewer subagent run UUID from comment text and verdict line.
+# - If verdict line carries (run <uuid>), that cue is authoritative.
+# - If a single UUID exists in comment text, it is accepted directly.
+# - If multiple UUIDs exist, only a UUID unambiguously cued as the reviewer run is accepted.
+# - Competing, plural, or quoted prior reviewer citations leave output empty (unknown).
+fleet_verdict_extract_run_id() {
+  local c_text="${1:-}" v_line="${2:-}"
+  local _c_uuids _c_count _c_vline _c_rev _c_rcount
+
+  # If the verdict line itself carries (run <uuid>), that cue is authoritative
+  if [ -n "$v_line" ]; then
+    _c_vline=$(grep -oE "\([[:space:]]*run[[:space:]]+[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[[:space:]]*\)" <<<"$v_line" \
+      | grep -oE "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" \
+      | tr '[:upper:]' '[:lower:]' \
+      | sort -u)
+    if [ "$(grep -c . <<<"$_c_vline" 2>/dev/null || true)" -eq 1 ]; then
+      printf '%s' "$_c_vline"
+      return 0
+    fi
+  fi
+
+  local full_text="$c_text"$'\n'"$v_line"
+  _c_uuids=$(grep -oE "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" <<<"$full_text" | tr '[:upper:]' '[:lower:]' | sort -u)
+  _c_count=$(grep -c . <<<"$_c_uuids" 2>/dev/null || true)
+  [ "$_c_count" -gt 0 ] || return 0
+
+  if [ "$_c_count" -eq 1 ]; then
+    printf '%s' "$_c_uuids"
+    return 0
+  fi
+
+  # Plural "reviewer runs" or multiple UUIDs in reviewer context is competing/ambiguous.
+  if grep -iqE "(^|[^a-zA-Z0-9_-])(reviewer|review)[[:space:]]+runs([^a-zA-Z0-9_-]|$)" <<<"$full_text"; then
+    return 0
+  fi
+
+  # In prose with multiple UUIDs, evaluate clauses to find unquoted operative reviewer cues.
+  # Clauses that introduce quoted/prior/foreign runs are excluded.
+  local cue_re="(^|[^a-zA-Z0-9_-])(independent[[:space:]]+)?review(er)?([[:space:]]+(subagent|agent|pi))?([[:space:]]*\([[:space:]]*run|[[:space:]]+run([[:space:]]+id)?|[[:space:]]*:)[:[:space:]]*[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
+  local unquoted_rev=""
+  while IFS= read -r clause; do
+    [ -n "$clause" ] || continue
+    # Skip clauses introducing quoted/prior/earlier/foreign reviews or runs
+    if grep -iqE "(^|[^a-zA-Z0-9_-])(quoted|prior|earlier|foreign|previous)[^.;\n]*(verdict|review|run|comment)" <<<"$clause"; then
+      continue
+    fi
+    local m
+    m=$(grep -ioE "$cue_re" <<<"$clause" | grep -oE "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" | tr '[:upper:]' '[:lower:]' || true)
+    if [ -n "$m" ]; then
+      unquoted_rev+="$m"$'\n'
+    fi
+  done <<< "$(sed -E "s/([.;\n|])/\n/g" <<<"$full_text")"
+
+  unquoted_rev=$(sort -u <<<"$unquoted_rev" | grep -E "." || true)
+  _c_rcount=$(grep -c . <<<"$unquoted_rev" 2>/dev/null || true)
+  if [ "$_c_rcount" -eq 1 ]; then
+    printf '%s' "$unquoted_rev"
+    return 0
+  fi
+
+  return 0
+}
+

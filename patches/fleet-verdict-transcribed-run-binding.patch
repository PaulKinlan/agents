+# BEAD/BRANCH RELEVANCE: validates that the run's descriptor, events, or output reference
+# the claimed bead or branch. An arbitrary unrelated reviewer run cannot back a foreign verdict claim.
 fleet_verdict_transcribed_run_status() {
-  local rid="${1:-}" named="${2:-}" root="${3:-}" d="" r="" state=""
+  local rid="${1:-}" named="${2:-}" root="${3:-}" bead="${4:-}" branch="${5:-}" d="" r="" state=""

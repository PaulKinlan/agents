-  branch=$("${git_cmd[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
+  caller_branch=$("${git_cmd[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
 
   tree_unverified=""
   t=$("${git_cmd[@]}" rev-parse "${target}^{tree}" 2>/dev/null) || {
@@ -170,12 +170,21 @@ if [ "${1:-}" = --status ]; then   # fleet-efk: resolve the GIVEN sha's tree, ne
     fi
     # fleet-8pqa: keep the record's OWN claim about where it ran. `repo` is where the question was asked (the
     # caller's checkout); `produced_in` is where the suite actually ran, which the old line silently overwrote.
-    jq -c --arg s "$target" --arg r "$top" --arg b "$branch" \
-      '. + {asked:$s} + (if $r != "" then (if (.repo // "") != "" and (.repo != $r) then {repo:$r,produced_in:.repo} else {repo:$r} end) else {} end) + (if $b != "" then {branch:$b} else {} end)' "$f"
+    # fleet-npyn (RE-CUT, coord 12:06): there is NO field named `branch` anywhere in this output, and that is
+    # the point. A field called `branch` living in a RECORD while it holds the READER's branch is the original
+    # defect in slower motion: a verdict record is read by many actors, and each would see its own branch in the
+    # same field. Two fields, one meaning each instead:
+    #   produced_branch - the branch the suite actually ran on, a property of the RECORD. It flows through the
+    #                     merge below untouched, so it is present whenever the record knows it (even when it
+    #                     equals the caller's) and ABSENT when it does not, with no guess in either direction.
+    #   caller_branch   - the branch of the checkout ASKING, a property of the READ and not of the record.
+    # A record written before this re-cut has no produced_branch, so it reads caller_branch and nothing else.
+    jq -c --arg s "$target" --arg r "$top" --arg b "$caller_branch" \
+      '. + {asked:$s} + (if $r != "" then (if (.repo // "") != "" and (.repo != $r) then {repo:$r,produced_in:.repo} else {repo:$r} end) else {} end) + (if $b != "" then {caller_branch:$b} else {} end)' "$f"
   else
     jq -nc --arg k "$([ -n "$FAST" ] && echo fast || echo full)" --arg t "$t" --arg s "$target" \

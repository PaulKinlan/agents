diff --git a/tests/fleet-land-message.test.sh b/tests/fleet-land-message.test.sh
index bea65a8..fd2ce40 100755
--- a/tests/fleet-land-message.test.sh
+++ b/tests/fleet-land-message.test.sh
@@ -76,7 +76,50 @@ cat > "$ROOT/fix/show.json" <<'J'
 J
 
 B="$ROOT/fix/comments.json"
-run() { GATE_FIXTURE="$ROOT/fix/gate.json" timeout 60 bash "$LM" "$@" 2>&1; }
+# JSON stdout is machine-readable data: keep helper diagnostics out of jq's input. Text-mode fixtures
+# keep the original combined-stream behavior so their refusal assertions still see stderr. Recorded
+# stderr is forwarded to the harness's own stderr (never hidden) and left at $ROOT/fix/json-stderr
+# so a guard can assert on it (agents-zcxb).
+run() {
+  local _rc _arg _json=0
+  for _arg in "$@"; do case "$_arg" in --print-json|--json) _json=1;; esac; done
+  if [ "$_json" = 1 ]; then
+    GATE_FIXTURE="$ROOT/fix/gate.json" timeout 60 bash "$LM" "$@" 2>"$ROOT/fix/json-stderr"
+    _rc=$?
+    if [ -s "$ROOT/fix/json-stderr" ]; then
+      printf 'run: --print-json stderr (recorded at %s):\n' "$ROOT/fix/json-stderr" >&2
+      cat "$ROOT/fix/json-stderr" >&2
+    fi
+  else
+    GATE_FIXTURE="$ROOT/fix/gate.json" timeout 60 bash "$LM" "$@" 2>&1
+    _rc=$?
+  fi
+  return "$_rc"
+}
+
+# --- harness guard (agents-zcxb): JSON stdout is data, stderr is diagnostics, and both stay observable.
+# The wrapper injects a warning on stderr around the REAL helper's JSON. The old combined-stream run()
+# folds that warning into jq's input, so the jq assertion reads EMPTY; the separated run() keeps stdout
+# parseable, records the warning, and preserves the helper's exit status. This guard therefore fails the
+# old harness and passes the corrected one.
+cat > "$B" <<'J'
+[{"author":"proj-lane-1","created_at":"2026-10-09T10:00:00Z",
+  "text":"LAND-SUMMARY\nWHAT: guard fixture.\nWHY: w.\nEFFECT: e."}]
+J
+cat > "$ROOT/fix/lm-warn" <<W
+#!/usr/bin/env bash
+printf 'fleet-land-message: INJECTED-WARNING-ON-STDERR\n' >&2
+exec bash "\${LM_REAL:?}" "\$@"
+W
+chmod +x "$ROOT/fix/lm-warn"
+LM_REAL="$LM"; export LM_REAL
+LM="$ROOT/fix/lm-warn"
+out_warn=$(run --print-json tk-1 fleet/thing); rc_warn=$?
+LM="$LM_REAL"
+eq "$(jq -r '.summary.comment_index' <<<"$out_warn")" "0"               "H1 a stderr warning does not corrupt JSON stdout"
+has "$(cat "$ROOT/fix/json-stderr")" "INJECTED-WARNING-ON-STDERR"       "H2 the warning is still visible (recorded stderr)"
+eq "$rc_warn" "0"                                                        "H3 the helper's exit status survives the wrapper"
+hasnt "$out_warn" "INJECTED-WARNING"                                     "H4 the warning is not folded into JSON stdout"
 
 echo "1. a well-formed block on the author's hand-off comment"
 cat > "$B" <<'J'

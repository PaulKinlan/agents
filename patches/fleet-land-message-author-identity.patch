From 2dfa052bd1ccc32e1bf34254d4a471d2cdd76b41 Mon Sep 17 00:00:00 2001
From: agents-factory-impl-l2xb <agents-factory-impl-l2xb@exe.xyz>
Date: Tue, 13 Oct 2026 16:13:55 +0000
Subject: [PATCH] fix(fleet-land-message): derive the branch author from the
 branch, and let the lander supply the authoring model (agents-2tov)

The independence check took the "branch author" from the ACTOR of the operative LAND-SUMMARY comment.
A summary appended by another lane - a coordinator replacing a block whose author's bd writes were
timing out, a workflow the helper explicitly supports - therefore made the APPENDER the author, and the
comparison used the appender's family: on agents-jb8m a deepseek reviewer was refused as same-family
against coord's record while the branch's own lane (impl-f6du) reads openai-codex/gpt-6-sol, i.e.
genuinely cross-family. THE SAME WRONG OBJECT IS WORSE IN THE OTHER DIRECTION: the author-lane verdict
filter discounted the APPENDER's verdicts, so with an appender of a different family the AUTHOR's own
verdict counts as independent evidence - a false POSITIVE, which authorises a landing, rather than a
false negative, which merely blocks one.

The author is now derived from the BRANCH NAME (fleet/<lane>-<bead> -> the longest lane recorded in
~/.fleet/lanes/*.model that matches at a boundary), with the operative summary's actor kept only as a
labelled fallback, and the derivation's SOURCE is recorded (author_lane, author_source,
author_model_source in --print-json; named in the refusal text). When no object settles the authoring
model - a lane restarted or rotated since the work was authored - --author-model supplies the OPERAND
rather than overriding the rule: the comparison still runs, the value is recorded as supplied, and the
refusal names that flag as the remedy.

Verified: tests/fleet-land-message.test.sh 297 passed / 0 failed with the patch, rc=1 and 13 failures
against the unpatched helper on the new case (LM_OVERRIDE=<path> bash tests/fleet-land-message.test.sh).
---
 bin/fleet-land-message           | 84 ++++++++++++++++++++++++++------
 tests/fleet-land-message.test.sh | 70 ++++++++++++++++++++++++++
 2 files changed, 139 insertions(+), 15 deletions(-)

diff --git a/bin/fleet-land-message b/bin/fleet-land-message
index e1f535a..a6a07a5 100755
--- a/bin/fleet-land-message
+++ b/bin/fleet-land-message
@@ -9,6 +9,13 @@
 #   fleet-land-message --from-comment <n> <bead> <branch> [...] when a bead has several LAND-SUMMARY blocks and
 #                                                             the last one is not the one to use (n is the
 #                                                             index from `bd comments <bead> --json`)
+#   fleet-land-message --author-model <provider/id> <bead> <branch> [...]
+#                                                             supply the AUTHORING model when no object on the
+#                                                             VM can (a lane restarted or rotated since the
+#                                                             work was authored). This is an INPUT to the
+#                                                             independence rule, not a way around it: the
+#                                                             comparison still runs, and the message records
+#                                                             that the value was supplied (agents-2tov).
 #
 # It PRINTS; it never commits, merges, amends or pushes. The merger uses it in place of the one-line subject:
 #
@@ -39,7 +46,7 @@
 set -uo pipefail
 export PATH="$HOME/fleet/bin:$HOME/.local/bin:$PATH"
 
-GATE_SHA=""; JSON=0; BEADS=(); ARGS=(); FROM_COMMENT=""; ALLOW_STALE=0; REPO_DIR=""
+GATE_SHA=""; JSON=0; BEADS=(); ARGS=(); FROM_COMMENT=""; ALLOW_STALE=0; REPO_DIR=""; AUTHOR_MODEL_ARG=""
 while [ $# -gt 0 ]; do
   case $1 in
     --gate) GATE_SHA=${2:?--gate needs a sha}; shift 2 ;;
@@ -48,6 +55,8 @@ while [ $# -gt 0 ]; do
     --gate=*) GATE_SHA=${1#--gate=}; shift ;;
     --allow-stale) ALLOW_STALE=1; shift ;;
     --print-json|--json) JSON=1; shift ;;
+    --author-model) AUTHOR_MODEL_ARG=${2:?--author-model needs provider/id}; shift 2 ;;
+    --author-model=*) AUTHOR_MODEL_ARG=${1#--author-model=}; shift ;;
     --repo) REPO_DIR=${2:?--repo needs a directory}; shift 2 ;;
     --repo=*) REPO_DIR=${1#--repo=}; shift ;;
     --worktree) REPO_DIR=${2:?--worktree needs a directory}; shift 2 ;;
@@ -231,10 +240,46 @@ rev_cleared=false; rev_unreviewed=0; rev_delta_identical=false; rev_run_id=""
 # named. This is NOT author keying as a rejection test (fleet-15b5 stands: a reviewer subagent inherits
 # its parent lane's actor, so a same-actor verdict is still eligible when no other-actor verdict exists -
 # the transcribed-subagent path, classified below by the reviewer model it must name).
+# ---------- WHO AUTHORED THIS BRANCH (agents-2tov) ----------
+# THE AUTHOR OF A BRANCH IS NAMED BY THE BRANCH, not by whoever last appended a LAND-SUMMARY. Until this was
+# fixed the author was taken from the ACTOR of the operative LAND-SUMMARY comment, so a summary appended by a
+# different lane (a coordinator replacing a block whose author's bd writes timed out - a supported workflow)
+# made THAT lane the author: measured on agents-jb8m, where the replacement block is coord's, so the author was
+# read as coord (deepseek/deepseek-flash) while the deepseek reviewer was refused as 'same-family' - a false
+# negative on a branch whose own lane file (~/.fleet/lanes/impl-f6du.model) reads openai-codex/gpt-6-sol, i.e.
+# genuinely cross-family. The same wrong object was used for the author-lane verdict filter, which is the same
+# defect pointed the other way: with an appender of a different family, an AUTHOR's own verdict stops being
+# discounted. Both now ask this one question, and the answer names its SOURCE so a wrong derivation is visible
+# rather than confident.
+fleet_author_lane_from_branch() {
+  local rem=${1#fleet/} best="" cand base
+  [ -d "$HOME/.fleet/lanes" ] || return 0
+  for cand in "$HOME/.fleet/lanes"/*.model; do
+    [ -f "$cand" ] || continue
+    base=$(basename "$cand"); base=${base%.model}
+    [ -n "$base" ] || continue
+    # A branch is fleet/<lane>-<bead> (or fleet/<lane>), and lanes contain hyphens, so the match must be at a
+    # boundary and the LONGEST known lane wins: fleet/impl-l2xb-followup2 is impl-l2xb, not impl.
+    case "$rem" in
+      "$base"|"$base"-*|"$base"/*) [ "${#base}" -gt "${#best}" ] && best=$base ;;
+    esac
+  done
+  printf '%s' "$best"
+}
+src_author=""; src_lane=""; src_author_source=""
+if [ -n "$BRANCH" ]; then
+  _bl=$(fleet_author_lane_from_branch "$BRANCH" 2>/dev/null || true)
+  if [ -n "$_bl" ]; then
+    src_lane="$_bl"; src_author="${FLEET_VM:-fleet-manager}-${_bl}"; src_author_source="branch-name"
+  fi
+fi
+if [ -z "$src_lane" ] && [ -n "$src_who" ]; then
+  src_author="$src_who"; src_lane=${src_who#"${FLEET_VM:-fleet-manager}-"}; src_author_source="summary-author"
+fi
 REV_POOL="$REV_CAND"; rev_author_ignored=0; rev_author_ignored_shas=""
-if [ -n "$src_who" ] && [ -n "$REV_CAND" ]; then
-  _nonauth=$(awk -F'\t' -v a="$src_who" '$2 != a' <<<"$REV_CAND")
-  _auth=$(awk -F'\t' -v a="$src_who" '$2 == a' <<<"$REV_CAND")
+if [ -n "$src_author" ] && [ -n "$REV_CAND" ]; then
+  _nonauth=$(awk -F'\t' -v a="$src_author" '$2 != a' <<<"$REV_CAND")
+  _auth=$(awk -F'\t' -v a="$src_author" '$2 == a' <<<"$REV_CAND")
   if [ -n "$_nonauth" ]; then
     REV_POOL="$_nonauth"
     rev_author_ignored=$(grep -c . <<<"$_auth" || true)
@@ -593,14 +638,20 @@ fi
 #                   without a summary anyway.
 # A determinable SAME family refuses even when the actor differs (cross-family is the fleet's rule for
 # every review, not only same-lane transcriptions).
-rev_independence="unknown"; rev_reviewer_model=""; rev_author_model=""; rev_block=""
+rev_independence="unknown"; rev_reviewer_model=""; rev_author_model=""; rev_author_model_source="comment cue"; rev_block=""
 if [ -n "$rev_verdict" ] && [ -n "$rev_text" ]; then
   _pm=$(fleet_verdict_split_models "${verdict_line:-}" "$rev_text" 2>/dev/null || true)
   rev_reviewer_model=$(sed -n 1p <<<"$_pm"); rev_author_model=$(sed -n 2p <<<"$_pm")
-  if [ -z "$rev_author_model" ] && [ -n "$src_who" ]; then
-    _lane=${src_who#"${FLEET_VM:-fleet-manager}-"}
-    if [ "$_lane" != "$src_who" ] && [ -f "$HOME/.fleet/lanes/$_lane.model" ]; then
-      rev_author_model=$(tr -d '[:space:]' < "$HOME/.fleet/lanes/$_lane.model" 2>/dev/null || true)
+  if [ -z "$rev_author_model" ] && [ -n "$AUTHOR_MODEL_ARG" ]; then
+    # agents-2tov: the operator with the evidence supplies the missing OPERAND, rather than overriding the
+    # rule. The comparison below still runs on it, and this text is what the message and JSON record, so a
+    # supplied value is never indistinguishable from a derived one.
+    rev_author_model="$AUTHOR_MODEL_ARG"; rev_author_model_source="supplied by the lander (--author-model)"
+  fi
+  if [ -z "$rev_author_model" ] && [ -n "$src_lane" ]; then
+    if [ -f "$HOME/.fleet/lanes/$src_lane.model" ]; then
+      rev_author_model=$(tr -d '[:space:]' < "$HOME/.fleet/lanes/$src_lane.model" 2>/dev/null || true)
+      rev_author_model_source="lane record $src_lane (${src_author_source:-unknown} author)"
     fi
   fi
   _fam=""
@@ -611,13 +662,13 @@ if [ -n "$rev_verdict" ] && [ -n "$rev_text" ]; then
       _fam="same"
     fi
   fi
-  if [ -n "$src_who" ] && [ "$rev_who" != "$src_who" ]; then
+  if [ -n "$src_author" ] && [ "$rev_who" != "$src_author" ]; then
     if [ "$_fam" = "same" ]; then
       rev_independence="same-family"
     else
       rev_independence="other-lane"
     fi
-  elif [ -n "$src_who" ]; then
+  elif [ -n "$src_author" ]; then
     if [ -z "$rev_reviewer_model" ]; then
       rev_independence="self-certified"
     elif [ -z "$rev_author_model" ]; then
@@ -639,11 +690,11 @@ if [ -n "$rev_verdict" ] && [ -n "$rev_text" ]; then
         ;;
       incomplete-provenance)
         rev_cleared=false
-        rev_block="independence: incomplete-provenance (reviewer model: $rev_reviewer_model; author model: not determinable - not named on the verdict, and no ~/.fleet/lanes lane record) — name the implementer's model on the verdict or record the lane's model, so the reviewer's family can be compared (fleet-ry7m)"
+        rev_block="independence: incomplete-provenance (reviewer model: $rev_reviewer_model; author model: not determinable for lane ${src_lane:-?} (${src_author_source:-no author lane}); not named on the verdict and no ~/.fleet/lanes lane record - supply it with --author-model <provider/id>, which the message records as supplied) — name the implementer's model on the verdict or record the lane's model, so the reviewer's family can be compared (fleet-ry7m)"
         ;;
       same-family)
         rev_cleared=false
-        rev_block="independence: same-family (reviewer model: $rev_reviewer_model; author model: $rev_author_model) — the fleet's rule is a different model family reviews every change, so this review cannot clear it (fleet-ry7m)"
+        rev_block="independence: same-family (reviewer model: $rev_reviewer_model; author model: $rev_author_model, from ${rev_author_model_source:-unknown}) — the fleet's rule is a different model family reviews every change, so this review cannot clear it (fleet-ry7m). If the author model above is the wrong object (a lane restarted or rotated since the work was authored), supply the authoring model with --author-model <provider/id> and the comparison runs on it; the value is recorded as supplied (agents-2tov)"
         ;;
     esac
   fi
@@ -931,7 +982,9 @@ if [ "$JSON" = 1 ]; then
     --arg rev_run_id "${rev_run_id:-}" \
     --arg cleared_sha "${cleared_label_sha:-}" \
     --arg rev_independence "${rev_independence:-unknown}" --arg rev_reviewer_model "${rev_reviewer_model:-}" \
-    --arg rev_author_model "${rev_author_model:-}" --arg branch_author "${src_who:-}" \
+    --arg rev_author_model "${rev_author_model:-}" --arg branch_author "${src_author:-$src_who}" \
+    --arg author_lane "${src_lane:-}" --arg author_source "${src_author_source:-}" \
+    --arg rev_author_model_source "${rev_author_model_source:-}" \
     --arg newer_not_used "${flm_newer_passed:-}" --arg disagreement "${rev_disagree:-}" --arg rev_named_branch "${rev_branch:-}" \
     --argjson rev_author_ignored "${rev_author_ignored:-0}" --arg rev_author_ignored_shas "${rev_author_ignored_shas:-}" \
     --arg gate_identity "${gate_identity:-}" \
@@ -941,7 +994,8 @@ if [ "$JSON" = 1 ]; then
       review:{state:$rev_state,verdict:$rev_verdict,reviewed_sha:$rev_sha,tip_sha:$rev_tip,
               unreviewed_commits:$rev_unreviewed,author:$rev_who,at:$rev_at,cleared:$rev_cleared,
               delta_identical:$rev_delta_identical,run_id:$rev_run_id,cleared_sha:$cleared_sha,
-              branch_author:$branch_author,independence:$rev_independence,
+              branch_author:$branch_author,author_lane:$author_lane,author_source:$author_source,
+              independence:$rev_independence,author_model_source:$rev_author_model_source,
               reviewer_model:$rev_reviewer_model,author_model:$rev_author_model,
               author_lane_verdicts_ignored:$rev_author_ignored,author_lane_verdict_shas:$rev_author_ignored_shas,
               newer_not_used:$newer_not_used,disagreement:$disagreement,named_branch:$rev_named_branch},
diff --git a/tests/fleet-land-message.test.sh b/tests/fleet-land-message.test.sh
index daaecb3..2c410bf 100755
--- a/tests/fleet-land-message.test.sh
+++ b/tests/fleet-land-message.test.sh
@@ -1293,6 +1293,76 @@ j_dis=$(run --print-json tk-1 fleet/delta1)
 has "$(jq -r '.review.disagreement' <<<"$j_dis")" "two verdicts on the SAME tip disagree" "35q ...and the disagreement is stated, not silently resolved"
 has "$out" "FAIL" "35r ...and the conservative verdict is the one reported"
 
+# 36. agents-2tov: the author of the branch comes from the BRANCH, not from whoever appended the operative
+# LAND-SUMMARY. THE LIVE CASE, reproduced on agents-jb8m: a coordinator appends a replacement block (the
+# author's bd writes were timing out), so the old derivation made COORD the author, read
+# ~/.fleet/lanes/coord.model, and refused a deepseek reviewer as 'same-family' - while the branch's own lane
+# record reads openai-codex/gpt-6-sol, i.e. genuinely cross-family. The branch here is fleet/thing2, whose lane
+# is 'thing2' by the fleet/ <lane>-<bead> convention.
+mkdir -p "$HOME/.fleet/lanes"
+printf 'openai-codex/gpt-6-sol\n' > "$HOME/.fleet/lanes/thing2.model"
+printf 'deepseek/deepseek-flash\n' > "$HOME/.fleet/lanes/coord.model"        # the appender's family: the trap
+cat > "$B" <<J
+[{"author":"test-vm-thing2","created_at":"2026-10-09T10:00:00Z","text":"Hand-off.\n\nLAND-SUMMARY\nWHAT: the other thing\nWHY: it was missing\nEFFECT: users notice"},
+ {"author":"test-vm-coord","created_at":"2026-10-09T10:30:00Z","text":"REPLACEMENT LAND-SUMMARY, APPENDED BY COORD AT THE AUTHOR'S REQUEST (their bd writes timed out).\n\nLAND-SUMMARY\nWHAT: the other thing\nWHY: it was missing\nEFFECT: users notice"},
+ {"author":"test-vm-rev-y","created_at":"2026-10-09T11:00:00Z","text":"VERDICT: PASS (reviewer deepseek/deepseek-flash)\nDelta: tk-2 main..$t2 branch fleet/thing2"}]
+J
+j=$(run --print-json tk-2 fleet/thing2)
+eq "$(jq -r '.review.author_lane' <<<"$j")" "thing2" "36a the author lane comes from the branch name"
+eq "$(jq -r '.review.author_source' <<<"$j")" "branch-name" "36b ...and says so, so a wrong derivation is visible"
+eq "$(jq -r '.review.branch_author' <<<"$j")" "test-vm-thing2" "36c the author is the branch's lane, not the appender"
+eq "$(jq -r '.review.author_model' <<<"$j")" "openai-codex/gpt-6-sol" "36d the AUTHOR lane's model, not the appender's"
+# 36e asserts the CLASS, not the finer label: the verdict here is posted by a DIFFERENT lane
+# (test-vm-rev-y), so the correct classification is other-lane ("independent by actor"); what matters is
+# that it is no longer refused as same-family, which is the false negative agents-jb8m hit.
+eq "$(jq -r '.review.independence' <<<"$j")" "other-lane" "36e a genuinely independent verdict is not refused as same-family"
+eq "$(jq -r '.review.cleared' <<<"$j")" "true" "36f ...and it clears"
+# 36g/36h: the same derivation must still REFUSE when the author lane's own family matches the reviewer, and
+# the refusal must name the source it used (the old text named the model with no provenance at all)
+printf 'deepseek/deepseek-flash\n' > "$HOME/.fleet/lanes/thing2.model"
+j=$(run --print-json tk-2 fleet/thing2)
+eq "$(jq -r '.review.independence' <<<"$j")" "same-family" "36g a same-family author lane still refuses"
+eq "$(jq -r '.review.cleared' <<<"$j")" "false" "36h ...and does not clear"
+has "$(run tk-2 fleet/thing2)" "from lane record thing2 (branch-name author)" "36i the refusal names where the author model came from"
+has "$(run tk-2 fleet/thing2)" "--author-model" "36i2 ...and names the remedy that supplies the missing operand"
+# 36j: the AUTHOR-LANE VERDICT FILTER asks the same question, so a verdict posted by the branch's own lane is
+# the one that is discounted - not one posted by whoever appended the summary
+printf 'openai-codex/gpt-6-sol\n' > "$HOME/.fleet/lanes/thing2.model"
+cat > "$B" <<J
+[{"author":"test-vm-coord","created_at":"2026-10-09T10:30:00Z","text":"REPLACEMENT LAND-SUMMARY.\n\nLAND-SUMMARY\nWHAT: the other thing\nWHY: it was missing\nEFFECT: users notice"},
+ {"author":"test-vm-thing2","created_at":"2026-10-09T11:00:00Z","text":"VERDICT: PASS (reviewer deepseek/deepseek-flash)\nDelta: tk-2 main..$t2 branch fleet/thing2"},
+ {"author":"test-vm-rev-y","created_at":"2026-10-09T11:10:00Z","text":"VERDICT: PASS (reviewer deepseek/deepseek-flash)\nDelta: tk-2 main..$t2 branch fleet/thing2"}]
+J
+j=$(run --print-json tk-2 fleet/thing2)
+eq "$(jq -r '.review.author_lane_verdicts_ignored' <<<"$j")" "1" "36j the branch lane's own verdict is the one discounted"
+# 36k: the TRANSCRIBED-subagent path, which is where the author model is the whole argument - the verdict is
+# posted by the branch's own lane, so there is no other-actor independence to lean on and the families must
+# genuinely differ. Before this fix the comparison used the appender's family and would have refused it.
+printf 'openai-codex/gpt-6-sol\n' > "$HOME/.fleet/lanes/thing2.model"
+cat > "$B" <<J
+[{"author":"test-vm-coord","created_at":"2026-10-09T10:30:00Z","text":"REPLACEMENT LAND-SUMMARY.\n\nLAND-SUMMARY\nWHAT: the other thing\nWHY: it was missing\nEFFECT: users notice"},
+ {"author":"test-vm-thing2","created_at":"2026-10-09T11:00:00Z","text":"VERDICT: PASS (reviewer deepseek/deepseek-flash vs implementer openai-codex/gpt-6-sol)\nDelta: tk-2 main..$t2 branch fleet/thing2"}]
+J
+j=$(run --print-json tk-2 fleet/thing2)
+eq "$(jq -r '.review.independence' <<<"$j")" "cross-family" "36k transcribed verdict with a named reviewer is cross-family"
+eq "$(jq -r '.review.cleared' <<<"$j")" "true" "36l ...and clears on the author lane's family, not the appender's"
+# 36m/36n: WHEN NO OBJECT SETTLES IT, the person with the evidence supplies the OPERAND rather than overriding
+# the rule (agents-2tov): the lane record here says deepseek (the appender's family, and the trap), the reviewer
+# is deepseek, and the lander knows the authoring model was gpt-6-sol. The comparison still runs, it clears, and
+# the value is recorded as SUPPLIED so it is never indistinguishable from a derived one.
+printf 'deepseek/deepseek-flash\n' > "$HOME/.fleet/lanes/thing2.model"
+cat > "$B" <<J
+[{"author":"test-vm-coord","created_at":"2026-10-09T10:30:00Z","text":"REPLACEMENT LAND-SUMMARY.\n\nLAND-SUMMARY\nWHAT: the other thing\nWHY: it was missing\nEFFECT: users notice"},
+ {"author":"test-vm-rev-y","created_at":"2026-10-09T11:00:00Z","text":"VERDICT: PASS (reviewer deepseek/deepseek-flash)\nDelta: tk-2 main..$t2 branch fleet/thing2"}]
+J
+j=$(run --print-json --author-model openai-codex/gpt-6-sol tk-2 fleet/thing2)
+eq "$(jq -r '.review.author_model' <<<"$j")" "openai-codex/gpt-6-sol" "36m a supplied authoring model is used"
+has "$(jq -r '.review.author_model_source' <<<"$j")" "supplied" "36n ...and is recorded as SUPPLIED, not derived"
+eq "$(jq -r '.review.cleared' <<<"$j")" "true" "36o ...and the comparison still runs and clears"
+j=$(run --print-json tk-2 fleet/thing2)
+eq "$(jq -r '.review.cleared' <<<"$j")" "false" "36p without the supplied operand the same tree still refuses"
+rm -f "$HOME/.fleet/lanes/thing2.model" "$HOME/.fleet/lanes/coord.model"
+
 if [ "$FAIL" -gt 0 ]; then
   echo "Failed tests ($FAIL):"
   for f in "${FAILED_TESTS[@]}"; do
-- 

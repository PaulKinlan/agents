--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -30,6 +30,9 @@
   case "$_a" in
     --fast) FAST=1 ;;
     --full) FORCE_FULL=1 ;;   # the explicit "yes, I mean the full gate" for a non-merger lane
+    --rerun) RERUN_ASKED=1; RERUN_REASON="" ;;   # agents-5q0w: a deliberate, recorded re-run of a FAILED tree
+    --rerun=*) RERUN_ASKED=1; RERUN_REASON="${_a#*=}" ;;
+    --rerun-authorised-by=*) RERUN_AUTHORISED_BY="${_a#*=}" ;;   # the exception coord reserves
     *) _args+=("$_a") ;;
   esac
 done
@@ -256,8 +259,43 @@
 fi
 
 exec 9>"$C/$tree.lock"; flock 9
+# agents-5q0w (coord ruling 2026-10-14): a re-run needs a reason; at most ONE without authorisation; a
+# disagreement is RED, not a vote. The prior verdict is never discarded - the fleet-0cxr rotation below
+# preserves it as <rec>.1 - so the failure is contextualised rather than replaced.
+if [ -n "${RERUN_ASKED:-}" ] && [ -z "${RERUN_REASON:-}" ]; then
+  echo "fleet-check: refusing --rerun without a reason: give one, e.g. --rerun=\"the broker test lost its socket race under shards\". A reasonless re-run IS the defect this path exists to prevent." >&2
+  exit 2
+fi
+if [ -n "${RERUN_REASON:-}" ]; then
+  # the count lives in the ROTATED history: a re-run records a fresh record that carries no .reruns.
+  prior_reruns=$(jq -r ".reruns // 0" "$rec" "$rec".[1-9] 2>/dev/null | sort -n | tail -1 || echo 0)
+  if [ "${prior_reruns:-0}" -ge 1 ] && [ -z "${RERUN_AUTHORISED_BY:-}" ]; then
+    echo "fleet-check: refusing a SECOND re-run of this tree: at most one is allowed without authorisation. Record the reason on the bead and ask the coordinator, then pass --rerun-authorised-by=<lane> - the authoriser is recorded." >&2
+    exit 2
+  fi
+  tree_red=0
+  if [ -f "${rec}.1" ] && [ "$(jq -r '.state // empty' "${rec}.1" 2>/dev/null)" = "FAIL" ] && [ -n "$(jq -r '.rerun_reason // empty' "${rec}.1" 2>/dev/null)" ]; then tree_red=1; fi
+  case $(state) in
+    FAIL) : ;;
+    PASS) if [ "$tree_red" = 1 ]; then
+            if [ -z "${RERUN_AUTHORISED_BY:-}" ]; then
+              echo "fleet-check: refusing --rerun: this tree is RED - the attempts disagree (a PASS that is the result of a re-run after a recorded FAIL), and only the coordinator may authorise a further attempt. Record the reason on the bead, then pass --rerun-authorised-by=<lane>; the authoriser is recorded." >&2
+              exit 2
+            fi
+            echo "fleet-check: re-running a RED tree at $lane's request (reason: $RERUN_REASON), authorised by $RERUN_AUTHORISED_BY - a further attempt, which is the coordinator's exception."
+          else
+            echo "fleet-check: refusing --rerun: this tree has a cached PASS, and re-running a passing tree spends the single heavy slot to learn nothing." >&2
+            exit 2
+          fi ;;
+  esac
+  # ONE attribution write for both paths, in the tool's own in-place idiom and WITHOUT a 2>/dev/null that
+  # could hide its own failure. It lands before the rotation, so it survives into <rec>.1.
+  jq --arg r "$RERUN_REASON" --arg b "$lane" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg ab "${RERUN_AUTHORISED_BY:-}" \
+    '.rerun_reason = $r | .rerun_by = $b | .rerun_at = $t | .reruns = ((.reruns // 0) + 1) | if $ab != "" then .rerun_authorised_by = $ab else . end' "$rec" > "$rec.tmp" && mv "$rec.tmp" "$rec"
+  echo "fleet-check: re-running the gate for this tree at $lane's request (reason: $RERUN_REASON)${RERUN_AUTHORISED_BY:+ authorised by $RERUN_AUTHORISED_BY}. The prior verdict and this attribution are preserved at ${rec}.1, not replaced."
+fi
 case $(state) in
-  PASS) if [ "$(jq -r .cmd "$rec")" = "$CHECK_CMD" ]; then
+  PASS) if [ -z "${RERUN_REASON:-}" ] && [ "$(jq -r .cmd "$rec")" = "$CHECK_CMD" ]; then
           # fleet-8pqa: a cached PASS is a verdict for the TREE it was produced against, so ask the artifact
           # before serving it (see record_identity). On a mismatch the gate runs instead of being skipped.
           record_identity "$rec" "$tree" "$GATE_KIND"
@@ -297,17 +335,35 @@
           # record with no count prints UNRECORDED, and the count says 'recorded' because it counts what the
           # record was able to write, not every re-serve that ever happened.
           jq --arg l "$lane" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.reserves = ((.reserves // 0) + 1) | .reserved_by = ((.reserved_by // {}) | .[$l] = ((.[$l] // 0) + 1)) | .reserved_last = {lane:$l, at:$t}' "$rec" > "$rec.tmp" && mv "$rec.tmp" "$rec"
+          # agents-5q0w: name the attempt, and never present a re-run as a first-class pass. N is DERIVED from the
+          # retention the rotation already gives (1 + the rotated siblings that exist), so no new field is needed, and
+          # the attribution is read from <rec>.1 where it was written before the rotation.
+          attempt_n=$(( 1 + $(ls "$rec".[1-9] 2>/dev/null | wc -l) ))
+          rerun_note=""
+          if [ -f "${rec}.1" ]; then
+            rerun_note=$(jq -r 'if (.rerun_reason // "") != "" then " - re-run by \(.rerun_by) at \(.rerun_at) (reason: \(.rerun_reason))" + (if (.rerun_authorised_by // "") != "" then ", authorised by \(.rerun_authorised_by)" else "" end) else "" end' "${rec}.1" 2>/dev/null || echo "")
+          fi
+          if [ "$attempt_n" -gt 1 ]; then echo "fleet-check: attempt $attempt_n on this tree${rerun_note}"; fi
+          # coord's ruling: a disagreement is not a vote. If this PASS is the result of a re-run after a recorded
+          # FAIL, the tree is RED and the change stays unlanded - the failure is contextualised, never replaced.
+          if [ -f "${rec}.1" ] && [ "$(jq -r '.state // empty' "${rec}.1" 2>/dev/null)" = "FAIL" ] && [ -n "$(jq -r '.rerun_reason // empty' "${rec}.1" 2>/dev/null)" ]; then
+            echo "fleet-check: RED - the attempts on this tree DISAGREE: attempt $attempt_n passed, but attempt $((attempt_n - 1)) recorded FAIL and was re-run rather than fixed${rerun_note}. A disagreement is not a vote, so this tree is not green and the change stays unlanded. A RE-RUN CAN NEVER MAKE A TREE GREEN BY ITSELF: the only path from RED is an explicit AUTHORISED decision recorded with the lane and a reason - pass --rerun-authorised-by=<lane> on a further attempt and record why on the bead." >&2
+            exit 1
+          fi
           jq -r --arg cov "$cov_info" '"fleet-check: PASS (cached) for tree of \(.sha): ran by \(.lane) at \(.at) in \(.secs)s.\($cov) Log: \(.log) Re-serves recorded: " + (if .reserves == null then "UNRECORDED (no reserve count in this record: it was written before reserve attribution, or the record could not be updated)" else "\(.reserves) time(s) by \((.reserved_by // {}) | to_entries | map("\(.key)=\(.value)") | join(", ")), last by \(.reserved_last.lane) at \(.reserved_last.at)" end)' "$rec"; exit 0
           fi
         else
           echo "fleet-check: cached PASS was for a different command; re-running gate"
         fi ;;
   FAIL) if [ "$(jq -r .cmd "$rec")" = "$CHECK_CMD" ]; then
+    if [ -n "${RERUN_REASON:-}" ]; then :; else
           # agents-dbit: recorded here too. A cached FAIL handed to a second lane is the same silent transfer of
           # one lane's evidence to another as a cached PASS.
           jq --arg l "$lane" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.reserves = ((.reserves // 0) + 1) | .reserved_by = ((.reserved_by // {}) | .[$l] = ((.[$l] // 0) + 1)) | .reserved_last = {lane:$l, at:$t}' "$rec" > "$rec.tmp" && mv "$rec.tmp" "$rec"
-          jq -r '"fleet-check: FAIL (cached, exit \(.rc)) for this exact tree: ran by \(.lane) at \(.at). Log: \(.log). Re-serves recorded: " + (if .reserves == null then "UNRECORDED (no reserve count in this record)" else "\(.reserves) time(s) by \((.reserved_by // {}) | to_entries | map("\(.key)=\(.value)") | join(", "))" end) + ". Re-running cannot change a deterministic failure: fix and commit. (Flaky? delete " + input_filename + " and re-run.)"' "$rec"; exit 1
-        fi ;;
+          if [ "$attempt_n" -gt 1 ]; then echo "fleet-check: attempt $attempt_n on this tree${rerun_note}"; fi
+          jq -r '"fleet-check: FAIL (cached, exit \(.rc)) for this exact tree: ran by \(.lane) at \(.at). Log: \(.log). Re-serves recorded: " + (if .reserves == null then "UNRECORDED (no reserve count in this record)" else "\(.reserves) time(s) by \((.reserved_by // {}) | to_entries | map("\(.key)=\(.value)") | join(", "))" end) + ". Fix and commit, or, if you are claiming this was transient, re-run it deliberately with --rerun=\"why\" - that runs the gate once more and records your reason, your lane, and the prior verdict preserved at <record>.1. A re-run is not free and cannot change a real regression, so it is yours to justify. (A cached PASS needs none: delete " + input_filename + " and re-run.)"' "$rec"; exit 1
+fi
+fi ;;
   RUNNING) if kill -0 "$(jq -r .pid "$rec")" 2>/dev/null; then
              jq --arg l "$lane" '.waiters += [$l] | .waiters |= unique' "$rec" > "$rec.tmp" && mv "$rec.tmp" "$rec"
              echo "fleet-check: already running for this tree (started by $(jq -r .lane "$rec")); you'll get a [check] message when it finishes. End your turn."; exit 0

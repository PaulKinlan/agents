diff --git a/tests/lane-workdir-signal.test.sh b/tests/lane-workdir-signal.test.sh
new file mode 100755
index 0000000..eb8b995
--- /dev/null
+++ b/tests/lane-workdir-signal.test.sh
@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+# tests/lane-workdir-signal.test.sh - agents-uq0q: a lane whose WORKDIR is the WRONG tree must be TOLD so.
+#
+# WHY THESE CASES: run-lane.sh exports FLEET_WORKDIR into the lane env and into its prompt, so a lane booting
+# on /tmp is told /tmp is its working directory and looks alive. The signal must fire on the two CERTAIN
+# cases (no repository at all; the canonical checkout, which a timer resets) and must stay SILENT on the
+# cases that merely look similar - that is the whole risk of this helper, because a false alarm on a healthy
+# lane teaches an operator to ignore the line.
+#
+# Self-contained: a fake HOME with throwaway git repositories. Run it directly:
+#   bash tests/lane-workdir-signal.test.sh
+set -uo pipefail
+HERE=$(cd "$(dirname "$0")/.." && pwd)
+SIG=${SIG_OVERRIDE:-$HERE/remote/lane-workdir-signal.sh}
+RUNLANE=${RUNLANE_OVERRIDE:-$HERE/remote/run-lane.sh}
+COMMON=${COMMON_OVERRIDE:-$HERE/roles/common.md}
+ROOT=$(mktemp -d); trap 'rm -rf "$ROOT"' EXIT
+export HOME="$ROOT/home"; mkdir -p "$HOME"
+PASS=0; FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n      %s\n' "$1" "${2:-}"; }
+quiet_when() { # <description> <role> <workdir> <repo>
+  local out; out=$(bash "$SIG" "$2" "$3" "$4" 2>&1)
+  [ -z "$out" ] && ok "$1" || bad "$1" "expected silence, got: $out"
+}
+loud_when() { # <description> <role> <workdir> <repo> <expected substring>
+  local out; out=$(bash "$SIG" "$2" "$3" "$4" 2>&1)
+  case "$out" in *"$5"*) ok "$1" ;; *) bad "$1" "expected to find '$5' in: $out" ;; esac
+}
+
+git init -q --bare "$HOME/origin.git"
+repo="$HOME/proj"; mkdir -p "$repo"
+( cd "$repo" && git init -q && echo x > README && git add README \
+  && git -c user.name=t -c user.email=t@t commit -qm init && git branch -M main \
+  && git remote add origin "$HOME/origin.git" && git push -q origin main && git fetch -q origin )
+worktree="$HOME/worktrees/proj-imp-x"
+git -C "$repo" worktree add -q -b fleet/imp-x "$worktree" refs/remotes/origin/main
+clone="$HOME/clones/proj-copy"; mkdir -p "$(dirname "$clone")"; git clone -q "$HOME/origin.git" "$clone"
+bogus="$HOME/tmp"; mkdir -p "$bogus"          # the /tmp case: a directory that is not a repository at all
+
+echo "1. the signal fires on the two certain cases, and only those"
+loud_when "1a a workdir with no git repository at all is reported" \
+  implementer "$bogus" "$repo" "holds no git repository at all"
+loud_when "1b and it says the tree is the WRONG one" \
+  implementer "$bogus" "$repo" "WRONG TREE"
+loud_when "1c and it names the lane action, boot-blocked" \
+  implementer "$bogus" "$repo" "report boot-blocked"
+loud_when "1d the canonical checkout is reported separately" \
+  reviewer "$repo" "$repo" "IS the canonical checkout"
+loud_when "1e and its reason is the timer that resets it" \
+  reviewer "$repo" "$repo" "every 5 minutes"
+loud_when "1f it fires for every worktree role" \
+  architect "$bogus" "$repo" "WRONG TREE"
+
+echo "2. the controls that make the line worth believing"
+quiet_when "2a a lane's own worktree is silent" implementer "$worktree" "$repo"
+quiet_when "2b a coords working directory outside ~/worktrees is silent (a real coord lane lives in ~/journal)" \
+  coord "$HOME/journal" "$repo"
+quiet_when "2c merge and hub roles are exempt too" merger "$repo" "$repo"
+quiet_when "2d an independent CLONE is silent, because retire keeps one on purpose" \
+  implementer "$clone" "$repo"
+quiet_when "2e a workdir that does not exist is silent (the report-side bead owns that state)" \
+  implementer "$HOME/worktrees/proj-gone" "$repo"
+# The note still fires - "this directory holds no repository" is a fact about the DIRECTORY, which needs no
+# repository argument at all - but it must NOT name a repository it never compared against. That was a real bug
+# this test caught: the first draft printed "...not this lane's worktree of $repo" with an empty or nonexistent
+# repo, asserting a comparison that never happened.
+for bad_repo in "$HOME/no-such-repo" ""; do
+  out=$(bash "$SIG" implementer "$bogus" "$bad_repo" 2>&1)
+  case "$out" in *"holds no git repository at all"*) ok "2f the note fires without a readable repo ($bad_repo)" ;;
+    *) bad "2f note missing for repo '$bad_repo'" "$out" ;; esac
+  case "$out" in *"worktree of "*|*" of ."*) bad "2g it does not name a repository it could not compare against" "$out" ;;
+    *) ok "2g no uncompared repository is named (repo '$bad_repo')" ;; esac
+done
+quiet_when "2h an empty workdir says nothing" implementer "" "$repo"
+
+echo "3. the wiring in run-lane.sh - the signal must reach the lane, not just a file nobody reads"
+grep -q 'FLEET_WORKDIR_NOTE' "$RUNLANE" && ok "3a run-lane.sh computes and exports FLEET_WORKDIR_NOTE" \
+  || bad "3a no FLEET_WORKDIR_NOTE in run-lane.sh"
+grep -q 'run-lane: WARNING:.*WORKDIR\|WARNING: \$WORKDIR_NOTE\|\$WORKDIR_NOTE.*WARNING' "$RUNLANE" \
+  && ok "3b the note is written as a WARNING into the lane log (the fleet-kf7u pattern)" \
+  || bad "3b the note is not logged as a WARNING"
+grep -q '\$FLEET_WORKDIR_NOTE' "$RUNLANE" && ok "3c and it is substituted into the prompt" \
+  || bad "3c FLEET_WORKDIR_NOTE is missing from the envsubst list"
+grep -q 'FLEET_WORKDIR_NOTE' "$COMMON" && ok "3d common.md renders the note where the workdir is announced" \
+  || bad "3d common.md does not render FLEET_WORKDIR_NOTE"
+
+echo
+printf '%s passed, %s failed\n' "$PASS" "$FAIL"
+[ "$FAIL" = 0 ]

+fi
+export FLEET_WORKDIR_NOTE="$WORKDIR_NOTE"
+cat "$HOME/fleet/roles/common.md" "$HOME/fleet/roles/$ROLE.md" | envsubst '$FLEET_MIN_PARALLEL $FLEET_MAX_LANES $FLEET_MODEL $FLEET_MODEL_POOL $FLEET_VM $FLEET_LANE $FLEET_ROLE $FLEET_WORKDIR $FLEET_WORKDIR_NOTE $FLEET_HUB $FLEET_PROJECT $FLEET_BEAD $FLEET_REPO $FLEET_DEFAULT_BRANCH' > "$PROMPT"
 
 cd "$HOME/journal"

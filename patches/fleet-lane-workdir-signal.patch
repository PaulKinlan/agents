+#!/usr/bin/env bash
+# lane-workdir-signal.sh <role> <workdir> <repo> -> one line, or nothing (fleet-uq0q)
+#
+# WHY (hub, 2026-10-14): lanes.sh spawn derives its worktree now, but a conf written before that validation can
+# hold any path - and run-lane.sh exports it as FLEET_WORKDIR into the lane's environment AND into the prompt, so
+# a lane booting on /tmp is TOLD that /tmp is its working directory and LOOKS ALIVE. That is the worse half of the
+# defect: the nightly's evidence is a lane that reported "boot blocked" (correct and useful) where a lane booting
+# on the wrong worktree would have committed into it.
+#
+# A SIGNAL, NEVER A REFUSAL: this prints text and always exits 0. The caller decides where it goes - the same
+# rule fleet-kf7u set for the ask-record warning, which went to the lane's own log because journald is not
+# where an operator looks.
+#
+# WHAT IT DELIBERATELY DOES NOT DO - it does not judge WORKDIR by a PATH SHAPE. A coord lane's working
+# directory is ~/journal on the hub and the canonical checkout on a project VM; neither is under ~/worktrees,
+# and both are legitimate. So only two facts are reported, and both are certain:
+#   1. WORKDIR holds no git repository at all (the /tmp case) - no lane's work lives there.
+#   2. WORKDIR IS the project's canonical checkout - which a timer resets every 5 minutes, so anything
+#      committed there can be destroyed.
+# An independent CLONE of the repository is deliberately NOT reported: lanes.sh retire keeps one on purpose
+# ("independent clone, not a linked worktree - kept"), so flagging it would be a false alarm.
+set -uo pipefail
+role=${1:-}; wd=${2:-}; repo=${3:-}
+
+# Only roles that ARE supposed to have a worktree. coord/hub/merger are exempt by design.
+case $role in implementer|reviewer|architect|designer|founder) ;; *) exit 0 ;; esac
+[ -n "$wd" ] && [ -d "$wd" ] || exit 0          # a MISSING directory is the report-side bead's state, not this one
+
+if [ ! -e "$wd/.git" ]; then
+  printf '%s\n' "WORKDIR $wd holds no git repository at all, so it is NOT a lane worktree for this project. If you edit here you are editing the WRONG TREE: do not commit, report boot-blocked to coord, and ask to be re-spawned (agents-uq0q)."
+  exit 0
+fi
+
+repo_real=$(cd "$repo" 2>/dev/null && pwd -P) || exit 0
+wd_real=$(cd "$wd" 2>/dev/null && pwd -P) || exit 0
+if [ -n "$repo_real" ] && [ "$wd_real" = "$repo_real" ]; then
+  printf '%s\n' "WORKDIR $wd IS the canonical checkout, not a lane worktree: a timer resets that checkout to origin/main every 5 minutes, so anything committed there can be destroyed. Cut your own worktree and commit there (agents-uq0q)."
+fi
+exit 0

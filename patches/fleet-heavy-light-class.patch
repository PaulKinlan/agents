diff --git a/bin/fleet-heavy b/bin/fleet-heavy
index d30e6fc..2ec4f94 100755
--- a/bin/fleet-heavy
+++ b/bin/fleet-heavy
@@ -11,6 +11,11 @@
 set -uo pipefail
 [ $# -gt 0 ] || { sed -n 2,10p "$0" | sed 's/^# \{0,1\}//'; exit 2; }
 slots=${FLEET_HEAVY_SLOTS:-1}; dir=${FLEET_HEAVY_DIR:-/tmp/fleet-heavy}; mkdir -p "$dir"
+# agents-v2t9: the LIGHT pool. A bounded-small job (a --fast check: measured 1.0 core and ~12s of
+# median work) does not need the exclusivity a 400-500s full gate needs, and on this 8-vCPU VM the
+# full gate leaves ~3.1 cores IDLE while it holds the slot. FLEET_HEAVY_LIGHT_SLOTS=0 keeps every job
+# on the old path, so this is opt-in per VM and a 2-CPU VM is unaffected.
+light_slots=${FLEET_HEAVY_LIGHT_SLOTS:-0}
 # flock is the AUTHORITY on whether a slot is held; slot<i>.who is only a human-readable label.
 # A killed job may leave the label behind, and a surviving descendant can hold the inherited fd
 # after its wrapper dies, so neither PID liveness nor the label decides anything:
@@ -28,6 +33,23 @@ prune_stale_labels() {
     [ -e "$dir/slot$i.who" ] || continue
     [ "$(slot_state "$i")" = free ] && rm -f "$dir/slot$i.who"
   done
+  # agents-v2t9: the light pool's labels need the same pruning, for the same reason - a killed job
+  # must not leave a label saying a slot is held when its flock is free. A light WAITER leaves a
+  # lightwait marker (see below) which is pruned by pid liveness: that is advisory only, because the
+  # flock remains the authority on the slots themselves.
+  local li lfd p
+  for f in "$dir"/lightwait.*; do
+    [ -e "$f" ] || continue
+    p=${f##*/lightwait.}
+    case "$p" in ''|*[!0-9]*) rm -f "$f"; continue;; esac
+    kill -0 "$p" 2>/dev/null || rm -f "$f"
+  done
+  for li in $(seq 1 "$light_slots"); do
+    [ -e "$dir/light$li.who" ] || continue
+    exec {lfd}>"$dir/light$li"
+    if flock -n "$lfd"; then flock -u "$lfd"; rm -f "$dir/light$li.who"; fi
+    exec {lfd}>&-
+  done 2>/dev/null
   # A waiter killed between creating its temp ticket and renaming it leaves litter that nothing
   # else cleans; the lock being free is proof its owner is gone.
   for f in "$dir"/.ticket.tmp.*; do
@@ -172,11 +194,56 @@ case "${1:-}" in
       case "$st" in free) echo "slot$i free";; *) echo "slot$i $st";; esac
     done
     echo "waiting: $(waiting_count)"
+    if [ "$light_slots" -gt 0 ]; then
+      for i in $(seq 1 "$light_slots"); do
+        exec {fd}>"$dir/light$i" 2>/dev/null || { echo "light$i held:unknown"; continue; }
+        if flock -n "$fd"; then flock -u "$fd"; echo "light$i free"
+        else echo "light$i held:$(cat "$dir/light$i.who" 2>/dev/null | head -1)"; fi
+        exec {fd}>&-
+      done
+      lw=0
+      for f in "$dir"/lightwait.*; do [ -e "$f" ] && lw=$((lw+1)); done
+      echo "light waiting: $lw"
+    fi
     exit 0;;
 esac
 # Re-entrant: a command already running inside a slot (fleet-gate -> a script that itself calls
 # fleet-heavy) runs directly instead of waiting for the slot its own parent holds (fleet-p4i deadlock).
 [ -n "${FLEET_HEAVY_HELD:-}" ] && exec "$@"
+# agents-v2t9: LIGHT class. A job that declares FLEET_HEAVY_LIGHT=1 (fleet-check does this for its
+# --fast gate, which is bounded by CHECK_FAST_TIMEOUT) contends for light1..lightN and NOT for the
+# main slot, so it neither waits for nor blocks a full gate. This is the whole point: across 724
+# fast-gate records the fleet spent 103026s waiting for a heavy slot to do 20219s of work (84% of
+# every iteration second), because a 12s, 1-core check was queued behind a 400-500s full gate.
+# Deliberate properties of the pool:
+#   * nice -n 19, so a co-running full gate (nice 10) keeps the cores it needs; the light job yields.
+#   * no arrival tickets: tickets exist so the merger's job cannot be overtaken by a later heavy job,
+#     which is about the MAIN slot. Taking one here would put a light job in the same priority class
+#     as a plain implementer's and delay that job's FIFO turn for as long as the light job runs, so
+#     this branch sits BEFORE ticket_take and takes no ticket at all.
+#   * a light job is NOT a preemption target: it does not hold the slot the merger needs, and its
+#     whole purpose is to keep running while a full gate does.
+if [ "${FLEET_HEAVY_LIGHT:-0}" = 1 ] && [ "${light_slots:-0}" -gt 0 ] 2>/dev/null; then
+  prune_stale_labels
+  waited=0
+  while :; do
+    for i in $(seq 1 "$light_slots"); do
+      exec {fd}>"$dir/light$i"
+      if flock -n "$fd"; then
+        rm -f "$dir/lightwait.$$"
+        echo "$$ ${FLEET_VM:-?}-${FLEET_LANE:-?} $(date -u +%T) $*" > "$dir/light$i.who"
+        FLEET_HEAVY_HELD=1 nice -n 19 "$@"; rc=$?
+        rm -f "$dir/light$i.who"; exec {fd}>&-; exit $rc
+      fi
+      exec {fd}>&-
+    done
+    [ $((waited % 60)) -eq 0 ] && echo "fleet-heavy: waiting for a light slot (busy: $(cat "$dir"/light*.who 2>/dev/null | cut -c1-80 | tr '\n' ';'))" >&2
+    # A light waiter holds no ticket, so `waiting: N` cannot see it: leave a marker, or --status
+    # reports an idle pool while a job is queued in it.
+    : > "$dir/lightwait.$$"
+    sleep 5; waited=$((waited+5))
+  done
+fi
 ticket_take
 [ "$myticket" -gt 0 ] || { echo "fleet-heavy: could not take a ticket (is $dir writable?)" >&2; exit 1; }
 waited=0
diff --git a/bin/fleet-check b/bin/fleet-check
index 45048df..913e21e 100755
--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -719,6 +719,11 @@ for attempt in 1 2 3 4 5 6; do   # re-queue after being preempted by the merger
   # \$cur_tree and \$(git ...) are escaped so they are evaluated INSIDE bash -c, in the worktree the command
   # would actually run in. git rev-parse HEAD^{tree} resolves against the same cwd the command gets, which is
   # the whole point: the comparison is between the tree that was queued and the tree the command would run.
+  # agents-v2t9: a --fast gate joins the LIGHT pool when the VM defines one, so it does not wait out
+  # a full gate it cannot disturb (measured: 1.0 core of the 3.1 the full gate leaves idle). It is
+  # bounded by CHECK_FAST_TIMEOUT, which is the property the pool requires. FLEET_HEAVY_LIGHT_SLOTS=0
+  # (the default) makes this a no-op and keeps every gate on the old single-slot path.
+  FLEET_HEAVY_LIGHT=$([ -n "$FAST" ] && echo 1 || echo 0) \
   fleet-heavy timeout --foreground -k 30 "$t" bash -c "echo \"=== fleet-check gate started \$(date -u +%T)\"; cur_tree=\$(git rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null || echo none); if [ \"\$cur_tree\" != \"$tree\" ]; then echo \"fleet-check: REFUSING to run - the worktree HEAD moved after this check was queued (queued tree $tree, current HEAD tree \$cur_tree). Running the command now would execute the suites of ANOTHER tree and cache the result under $tree, so nothing is run and nothing is cached (fleet-m9cr). Return to the queued tree, or queue a fresh check for the current one.\" >&2; exit 1; fi; $cmd" >> "$log" 2>&1 &
   job_pid=$!
   wait "$job_pid"
diff --git a/tests/fleet-heavy-light-class.test.sh b/tests/fleet-heavy-light-class.test.sh
new file mode 100755
index 0000000..43b3878
--- /dev/null
+++ b/tests/fleet-heavy-light-class.test.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+# tests/fleet-heavy-light-class.test.sh — agents-v2t9: a bounded-small job must not queue behind a
+# full gate.
+#
+# WHY (measured 2026-10-13 on agents-factory, 8 vCPU). Across the 724 fast-gate records that carry the
+# gate's own run_s/wait_s split, the fleet spent 20219s of suite work against 103026s of waiting: 84% of
+# every implementer iteration second was queue. 49% of iterations waited 0s, but the 41% that waited
+# >=60s did so behind a MEDIAN 11s of work, because one slot served both a 400-500s full gate and a 12s
+# fast check and the queue cannot tell them apart. The fast gate is not slow; it is QUEUED.
+#
+# THE PROPERTY THIS PINS, and the one it must not break. A job that declares itself light
+# (FLEET_HEAVY_LIGHT=1) contends for light1..lightN instead of the main slot, so it does not wait for a
+# full gate; and nothing about the main slot changes - it stays exclusive, FIFO, and the merger's
+# preemption is untouched. The pool is inert until FLEET_HEAVY_LIGHT_SLOTS is set, so a small VM keeps
+# today's behaviour by doing nothing: assertion 1 exists to fail if that ever stops being true.
+#
+# SELF-CONTAINED: no network, no part of the fleet suite, its own FLEET_HEAVY_DIR in a temp dir. The
+# held main slot is a flock THIS TEST owns (fd 9) rather than a `fleet-heavy sleep` child, so the hold
+# and the release are exact; killing a fleet-heavy wrapper would leave the flock held by its surviving
+# child - the leak fleet-heavy's own header describes - and the first version of this test failed for
+# that reason rather than because of the code under test.
+#
+# ORDERING CLAIM WORTH KNOWING WHEN READING: a light job takes NO arrival ticket. Taking one would put
+# it in the same priority class as a plain implementer's job and delay that job's FIFO turn for as long
+# as the light job runs, so the light branch sits before ticket_take, and assertion 3b pins it.
+set -uo pipefail
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+FH=${FLEET_HEAVY_OVERRIDE:-$HERE/bin/fleet-heavy}
+H=$(mktemp -d /tmp/fleet-v2t9.XXXXXX)
+STAGE=$(mktemp -d /tmp/fleet-v2t9-stage.XXXXXX)
+fails=0
+pass() { printf '  ok   %s\n' "$1"; }
+fail() { printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }
+cleanup() { kill -TERM -"${HOLDER:-0}" 2>/dev/null; rm -rf "$H" "$STAGE"; }
+trap cleanup EXIT
+status() { FLEET_HEAVY_DIR=$H "$@"; }
+
+# The fixture is a DEDICATED holder process in its own session, not this shell's fd. Two reasons, both
+# measured: (1) a flock fd opened by this shell is INHERITED by every child it spawns, so the test's own
+# subshells keep the slot held after it "releases" it - the reclaim path in fleet-heavy reported exactly
+# that ("descendants still held slot1 after the job finished") and killed them; (2) a dedicated process
+# can be released exactly, by signalling its process GROUP, instead of by killing a wrapper and leaving
+# its child holding the inherited fd.
+setsid bash -c "exec 9>\"$H/slot1\"; flock -n 9 || exit 9; echo \"\$\$ fleet-v2t9-fixture 00:00:00 main-slot-holder\" > \"$H/slot1.who\"; sleep 300" >/dev/null 2>&1 &
+HOLDER=$!
+held_fixture() { case "$(status "$FH" --status 2>/dev/null)" in *"main-slot-holder"*) return 0;; *) return 1;; esac; }
+light_held()    { case "$(status env FLEET_HEAVY_LIGHT_SLOTS=1 "$FH" --status 2>/dev/null)" in *"light1 held:"*) return 0;; *) return 1;; esac; }
+light_free()    { case "$(status env FLEET_HEAVY_LIGHT_SLOTS=1 "$FH" --status 2>/dev/null)" in *"light1 free"*) return 0;; *) return 1;; esac; }
+for _ in $(seq 1 20); do   # bounded: the holder must be IN before anything depends on it
+  held_fixture && break
+  sleep 0.5
+done
+held_fixture || { echo "SKIP: could not hold the fixture slot (nothing to test)"; exit 0; }
+
+echo "1. with no pool sized, a light job behaves exactly as before (the default is inert)"
+timeout -k 5 6 env FLEET_HEAVY_DIR=$H FLEET_HEAVY_LIGHT=1 $FH true
+[ $? -eq 124 ] && pass "FLEET_HEAVY_LIGHT_SLOTS unset: the light job queued" \
+               || fail "a light job did not queue, so the pool is not opt-in"
+
+echo "2. and a plain MAIN job still queues behind a held slot (exclusivity and FIFO preserved)"
+timeout -k 5 6 env FLEET_HEAVY_DIR=$H $FH true
+[ $? -eq 124 ] && pass "a main job still queues" || fail "the main slot is no longer exclusive"
+
+echo "3. with a pool sized, a light job runs NOW, beside the held slot"
+rm -f "$H"/tickets/*   # stale tickets from 1 and 2, so 3b can assert something exact
+t0=$(date +%s)
+timeout -k 5 8 env FLEET_HEAVY_DIR=$H FLEET_HEAVY_LIGHT_SLOTS=2 FLEET_HEAVY_LIGHT=1 \
+  $FH bash -c "cp $H/light*.who $STAGE/snap.who 2>/dev/null; ls $H/tickets/ > $STAGE/snap.tickets 2>/dev/null; true"
+rc=$?; t1=$(date +%s)
+[ "$rc" -eq 0 ] && [ $((t1-t0)) -le 2 ] && pass "the light job ran immediately (waited $((t1-t0))s) while the main slot was held" \
+               || fail "expected an immediate rc=0, got rc=$rc after $((t1-t0))s"
+# light1.who holds the JOB'S OWN COMMAND LINE, not the slot name: assert the file exists and is this
+# job, not that it contains the word "light1".
+[ -s "$STAGE/snap.who" ] && grep -q "snap.who" "$STAGE/snap.who" \
+  && pass "the job held a light slot (its own label was in light1.who)" \
+  || fail "no light1.who during the light job"
+grep -q "main-slot-holder" "$H/slot1.who" 2>/dev/null \
+  && pass "the light path did not touch the main slot's label" \
+  || fail "the light path overwrote slot1's label"
+[ -z "$(cat "$STAGE/snap.tickets" 2>/dev/null)" ] \
+  && pass "a light job takes NO main-slot arrival ticket (main-slot FIFO is untouched by it)" \
+  || fail "a light job left a ticket in the main queue: $(cat "$STAGE/snap.tickets" 2>/dev/null)"
+
+echo "4. the pool has a size, and a waiting light job is visible"
+env FLEET_HEAVY_DIR=$H FLEET_HEAVY_LIGHT_SLOTS=1 FLEET_HEAVY_LIGHT=1 $FH sleep 6 &
+for _ in $(seq 1 20); do   # bounded wait: the sleeper must BE in light1 before the cap is tested
+  light_held && break
+  sleep 0.5
+done
+light_held && pass "--status reports the light pool (asked with the pool size, as the main slots need too)" \
+           || fail "--status did not report light1"
+timeout -k 5 3 env FLEET_HEAVY_DIR=$H FLEET_HEAVY_LIGHT_SLOTS=1 FLEET_HEAVY_LIGHT=1 $FH true
+[ $? -eq 124 ] && pass "a second light job waited: the cap is real, not unlimited concurrency" \
+               || fail "the light pool let more jobs in than its size"
+[ -n "$(ls "$H"/lightwait.* 2>/dev/null)" ] \
+  && pass "a waiting light job leaves a lightwait marker (it holds no ticket, so 'waiting: N' cannot see it)" \
+  || fail "the light waiter is invisible to --status"
+for _ in $(seq 1 12); do   # let the light sleeper expire; no kill, so no orphan
+  light_free && break
+  sleep 1
+done
+
+echo "5. release the main slot: the main job runs, and the pool did not interfere"
+kill -TERM -"$HOLDER" 2>/dev/null; wait "$HOLDER" 2>/dev/null   # the holder's own process group
+for _ in $(seq 1 20); do
+  case "$(status "$FH" --status 2>/dev/null)" in *"slot1 free"*) break;; esac
+  sleep 0.5
+done
+timeout -k 5 20 env FLEET_HEAVY_DIR=$H $FH true
+[ $? -eq 0 ] && pass "the main job runs once the slot frees" || fail "the main job did not run"
+
+echo "6. re-entrancy: an OUTER light job runs an INNER fleet-heavy, with pool size 1"
+# agents-ltpg, and it is the reason this assertion is written this way: the first version invoked $FH
+# only ONCE, inside bash -c, so no outer invocation ever held a light slot and re-entry was never
+# exercised - it printed "a nested call ran directly" and passed for a run with no nested call at all.
+# The shape that can actually fail is an outer fleet-heavy HOLDING light1 (pool size 1) whose job
+# invokes fleet-heavy again: the inner call can only succeed because the outer exports
+# FLEET_HEAVY_HELD, so with the re-entrancy guard missing it blocks on the slot its own parent holds
+# and this times out. Verified by mutation, not by reasoning - see the write-up.
+timeout -k 5 12 env FLEET_HEAVY_DIR=$H FLEET_HEAVY_LIGHT_SLOTS=1 FLEET_HEAVY_LIGHT=1 \
+  $FH bash -c "FLEET_HEAVY_DIR=$H $FH true"
+rc=$?
+[ "$rc" -eq 0 ] && pass "the outer light job ran, and its inner fleet-heavy call did not deadlock on the slot its parent holds" \
+                || fail "the nested call did not complete (rc=$rc): the light path holds a slot its own children queue on"
+
+echo
+printf 'fleet-heavy light class: %s passed, %s failed\n' "$((12-fails))" "$fails"
+[ "$fails" -eq 0 ]

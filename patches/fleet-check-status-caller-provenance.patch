From 43c1d94d86e31954bc565e53c25032f9cdb81d40 Mon Sep 17 00:00:00 2001
From: agents-factory-hubpatch <agents-factory-hubpatch@exe.xyz>
Date: Mon, 12 Oct 2026 22:34:56 +0000
Subject: [PATCH] feat(fleet-check): separate record provenance from caller
 context in --status

1. In bin/fleet-check, record cur_branch when starting the gate and persist
   it in the RUNNING record.
2. In bin/fleet-check --status, preserve the record's own .repo and .branch
   instead of overwriting them with the caller's worktree and branch.
3. Report caller's context distinctly as caller_repo and caller_branch when
   they differ from the record's own repo and branch.
4. Keep produced_in matching the producing repo for backward compatibility.
5. In tests/fleet-gate-check.test.sh, add section 26 asserting record
   provenance preservation and caller context separation across worktrees.
---
 bin/fleet-check                | 14 +++++++++-----
 tests/fleet-gate-check.test.sh | 31 +++++++++++++++++++++++++++++++
 2 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/bin/fleet-check b/bin/fleet-check
index 3052522..fceee38 100755
--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -168,10 +168,13 @@ if [ "${1:-}" = --status ]; then   # fleet-efk: resolve the GIVEN sha's tree, ne
           note:"the cached record is NOT a verdict for this tree, so nothing is reported as PASS for it: re-run the gate, or ask for the tree the record names"}'
       exit 0
     fi
-    # fleet-8pqa: keep the record's OWN claim about where it ran. `repo` is where the question was asked (the
-    # caller's checkout); `produced_in` is where the suite actually ran, which the old line silently overwrote.
+    # fleet-8pqa: keep the record's OWN claim about where it ran. The record's own repo/branch
+    # remain .repo and .branch; the caller's context is reported distinctly as caller_repo and caller_branch.
     jq -c --arg s "$target" --arg r "$top" --arg b "$branch" \
-      '. + {asked:$s} + (if $r != "" then (if (.repo // "") != "" and (.repo != $r) then {repo:$r,produced_in:.repo} else {repo:$r} end) else {} end) + (if $b != "" then {branch:$b} else {} end)' "$f"
+      '. + {asked:$s}
+         + (if (.repo // "") != "" then {produced_in:.repo} else (if $r != "" then {repo:$r,produced_in:$r} else {} end) end)
+         + (if $r != "" and (.repo // "") != "" and .repo != $r then {caller_repo:$r} else {} end)
+         + (if (.branch // "") != "" then (if $b != "" and .branch != $b then {caller_branch:$b} else {} end) else (if $b != "" then {branch:$b} else {} end) end)' "$f"
   else
     jq -nc --arg k "$([ -n "$FAST" ] && echo fast || echo full)" --arg t "$t" --arg s "$target" \
       --arg r "$top" --arg b "$branch" --arg unv "$tree_unverified" '
@@ -186,7 +189,7 @@ fi
 lane=${FLEET_LANE:?FLEET_LANE not set}
 [ -z "$(git status --porcelain --untracked-files=no 2>/dev/null)" ] || { echo "fleet-check: worktree has uncommitted changes; commit first (the verdict is cached per commit tree)" >&2; exit 2; }
 tree=$(git rev-parse 'HEAD^{tree}' 2>/dev/null) || { echo "fleet-check: not in a git worktree" >&2; exit 2; }
-sha=$(git rev-parse --short HEAD); top=$(git rev-parse --show-toplevel)
+sha=$(git rev-parse --short HEAD); top=$(git rev-parse --show-toplevel); cur_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
 rec="$C/$tree${FAST:+.fast}.json"
 FLEET_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
 cov_script="$FLEET_DIR/remote/check-coverage.py"
@@ -367,9 +370,10 @@ if [ -f "$log" ] || [ -f "$rec" ]; then
 fi
 
 jq -nc --arg t "$tree" --arg sha "$sha" --arg l "$lane" --arg c "$CHECK_CMD" --arg log "$log" --arg k "$([ -n "$FAST" ] && echo fast || echo full)" --arg top "$top" \
+  --arg b "$cur_branch" \
   --arg prev_log "$([ -f "$log.1" ] && echo "$log.1" || echo "")" \
   --arg prev_attempt "${prev_attempt_msg:-}" \
-  '{state:"RUNNING",kind:$k,tree:$t,sha:$sha,lane:$l,waiters:[$l],cmd:$c,log:$log,repo:$top,at:(now|todate)} + (if $prev_log != "" then {prev_log:$prev_log} else {} end) + (if $prev_attempt != "" then {prev_attempt:$prev_attempt} else {} end)' > "$rec"
+  '{state:"RUNNING",kind:$k,tree:$t,sha:$sha,lane:$l,waiters:[$l],cmd:$c,log:$log,repo:$top,at:(now|todate)} + (if $b != "" and $b != "HEAD" then {branch:$b} else {} end) + (if $prev_log != "" then {prev_log:$prev_log} else {} end) + (if $prev_attempt != "" then {prev_attempt:$prev_attempt} else {} end)' > "$rec"
 
 # Write worker script via heredoc to eliminate quoting hazards (fleet-5bzu)
 worker_script=$(mktemp "${rec%.json}.worker.XXXXXX.sh" 2>/dev/null || mktemp /tmp/fleet-check-worker.XXXXXX.sh)
diff --git a/tests/fleet-gate-check.test.sh b/tests/fleet-gate-check.test.sh
index b2de0be..83330e3 100755
--- a/tests/fleet-gate-check.test.sh
+++ b/tests/fleet-gate-check.test.sh
@@ -2682,6 +2682,37 @@ wait_check "$m9_rec2" 90
 [ "$(jq -r .state "$m9_rec2" 2>/dev/null)" = "PASS" ] && ok "25g and caches a PASS for it" || bad "25g and caches a PASS for it" "state=$(jq -r .state "$m9_rec2" 2>/dev/null)"
 rm -f "$M9_CMD"
 
+# 26. Record provenance and caller context separation
+echo "26. Record provenance and caller context separation"
+R26_A="$ROOT/r26-a"; mkdir -p "$R26_A"
+( cd "$R26_A" && git init -q . && git checkout -q -b fleet/lane-a \
+  && echo "a" > a.txt && git add a.txt \
+  && git -c user.email=a@a -c user.name=a commit -q -m "commit a" )
+r26_tree=$(git -C "$R26_A" rev-parse "HEAD^{tree}")
+r26_sha=$(git -C "$R26_A" rev-parse HEAD)
+plant "$HOME/.fleet/checks/$r26_tree.fast.json" \
+  "{\"state\":\"PASS\",\"kind\":\"fast\",\"tree\":\"$r26_tree\",\"sha\":\"$r26_sha\",\"lane\":\"lane-a\",\"repo\":\"$R26_A\",\"branch\":\"fleet/lane-a\",\"rc\":0,\"secs\":1}"
+
+# Query from a DIFFERENT worktree and branch
+R26_B="$ROOT/r26-b"; mkdir -p "$R26_B"
+( cd "$R26_B" && git init -q . && git checkout -q -b fleet/lane-b \
+  && git remote add origin "$R26_A" && git fetch -q origin \
+  && git reset -q --hard "$r26_sha" )
+st_r26_cross=$( cd "$R26_B" && check --fast --status "$r26_sha" )
+
+eq "$(jq -r '.repo' <<<"$st_r26_cross")" "$R26_A" "26a record repo is preserved from producing checkout (was overwritten by caller)"
+eq "$(jq -r '.branch' <<<"$st_r26_cross")" "fleet/lane-a" "26b record branch is preserved from producing checkout (was caller branch)"
+eq "$(jq -r '.caller_repo' <<<"$st_r26_cross")" "$R26_B" "26c caller worktree reported distinctly as caller_repo"
+eq "$(jq -r '.caller_branch' <<<"$st_r26_cross")" "fleet/lane-b" "26d caller branch reported distinctly as caller_branch"
+eq "$(jq -r '.produced_in' <<<"$st_r26_cross")" "$R26_A" "26e produced_in reports producing checkout"
+
+# Query from the SAME worktree and branch
+st_r26_same=$( cd "$R26_A" && check --fast --status "$r26_sha" )
+eq "$(jq -r '.repo' <<<"$st_r26_same")" "$R26_A" "26f same worktree query repo matches"
+eq "$(jq -r '.branch' <<<"$st_r26_same")" "fleet/lane-a" "26g same worktree query branch matches"
+eq "$(jq -r '.caller_repo // ""' <<<"$st_r26_same")" "" "26h caller_repo omitted when queried from producing worktree"
+eq "$(jq -r '.caller_branch // ""' <<<"$st_r26_same")" "" "26i caller_branch omitted when queried from producing branch"
+
 printf '%s passed, %s failed\n' "$PASS" "$FAIL"
 cleanup_nested_gates
 # fleet-opl3 (coord: "we get the intermittent non-run as a FILE rather than as a description"): A RED RUN
-- 
2.43.0


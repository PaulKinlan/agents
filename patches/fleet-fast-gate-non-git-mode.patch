+++ b/tests/fast-gate-nongit.test.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# tests/fast-gate-nongit.test.sh — a plain checkout must RUN its in-scope suites (agents-i4u9).
+#
+# THE DEFECT, measured: remote/fast-gate.sh refused a tree that is not a git work tree, and the fleet repo is
+# deployed as plain files on project VMs - so the hub's own 67 suites were all in scope and none could run
+# there, which is how one red suite (pick-model-crossfamily) sat unobserved. Coord's rule: a test in scope
+# either RUNS or is NAMED as skipped-with-a-reason; silence is not either.
+#
+# DRIVEN, not hoped for: the fixture is a temp tree with two dummy suites that write markers, so "it ran" is a
+# fact on disk, and the reason must appear in the output.
+set -uo pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+GATE=${FLEET_FAST_GATE_BIN:-$HERE/remote/fast-gate.sh}
+PASS=0; FAIL=0
+N=0
+ok()  { N=$((N+1)); PASS=$((PASS+1)); printf 'ok %d - %s\n' "$N" "$1"; }
+bad() { N=$((N+1)); FAIL=$((FAIL+1)); printf 'not ok %d - %s\n' "$N" "$1"; }
+T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
+mkdir -p "$T/tests"
+printf '#!/usr/bin/env bash\nprintf ran > "%s/one.ran"\n' "$T" > "$T/tests/one.test.sh"
+printf '#!/usr/bin/env bash\nprintf ran > "%s/two.ran"\n' "$T" > "$T/tests/two.test.sh"
+chmod +x "$T/tests/one.test.sh" "$T/tests/two.test.sh"
+[ -d "$T/.git" ] && { bad "0a fixture is not a plain checkout"; }
+
+out=$("$GATE" --tree "$T" 2>&1); rc=$?
+[ "$rc" = 0 ] && ok "1a a plain checkout is not a refusal" || bad "1a expected exit 0 from a plain checkout, got $rc" "$out"
+case "$out" in *"NOT a git work tree"*) ok "1b ... and the output NAMES why it ran everything";; *) bad "1b the reason must be stated, not implied" "$out";; esac
+if [ -f "$T/one.ran" ] && [ -f "$T/two.ran" ]; then ok "1c every in-scope suite actually RAN"; else bad "1c suites did not run" "$(ls -1 "$T")"; fi
+# the refusal is gone for the reason that mattered: with no delta the selection must not silently drop anything
+# --list writes BASENAMES to stdout (the banner goes to stderr), so count non-empty lines - measured, after
+# a first version grepped for 'test' and found nothing because a basename has no .test.sh in it.
+L=$(cd "$T" && "$GATE" --list 2>/dev/null | grep -c .)
+[ "${L:-0}" -ge 2 ] && ok "1d the selection offers the in-scope suites" || bad "1d expected two named suites, got ${L:-0}"
+[ "$FAIL" = 0 ] || echo "FAILED $FAIL"
+[ "$FAIL" = 0 ]

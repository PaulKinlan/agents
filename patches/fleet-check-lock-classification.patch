From e5cf70f88f2efa2974ce54fce9b11f7524317ec7 Mon Sep 17 00:00:00 2001
From: agents-factory-hubpatch <agents-factory-hubpatch@exe.xyz>
Date: Mon, 12 Oct 2026 13:11:34 +0000
Subject: [PATCH] fix(fleet-check): classify 0-byte locks into LOCKED-RUNNING,
 LOCKED-STALE, or COMPLETED

Classify gate status when 0-byte lock files exist:
- LOCKED-RUNNING: lock held by active process, report holding pid
- LOCKED-STALE: lock free (unheld), report mtime of dead run
- COMPLETED: verdict json exists, report verdict's own status
- NONE: neither json nor lock exists

Worker holds the lock on fd 9 for its entire lifetime.
Strictly isolate --fast to .fast.lock without falling back to full-gate .lock.
Require a held lock for LOCKED-RUNNING, avoiding PID collision false-positives.
Preserve produced_in provenance on running records and handle missing lock fallback for mtime.
Restore fleet-8pqa provenance comment on completed verdict path.

Deliver tests in tests/fleet-check-lock.test.sh, including status checks
during a real detached run.
---
 bin/fleet-check                |  56 +++++++++++++++-
 tests/fleet-check-lock.test.sh | 116 +++++++++++++++++++++++++++++++++
 2 files changed, 169 insertions(+), 3 deletions(-)
 create mode 100755 tests/fleet-check-lock.test.sh

diff --git a/bin/fleet-check b/bin/fleet-check
index 260c16e..cbb2585 100755
--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -131,7 +131,7 @@ if [ "${1:-}" = --status ]; then   # fleet-efk: resolve the GIVEN sha's tree, ne
       #  3. INSIDE a repo, no record, and the id is not a tree object here -- REFUSE. This is the
       #     defect: a commit sha from another repo, or a typo, was indistinguishable from a real
       #     cache miss, and every reader downstream treats NONE as 'never measured'.
-      if [ -f "$C/$target.json" ] || [ -f "$C/$target.fast.json" ]; then
+      if [ -f "$C/$target.json" ] || [ -f "$C/$target.fast.json" ] || [ -f "$C/$target.lock" ] || [ -f "$C/$target.fast.lock" ]; then
         t="$target"
       elif [ -z "$top" ]; then
         t="$target"
@@ -156,6 +156,8 @@ if [ "${1:-}" = --status ]; then   # fleet-efk: resolve the GIVEN sha's tree, ne
     fi
   }
   f="$C/$t${FAST:+.fast}.json"
+  lock_file="$C/$t${FAST:+.fast}.lock"
+
   if [ -f "$f" ]; then
     record_identity "$f" "$t" "$GATE_KIND"
     if [ -n "$rec_state" ]; then
@@ -168,11 +170,57 @@ if [ "${1:-}" = --status ]; then   # fleet-efk: resolve the GIVEN sha's tree, ne
           note:"the cached record is NOT a verdict for this tree, so nothing is reported as PASS for it: re-run the gate, or ask for the tree the record names"}'
       exit 0
     fi
+    # If the JSON record has state "RUNNING", verify whether it is actually running or dead:
+    curr_st=$(jq -r '.state // empty' "$f" 2>/dev/null || true)
+    if [ "$curr_st" = "RUNNING" ]; then
+      if [ -f "$lock_file" ] && ! flock -n "$lock_file" true 2>/dev/null; then
+        local_pid=$(jq -r '.pid // empty' "$f" 2>/dev/null || true)
+        holding_pid=$(lsof -t "$lock_file" 2>/dev/null | head -1)
+        [ -z "$holding_pid" ] && holding_pid=$(fuser "$lock_file" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | head -1)
+        holding_pid="${holding_pid:-$local_pid}"
+        jq -c --arg s "$target" --arg r "$top" --arg b "$branch" --arg p "${holding_pid:-}" \
+          '. + {state:"LOCKED-RUNNING",asked:$s} + (if $p != "" then {holding_pid:$p} else {} end) + (if $r != "" then (if (.repo // "") != "" and (.repo != $r) then {repo:$r,produced_in:.repo} else {repo:$r} end) else {} end) + (if $b != "" then {branch:$b} else {} end)' "$f"
+        exit 0
+      else
+        # Stale running record from a dead run (lock is free or missing):
+        stale_target="$f"
+        [ -f "$lock_file" ] && stale_target="$lock_file"
+        lock_mtime=$(date -r "$stale_target" --iso-8601=seconds 2>/dev/null || stat -c %y "$stale_target" 2>/dev/null || echo "unknown")
+        jq -c --arg s "$target" --arg r "$top" --arg b "$branch" --arg mt "$lock_mtime" \
+          '. + {state:"LOCKED-STALE",asked:$s,stale_at:$mt,error:("no verdict, stale lock from a dead run at " + $mt),note:("no verdict, stale lock from a dead run at " + $mt)} + (if $r != "" then (if (.repo // "") != "" and (.repo != $r) then {repo:$r,produced_in:.repo} else {repo:$r} end) else {} end) + (if $b != "" then {branch:$b} else {} end)' "$f"
+        exit 0
+      fi
+    fi
+    # COMPLETED verdict: a verdict json exists; the lock is irrelevant, and print the verdict's own status.
     # fleet-8pqa: keep the record's OWN claim about where it ran. `repo` is where the question was asked (the
     # caller's checkout); `produced_in` is where the suite actually ran, which the old line silently overwrote.
     jq -c --arg s "$target" --arg r "$top" --arg b "$branch" \
       '. + {asked:$s} + (if $r != "" then (if (.repo // "") != "" and (.repo != $r) then {repo:$r,produced_in:.repo} else {repo:$r} end) else {} end) + (if $b != "" then {branch:$b} else {} end)' "$f"
   else
+    # No verdict json: classify lock file presence and held/free state
+    if [ -f "$lock_file" ]; then
+      if ! flock -n "$lock_file" true 2>/dev/null; then
+        # Held: a gate really is in progress
+        holding_pid=$(lsof -t "$lock_file" 2>/dev/null | head -1)
+        [ -z "$holding_pid" ] && holding_pid=$(fuser "$lock_file" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | head -1)
+        jq -nc --arg k "$([ -n "$FAST" ] && echo fast || echo full)" --arg t "$t" --arg s "$target" \
+          --arg r "$top" --arg b "$branch" --arg l "$lock_file" --arg p "${holding_pid:-}" '
+          {state:"LOCKED-RUNNING",kind:$k,tree:$t,asked:$s,repo:$r,branch:$b,lock:$l}
+          + (if $p != "" then {holding_pid:$p,pid:$p} else {} end)
+          + {note:("gate in progress (lock held" + (if $p != "" then " by pid " + $p else "" end) + ")")}'
+        exit 0
+      else
+        # Free: no verdict, stale lock from a dead run at <mtime>
+        lock_mtime=$(date -r "$lock_file" --iso-8601=seconds 2>/dev/null || stat -c %y "$lock_file" 2>/dev/null || echo "unknown")
+        jq -nc --arg k "$([ -n "$FAST" ] && echo fast || echo full)" --arg t "$t" --arg s "$target" \
+          --arg r "$top" --arg b "$branch" --arg l "$lock_file" --arg mt "$lock_mtime" '
+          {state:"LOCKED-STALE",kind:$k,tree:$t,asked:$s,repo:$r,branch:$b,lock:$l,mtime:$mt,
+           error:("no verdict, stale lock from a dead run at " + $mt),
+           note:("no verdict, stale lock from a dead run at " + $mt)}'
+        exit 0
+      fi
+    fi
+    # No json and no lock: genuine absence
     jq -nc --arg k "$([ -n "$FAST" ] && echo fast || echo full)" --arg t "$t" --arg s "$target" \
       --arg r "$top" --arg b "$branch" --arg unv "$tree_unverified" '
       {state:"NONE",kind:$k,tree:$t,asked:$s,repo:$r,branch:$b}
@@ -247,7 +295,7 @@ if [ "${1:-}" = --stop ]; then
   rm -f "$rec" "${rec%.json}.worker."*.sh; echo "fleet-check: stopped${pid:+ (process group $pid)}; no verdict recorded"; exit 0
 fi
 
-exec 9>"$C/$tree.lock"; flock 9
+exec 9>"${rec%.json}.lock"; flock 9
 case $(state) in
   PASS) if [ "$(jq -r .cmd "$rec")" = "$CHECK_CMD" ]; then
           # fleet-8pqa: a cached PASS is a verdict for the TREE it was produced against, so ask the artifact
@@ -352,9 +400,11 @@ jq -nc --arg t "$tree" --arg sha "$sha" --arg l "$lane" --arg c "$CHECK_CMD" --a
 worker_script=$(mktemp "${rec%.json}.worker.XXXXXX.sh" 2>/dev/null || mktemp /tmp/fleet-check-worker.XXXXXX.sh)
 cat << 'WORKER_EOF' > "$worker_script"
 #!/usr/bin/env bash
-exec 9>&- 2>/dev/null || true
 rec=$1; log=$2; dir=$3; t=$4; cmd=$5; tree=$6; sha=$7; fast=$8; cov_script=$9; self=${10:-$0}
 trap 'rm -f "$self" 2>/dev/null || true' EXIT
+# Hold lock for worker's lifetime
+exec 9>"${rec%.json}.lock"
+flock 9
 start=$(date +%s)
 worker_run_id="run-$$-${self##*/}"
 set -m
diff --git a/tests/fleet-check-lock.test.sh b/tests/fleet-check-lock.test.sh
new file mode 100755
index 0000000..6ebd31a
--- /dev/null
+++ b/tests/fleet-check-lock.test.sh
@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+# Test classification of 0-byte locks and running checks in fleet-check --status
+#
+# States:
+#   - COMPLETED: a verdict json exists; lock is irrelevant, verdict's own status is reported
+#   - LOCKED-RUNNING: held - a gate really is in progress. Reported as LOCKED-RUNNING with holding pid
+#   - LOCKED-STALE: free - no verdict, stale lock from a dead run at <mtime>. Reported as LOCKED-STALE with mtime
+#   - NONE: neither verdict nor lock exists.
+set -uo pipefail
+
+FC=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/fleet-check
+fails=0
+pass() { printf '  ok   %s\n' "$1"; }
+fail() { printf '  FAIL %s (%s)\n' "$1" "${2:-}"; fails=$((fails+1)); }
+has()  { [[ "$1" == *"$2"* ]] && pass "$3" || fail "$3" "expected to contain '$2' in '$1'"; }
+hasnt(){ [[ "$1" != *"$2"* ]] && pass "$3" || fail "$3" "expected NOT to contain '$2' in '$1'"; }
+
+ROOT=$(mktemp -d)
+trap 'rm -rf "$ROOT"' EXIT
+mkdir -p "$ROOT/.fleet/checks" "$ROOT/repo" "$ROOT/fleet-heavy"
+cd "$ROOT/repo"
+git init -q . && git config user.email t@t && git config user.name t
+echo "init" > file.txt && git add file.txt && git commit -qm "init"
+tree_sha=$(git rev-parse 'HEAD^{tree}')
+commit_sha=$(git rev-parse --short HEAD)
+
+C="$ROOT/.fleet/checks"
+export HOME="$ROOT" FLEET_LANE=test-lane FLEET_HEAVY_DIR="$ROOT/fleet-heavy"
+
+# 1. NONE: Neither verdict nor lock exists
+st_none=$(bash "$FC" --status HEAD 2>&1)
+has "$st_none" '"state":"NONE"' "1a status reports NONE when no verdict or lock exists"
+
+# 2. LOCKED-STALE: 0-byte lock file exists and is free (not held)
+touch "$C/$tree_sha.lock"
+st_stale=$(bash "$FC" --status HEAD 2>&1)
+has "$st_stale" '"state":"LOCKED-STALE"' "2a 0-byte free lock reports LOCKED-STALE"
+hasnt "$st_stale" '"state":"NONE"' "2b 0-byte free lock does NOT report NONE"
+has "$st_stale" "$tree_sha.lock" "2c status reports the lock file path"
+has "$st_stale" '"mtime":' "2d status reports lock mtime"
+has "$st_stale" "stale lock from a dead run" "2e status explains stale lock"
+
+# 3. LOCKED-RUNNING: Lock file is held by an active process
+# Hold lock in a background subshell
+(
+  exec 9>"$C/$tree_sha.lock"
+  flock 9
+  sleep 4
+) &
+hold_pid=$!
+sleep 0.2
+
+st_running=$(bash "$FC" --status HEAD 2>&1)
+has "$st_running" '"state":"LOCKED-RUNNING"' "3a held lock reports LOCKED-RUNNING"
+hasnt "$st_running" '"state":"NONE"' "3b held lock does NOT report NONE"
+has "$st_running" '"holding_pid":' "3c status reports holding pid"
+has "$st_running" "$hold_pid" "3d status reports the actual holding pid"
+has "$st_running" "gate in progress (lock held" "3e status explains gate in progress"
+
+wait "$hold_pid" 2>/dev/null || true
+
+# 4. COMPLETED: Verdict json exists; lock is irrelevant
+printf '{"state":"PASS","kind":"full","tree":"%s","sha":"%s","lane":"test-merger","at":"2026-10-12T12:00:00Z","secs":42,"log":"/tmp/test.log"}' "$tree_sha" "$commit_sha" > "$C/$tree_sha.json"
+st_completed=$(bash "$FC" --status HEAD 2>&1)
+has "$st_completed" '"state":"PASS"' "4a completed verdict reports verdict state PASS"
+hasnt "$st_completed" '"state":"LOCKED-STALE"' "4b completed verdict does not report LOCKED-STALE"
+hasnt "$st_completed" '"state":"NONE"' "4c completed verdict does not report NONE"
+rm -f "$C/$tree_sha.json"
+
+# 5. FAST gate lock isolation
+# Fast gate uses .fast.lock and must never report full gate lock
+touch "$C/$tree_sha.lock"
+st_fast_none=$(bash "$FC" --status --fast HEAD 2>&1)
+has "$st_fast_none" '"state":"NONE"' "5a --status --fast ignores full gate .lock (reports NONE)"
+hasnt "$st_fast_none" '"state":"LOCKED-STALE"' "5b --status --fast does not report full gate lock as stale"
+rm -f "$C/$tree_sha.lock"
+
+touch "$C/$tree_sha.fast.lock"
+st_fast_stale=$(bash "$FC" --status --fast HEAD 2>&1)
+has "$st_fast_stale" '"state":"LOCKED-STALE"' "5c --status --fast detects .fast.lock as LOCKED-STALE"
+has "$st_fast_stale" '"kind":"fast"' "5d --status --fast reports kind fast"
+rm -f "$C/$tree_sha.fast.lock"
+
+# 6. JSON with state RUNNING but lock is free (even if pid happens to be alive, lock must be held)
+# Current shell $$ is alive, but lock is not held -> must report LOCKED-STALE, never LOCKED-RUNNING
+printf '{"state":"RUNNING","kind":"full","tree":"%s","sha":"%s","lane":"test-lane","pid":%d,"at":"2026-10-12T10:00:00Z"}' "$tree_sha" "$commit_sha" "$$" > "$C/$tree_sha.json"
+st_dead_running=$(bash "$FC" --status HEAD 2>&1)
+has "$st_dead_running" '"state":"LOCKED-STALE"' "6a live pid without held lock reports LOCKED-STALE"
+hasnt "$st_dead_running" '"state":"LOCKED-RUNNING"' "6b live pid without held lock does NOT report LOCKED-RUNNING"
+has "$st_dead_running" "stale lock from a dead run" "6c live pid without held lock explains stale run"
+rm -f "$C/$tree_sha.json"
+
+# 7. Real detached run holds lock throughout execution and reports LOCKED-RUNNING
+echo 'CHECK_FAST_CMD="sleep 1; echo ran_test_fast"; CHECK_FAST_TIMEOUT=30' > "$ROOT/.fleet/check.conf"
+bash "$FC" --fast >/dev/null 2>&1
+# Immediately check status while worker is running
+st_live=$(bash "$FC" --status --fast HEAD 2>&1)
+has "$st_live" '"state":"LOCKED-RUNNING"' "7a status during real detached run reports LOCKED-RUNNING"
+has "$st_live" '"holding_pid":' "7b status during real detached run reports holding pid"
+
+# Wait for worker to finish
+for i in $(seq 1 40); do
+  [ -f "$C/$tree_sha.fast.json" ] && [ "$(jq -r .state "$C/$tree_sha.fast.json" 2>/dev/null)" = "PASS" ] && break
+  sleep 0.2
+done
+st_after=$(bash "$FC" --status --fast HEAD 2>&1)
+has "$st_after" '"state":"PASS"' "7c status after real detached run completes reports PASS"
+
+
+if [ "$fails" -eq 0 ]; then
+  echo "All lock classification tests passed."
+  exit 0
+else
+  echo "$fails test(s) failed."
+  exit 1
+fi
-- 

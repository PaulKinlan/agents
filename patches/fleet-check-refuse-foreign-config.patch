diff --git a/bin/fleet-check b/bin/fleet-check
index 6c72b58..9271af3 100755
--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -211,6 +211,120 @@ if [ -z "$CHECK_CMD" ]; then
     CHECK_CMD="npm test"; jq -e '.scripts.build' "$top/package.json" >/dev/null 2>&1 && CHECK_CMD="npm run build && npm test"
   else echo "fleet-check: no CHECK_CMD in ~/.fleet/check.conf and nothing to auto-detect; ask coord to set it" >&2; exit 2; fi
 fi
+# ---------------------------------------------------------------------------
+# agents-0r1c: REFUSE A GATE COMMAND THAT CANNOT RUN IN THE REPO BEING GATED.
+#
+# ORDERING WARNING - READ BEFORE APPLYING. This patch is the shared-reader half of agents-0r1c and
+# it is LOAD-BEARING, but DO NOT APPLY IT until the host's ~/.fleet/check.conf has been repaired.
+# On any host whose machine-global config was written by an --install from ONE repo, that file names
+# paths that exist only in that repo, and this guard refuses exactly such a command: applied first,
+# it turns every gate on that host into a refusal. Repair the host file first (give each repo its own
+# repo-local config and point its gate at it with FLEET_CHECK_CONF, or re-install the host-wide file
+# from the repo that is actually meant to own the host's gate), then apply this. The refusal is
+# deliberate and is what makes the next install loud rather than silent - the point is to stop the
+# config being WRITTEN silently, and by then the wrong file must not already be in service.
+#
+# WHY THIS EXISTS. agents-0utp fixed the WRITER (a bare --install no longer rewrites the
+# machine-global file) and agents-p8lh made the repairs it prints truthful, but a config ALREADY
+# installed by another repo keeps being read - and this file is the reader that reads it. The live
+# ~/.fleet/check.conf carries `bash tools/fast-gate.sh` and a suite command needing tools/ and
+# tests/, which exist only in the repo that installed it, so a gate in any other repo died with
+# EXIT 127: a message about a MISSING TOOL when the truth is a FOREIGN CONFIG.
+#
+# THE RULE IS "A PATH THE COMMAND MUST READ OR EXECUTE CANNOT EXIST HERE", NOT "SOME TOKEN LOOKS LIKE
+# A PATH". The first attempt at this guard extracted path-shaped tokens and checked them all, and
+# agents-0r1c review broke it in BOTH directions on the same day: it MISSED `bash ./tools/fast-gate.sh`
+# (a ./ prefix is the same missing file spelled differently) and it REFUSED `bash tools/fast-gate.sh >
+# logs/result.log` (a redirection target is a file the command CREATES, not one it must read). A rule
+# whose two errors are "misses a real case" and "blocks a real case" has not decided what it protects.
+# So the candidate set is now small and defensible, and it is exactly what EXIT 127 means:
+#   1. the COMMAND WORD - with a slash it is a path that must exist, without one it must resolve on
+#      PATH (a missing `bash` is as unrunnable as a missing script);
+#   2. the SCRIPT ARGUMENT of an interpreter (`bash tools/x.sh`, `python3 tools/x.py`) - skipping
+#      flags, and stopping at -c/--command (the argument is CODE) and at -m (a MODULE);
+#   3. the values of -s and -t, but ONLY when the command line mentions unittest/discover, because
+#      those are that tool's INPUT directories (`sort -t ,` must not be read as a path);
+#   4. the target of a READ redirection (<), which must exist.
+# Everything else is ignored BY CONSTRUCTION: output redirections, plain arguments, flags. And `./` is
+# stripped before every existence check, so an explicit prefix cannot buy a missing file a pass.
+#
+# THE STAMP IS ATTRIBUTION, NOT THE TRIGGER. "Cannot exist here" is the test, never "came from
+# elsewhere": a config whose named paths all resolve is read normally even when its '# Project:' stamp
+# names another directory, because a worktree of the same project is exactly that - refusing on
+# identity alone would turn every worktree gate red for an innocent branch. An unstamped config is
+# refused without inventing a culprit.
+_fc_command_paths() {   # stdin: a command string; stdout: P<TAB>path (must exist) or C<TAB>word (PATH)
+  awk '
+    function unquote(w) { gsub(/^["\047]+/, "", w); gsub(/["\047]+$/, "", w); return w }
+    function stripdot(p) { while (p ~ /^\.\//) sub(/^\.\//, "", p); return p }
+    {
+      n = split($0, raw, /[ \t]+/); m = 0; skip = 0; read = 0
+      for (i = 1; i <= n; i++) {
+        if (raw[i] == "") continue
+        t = unquote(raw[i])
+        if (t == "") continue
+        if (t ~ /^[0-9]?>>?[^&>]/ || t == ">" || t == ">>" || t == "1>" || t == "2>" || t == "2>>" || t == ">&" || t ~ /^[0-9]?>>?&/) { skip = 1; continue }
+        if (t == "<" || t == "<&") { read = 1; continue }
+        if (t ~ /^<<?/) { skip = 1; continue }
+        if (skip) { skip = 0; continue }
+        if (read) { read = 0; print "P\t" stripdot(t); continue }
+        m++; word[m] = t
+      }
+      if (m == 0) exit
+      j = 1
+      while (j <= m && word[j] ~ /^[A-Za-z_][A-Za-z0-9_]*=/) j++
+      while (j <= m) {
+        b = word[j]; sub(/.*\//, "", b)
+        if (b == "env" || b == "nohup" || b == "setsid" || b == "nice" || b == "ionice" || b == "stdbuf" || b == "xvfb-run") {
+          j++
+          while (j <= m && (word[j] ~ /^-/ || word[j] ~ /^[A-Za-z_][A-Za-z0-9_]*=/)) j++
+          continue
+        }
+        if (b == "timeout") { j++; while (j <= m && word[j] ~ /^-/) j++; j++; continue }
+        break
+      }
+      if (j > m) exit
+      cmd = word[j]; b = cmd; sub(/.*\//, "", b)
+      if (cmd ~ /\//) print "P\t" stripdot(cmd); else print "C\t" b
+      if (b == "bash" || b == "sh" || b == "dash" || b == "zsh" || b == "ksh" || b == "python" || b == "python3" || b == "ruby" || b == "perl" || b == "php" || b == "node" || b == "deno") {
+        k = j + 1; stop = 0
+        while (k <= m) {
+          if (word[k] == "-c" || word[k] == "--command" || word[k] == "-m" || word[k] == "-") { stop = 1; break }
+          if (word[k] ~ /^-/) { k++; continue }
+          break
+        }
+        if (!stop && k <= m) print "P\t" stripdot(word[k])
+      }
+      if ($0 ~ /unittest|discover/) for (i = j; i < m; i++) if (word[i] == "-s" || word[i] == "-t") print "P\t" stripdot(word[i + 1])
+    }'
+}
+if [ -n "${CHECK_CMD:-}" ] && [ -n "${top:-}" ] && [ -r "$CHECK_CONF" ]; then
+  _fc_missing=""
+  while IFS=$'\t' read -r _fc_kind _fc_val; do
+    [ -n "$_fc_val" ] || continue
+    case "$_fc_kind" in
+      C) command -v "$_fc_val" >/dev/null 2>&1 || _fc_missing="${_fc_missing}${_fc_missing:+, }$_fc_val (not on PATH)" ;;
+      P) [ "$_fc_val" = "." ] && continue
+         case "$_fc_val" in
+           /*) [ -e "$_fc_val" ]      || _fc_missing="${_fc_missing}${_fc_missing:+, }$_fc_val" ;;
+           *)  [ -e "$top/$_fc_val" ] || _fc_missing="${_fc_missing}${_fc_missing:+, }$_fc_val" ;;
+         esac ;;
+    esac
+  done < <(printf '%s\n' "$CHECK_CMD" | _fc_command_paths)
+  if [ -n "$_fc_missing" ]; then
+    _fc_kind_name="the gate"; [ -n "${FAST:-}" ] && _fc_kind_name="the fast gate"
+    _fc_who="$(grep -m1 -E '^# Project: ' "$CHECK_CONF" 2>/dev/null | sed -E 's/^# Project: //' || true)"
+    if [ -n "$_fc_who" ]; then _fc_attrib="was installed by $_fc_who and"; else _fc_attrib="carries no 'Project:' stamp and"; fi
+    {
+      echo "fleet-check: REFUSING $_fc_kind_name for $top: $CHECK_CONF $_fc_attrib names [$_fc_missing], which cannot be run here."
+      echo "fleet-check:   That command cannot run here - a missing program or script fails with EXIT 127, which reads as a missing tool when the truth is a config naming paths from another repo."
+      echo "fleet-check:   No verdict was recorded for this tree, so this refusal cannot be mistaken for a result."
+      echo "fleet-check:   repair: give THIS repo its own config and point the gate at it - run the installer in $top, then set FLEET_CHECK_CONF to the file it wrote; or, if this repo is meant to own the host-wide config, re-install it with --install --global from the repo that is meant to own it."
+    } >&2
+    exit 2
+  fi
+fi
+
 # ONLY THE MERGER RUNS THE FULL GATE (Paul, 2026-10-11: "the merger lanes being way too slow and way
 # too aggressive on the number of reviews and tests"). Measured the same day across the fleet: 915 of 1781

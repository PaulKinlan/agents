# patches/fleet-reviewer-family-scope.patch
# remote/lanes.sh: the cross-family spawn guard is REVIEWER-SPECIFIC BY CHOICE - a record, not a change (agents-dyxk).
# Base (MEASURED on this VM's deployed fleet copy; ADVISORY until the hub reconciles the deployment, agents-aieo):
#   remote/lanes.sh   40537 bytes sha256 7f0be21489db73e4d18821c58e6e669d22ec54f5192bc00bf158b5b9d422e4aa
# Apply from the fleet repo root: patch -p1 < patches/fleet-reviewer-family-scope.patch
--- a/remote/lanes.sh
+++ b/remote/lanes.sh
@@ -376,12 +376,21 @@
     # implementer's provider excluded so a rotation that cannot avoid it fails HERE, before any worktree is
     # cut. The choice itself is NOT pinned into MODEL - rotation, cooldown and failover semantics stay in
     # run-lane.sh - instead IMPL_MODEL is recorded in the conf so every later re-pick (run-lane restart,
     # lane-host failover) re-applies the same exclusion. When the implementer's model cannot be determined
     # the spawn proceeds UNGUARDED but says so - the verdict-time provenance check (fleet-ry7m) is the
     # backstop, so the gap is visible rather than silent either way.
+    # WHY THE FAMILY GUARD IS REVIEWER-SPECIFIC BY CHOICE (agents-dyxk): a reviewer's model family is what the
+    # CLEARANCE depends on, because its verdict is what gates landing, so the implementer's family must be
+    # excluded. An architect, designer or founder lane produces a DESIGN DECISION rather than a verdict on a
+    # diff, so its independence is not what the clearance rests on, and it is deliberately not family-checked.
+    # The role test below is the guard's ONLY enforcement point: the same-family refusal, the empty-model
+    # dry-run through pick-model that fails before any worktree is cut, and the unguarded-when-unknown notice
+    # are all inside it. The scope is PINNED ON PURPOSE - tests/pick-model-crossfamily.test.sh:65 and :68-69
+    # ("ok 5b architect unaffected") assert it - so the exemption is a measured decision rather than an
+    # oversight. Changing it is a different decision, and a different bead.
     impl=""
     if [ "$role" = reviewer ]; then
       impl=$(bash "${FLEET_IMPL_MODEL_RESOLVER:-$HOME/fleet/remote/impl-model.sh}" "$bead" 2>/dev/null | head -1 || true)
       if [ -n "$model" ] && [ -n "$impl" ] && [ "${model%%/*}" = "${impl%%/*}" ]; then
         echo "refusing to spawn reviewer '$name' on '$model': the implementer for bead ${bead:-<none>} runs '$impl' (same family). Pass a cross-family model (fleet-ccfq)" >&2
         exit 1

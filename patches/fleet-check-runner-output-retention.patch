--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -505,6 +505,27 @@
     tail=$(tail -c 1200 "$log" 2>/dev/null | sed "s/\x1b\[[0-9;]*m//g")
   fi
 
+  # fleet-50p7: the runner's OWN output is the evidence a reader comes for, and it is not reliably inside a
+  # positional 1200-byte tail. Measured on three real records: one had it inside, two did not (their last
+  # 1200 bytes were preemption and re-queue chatter), and the log each record names is MISSING for all three,
+  # so a reader could not recover it afterwards either. The record therefore carries the facts ITSELF, bounded,
+  # and says plainly when it cannot - the alternative, promising to keep the logs, is a promise someone else
+  # can break (coord, agents-50p7). Composed like the FAIL block above, so no new JSON key and no new reader.
+  local runner_block rp
+  rp=$(grep -m1 -F "runner output -> " "$log" 2>/dev/null | sed "s/.*runner output -> //" | tr -d "\r")
+  if [ -n "$rp" ] && [ -f "$rp" ]; then
+    runner_block="RUNNER OUTPUT ($rp):
+$(grep -E "^Ran [0-9]+ tests? in" "$rp" 2>/dev/null | tail -n 1)
+$(grep -E "^(OK|FAILED)" "$rp" 2>/dev/null | tail -n 1)"
+  elif [ -n "$rp" ]; then
+    runner_block="RUNNER OUTPUT: rotated (the log named $rp, which no longer exists)"
+  else
+    runner_block="RUNNER OUTPUT: not captured (the log names no runner-output path)"
+  fi
+  tail="$tail
+
+$runner_block"
+
   [ -f "$rec" ] || { rm -f "$cov_out"; return 0; }
   exec 9>"${rec%.json}.lock"; flock -w 5 9 || true
 
--- a/tests/fleet-gate-check.test.sh
+++ b/tests/fleet-gate-check.test.sh
@@ -2788,6 +2788,35 @@
 ( kill() { printf '%s\n' "$*" >> "$KILL_PROBE"; }; SELF_PG=24601; kill_group_safe 24601 )
 [ -s "$KILL_PROBE" ] && bad "26f kill_group_safe refuses our own process group" "signalled: $(cat "$KILL_PROBE")" || ok "26f kill_group_safe refuses our own process group (the suite cannot kill itself)"
 
+echo "23-50p7. the record carries the runner's own output, or says it could not (agents-50p7)"
+# Measured before this on three real records: the .log each record names was MISSING for ALL THREE, and whether
+# the runner's own "Ran N tests in Xs" line survived inside the positional 1200-byte tail was LUCK - one record
+# had it, two did not. So the record carries the facts at write time, bounded, and when it cannot it SAYS SO
+# rather than naming a file that may not exist (coord's shape decision: retention is a promise someone else can
+# break, so "keep logs N days" is not the fix).
+P50_REPO="$ROOT/p50-repo"; rm -rf "$P50_REPO"; mkdir -p "$P50_REPO"
+( cd "$P50_REPO" && git init -q -b main . && echo x > f.txt && git add . && git commit -q -m init )
+P50_SUM="$ROOT/p50-summary.txt"; printf '................\nRan 7 tests in 1.234s\n\nOK\n' > "$P50_SUM"
+p50_conf() {  # <runner-output path>
+  printf 'CHECK_FAST_CMD=%s\nCHECK_FAST_TIMEOUT=30\n' \
+    "'echo \"fast-gate: runner output -> $1\"; for i in \$(seq 1 60); do echo \"chatter \$i padding padding padding padding padding\"; done; echo fast-gate: passed: tests/test_x.py'" > "$CHECK_CONF"
+}
+p50_run() {
+  rm -rf "$ROOT/home/.fleet/checks"
+  ( cd "$P50_REPO" && check --fast >/dev/null 2>&1 )
+  local i rec=""
+  for i in $(seq 1 200); do rec=$(ls "$ROOT/home/.fleet/checks/"*.fast.json 2>/dev/null | head -1); \
+    [ -n "$rec" ] && jq -e '.done' "$rec" >/dev/null 2>&1 && break; sleep 0.3; done
+  cat "$rec" 2>/dev/null
+}
+p50_conf "$P50_SUM"
+p50_rec=$(p50_run)
+has "$p50_rec" 'Ran 7 tests in 1.234s' "23-50p7-a the record carries the runner's own measurement, not only a path to it"
+has "$p50_rec" 'RUNNER OUTPUT' "23-50p7-b and it names where that output came from"
+p50_conf "$ROOT/p50-summary-gone.txt"
+p50_rec2=$(p50_run)
+has "$p50_rec2" 'RUNNER OUTPUT: rotated' "23-50p7-c when the runner output is gone the record SAYS SO instead of naming a file that may not exist"
+
 printf '%s passed, %s failed\n' "$PASS" "$FAIL"
 cleanup_nested_gates
 # fleet-opl3 (coord: "we get the intermittent non-run as a FILE rather than as a description"): A RED RUN

index ef05d57..5128a58 100755
--- a/remote/lanes.sh
+++ b/remote/lanes.sh
@@ -11,6 +11,7 @@
 #   lanes.sh retire <lane>            stop + remove its worktree if clean and merged
 #   lanes.sh restart <lane> [reason]  restart a lane (pi resumes the same session; reason is told to the lane)
 #   lanes.sh fresh <lane> [reason]    restart the lane on a NEW session (state recovered from beads)
+#   lanes.sh send <lane> <text...|->   queue a prompt; '-' reads piped/file stdin, refuses a tty or empty text
 #   lanes.sh list                     lanes with role/model/state (a checkout that is gone or broken is
 #                                     marked at the end of the line: [checkout-missing], [checkout-broken])
 #   lanes.sh check                    report lanes whose checkout the deploy temp path leaked into, and
@@ -631,7 +632,26 @@ case $c in
   log) tail -n ${2:-80} "$LD/${1:?lane}.events.log" ;;   # always non-following: the safe one for lanes
   status) lane=${1:?lane}; lane_status "$lane" ;;
   running|win_exists) lane=${1:?lane}; win_exists "$lane" ;;
-  send)  # lanes.sh send <lane> <text>  -> queued as a follow-up prompt via the lane's control socket
-    lane=${1:?lane}; shift; jq -nc --arg m "$*" '{type:"prompt",message:$m}' | timeout 10 nc -N -U "$LD/$lane.sock" ;;
+  send)  # lanes.sh send <lane> <text...> | lanes.sh send <lane> - < piped/file stdin
+    lane=${1:?lane}; shift
+    if [ "$#" -eq 1 ] && [ "$1" = "-" ]; then
+      # A bare '-' is fleet-send's stdin marker, but without this branch the lane receives
+      # the literal '-' as its entire prompt and the sender sees a successful acknowledgement.
+      if [ -t 0 ]; then
+        echo "lanes.sh send: REFUSED: '-' requires piped/file stdin; pass text as arguments or pipe it to 'lanes.sh send <lane> -'" >&2
+        exit 2
+      fi
+      if ! message=$(timeout -k 2 10 cat); then
+        echo "lanes.sh send: REFUSED: could not read piped/file stdin for '-'" >&2
+        exit 2
+      fi
+    else
+      message="$*"
+    fi
+    if [ -z "${message//[[:space:]]/}" ]; then
+      echo "lanes.sh send: REFUSED: prompt is empty; pass text as arguments or pipe it to 'lanes.sh send <lane> -'" >&2
+      exit 2
+    fi
+    jq -nc --arg m "$message" '{type:"prompt",message:$m}' | timeout 10 nc -N -U "$LD/$lane.sock" ;;
   *) sed -n 2,12p "$0" | sed 's/^# \{0,1\}//' ;;
 esac
diff --git a/tests/lanes-send-stdin.test.sh b/tests/lanes-send-stdin.test.sh
new file mode 100755
index 0000000..ecbaf25
--- /dev/null
+++ b/tests/lanes-send-stdin.test.sh
@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# Send exactly '-' from a pipe/file, never as a silent literal prompt. No live lane or socket.
+set -euo pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+LANES=${LANES_OVERRIDE:-$HERE/remote/lanes.sh}
+python3 - "$LANES" <<'PY'
+import json
+import os
+import pty
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+lanes = Path(sys.argv[1])
+count = 0
+with tempfile.TemporaryDirectory(prefix="lanes-send-stdin-") as tmp:
+    home = Path(tmp)
+    (home / "fleet").mkdir()
+    (home / ".fleet" / "lanes").mkdir(parents=True)
+    fakebin = home / "bin"
+    fakebin.mkdir()
+    (home / "fleet" / "fleet.conf").write_text(
+        "export FLEET_VM=test-vm FLEET_PROJECT=test-vm FLEET_HUB=hub-vm\n", encoding="utf-8")
+    nc = fakebin / "nc"
+    nc.write_text("#!/usr/bin/env bash\n"
+                  "printf '%s\\n' \"$*\" > \"$HOME/.fleet/last-nc-args\"\n"
+                  "cat > \"$HOME/.fleet/last-request.json\"\n"
+                  "printf '{\"ok\":true}\\n'\n", encoding="utf-8")
+    nc.chmod(0o755)
+    env = dict(os.environ)
+    env["HOME"] = str(home)
+    env["PATH"] = str(fakebin) + os.pathsep + env.get("PATH", "")
+    sent = home / ".fleet" / "last-request.json"
+    socket_args = home / ".fleet" / "last-nc-args"
+
+    def run(*args, input=None, stdin=None):
+        sent.unlink(missing_ok=True)
+        socket_args.unlink(missing_ok=True)
+        return subprocess.run(["bash", str(lanes), "send", "trial", *args],
+                              input=input, stdin=stdin, text=True, capture_output=True,
+                              env=env, timeout=8)
+
+    def check(condition, detail):
+        global count
+        if not condition:
+            raise AssertionError(detail)
+        count += 1
+
+    message = "Review the pinned tree.\nReport findings."
+    response = run("-", input=message + "\n")
+    check(response.returncode == 0 and json.loads(sent.read_text()) ==
+          {"type": "prompt", "message": message} and response.stdout.strip() == '{"ok":true}',
+          f"piped '-' must deliver its body, not the literal dash: {response}")
+    check(socket_args.read_text().strip().endswith("/trial.sock"),
+          "successful send must still target the lane's control socket")
+
+    prompt = home / "prompt.txt"
+    prompt.write_text("first line\nsecond line\n", encoding="utf-8")
+    with prompt.open(encoding="utf-8") as source:
+        response = run("-", stdin=source)
+    check(response.returncode == 0 and json.loads(sent.read_text())["message"] ==
+          "first line\nsecond line", "file stdin must deliver its body")
+
+    response = run("text", "argument")
+    check(response.returncode == 0 and json.loads(sent.read_text())["message"] == "text argument",
+          "existing multi-argument send must retain its message")
+    response = run("-", "suffix")
+    check(response.returncode == 0 and json.loads(sent.read_text())["message"] == "- suffix",
+          "only an EXACT bare '-' is an stdin marker")
+
+    master, slave = pty.openpty()
+    try:
+        response = run("-", stdin=slave)
+    finally:
+        os.close(slave)
+        os.close(master)
+    check(response.returncode == 2 and "REFUSED" in response.stderr and not sent.exists(),
+          "terminal stdin must refuse '-' before sending anything")
+
+    for label, kwargs in (("empty pipe", {"input": ""}),
+                          ("whitespace pipe", {"input": "  \n\t"}),
+                          ("missing text", {})):
+        response = run(*(["-"] if label != "missing text" else []), **kwargs)
+        check(response.returncode == 2 and "REFUSED" in response.stderr and not sent.exists(),
+              f"{label} must refuse rather than acknowledge an empty prompt: {response}")
+
+print(f"lanes-send-stdin: {count}/{count} passed (fake nc, no lane socket)")
+PY

diff --git a/bin/fleet-land-message b/bin/fleet-land-message
--- a/bin/fleet-land-message
+++ b/bin/fleet-land-message
@@ -39,7 +39,7 @@
 set -uo pipefail
 export PATH="$HOME/fleet/bin:$HOME/.local/bin:$PATH"
 
-GATE_SHA=""; JSON=0; BEADS=(); ARGS=(); FROM_COMMENT=""; ALLOW_STALE=0; REPO_DIR=""
+GATE_SHA=""; JSON=0; BEADS=(); ARGS=(); FROM_COMMENT=""; ALLOW_STALE=0; UNION_TREE=""; REPO_DIR=""
 while [ $# -gt 0 ]; do
   case $1 in
     --gate) GATE_SHA=${2:?--gate needs a sha}; shift 2 ;;
@@ -47,6 +47,11 @@
     --from-comment=*) FROM_COMMENT=${1#--from-comment=}; shift ;;
     --gate=*) GATE_SHA=${1#--gate=}; shift ;;
     --allow-stale) ALLOW_STALE=1; shift ;;
+    # agents-kjpu: the merger builds the union AFTER this tool runs, so it must be TOLD which tree it is
+    # about to land. The flag asserts NOTHING - it enables the content check below, and absent it nothing
+    # changes. A caller-supplied boolean would be the false green this guard exists to prevent.
+    --union-tree) UNION_TREE=${2:?--union-tree needs a tree sha}; shift 2 ;;
+    --union-tree=*) UNION_TREE=${1#--union-tree=}; shift ;;
     --print-json|--json) JSON=1; shift ;;
     --repo) REPO_DIR=${2:?--repo needs a directory}; shift 2 ;;
     --repo=*) REPO_DIR=${1#--repo=}; shift ;;
@@ -271,7 +276,7 @@
   | "\(.key)\t\(.value.author // "?")\t\(.value.created_at // "?")"' <<<"$COMMENTS" 2>/dev/null)
 
 rev_pick=""; rev_idx=""; rev_who=""; rev_at=""; rev_verdict=""; rev_sha=""; rev_state="NONE"
-rev_cleared=false; rev_unreviewed=0; rev_delta_identical=false; rev_run_id=""
+rev_cleared=false; rev_unreviewed=0; rev_delta_identical=false; rev_union_verified=false; rev_run_id=""
 
 # ---------- reviewer independence: which verdicts may be operative (fleet-ry7m) ----------
 # A verdict comment authored by the BRANCH AUTHOR'S OWN LANE cannot mask a verdict from any other actor:
@@ -473,6 +478,33 @@
               if fleet_verdict_is_positive "$rev_verdict"; then rev_cleared=true; else rev_cleared=false; fi
             fi
           fi
+
+          # UNION-TREE PRESENCE CHECK (agents-kjpu). Only reached when the delta fallback declined, which is the
+          # case it cannot serve: a branch that GREW after clearance, so the reviewed delta is a SUBSET of what
+          # will land. The merger built the union from the cleared content, but the union exists only after this
+          # tool has run - so the lander must be TOLD the tree, and it then checks the CLEARED DELTA'S PRESENCE
+          # in it rather than its identity with the ref. PRESENCE is the real content check: on every path the
+          # reviewed delta touched, the declared tree must hold the CLEARED commit's content; other paths are
+          # unconstrained, which is what 'plus these others' means. There is deliberately NO boolean anywhere -
+          # `git diff --quiet` on those paths is the whole verdict, so a caller cannot assert a clearance it has
+          # not got, and an empty reviewed delta (which would make the pathspec vacuous) refuses rather than
+          # passing. WITH THE FLAG ABSENT THIS BLOCK IS DEAD, so current behaviour is unchanged (additive only).
+          if [ "$rev_cleared" = false ] && [ -n "$UNION_TREE" ]; then
+            ut_commit=$(git rev-parse -q --verify "${UNION_TREE}^{tree}" 2>/dev/null || echo "")
+            if [ -z "$ut_commit" ]; then
+              printf 'fleet-land-message: --union-tree %s is not a tree object in this repository\n' "$UNION_TREE" >&2
+            elif [ -z "$rev_files" ]; then
+              printf 'fleet-land-message: --union-tree %s was given but the reviewed delta names no paths, so its presence cannot be checked\n' "$ut_commit" >&2
+            elif git diff --quiet "$rev_full" "$ut_commit" -- $rev_files 2>/dev/null; then
+              rev_state="CURRENT"
+              rev_union_verified=true
+              ut_verified_tree=$ut_commit
+              if fleet_verdict_is_positive "$rev_verdict"; then rev_cleared=true; else rev_cleared=false; fi
+            else
+              printf 'fleet-land-message: --union-tree %s does NOT carry the cleared delta: %s\n' \
+                "$ut_commit" "$(git diff --name-only "$rev_full" "$ut_commit" -- $rev_files 2>/dev/null | tr '\n' ' ')" >&2
+            fi
+          fi
         fi
       fi
     else
@@ -699,7 +731,9 @@
 
 if [ "$rev_state" = "CURRENT" ]; then
   if [ "$rev_cleared" = true ]; then
-    if [ "$rev_delta_identical" = true ]; then
+    if [ "$rev_union_verified" = true ]; then
+      rev_line="PASS (verdict: $rev_verdict) for commit $rev_sha (union tree ${ut_verified_tree:-$UNION_TREE} carries the cleared delta; the branch has moved past it, and the clearance is for the CONTENT it reviewed) by $rev_who at $rev_at [reviewer ${rev_reviewer_model:-?}; independence: $rev_independence]"
+    elif [ "$rev_delta_identical" = true ]; then
       rev_line="PASS (verdict: $rev_verdict) for commit $rev_sha (rebased: delta identical to tip $tip) by $rev_who at $rev_at [reviewer ${rev_reviewer_model:-?}; independence: $rev_independence]"
     else
       rev_line="PASS (verdict: $rev_verdict) for commit ${rev_sha:-$tip} by $rev_who at $rev_at [reviewer ${rev_reviewer_model:-?}; independence: $rev_independence]"
@@ -976,6 +1010,7 @@
     --arg rev_who "${rev_who:-}" --arg rev_at "${rev_at:-}" --argjson rev_unreviewed "${rev_unreviewed:-0}" \
     --argjson rev_cleared "$rev_cleared" --arg rev_tip "$tip" \
     --argjson rev_delta_identical "${rev_delta_identical:-false}" \
+    --argjson rev_union_verified "${rev_union_verified:-false}" --arg union_tree "$UNION_TREE" \
     --arg rev_run_id "${rev_run_id:-}" \
     --arg cleared_sha "${cleared_label_sha:-}" \
     --arg rev_independence "${rev_independence:-unknown}" --arg rev_reviewer_model "${rev_reviewer_model:-}" \
@@ -988,7 +1023,8 @@
                rejected_blocks:$rejected,mentions_without_a_block:$mentions},
       review:{state:$rev_state,verdict:$rev_verdict,reviewed_sha:$rev_sha,tip_sha:$rev_tip,
               unreviewed_commits:$rev_unreviewed,author:$rev_who,at:$rev_at,cleared:$rev_cleared,
-              delta_identical:$rev_delta_identical,run_id:$rev_run_id,cleared_sha:$cleared_sha,
+              delta_identical:$rev_delta_identical,union_verified:$rev_union_verified,union_tree:$union_tree,
+              run_id:$rev_run_id,cleared_sha:$cleared_sha,
               branch_author:$branch_author,independence:$rev_independence,
               reviewer_model:$rev_reviewer_model,author_model:$rev_author_model,
               author_lane_verdicts_ignored:$rev_author_ignored,author_lane_verdict_shas:$rev_author_ignored_shas,
diff --git a/tests/fleet-land-message.test.sh b/tests/fleet-land-message.test.sh
--- a/tests/fleet-land-message.test.sh
+++ b/tests/fleet-land-message.test.sh
@@ -1337,5 +1337,77 @@
     echo "  - $f"
   done
 fi
+
+echo "13. union-tree flag: a MERGER-BUILT UNION carries the cleared delta plus others (agents-kjpu)"
+# The case the delta-identity fallback cannot serve: the branch was cleared, then the ref MOVED (rebase) and the
+# branch GREW with another lane's commit, so the reviewed delta is now a SUBSET of what will land. The merger's
+# union carries the cleared content, but it is built AFTER this tool runs, so the tool must be TOLD the tree.
+rm -f "$FIX/bd-updates.log" "$FIX/bd-comments-added.log"
+git -C "$ROOT/repo" checkout -q main
+git -C "$ROOT/repo" checkout -q -b fleet/union1 main
+echo "union1 cleared content" > "$ROOT/repo/u1.txt"
+git -C "$ROOT/repo" add u1.txt && git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "feat: union1"
+u1_rev=$(git -C "$ROOT/repo" rev-parse --short fleet/union1)
+git -C "$ROOT/repo" checkout -q main
+echo "main progress 2" > "$ROOT/repo/main2.txt"
+git -C "$ROOT/repo" add main2.txt && git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "main: progress 2"
+git -C "$ROOT/repo" checkout -q fleet/union1
+git -C "$ROOT/repo" rebase -q main
+echo "another lane's work" > "$ROOT/repo/other.txt"
+git -C "$ROOT/repo" add other.txt && git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "feat: another lane"
+u1_tip=$(git -C "$ROOT/repo" rev-parse --short fleet/union1)
+ut_union=$(git -C "$ROOT/repo" rev-parse "fleet/union1^{tree}")     # what the merger would land
+git -C "$ROOT/repo" checkout -q main
+cat > "$B" <<J
+[{"author":"proj-lane-1","created_at":"2026-10-11T10:00:00Z",
+  "text":"LAND-SUMMARY\nWHAT: union1.\nWHY: why.\nEFFECT: effect."},
+ {"author":"proj-lane-1","created_at":"2026-10-11T11:00:00Z",
+  "text":"Reviewer subagent verdict:\nVERDICT: PASS (reviewer antigravity/gemini-3.8-flash vs implementer deepseek/deepseek-flash)\nDelta: tk-1 base..$u1_rev branch fleet/union1\nRun ID: 22223333-4444-5555-6666-777788889999\nFindings: none"}]
+J
+
+# 13a-13d: the declared union tree CARRIES the cleared delta, so the clearance holds for the content.
+out_u1=$(run --union-tree "$ut_union" tk-1 fleet/union1); rc_u1=$?
+[ "$rc_u1" = 0 ] && ok "13a a grown branch is cleared when the declared union tree carries the cleared delta" || bad "13a expected exit 0 with --union-tree" "rc=$rc_u1 out=$out_u1"
+has "$out_u1" "union tree $ut_union carries the cleared delta" "13b the message says the clearance is for the CONTENT"
+[ ! -s "$FIX/bd-updates.log" ] && ok "13c and NO label was stripped - a refused land strips, a cleared one does not" || bad "13c labels stripped on a cleared landing" "$(cat "$FIX/bd-updates.log")"
+j_u1=$(run --print-json --union-tree "$ut_union" tk-1 fleet/union1)
+eq "$(jq -r '.review.union_verified' <<<"$j_u1")" "true" "13d JSON review union_verified is true"
+eq "$(jq -r '.review.delta_identical' <<<"$j_u1")" "false" "13e and delta_identical stays FALSE - a different fact, not a relabelled one"
+
+# 13f-13h: THE CONTROL THAT MAKES THE FLAG WORTHLESS TO FAKE - a union tree that does NOT carry the cleared
+# content must refuse. Without this the flag would be a boolean the caller sets, which is exactly the false green
+# an unverifiable clearance is made of.
+git -C "$ROOT/repo" checkout -q -b union-missing main
+echo "another lane's work" > "$ROOT/repo/other.txt"
+git -C "$ROOT/repo" add other.txt && git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "union without the cleared delta"
+ut_missing=$(git -C "$ROOT/repo" rev-parse 'HEAD^{tree}')
+git -C "$ROOT/repo" checkout -q main
+out_u1m=$(run --union-tree "$ut_missing" tk-1 fleet/union1); rc_u1m=$?
+[ "$rc_u1m" = 1 ] && ok "13f a union tree WITHOUT the cleared delta is REFUSED" || bad "13f expected exit 1 when the union omits the cleared content" "rc=$rc_u1m out=$out_u1m"
+has "$out_u1m" "does NOT carry the cleared delta" "13g and the refusal names the path it checked and failed at"
+out_u1b=$(run --union-tree deadbeefdeadbeefdeadbeefdeadbeefdeadbeef tk-1 fleet/union1); rc_u1b=$?
+[ "$rc_u1b" = 1 ] && ok "13h a --union-tree that is not a tree object refuses, naming it" || bad "13h expected exit 1 for a non-tree" "rc=$rc_u1b out=$out_u1b"
+
+# 13i-13j: THE FLAG CANNOT MINT A CLEARANCE - content present, verdict not positive, still refused.
+cat > "$B" <<J
+[{"author":"proj-lane-1","created_at":"2026-10-11T12:00:00Z",
+  "text":"LAND-SUMMARY\nWHAT: union1.\nWHY: why.\nEFFECT: effect."},
+ {"author":"proj-lane-1","created_at":"2026-10-11T13:00:00Z",
+  "text":"Reviewer subagent verdict:\nVERDICT: FAIL\nDelta: tk-1 base..$u1_rev branch fleet/union1\nFindings: one P1."}]
+J
+out_u1f=$(run --union-tree "$ut_union" tk-1 fleet/union1); rc_u1f=$?
+[ "$rc_u1f" = 1 ] && ok "13i a FAIL verdict is still refused even with the content present" || bad "13i expected exit 1 on FAIL" "rc=$rc_u1f out=$out_u1f"
+cat > "$B" <<J
+[{"author":"proj-lane-1","created_at":"2026-10-11T10:00:00Z",
+  "text":"LAND-SUMMARY\nWHAT: union1.\nWHY: why.\nEFFECT: effect."},
+ {"author":"proj-lane-1","created_at":"2026-10-11T11:00:00Z",
+  "text":"Reviewer subagent verdict:\nVERDICT: PASS (reviewer antigravity/gemini-3.8-flash vs implementer deepseek/deepseek-flash)\nDelta: tk-1 base..$u1_rev branch fleet/union1\nRun ID: 22223333-4444-5555-6666-777788889999\nFindings: none"}]
+J
+
+# 13j-13k: ADDITIVE ONLY - with the flag ABSENT the same grown branch behaves exactly as it did before.
+out_u1n=$(run tk-1 fleet/union1); rc_u1n=$?
+[ "$rc_u1n" = 1 ] && ok "13j without the flag the grown branch still refuses - default unchanged" || bad "13j expected exit 1 without the flag" "rc=$rc_u1n out=$out_u1n"
+eq "$(run --print-json tk-1 fleet/union1 | jq -r '.review.union_verified')" "false" "13k and union_verified defaults to false"
+
 printf '%s passed, %s failed\n' "$PASS" "$FAIL"
 [ "$FAIL" = 0 ]

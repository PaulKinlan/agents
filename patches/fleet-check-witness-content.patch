+
+# agents-bp6m: the CONTENT of every tracked path in the working tree, as one hash - the working-tree half of the
+# fingerprint. No mtime, no ctime, no size: bytes only, so a rewrite that produces identical bytes is not a
+# change. `git hash-object` FOLLOWS a symlink, so a link to a file outside the repo contributes its TARGET's
+# content and a target rewrite is witnessed through the link (fleet-sohq) - with no second pass to pay for.
+worktree_content_digest() {
+  local hashes f
+  if hashes=$(git ls-files -z 2>/dev/null | xargs -0 -r git hash-object --no-filters -- 2>/dev/null); then
+    # THE HAPPY PATH IS ALSO THE FAST PATH: one git process for the whole list, measured at 0.030s for 381
+    # tracked files against 0.020s for the metadata form it replaces, and 0.027s against 0.023s for 2280 files.
+    printf '%s\n' "$hashes"
+  else
+    # GIT ABORTS THE WHOLE BATCH ON A PATH IT CANNOT READ, and a truncated list would silently weaken the
+    # witness instead of failing it: measured, one broken symlink in a six-path repo yielded TWO hashes and
+    # exit 123, with no indication in the output that four paths were skipped. So the status is checked, and
+    # on failure every path is read on its own with a MARKER for the ones that have no content to hash (a
+    # broken symlink, a link to a directory, a submodule). A marker is a witness of the path's identity, not
+    # of content that does not exist, and it keeps the digest complete and stable across the two readings.
+    while IFS= read -r -d '' f; do
+      if [ -f "$f" ]; then
+        git hash-object --no-filters -- "$f" 2>/dev/null || printf 'unhashable %s\n' "$f"
+      else
+        printf 'unreadable-as-content %s\n' "$f"
+      fi
+    done < <(git ls-files -z 2>/dev/null)
+  fi
+}
 # fleet-arx8: the fingerprint of what the suites could read when the run began, compared against the same
-# reading after it stops. fleet-iajo replaced the 5s mid-run sampler with this: a sampler is a POLL and a
-# round trip that completes inside one interval is invisible to it (measured: state=PASS while the record
-# read corrupt bytes). The current fingerprint includes nsec ctime, which advances on EVERY write and cannot
-# be restored from userland, so the two readings agree BY CONSTRUCTION rather than by luck of timing.
+# reading after it stops. It is a RECORDED FACT rather than a poll: the start and end readings are taken around
+# the run, so there is no sampling interval to hide in. agents-bp6m made it a CONTENT witness (tree hash,
+# porcelain, diff, and the bytes of every tracked path); it was previously keyed on nsec ctime, which reported a
+# write where a content change is what matters, so a suite that rewrote a tracked file with identical bytes
+# turned a genuine verdict into STALE.
+#
+# THE FLOOR OF THIS WITNESS, STATED RATHER THAN IMPLIED: because it compares CONTENT at the two ends of the run,
+# a write that is FULLY REVERTED before the run stops leaves both readings identical and is not witnessed (it was
+# visible to the old ctime form, which is the one thing that form bought). So the guarantee is "the tree the
+# suites READ had the content recorded at the END of the run", not "no byte ever changed mid-run", and the record
+# says exactly that in .witnessed. Closing the gap would need continuous observation of writes (an inotify-style
+# watcher, a new long-lived process beside the gate) rather than a digest function, and it is not attempted here.
 digest_start=$(worktree_digest)
-# The sample file lives OUTSIDE the repo on purpose: writing it in $dir would itself dirty the worktree and
-# trip the check this exists to make honest. 5s resolution is stated, not implied - a change made and fully
-# reverted inside one interval is below this witness's floor, and the end-digest comparison is what covers the
-# case where it is still changed when the run stops.
 fleet-deps > "$log" 2>&1 &
 job_pid=$!
 wait "$job_pid" 2>/dev/null || true

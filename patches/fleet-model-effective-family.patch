+  && ok "11s superseded fallback reports the family the turn ran" || no "11s match turn family" "${out:-(empty)}"
+[ -n "$out" ] && printf '%s' "$out" | grep -qi "superseded" && printf '%s' "$out" | grep -q "deepseek/deepseek-flash" \
+  && ok "11s and names the superseded fallback beside it" || no "11s discloses superseded fallback" "${out:-(empty)}"

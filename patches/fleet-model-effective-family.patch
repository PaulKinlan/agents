 MW="${FLEET_WINDOWS_FILE:-$HOME/.fleet/model-windows.json}"
 cooling() { [ -f "$CD" ] && jq -e --arg p "${1%%/*}" --arg now "$now" '(.[$p] // "") > $now' "$CD" >/dev/null 2>&1; }
 known() { [ ! -s "$MW" ] || jq -e --arg m "$1" 'has($m)' "$MW" >/dev/null 2>&1; }
-is_healthy() { ! cooling "$1" && known "$1"; }
+
+_observed_fallbacks=""
+_observed_fallbacks_loaded=0
+observed_fallback() {
+  local target="${1%%:*}"
+  local lanes_dir="${FLEET_LANES_DIR:-$HOME/.fleet/lanes}"
+  if [ "$_observed_fallbacks_loaded" -eq 0 ]; then
+    _observed_fallbacks=$(grep -hE '^[0-9]{2}:[0-9]{2}:[0-9]{2} ℹ runtime model fell back: ' "$lanes_dir"/*.events.log 2>/dev/null \
+      | sed -n -E 's/^[0-9]{2}:[0-9]{2}:[0-9]{2} ℹ runtime model fell back: ([^ ]+) -> .*/\1/p' \
+      | sort -u)
+    _observed_fallbacks_loaded=1
+  fi
+  [ -n "$_observed_fallbacks" ] && grep -qxF "$target" <<< "$_observed_fallbacks"
+}
+
+_skipped_logged=""
+skip_observed_fallback() {
+  local m=$1
+  if observed_fallback "$m"; then
+    case " $_skipped_logged " in
+      *" $m "*) ;;
+      *)
+        echo "pick-model: skipping $m (observed runtime fallback in events.log)" >&2
+        _skipped_logged="${_skipped_logged:+$_skipped_logged }$m"
+        ;;
+    esac
+    return 0
+  fi
+  return 1
+}
+
+is_healthy() { ! skip_observed_fallback "$1" && ! cooling "$1" && known "$1"; }
 

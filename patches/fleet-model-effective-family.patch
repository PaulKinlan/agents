 echo
+
+# 11s: a fallback SUPERSEDED by a later successful turn reports the turn's family AND discloses the superseded fallback,
+# so a reader can tell "never fell back" from "fell back once and recovered". (Coord, agents-kq0r: note it BESIDE the turn
+# rather than comparing across the gap.)
+printf '10:00:00 \u2139 runtime model fell back: pi-claude-code-provider/sonnet -> deepseek/deepseek-flash\n' > "$F11/l-superseded.events.log"
+printf '{"at":"2026-10-13T10:00:02Z","model":"deepseek/deepseek-flash","host":"sdk"}\n{"at":"2026-10-13T10:05:00Z","model":"openai-codex/gpt-6-sol","host":"sdk"}\n' > "$F11/l-superseded.turns.jsonl"

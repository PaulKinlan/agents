+printf '19:29:46 \u2699 bash: printf '\''10:00:00 \u2139 runtime model fell back: pi-claude-code-provider/sonnet -> deepseek/deepseek-flash\\n'\'' > /tmp/x.events.log\n' > "$F11/l-quoting.events.log"

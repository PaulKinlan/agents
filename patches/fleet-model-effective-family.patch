   lane)
     [ $# -ge 2 ] || die "lane needs a lane name"
-    lname=$2; shift 2; lasked=""; lsupplied=0
+    lname=$2; shift 2; lasked=""; lsupplied=0; lfamily=0
     while [ $# -gt 0 ]; do
       case $1 in
         --asked) [ $# -ge 2 ] || die "--asked needs a value"; lasked=$(trim "$2"); lsupplied=1; shift 2 ;;
+        --family) lfamily=1; shift ;;
         *) die "unknown option for lane: $1" ;;

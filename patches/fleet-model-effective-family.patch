+fb_governs_turn() {  # <turns_file> <fb_line> <turn_model> <fb_model>
+  if ! command -v python3 >/dev/null 2>&1; then
+    return 2
+  fi
+  python3 -c '
+import json, re, sys
+from datetime import datetime
+
+turns_file = sys.argv[1]
+fb_line = sys.argv[2]
+turn_model = sys.argv[3]
+fb_model = sys.argv[4]
+
+m_time = re.match(r"^([0-9]{2}:[0-9]{2}:[0-9]{2})", fb_line)
+fb_time_str = m_time.group(1) if m_time else None
+if not fb_time_str:
+    sys.exit(2)
+
+turns = []
+try:
+    with open(turns_file, "r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                turns.append(json.loads(line))
+            except Exception:
+                pass
+except Exception:
+    sys.exit(2)
+
+if not turns:
+    sys.exit(2)
+
+last_turn = turns[-1]
+last_at = str(last_turn.get("at") or "")
+try:
+    last_wall = float(last_turn.get("wall_s") or 0)
+except Exception:
+    last_wall = 0.0
+
+m_date = re.search(r"([0-9]{4}-[0-9]{2}-[0-9]{2})", last_at)
+date_str = m_date.group(1) if m_date else datetime.now().strftime("%Y-%m-%d")
+
+try:
+    fb_dt = datetime.fromisoformat(f"{date_str}T{fb_time_str}+00:00")
+    fb_epoch = fb_dt.timestamp()
+except Exception:
+    sys.exit(2)
+
+def parse_epoch(at_str):
+    m = re.search(r"([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2}:[0-9]{2}:[0-9]{2})(?:\.[0-9]+)?Z?", at_str)
+    if m:
+        try:
+            return datetime.fromisoformat(f"{m.group(1)}T{m.group(2)}+00:00").timestamp()
+        except Exception:
+            pass
+    m2 = re.search(r"([0-9]{2}:[0-9]{2}:[0-9]{2})", at_str)
+    if m2:
+        try:
+            return datetime.fromisoformat(f"{date_str}T{m2.group(1)}+00:00").timestamp()
+        except Exception:
+            pass
+    return None
+
+last_epoch = parse_epoch(last_at)
+if last_epoch is None:
+    sys.exit(2)
+
+if fb_epoch - last_epoch > 43200:
+    fb_epoch -= 86400
+elif last_epoch - fb_epoch > 43200:
+    fb_epoch += 86400
+
+if fb_epoch > last_epoch:
+    sys.exit(1)
+
+for t in turns[:-1]:
+    ep = parse_epoch(str(t.get("at") or ""))
+    m = t.get("model")
+    if ep is not None and fb_epoch <= ep < last_epoch and m == fb_model and turn_model != fb_model:
+        sys.exit(1)
+
+turn_start_epoch = last_epoch - last_wall
+slack = turn_start_epoch - fb_epoch
+if -5 <= slack <= 120:
+    sys.exit(0)
+else:
+    sys.exit(1)
+' "$1" "$2" "$3" "$4"
+}
+
+lane_family() {  # <lane>
+  MIS=""; UNK=""
+  local lane=$1 tf ef pf pointer turn_observed="" fb_observed=""
+  local line m dup_rc fb_line fb_req fb_eff fam fb_gov_rc
+  tf="$LANES/$lane.turns.jsonl"; ef="$LANES/$lane.events.log"; pf="$LANES/$lane.model"
+
+  for _f in "$tf" "$ef" "$pf"; do
+    trust_bytes "$_f" "lane '$lane' record" || { finalize "lane $lane family"; return $?; }
+  done
+
+  if [ -f "$tf" ] && [ -s "$tf" ]; then
+    line=$(tail -1 "$tf")
+    if [ -z "$line" ]; then
+      note_unk "the most recent turn record of lane '$lane' is blank, so what it last ran is not recorded"
+    else
+      dup_rc=0; dup_keys "$line" || dup_rc=$?
+      if [ "$dup_rc" = 0 ]; then
+        note_unk "the most recent turn record of lane '$lane' carries a DUPLICATE key (possibly an escaped spelling of one), which jq silently collapses to the last, so the observed model is not established"
+      elif [ "$dup_rc" = 2 ]; then
+        note_unk "the most recent turn record of lane '$lane' cannot be checked for duplicate keys on this host, so the observed model is not established"
+      else
+        m=$(turn_model "$line")
+        if [ -z "$m" ]; then
+          note_unk "the most recent turn record of lane '$lane' is not valid JSON with a string model, so what it last ran is not recorded"
+        else
+          turn_observed="$m"
+        fi
+      fi
+    fi
+  fi
+
+  local ambig_line
+  if [ -f "$ef" ]; then
+    fb_line=$(grep -E '^[0-9]{2}:[0-9]{2}:[0-9]{2} ℹ runtime model fell back: ' "$ef" 2>/dev/null | tail -1 || true)
+    if [ -n "$fb_line" ]; then
+      fb_req=$(printf '%s\n' "$fb_line" | sed -n -E 's/^[0-9]{2}:[0-9]{2}:[0-9]{2} ℹ runtime model fell back: ([^ ]+) -> ([^ ]+).*/\1/p')
+      fb_eff=$(printf '%s\n' "$fb_line" | sed -n -E 's/^[0-9]{2}:[0-9]{2}:[0-9]{2} ℹ runtime model fell back: ([^ ]+) -> ([^ ]+).*/\2/p')
+      if [ -z "$fb_eff" ] || ! value_is_plain "$fb_eff" || [[ "$fb_eff" != */* ]]; then
+        note_unk "the events log of lane '$lane' recorded a fallback with an invalid effective model: $fb_eff"
+      else
+        fb_observed="$fb_eff"
+      fi
+    else
+      ambig_line=$(grep -E 'runtime model fell back: ' "$ef" 2>/dev/null | grep -vE '^[0-9]{2}:[0-9]{2}:[0-9]{2} ⚙ ' | tail -1 || true)
+      if [ -n "$ambig_line" ]; then
+        note_unk "the events log of lane '$lane' contains an ambiguous fallback line (phrase present, not host record shape): $ambig_line"
+      fi
+    fi
+  fi
+
+  if [ -n "$turn_observed" ] && [ -n "$fb_observed" ]; then
+    case $(compare "$fb_observed" "$turn_observed") in
+      MATCH)
+        if [ -z "$MIS" ] && [ -z "$UNK" ]; then
+          fam=$(lower "${turn_observed%%/*}")
+          say "MATCH    family $fam (lane $lane ran $turn_observed, source: turns.jsonl and events.log)"
+        fi
+        ;;
+      CASE)
+        fb_gov_rc=0
+        fb_governs_turn "$tf" "$fb_line" "$turn_observed" "$fb_observed" || fb_gov_rc=$?
+        if [ "$fb_gov_rc" -eq 1 ]; then
+          if [ -z "$MIS" ] && [ -z "$UNK" ]; then
+            fam=$(lower "${turn_observed%%/*}")
+            say "MATCH    family $fam (lane $lane ran $turn_observed, source: turns.jsonl; an earlier fallback to $fb_observed is superseded by this turn, which is the effective family)"
+          fi
+        else
+          note_unk "lane '$lane' turns.jsonl ($turn_observed) and events.log fallback ($fb_observed) differ only in case"
+        fi
+        ;;
+      *)
+        fb_gov_rc=0
+        fb_governs_turn "$tf" "$fb_line" "$turn_observed" "$fb_observed" || fb_gov_rc=$?
+        if [ "$fb_gov_rc" -eq 1 ]; then
+          if [ -z "$MIS" ] && [ -z "$UNK" ]; then
+            fam=$(lower "${turn_observed%%/*}")
+            say "MATCH    family $fam (lane $lane ran $turn_observed, source: turns.jsonl; an earlier fallback to $fb_observed is superseded by this turn, which is the effective family)"
+          fi
+        elif [ "$fb_gov_rc" -eq 2 ]; then
+          note_unk "lane '$lane' turns.jsonl ($turn_observed) and events.log fallback ($fb_observed) disagree, and temporal association cannot be established from their timestamps"
+        else
+          note_mis "lane '$lane' last turn ran $turn_observed (source: turns.jsonl) but events.log recorded fallback to $fb_observed (source: events.log)"
+        fi
+        ;;
+    esac
+  elif [ -n "$turn_observed" ]; then
+    if [ -z "$MIS" ] && [ -z "$UNK" ]; then
+      fam=$(lower "${turn_observed%%/*}")
+      say "MATCH    family $fam (lane $lane ran $turn_observed, source: turns.jsonl)"
+    fi
+  elif [ -n "$fb_observed" ]; then
+    if [ -z "$MIS" ] && [ -z "$UNK" ]; then
+      fam=$(lower "${fb_observed%%/*}")
+      say "MATCH    family $fam (lane $lane fell back to $fb_observed, source: events.log)"
+    fi
+  else
+    pointer=$(cat "$pf" 2>/dev/null; printf '\001')
+    pointer=${pointer%$'\001'}
+    case "$pointer" in *$'\n') pointer=${pointer%$'\n'} ;; esac
+    case "$pointer" in
+      [$' \t\r\v\f']*|*[$' \t\r\v\f'])
+        note_unk "the pointer file $pf is padded with whitespace at one end, so the value it holds is not a plain model id"
+        finalize "lane $lane family"; return $? ;;
+      *[$'\001'-$'\037']*|*[$'\177']*)
+        note_unk "the pointer file $pf carries a control character, which cannot be compared faithfully"
+        finalize "lane $lane family"; return $? ;;
+    esac
+    if [ -n "$pointer" ]; then
+      note_unk "lane '$lane' has only pointer evidence ($pointer, source: pointer-only); what actually ran cannot be established without turns.jsonl or events.log"
+    elif [ -f "$LANES/$lane.asks.jsonl" ]; then
+      note_unk "lane '$lane' has only ask evidence (source: asks.jsonl); what actually ran cannot be established without turns.jsonl or events.log"
+    else
+      [ -z "$UNK" ] && note_unk "lane '$lane' has no turn record, fallback event, or model pointer, so what family it ran cannot be established"
+    fi
+  fi
+
+  finalize "lane $lane family"
+}
+

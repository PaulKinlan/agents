+[ -n "$out" ] && ! printf '%s' "$out" | grep -qiE "fallback|superseded|deepseek" \
+  && ok "11t and names no fallback anywhere in output" || no "11t no fallback named" "${out:-(empty)}"
+
+# 11u: an ambiguous line (phrase present, not the host shape) reports UNKNOWN (exit 3), never MISMATCH (agents-kq0r P2)
+printf 'prefix 10:00:00 \u2139 runtime model fell back: pi-claude-code-provider/sonnet -> deepseek/deepseek-flash\n' > "$F11/l-ambig.events.log"
+FLEET_LANES_DIR="$F11" audit family l-ambig

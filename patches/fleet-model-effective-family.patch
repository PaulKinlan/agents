+
+# 11v: guard: real same-run contradiction is MISMATCH (1)
+printf '10:00:00 \u2139 runtime model fell back: pi-claude-code-provider/sonnet -> deepseek/deepseek-flash\n' > "$F11/l-guard-mis.events.log"
+printf '{"at":"2026-10-13T10:00:02Z","model":"openai-codex/gpt-6-sol","host":"sdk"}\n' > "$F11/l-guard-mis.turns.jsonl"
+FLEET_LANES_DIR="$F11" audit family l-guard-mis
+[ -n "$out" ] && [ "$rc" = 1 ] && printf '%s' "$out" | grep -qE "^MISMATCH " \
+  && ok "11v guard: real same-run contradiction is MISMATCH (1)" || no "11v guard mismatch" "rc=$rc out=${out:-(empty)}"
+
+# 11w: guard: real superseded fallback is MATCH with disclosure
+printf '10:00:00 \u2139 runtime model fell back: pi-claude-code-provider/sonnet -> deepseek/deepseek-flash\n' > "$F11/l-guard-sup.events.log"
+printf '{"at":"2026-10-13T10:00:02Z","model":"deepseek/deepseek-flash","host":"sdk"}\n{"at":"2026-10-13T10:05:00Z","model":"openai-codex/gpt-6-sol","host":"sdk"}\n' > "$F11/l-guard-sup.turns.jsonl"
+FLEET_LANES_DIR="$F11" audit family l-guard-sup
+[ -n "$out" ] && [ "$rc" = 0 ] && printf '%s' "$out" | grep -qE "^MATCH    family openai-codex" \
+  && printf '%s' "$out" | grep -qi "superseded" && printf '%s' "$out" | grep -q "deepseek/deepseek-flash" \
+  && ok "11w guard: real superseded fallback reports MATCH with disclosure" || no "11w guard superseded" "rc=$rc out=${out:-(empty)}"
+

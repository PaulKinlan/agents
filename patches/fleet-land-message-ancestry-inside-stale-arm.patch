--- a/bin/fleet-land-message
+++ b/bin/fleet-land-message
@@ -759,8 +759,36 @@
     already_landed=1
   fi
 
+  # agents-urh9 (re-cut onto agents-p1c2, agents-zop7): p1c2 owns the PROPERTY - a clearance consumed by
+  # landing cannot be un-consumed by a later tip move - and keys it on the bead's `merged` label. What it does
+  # not have, and what this adds, is the MEASURED fact: ANCESTRY AGAINST THE DEFAULT BRANCH. A label can be
+  # absent while the work is landed, so the label alone under-reports; and the tip-move rule exists to protect
+  # 'reviewed X, landing Y', which is impossible once Y is the history of the default branch.
+  #
+  # CONTRACT WHEN ANCESTRY CANNOT BE ESTABLISHED (agents-zlz4), stated here rather than inferred from the code,
+  # because the answer is only as fresh as the CALLER'S remote-tracking ref and a stale fetch would otherwise
+  # turn a spent clearance back into an invalidated one:
+  #   YES  -> spent: keep merge-queue and every cleared: label, report SPENT.
+  #   NO   -> NOT proof that it did not land, so the p1c2 path proceeds - but loudly, naming the assumption.
+  #   REF ABSENT (no refs/remotes/origin/<default>) -> the p1c2 path, with the same loud NOTE: a missing
+  #     remote-tracking ref is evidence absent, not adverse, and must never be a hard stop for landing.
   if [ "$rev_state" = "STALE" ] || [ "$rev_state" = "DIVERGED" ]; then
-    if [ "$already_landed" = 1 ]; then
+  DFLT=$(cat "$HOME/.fleet/default-branch" 2>/dev/null || echo main)
+  if [ "$already_landed" = 0 ] && [ -n "$rev_sha" ] && git rev-parse -q --verify "$rev_sha^{commit}" >/dev/null 2>&1; then
+    if ! git rev-parse -q --verify "refs/remotes/origin/$DFLT" >/dev/null 2>&1; then
+      echo "fleet-land-message: NOTE: could not answer: has $rev_sha landed on origin/$DFLT? - that ref does not exist here, so ancestry cannot be established; following the p1c2 path (the bead's merged label still governs whether the clearance was spent), not refusing." >&2
+    elif git merge-base --is-ancestor "$rev_sha" "refs/remotes/origin/$DFLT" 2>/dev/null; then
+      already_landed=2
+    else
+      echo "fleet-land-message: NOTE: could not answer whether $rev_sha has landed on refs/remotes/origin/$DFLT as this checkout currently sees it; proceeding on the p1c2 path. If that ref is stale the clearance may in fact be spent." >&2
+    fi
+  fi
+    if [ "$already_landed" != 0 ]; then
+      if [ "$already_landed" = 2 ]; then
+        bdf comments add "$BEAD" "merge-queue clearance SPENT (measured): reviewed commit $rev_sha IS an ancestor of refs/remotes/origin/$DFLT, so the clearance was consumed by landing. merge-queue and every cleared: label are LEFT IN PLACE; the later tip move to $tip (+$rev_unreviewed unreviewed commit(s)) is refused below on its own merits." >/dev/null 2>&1 || true
+        echo "fleet-land-message: REFUSING the unreviewed delta: origin/$BRANCH tip $tip moved after review for $rev_sha (+$rev_unreviewed unreviewed commit(s)), BUT that clearance is SPENT - $rev_sha already landed on origin/$DFLT - so the labels are LEFT IN PLACE rather than stripped." >&2
+        exit 1
+      fi
       bdf comments add "$BEAD" "clearance already spent by landing: origin/$BRANCH tip $tip moved after review for $rev_sha (+$rev_unreviewed unreviewed commit(s)), but this bead's work has already landed. The spent clearance is NOT invalidated and its merge-queue/cleared: labels are left in place; only the stale delta is refused." >/dev/null 2>&1 || true
     elif [ ${#rm_labels[@]} -gt 0 ]; then
       bdf update "$BEAD" "${rm_labels[@]}" >/dev/null 2>&1 || true

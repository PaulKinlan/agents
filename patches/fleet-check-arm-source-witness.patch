diff --git a/bin/fleet-check b/bin/fleet-check
index 6c72b58..f0e677c 100755
--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -583,7 +583,25 @@ $last_tail"
   # not yet published, and report a failure about the machine's speed rather than about the tree. A record must
   # not be readable in a terminal state that does not yet describe the run it names. .done stays after the POST
   # because .done is the NOTIFICATION marker (fleet-wq10, fleet-nrrt) while .witnessed describes the RUN.
+  # fleet-6sgf: .witnessed must be a claim THIS RUN can support, and the two arm-registry states mean
+  # different things for untracked files. Read from the INDEX, only tracked content was read. From the
+  # FILESYSTEM fallback, every *.sh in the registry is sourced, so untracked arm files WERE read - and
+  # bin/fleet-check cannot tell those apart from a log, which is why the gate reports the state it took into
+  # $FLEET_GATE_SIGNAL_FILE (tools/fast-gate.sh writes it; the spelling is fleet-gate-signal/1). The ABSENCE
+  # or unreadability of that signal is reported as NO CLAIM - never a silent "witnessed", and never a claim
+  # that untracked files were NOT read either, which the record cannot know (fleet-6sgf, coord condition 2).
+  # kind=full is deliberately untouched: the arm registry does not arise in a full-gate command.
   local witnessed="commit tree; tracked file content; and tracked files' identity INCLUDING SYMLINK TARGETS (size + nsec ctime). NOT witnessed: untracked files, or anything the gate's own command touches outside the repository."
+  if [ -n "${fast:-}" ]; then
+    if [ -r "${rec%.json}.signal.json" ]; then
+      IFS=$'\t' read -r arms_source arms_reason < <(jq -r 'if (.schema=="fleet-gate-signal/1") then [(.arms_source//""),(.arms_reason//"")]|@tsv else "\t" end' "${rec%.json}.signal.json" 2>/dev/null) || true
+    fi
+    case "${arms_source:-}" in
+      index) : ;;   # every clause of the default sentence is true in this state
+      fallback) witnessed="commit tree; tracked file content; and tracked files' identity INCLUDING SYMLINK TARGETS (size + nsec ctime). BUT the fast gate's arm registry took the FILESYSTEM FALLBACK (${arms_reason:-reason not given}), so every *.sh in that registry WAS READ FROM DISK AND SOURCED: UNTRACKED ARM FILES WERE WITNESSED in this run, unlike a run that read its arms from the index." ;;
+      *) witnessed="NOT RECORDED: the fast gate's arm-source signal could not be read for this run, so this record makes NO CLAIM about untracked files - neither that they were witnessed nor that they were not (fleet-6sgf)." ;;
+    esac
+  fi
   # Persist final verdict state BEFORE POST so any lane woken immediately sees the final verdict, not RUNNING (fleet-5bzu review P1)
   if [ "$cov_ok" = 1 ]; then
     jq --arg st "$st" --arg sreason "$state_reason" --arg witnessed "$witnessed" --argjson rc "$rc" --argjson s "$secs" --slurpfile cov "$cov_out" --arg tail "$tail" --argjson run "$run" --argjson ws "$wait_json" --argjson wu "$wu_bool" \
@@ -760,6 +778,11 @@ trap - TERM
 finish "$rc"
 WORKER_EOF
 
+# fleet-6sgf: where the gate reports the arm source it used. Removed first, because a signal left over from an
+# earlier run on this same record must never be able to vouch for THIS one - absence has to mean no claim.
+export FLEET_GATE_SIGNAL_FILE="${rec%.json}.signal.json"
+rm -f "$FLEET_GATE_SIGNAL_FILE"
+
 chmod +x "$worker_script"
 setsid nohup bash "$worker_script" "$rec" "$log" "$top" "$CHECK_TIMEOUT" "$CHECK_CMD" "$tree" "$sha" "${FAST:-}" "$cov_script" "$worker_script" >/dev/null 2>&1 < /dev/null 9>&- &
 worker_pid=$!
diff --git a/tests/fleet-gate-check.test.sh b/tests/fleet-gate-check.test.sh
index fba7942..9259bc5 100755
--- a/tests/fleet-gate-check.test.sh
+++ b/tests/fleet-gate-check.test.sh
@@ -2798,6 +2798,50 @@ cleanup_nested_gates
 # for a red run, and KEEP_FIXTURES=1 does it on demand for a run that merely looked clean. Deliberately NOT
 # done by rewriting the preamble's trap line: 15b4/15b9 pin that line and its mutation behaviour, and a
 # self-check is not something to edit to accommodate a change (the property they pin is unchanged).
+# 25. fleet-6sgf: .witnessed must state what the run can support. The arm registry has two states with
+# different meaning for untracked files - read from the INDEX only tracked content was read, while the
+# FILESYSTEM fallback sources every *.sh on disk, so UNTRACKED arm files WERE read - and bin/fleet-check
+# cannot tell them apart from a log. The gate reports which state it took into $FLEET_GATE_SIGNAL_FILE, and
+# the ABSENCE or unreadability of that signal must read as NO CLAIM rather than as a silent default
+# (coord condition 2). Each case runs a REAL fast gate through the harness's own check, and the last two pin
+# the two directions the record must never go: it must not deny untracked input in the fallback state, and it
+# must not stop saying so in the indexed one.
+SIG_WT="$ROOT/6sgf-wt"; git -C "$S8_REPO" worktree add -q --detach "$SIG_WT" "$psha2" 2>/dev/null
+cat > "$ROOT/6sgf-gate.sh" <<'SIGEOF'
+#!/usr/bin/env bash
+# stands in for tools/fast-gate.sh: reports the arm source exactly as the real gate does, into the file the
+# caller named, and echoes a normal gate line so the record looks like any other PASS.
+case "${1:-}" in
+  index)    printf '%s' '{"schema":"fleet-gate-signal/1","arms_source":"index","arms_reason":""}' > "$FLEET_GATE_SIGNAL_FILE" ;;
+  fallback) printf '%s' '{"schema":"fleet-gate-signal/1","arms_source":"fallback","arms_reason":"this tree is not a git working tree"}' > "$FLEET_GATE_SIGNAL_FILE" ;;
+  garbage)  printf '%s' 'not json at all' > "$FLEET_GATE_SIGNAL_FILE" ;;
+  other)    printf '%s' '{"schema":"some-other-schema/9","arms_source":"index"}' > "$FLEET_GATE_SIGNAL_FILE" ;;
+  none)     : ;;
+esac
+echo "gate ok"
+SIGEOF
+chmod +x "$ROOT/6sgf-gate.sh"
+sig_case() {  # <description> <gate keyword> <expected substring, prefixed ! to expect its absence>
+  echo "CHECK_FAST_CMD=\"bash $ROOT/6sgf-gate.sh $2\"; CHECK_FAST_TIMEOUT=30" > "$CHECK_CONF"
+  sig_rec="$HOME/.fleet/checks/$( git -C "$SIG_WT" rev-parse 'HEAD^{tree}' ).fast.json"
+  rm -f "$sig_rec" "${sig_rec%.json}.signal.json"
+  ( cd "$SIG_WT" && check --fast >/dev/null 2>&1 )
+  wait_check "$sig_rec"
+  sig_wit=$( jq -r '.witnessed // ""' "$sig_rec" 2>/dev/null )
+  case "$3" in
+    !*) hasnt "$sig_wit" "${3#!}" "$1" ;;
+    *)  has "$sig_wit" "$3" "$1" ;;
+  esac
+}
+sig_case "25a an INDEXED run keeps the existing sentence (only tracked content read)" index "NOT witnessed: untracked files"
+sig_case "25b a FILESYSTEM fallback says untracked arm files WERE read and sourced" fallback "UNTRACKED ARM FILES WERE WITNESSED"
+sig_case "25c and the fallback's reason is carried into the record" fallback "this tree is not a git working tree"
+sig_case "25d NO signal at all reads as NO CLAIM, not as witnessed" none "NO CLAIM about untracked files"
+sig_case "25e an unreadable signal reads as NO CLAIM too" garbage "NO CLAIM about untracked files"
+sig_case "25f and a signal under an UNKNOWN schema is not trusted either" other "NO CLAIM about untracked files"
+sig_case "25g while an indexed run still says untracked files were not read" index "NOT witnessed"
+sig_case "25h and a fallback run NEVER denies that untracked files were read" fallback "!NOT witnessed: untracked files"
+
 if [ "$FAIL" -gt 0 ] || [ "${KEEP_FIXTURES:-0}" = 1 ]; then
   trap - EXIT
   echo "fleet-gate-check: fixtures PRESERVED at $ROOT (exit $([ "$FAIL" -gt 0 ] && echo 1 || echo 0)${KEEP_FIXTURES:+, KEEP_FIXTURES=$KEEP_FIXTURES})"

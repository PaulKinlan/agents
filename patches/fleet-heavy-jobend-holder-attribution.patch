--- /home/exedev/fleet/bin/fleet-heavy	2026-10-12 21:10:28.000000000 +0000
+++ /tmp/fleet-heavy-fixed	2026-10-13 01:11:37.215469512 +0000
@@ -197,10 +197,41 @@
         # minutes, blocking every gate on the VM, their wrapper long gone.
         # So before releasing, sweep anything that is holding the slot and is not us. This is the source fix;
         # reclaim_abandoned_slot() is the safety net for holders that pre-date it.
-        leaked=$(slot_fd_holders "$i" | grep -v "^$$\$" | tr '\n' ' ')
+        # agents-nxj8: DO NOT COUNT THE MEASUREMENT AS THE LEAK, AND KILL BY GROUP.
+        # (a) This substitution INHERITS the open fd on the slot file, so its fork, grep and tr are holders
+        #     by slot_fd_holders' own fd test. They are GRANDCHILDREN of us (their ppid is the substitution's
+        #     subshell), and the fleet-91fr exclusion covers only $$ and its DIRECT children - so the sweep
+        #     reported its own pipeline as leaked descendants. Measured live 2026-10-13 with a bounded /proc
+        #     scan using the same fd test: the warning named 3288847 3288848 3288849, which are exactly the
+        #     fork, `grep -v ^<ourpid>$` and `tr \n` of this line, and they shared OUR process group while a
+        #     real leaked holder is setsid-detached with its own. Excluding our own group removes the
+        #     instrument and keeps the leak - the two populations differ in a field the kernel maintains.
+        # (b) The kill is a PID LIST, so a holder that re-spawns between TERM and KILL survives. The orphan
+        #     path already fixed this with a negative pid (L239-244, fleet-uhxq: "a child that reparented, or
+        #     one spawned between the walk and the kill, SURVIVED and went on burning CPU"); that correction
+        #     was never carried here.
+        our_pg=$(ps -o pgid= -p $$ | tr -d ' ')
+        leaked=""
+        for p in $(slot_fd_holders "$i"); do
+          [ "$p" = "$$" ] && continue
+          pg=$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')
+          [ -z "$pg" ] && continue
+          [ "$pg" = "$our_pg" ] && continue
+          leaked="$leaked $p"
+        done
         if [ -n "${leaked// /}" ]; then
           echo "fleet-heavy: warning - descendants still held slot$i after the job finished ($leaked); killing them so the slot is released" >&2
-          kill -TERM $leaked 2>/dev/null; sleep 1; kill -KILL $leaked 2>/dev/null
+          for pg in $(for p in $leaked; do ps -o pgid= -p "$p" 2>/dev/null; done | tr -d ' ' | sort -u); do
+            [ -z "$pg" ] && continue
+            [ "$pg" = "$our_pg" ] && continue
+            kill -TERM -"$pg" 2>/dev/null
+          done
+          sleep 1
+          for pg in $(for p in $leaked; do ps -o pgid= -p "$p" 2>/dev/null; done | tr -d ' ' | sort -u); do
+            [ -z "$pg" ] && continue
+            [ "$pg" = "$our_pg" ] && continue
+            kill -KILL -"$pg" 2>/dev/null
+          done
         fi
         rm -f "$dir/slot$i.who"; exit $rc
       fi

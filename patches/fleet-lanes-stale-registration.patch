--- a/remote/lanes.sh
+++ b/remote/lanes.sh
@@ -555,12 +555,15 @@
       cs=$(checkout_state "$l")
       [ -n "$cs" ] || continue
       wd=$( ( source "$f"; printf '%s' "${WORKDIR:-}" ) )
+      stale_registration=""
       case "$cs" in
         no-checkout)    why="no checkout path recorded" ;;
         checkout-missing) why="the checkout directory does not exist" ;;
         *) dg=$(dead_gitdir "$l")
            if [ -n "$dg" ]; then why=".git points at $dg, which no longer exists (a checkout that was removed, e.g. a deploy temp root)"
-           else why="it exists but is not a usable git repo"; fi ;;
+           else why="it holds no git repository at all, so this registration has no lane worktree: the shape a PRE-VALIDATION lanes.sh spawn wrote (WORKDIR not a worktree path) - spawn now derives the worktree and refuses an empty bead (fleet-kjm5, fleet-c3vf)"
+                stale_registration=1
+           fi ;;
       esac
       case "$cs" in
         checkout-leaked) why="the checkout PATH carries the deploy's temp directory, so it works only while that directory exists (a path, not a project name, was used as the project)"
@@ -569,7 +572,13 @@
       esac
       role=$( ( source "$f" 2>/dev/null; printf '%s' "${ROLE:-}" ) )
       case "$role" in
-        implementer|reviewer|architect|designer|founder) next="lanes.sh retire $l deregisters this lane and keeps the checkout" ;;
+        implementer|reviewer|architect|designer|founder)
+          # A stale registration is NOT repaired by retiring: retire only stops and deregisters the lane, so on a
+          # lane that is still working it stops real work and leaves the malformed conf exactly as it was. What
+          # repairs it is a spawn, which rewrites the registration and cuts a fresh worktree (fleet-c3vf).
+          if [ -n "$stale_registration" ]; then
+            next="re-spawn the lane (lanes.sh spawn $l ...): a spawn rewrites the registration and cuts a fresh worktree - 'lanes.sh retire $l' only stops and deregisters, so it repairs nothing and must not be used while the lane is still working"
+          else next="lanes.sh retire $l deregisters this lane and keeps the checkout"; fi ;;
         *) next="this is a $role lane: lanes.sh retire leaves non-role lanes alone, so repair it from the canonical checkout or re-provision" ;;
       esac
       printf '%-14s %-16s %s\n     %s\n     next: %s.\n' "$l" "$cs" "$wd" "$why" "$next"
--- a/tests/lanes.test.sh
+++ b/tests/lanes.test.sh
@@ -1062,6 +1062,30 @@
 lanes retire imp-live-rot >/dev/null 2>&1 || true
 echo '{}' > "$HOME/.fleet/model-cooldown.json"
 
+echo "30. a registration with no lane worktree is diagnosed as such, and is NOT 'repaired' by retiring (fleet-c3vf)"
+# Why: lane confs written before spawn validated the worktree can still be on a VM - THIS VM carried one
+# (ROLE/MODEL/WORKDIR/BEAD, four fields and MODEL='(default)'; the current writer emits five, including
+# IMPL_MODEL). The producer is closed (spawn derives the worktree and refuses an empty bead, fleet-kjm5), but
+# an operator sweeping the OLD conf was told 'it exists but is not a usable git repo' and told to RETIRE the
+# lane: on a lane that was still working that stops real work and repairs nothing. The state STRING stays
+# checkout-broken because the list column is parsed positionally (autopilot.sh, see 17j); the guidance changes.
+stale_wd="$HOME/legacy-checkout"
+mkdir -p "$stale_wd"
+printf 'ROLE=%s\nMODEL=%s\nWORKDIR=%s\nBEAD=\n' implementer "'(default)'" "$stale_wd" > "$ldir/stale-reg.conf"
+set +e
+out=$(lanes check); rc=$?
+set -e
+has "$out" "stale-reg" "30a a registration with no lane worktree is reported"
+has "$out" "it holds no git repository at all" "30b the diagnosis names the missing repository, not a broken one"
+has "$out" "no lane worktree" "30c and names what is actually missing"
+has "$out" "re-spawn the lane" "30d the next action is the one that repairs it"
+had_retire=$(grep -c "lanes.sh retire stale-reg deregisters" <<<"$out" || true)
+[ "$had_retire" = 0 ] && ok "30e it does NOT advise retiring a working lane to repair a stale registration" || bad "30e wrong advice given" "$(grep 'lanes.sh retire stale-reg' <<<"$out")"
+[ "$rc" != 0 ] && ok "30f a malformed registration exits non-zero so a sweep can see it" || bad "30f non-zero exit" "rc=$rc"
+grep -q '\[checkout-broken\]' <<<"$(lanes list | grep stale-reg)" && ok "30g the list marker is unchanged (autopilot.sh parses the column positionally)" || bad "30g list marker changed" "$(lanes list | grep stale-reg)"
+# The dead-gitdir shape keeps its own wording and its own next action (17e-17g above must not move).
+rm -f "$ldir/stale-reg".*
+
 echo
 printf '%s passed, %s failed\n' "$PASS" "$FAIL"
 [ "$FAIL" = 0 ]

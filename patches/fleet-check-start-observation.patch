+#!/usr/bin/env bash
+set -euo pipefail
+# agents-80np: drive the REAL fleet-check --status reader in a disposable Git repo,
+# HOME and heavy queue. No live heavy slot, inbox, cached record or repo is touched.
+HERE=$(cd "$(dirname "$0")/.." && pwd)
+D=$(mktemp -d /tmp/fleet-check-start-observation.XXXXXX)
+mkdir -p "$D/home/.fleet" "$D/bin" "$D/heavy/tickets" "$D/repo"
+PASS=0 FAIL=0
+ok() { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; }
+check() { local label=$1; shift; if "$@" >/dev/null 2>&1; then ok "$label"; else bad "$label"; fi; }
+printf 'scratch=%s\n' "$D"
+cat > "$D/bin/curl" <<'CURL'
+#!/usr/bin/env bash
+while [ "$#" -gt 0 ]; do
+  if [ "$1" = --data-binary ]; then shift; printf '%s\n' "$1" > "$FLEET_FIXTURE_WAKE"; exit 0; fi
+  shift
+done
+exit 2
+CURL
+chmod +x "$D/bin/curl"
+export HOME="$D/home" FLEET_HEAVY_DIR="$D/heavy" FLEET_HEAVY_SLOTS=1 FLEET_HEAVY_PRIORITY=0
+export FLEET_LANE="fixture80np$$" FLEET_VM=fixture FLEET_CHECK_CONF="$D/check.conf" FLEET_FIXTURE_WAKE="$D/wake.json"
+export PATH="$D/bin:$HERE/bin:$PATH"
+unset FLEET_HEAVY_HELD
+printf "CHECK_FAST_CMD='echo status-probe-start; sleep 6; echo status-probe-end'\nCHECK_FAST_TIMEOUT=30\n" > "$FLEET_CHECK_CONF"
+cd "$D/repo"; git -c init.templateDir= init -q -b main; git config user.email fixture@example.test; git config user.name Fixture
+printf 'recorded tree\n' > content.txt; git add content.txt; git commit -qm 'scratch gate status fixture'
+tree=$(git rev-parse HEAD^{tree}); sha=$(git rev-parse HEAD)
+rec="$HOME/.fleet/checks/$tree.fast.json" log="$HOME/.fleet/checks/$tree.fast.log"
+holder=""
+cleanup() {
+  trap - EXIT
+  if [ -n "$holder" ]; then kill -TERM "$holder" 2>/dev/null || true; wait "$holder" 2>/dev/null || true; fi
+  if [ -f "$rec" ] && [ "$(jq -r '.state // ""' "$rec" 2>/dev/null)" = RUNNING ]; then
+    pid=$(jq -r '.pid // empty' "$rec" 2>/dev/null)
+    # Signal only a worker that still names this scratch record in its cmdline.
+    if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq "$rec"; then
+      kill -TERM -"$pid" 2>/dev/null || true
+    fi
+  fi
+  rm -rf -- "$D"
+}
+trap cleanup EXIT
+( exec 9>"$FLEET_HEAVY_DIR/slot1"; flock -x 9; echo "$$ fixture-holder private" > "$FLEET_HEAVY_DIR/slot1.who"; exec sleep 80 ) & holder=$!
+timeout -k 5 12 bash -c 'until [ -s "$1/slot1.who" ] && [ "$(flock -n "$1/slot1" true 2>/dev/null; echo $?)" = 1 ]; do sleep .1; done' _ "$FLEET_HEAVY_DIR"
+printf 'tree=%s sha=%s\n' "$tree" "$sha"
+"$HERE/bin/fleet-check" --fast > "$D/start.out"
+# Capture the actual status reader while the log PROVES it is queued.
+timeout -k 5 20 bash -c 'until [ -s "$1" ] && grep -q "waiting for a heavy slot" "$2" 2>/dev/null; do sleep .1; done' _ "$rec" "$log"
+"$HERE/bin/fleet-check" --status --fast "$sha" > "$D/queued.json"
+cp "$log" "$D/queued.log"
+queued_tickets=$(find "$FLEET_HEAVY_DIR/tickets" -mindepth 1 -maxdepth 1 -type f | wc -l)
+printf 'QUEUED status=%s log_marker=%s\n' "$(jq -c '{state,run_start_observation,run_s,wait_s,pid,has_run_s:has("run_s"),has_wait_s:has("wait_s")}' "$D/queued.json")" "$(grep -c '^=== fleet-check gate started' "$log" || true)"
+# Release ONLY the private holder; the real command now runs for six seconds.
+kill -TERM "$holder"; wait "$holder" 2>/dev/null || true; holder=""
+timeout -k 5 20 bash -c 'until grep -q "^=== fleet-check gate started" "$1" 2>/dev/null && grep -q "status-probe-start" "$1" 2>/dev/null; do sleep .1; done' _ "$log"
+"$HERE/bin/fleet-check" --status --fast "$sha" > "$D/started.json"
+printf 'STARTED status=%s log_marker=%s\n' "$(jq -c '{state,run_start_observation,run_s,wait_s,pid,has_run_s:has("run_s"),has_wait_s:has("wait_s")}' "$D/started.json")" "$(grep -c '^=== fleet-check gate started' "$log" || true)"
+# Inspect reader-visible observations AFTER witnessing both moments, not only the raw file.
+check 'queued ticket and waiting line with NO gate-start marker' bash -c '[ "$1" -eq 0 ] && [ "$2" -gt 0 ] && grep -q "waiting for a heavy slot" "$3"' _ "$(grep -c '^=== fleet-check gate started' "$D/queued.log" || true)" "$queued_tickets" "$D/queued.log"
+check 'queued reader: RUNNING without finish-time fields' jq -e '.state == "RUNNING" and (has("run_s") | not) and (has("wait_s") | not)' "$D/queued.json"
+check 'queued reader: start has NOT been observed (not claimed never-ran)' jq -e '.run_start_observation == "NOT_OBSERVED" and (.run_start_note | contains("does NOT prove"))' "$D/queued.json"
+check 'started reader: RUNNING without finish-time fields' jq -e '.state == "RUNNING" and (has("run_s") | not) and (has("wait_s") | not)' "$D/started.json"
+check 'started reader: positive start observation despite absent run_s/wait_s' jq -e '.run_start_observation == "OBSERVED" and (.run_start_note | contains("started at least once"))' "$D/started.json"
+timeout -k 5 35 bash -c 'until [ -s "$1" ] && [ "$(jq -r ".state // \"\"" "$2" 2>/dev/null)" != RUNNING ]; do sleep .1; done' _ "$D/wake.json" "$rec"
+"$HERE/bin/fleet-check" --status --fast "$sha" > "$D/finished.json"
+printf 'FINISHED status=%s\n' "$(jq -c '{state,run_s,wait_s,has_run_s:has("run_s"),has_wait_s:has("wait_s")}' "$D/finished.json")"
+check 'finished reader: completion time exists and live observation is absent' jq -e '(.state != "RUNNING") and (.run_s|type == "number") and (.wait_s|type == "number") and (has("run_start_observation")|not)' "$D/finished.json"
+check 'no live inbox call: curl stub received a wake' test -s "$D/wake.json"
+check 'private slot released, no lock holder retained' flock -n "$FLEET_HEAVY_DIR/slot1" true
+printf '%d passed, %d failed\n' "$PASS" "$FAIL"
+[ "$FAIL" = 0 ]

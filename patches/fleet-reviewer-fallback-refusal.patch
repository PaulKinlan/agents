+#!/usr/bin/env bash
+# bin/fleet-fallback-guard — runtime model fallback guard for reviewer lanes (fleet-szle, agents-kq0r)
+#
+# WHY THIS EXISTS:
+# The spawn-time cross-family guard (remote/lanes.sh:361-387, remote/pick-model.sh:192-209) checks
+# the CHOSEN model against the implementer's family at lane creation and start. Afterwards, the SDK host
+# can fall back at runtime (sdk-host/host.mjs:117-124: "ℹ runtime model fell back: <req> -> <eff>").
+# Nothing re-evaluates the family at the fallback point, so a reviewer lane can silently run on the
+# implementer's own family and self-review. Measured on this VM: 25 lanes have a fallback line, in all 25
+# the family changed, and 22 are reviewer lanes that asked for Claude and ran DeepSeek.
+#
+# WHAT THIS ENFORCES:
+# 1. Refuse (exit 1) ONLY when:
+#    - role is "reviewer", AND
+#    - FLEET_IMPL_MODEL is set and non-empty, AND
+#    - the effective model family equals the implementer's model family.
+# 2. Proceed (exit 0) when:
+#    - role is not reviewer (e.g. implementer, architect, coord), OR
+#    - the effective model family differs from the implementer's family.
+# 3. Fail open with a note (exit 0):
+#    - if FLEET_IMPL_MODEL is unset, or
+#    - if any model string is unparseable (missing the family prefix before '/').
+#    A tool that refuses on absence would block lanes with incomplete records (same defect class as a
+#    false green in the other direction).
+#
+# USAGE:
+#   fleet-fallback-guard <role> <impl_model> <requested_model> <effective_model> [source]
+set -uo pipefail
+
+role=${1:-${FLEET_ROLE:-}}
+if [ $# -ge 2 ]; then
+  impl_model=$2
+else
+  impl_model=${FLEET_IMPL_MODEL:-}
+fi
+requested_model=${3:-}
+effective_model=${4:-}
+source=${5:-${FLEET_FALLBACK_SOURCE:-runtime fallback}}
+
+is_parseable() {
+  local m=$1
+  [[ "$m" == */* ]] && [ -n "${m%%/*}" ] && [ -n "${m#*/}" ]
+}
+
+if [ "$role" != "reviewer" ]; then
+  echo "PROCEED: role '$role' is not reviewer; cross-family guard does not apply"
+  exit 0
+fi
+
+if [ -z "$impl_model" ]; then
+  echo "NOTE: implementer model (FLEET_IMPL_MODEL) is unset; cannot establish implementer family; proceeding without guard"
+  exit 0
+fi
+
+if ! is_parseable "$impl_model"; then
+  echo "NOTE: cannot establish implementer model family from '$impl_model' (unparseable model string); proceeding without guard"
+  exit 0
+fi
+
+if [ -z "$effective_model" ] || ! is_parseable "$effective_model"; then
+  echo "NOTE: cannot establish effective model family from '${effective_model:-<unset>}' (unparseable model string); proceeding without guard"
+  exit 0
+fi
+
+if [ -z "$requested_model" ] || ! is_parseable "$requested_model"; then
+  echo "NOTE: cannot establish requested model family from '${requested_model:-<unset>}' (unparseable model string); proceeding without guard"
+  exit 0
+fi
+
+impl_family=$(printf '%s' "${impl_model%%/*}" | tr '[:upper:]' '[:lower:]')
+eff_family=$(printf '%s' "${effective_model%%/*}" | tr '[:upper:]' '[:lower:]')
+req_family=$(printf '%s' "${requested_model%%/*}" | tr '[:upper:]' '[:lower:]')
+
+if [ "$eff_family" != "$impl_family" ]; then
+  echo "PROCEED: reviewer effective family '$eff_family' differs from implementer family '$impl_family' (requested family '$req_family', source: $source)"
+  exit 0
+fi
+
+echo "REFUSE: reviewer cannot run effective model family '$eff_family' (effective model '$effective_model', source: $source); matches implementer model family '$impl_family' (implementer model '$impl_model', source: FLEET_IMPL_MODEL); requested family was '$req_family' (requested model '$requested_model') (fleet-szle)"
+exit 1

+++ b/tests/fleet-fallback-guard.test.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# tests/fleet-fallback-guard.test.sh — regression tests for reviewer runtime fallback guard (fleet-szle / agents-kq0r)
+set -uo pipefail
+
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+GUARD="${FLEET_FALLBACK_GUARD:-$HERE/bin/fleet-fallback-guard}"
+PASS=0; FAIL=0
+ok()   { PASS=$((PASS + 1)); printf '  ok   %s
+' "$1"; }
+bad()  { FAIL=$((FAIL + 1)); printf '  FAIL %s
+      %s
+' "$1" "${2:-}"; }
+has()  { grep -qF -- "$2" <<<"$1" && ok "$3" || bad "$3" "expected to find: '$2', got: '$1'"; }
+
+[ -x "$GUARD" ] || { echo "no executable $GUARD"; exit 1; }
+
+echo "1. REFUSE: reviewer falling back to implementer model family"
+out=$("$GUARD" reviewer deepseek/deepseek-flash pi-claude-code-provider/sonnet deepseek/deepseek-flash 2>&1); rc=$?
+[ "$rc" -eq 1 ] && ok "1a refuses with exit 1" || bad "1a expected exit 1, got $rc"
+has "$out" "REFUSE" "1b message states REFUSE"
+has "$out" "pi-claude-code-provider" "1c message names requested family"
+has "$out" "deepseek" "1d message names effective family"
+has "$out" "runtime fallback" "1e message names source: runtime fallback"
+has "$out" "FLEET_IMPL_MODEL" "1f message names source: FLEET_IMPL_MODEL"
+
+echo "2. PROCEED: reviewer falling back to cross-family model"
+out=$("$GUARD" reviewer deepseek/deepseek-flash pi-claude-code-provider/sonnet openai-codex/gpt-6-sol 2>&1); rc=$?
+[ "$rc" -eq 0 ] && ok "2a proceeds with exit 0" || bad "2a expected exit 0, got $rc"
+has "$out" "PROCEED" "2b message states PROCEED"
+
+echo "3. PROCEED: implementer falling back to same family as FLEET_IMPL_MODEL"
+out=$("$GUARD" implementer deepseek/deepseek-flash pi-claude-code-provider/sonnet deepseek/deepseek-flash 2>&1); rc=$?
+[ "$rc" -eq 0 ] && ok "3a proceeds with exit 0" || bad "3a expected exit 0, got $rc"
+has "$out" "PROCEED" "3b message states PROCEED"
+
+echo "4. PROCEED WITH A NOTE: FLEET_IMPL_MODEL unset"
+out=$("$GUARD" reviewer "" pi-claude-code-provider/sonnet deepseek/deepseek-flash 2>&1); rc=$?
+[ "$rc" -eq 0 ] && ok "4a proceeds with exit 0" || bad "4a expected exit 0, got $rc"
+has "$out" "NOTE" "4b message states NOTE"
+has "$out" "FLEET_IMPL_MODEL" "4c note mentions FLEET_IMPL_MODEL"
+
+echo "5. PROCEED WITH A NOTE: unparseable model string"
+out=$("$GUARD" reviewer deepseek/deepseek-flash pi-claude-code-provider/sonnet unparseable 2>&1); rc=$?
+[ "$rc" -eq 0 ] && ok "5a unparseable effective model proceeds with exit 0" || bad "5a expected exit 0, got $rc"
+has "$out" "NOTE" "5b message states NOTE"
+
+out=$("$GUARD" reviewer unparseable pi-claude-code-provider/sonnet deepseek/deepseek-flash 2>&1); rc=$?
+[ "$rc" -eq 0 ] && ok "5c unparseable impl model proceeds with exit 0" || bad "5c expected exit 0, got $rc"
+has "$out" "NOTE" "5d message states NOTE"
+
+echo
+echo "fleet-fallback-guard: $((PASS + FAIL)) checks, $FAIL failed"
+[ "$FAIL" -eq 0 ]

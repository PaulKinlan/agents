+        const guardBin = process.env.FLEET_FALLBACK_GUARD_BIN || join(HOME, "fleet/bin/fleet-fallback-guard");
+        let refusal = null;
+        try {
+          const out = cp.execFileSync(guardBin, [role, implModel, p.model, actualModel], { encoding: "utf8" });

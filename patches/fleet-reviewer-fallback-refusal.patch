+            this.log(`ℹ ${out.trim()}`);
+          }
+        } catch (e) {
+          const outText = (e.stdout || e.stderr || "").trim();
+          if (e.status === 1 && outText.includes("REFUSE:")) {
+            refusal = outText;
+          } else {
+            const why = e.code ? `cannot execute (${e.code})` : `exited ${e.status || "abnormally"}`;
+            this.log(`ℹ NOTE: fallback guard ${why}; proceeding without guard`);
+          }
+        }
+        if (refusal) {
+          this.log(`✖ ${refusal}`);
+          hlog(`lane ${this.name} start refused: ${refusal}`);
+          try { session.dispose(); } catch {}
+          throw new Error(refusal);
+        }
       }
       this.unsub = session.subscribe((ev) => { try { this.onEvent(ev); } catch (e) { hlog(`${this.name} event error ${e}`); } });
       const u = process.cpuUsage(t0);

-# The gate commands write a marker that can only come from a real run, plus a per-run marker file, so a
-# refusal cannot be mistaken for a run (the refusal message QUOTES the command it would have run).
-printf 'CHECK_CMD="echo RAN_FULL_MARKER"\nCHECK_FAST_CMD="echo RAN_FAST_MARKER"\n' > "$T/.fleet/check.conf"
-
-# Wait for an async gate to leave a record, then report the command it recorded.
-# The fast record is keyed <tree>.fast.json (the kind is part of the cache key), so the suffix is an
-# argument - looking for the wrong file is a test bug, not a gate failure.
-await_record() { # await_record <tree> [suffix]
-  local f="$T/.fleet/checks/$1${2:-}.json" i
-  for i in $(seq 1 40); do
-    if [ -s "$f" ] && jq -e '.cmd' "$f" >/dev/null 2>&1; then jq -r '.cmd' "$f"; return 0; fi
-    sleep 0.5
+suite_groups_of() { # unique process groups of the given pids; never this shell's own group
+  local pid stat rest pgid mine
+  mine=$(ps -o pgid= -p "$$" 2>/dev/null | tr -d ' ')
+  for pid in $1; do
+    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || continue
+    rest=${stat##*') '}
+    pgid=$(printf '%s' "$rest" | awk '{print $3}')
+    [ -n "$pgid" ] || continue
+    [ "$pgid" = "$mine" ] && continue
+    printf '%s\n' "$pgid"
+  done | sort -u
+}
+suite_survivors() { # anything still tied to the tree: by cwd/cmdline, OR by a group we signalled
+  local pid stat rest pgid g
+  suite_tied_pids
+  [ -n "${KILLED_GROUPS:-}" ] || return 0
+  for p in /proc/[0-9]*; do
+    pid=${p#/proc/}
+    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || continue
+    rest=${stat##*') '}
+    pgid=$(printf '%s' "$rest" | awk '{print $3}')
+    for g in $KILLED_GROUPS; do
+      [ "$pgid" = "$g" ] && printf '%s\n' "$pid"
+    done
+  done | sort -u
+}
+suite_teardown() {
+  local tied groups n i p g surv killed
+  KILLED_GROUPS=""
+  # 1. A gate that is merely parking is not a leak yet: give it a moment to finish on its own.
+  for i in $(seq 1 20); do
+    [ -z "$(suite_tied_pids)" ] && break
+    sleep 0.1
   done
-  echo "NO-RECORD"
+  tied=$(suite_tied_pids)
+  if [ -n "$tied" ]; then
+    groups=$(suite_groups_of "$tied")
+    KILLED_GROUPS="$groups"
+    n=$(printf '%s\n' "$tied" | wc -l)
+    killed="$tied"
+    # 2. Signal each GROUP (covers forked descendants), then any pid left without a usable group.
+    for g in $groups; do kill -TERM "-$g" 2>/dev/null || true; done
+    for p in $tied; do kill -TERM "$p" 2>/dev/null || true; done
+    # 3. Wait for the WHOLE TREE to go, not for one pid.
+    for i in $(seq 1 30); do
+      [ -z "$(suite_survivors)" ] && break
+      sleep 0.1
+    done
+    surv=$(suite_survivors)
+    if [ -n "$surv" ]; then
+      for g in $groups; do kill -KILL "-$g" 2>/dev/null || true; done
+      for p in $surv; do kill -KILL "$p" 2>/dev/null || true; done
+      sleep 0.3
+      surv=$(suite_survivors)
+    fi
+  fi
+  # 4. ONLY NOW delete the tree, and only after the tree is confirmed clear.
+  rm -rf "$T"
+  # 5. Report. An EXIT trap may set the final status.
+  if [ -n "$surv" ]; then
+    printf '  FAIL %s process(es) tied to this suite SURVIVED its teardown - the temp tree was deleted under\n' "$(printf '%s' "$surv" | wc -l)"
+    printf '       them, so they hold the heavy slot with a deleted cwd (the agents-825v/agents-cpij husk):\n'
+    printf '       pids: %s\n' "$(printf '%s' "$surv" | tr '\n' ' ')"
+    exit 1
+  fi
+  if [ -n "$killed" ]; then
+    printf '  FAIL %s worker(s) outlived this suite and HAD TO BE KILLED - their groups were signalled\n' "$n"
+    printf '       before the tree was deleted, so the husk did NOT form; they are still a leak:\n'
+    printf '       pids: %s   groups: %s\n' "$(printf '%s' "$killed" | tr '\n' ' ')" "$(printf '%s' "$KILLED_GROUPS" | tr '\n' ' ')"
+    exit 1
+  fi
 }
-tree() { git rev-parse 'HEAD^{tree}'; }

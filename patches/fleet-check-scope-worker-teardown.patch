@@ -15,96 +15,124 @@
 pass() { printf '  ok   %s\n' "$1"; }
 fail() { printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }
 
-T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
-# THIS SUITE MUST USE ITS OWN HEAVY QUEUE. It runs a REAL gate (fleet-check), and fleet-check takes a slot
-# through `fleet-heavy` - so without this the suite joins the VM's SHARED queue at /tmp/fleet-heavy. Measured
-# 2026-10-12: the hub's single slot was held 34 minutes by gate WORKERS whose fixture HOME
-# (/tmp/tmp.I6i63vUAqR) had already been deleted, blocking every real gate on the VM. A test that uses the
-# shared queue can starve the machine it is testing on, and worse, its orphaned workers outlive it. The slot is
-# per-FLEET_HEAVY_DIR, so a private dir costs this suite nothing but its own (empty) queue.
-export FLEET_HEAVY_DIR="$T/heavy"; mkdir -p "$FLEET_HEAVY_DIR"
-
-# THIS SUITE TESTS THE GUARD, so it must not inherit the gate's own opt-in: when the suite runs INSIDE a
-# full gate, FLEET_FULL_GATE_OK=1 is exported (that is how the gate itself is allowed to run), and the
-# "implementer is refused" case then sees an opted-in process and passes the guard it is meant to test.
-# Measured 2026-10-11: 5/5 standalone, and the suite FAILED inside the gate for exactly this reason.
-unset FLEET_FULL_GATE_OK
-mkdir -p "$T/.fleet/checks"
-cd "$T" || exit 1
-git init -q . && git config user.email t@t && git config user.name t
-newtree() {
-  echo "$1" > f.txt
-  for _ in $(seq 1 30); do
-    if git add f.txt 2>/dev/null && git commit -qm "$1" 2>/dev/null; then return 0; fi
-    sleep 0.2
+# TEARDOWN: this suite must not leave a gate worker behind, and it must SAY SO if it was going to.
+#
+# WHY (agents-825v): the previous teardown was `rm -rf "$T"`, which deletes the checks dir and the temp HOME
+# out from under a worker fleet-heavy detached - so the worker is reparented to pid 1 with a DELETED cwd and
+# keeps holding its heavy slot. Measured 2026-10-12: three such husks alive for over an hour, one at 1h50m, on
+# a 2-vCPU VM whose single heavy slot they therefore occupied. The private FLEET_HEAVY_DIR set above keeps the
+# suite out of the SHARED queue, but it does not stop the worker outliving the suite; only killing it does.
+#
+# WHY IT BOTH KILLS AND FAILS, which is the whole design point: a teardown that only asserted "nothing
+# survives" would leave the husk holding the slot, and a teardown that only killed would hide the leak behind
+# a green suite. Doing both means the slot is released AND a leak is visible - the same two-sided rule as the
+# control in agents-yltq: an instrument must not be able to report success on a dead one.
+#
+# WHICH PROPERTY IDENTIFIES THE LEAK, and why this pattern and not another: a leaked worker's command line
+# embeds the path of the script fleet-heavy wrote into this suite's checks dir, i.e. it contains $T. Nothing
+# else on the VM has this mktemp path in its argv, so the scan matches exactly the processes this suite
+# started. That is deliberate, and it avoids the two cleanup traps this fleet has already paid for:
+#   * `pgrep -f`/`pkill -f` with a pattern taken from the SUBJECT also matches the INVOKING SHELL's own command
+#     line (cost this lane two shells, exit 143 each; also cost one more while writing this patch);
+#   * a pattern a real gate also matches kills an honest job (coord's rule 52 - a cleanup pattern must match a
+#     property the leak has and the real job does not).
+# A scan for a mktemp path has both properties: the invoking shell's argv does not contain it, and no real gate
+# was ever handed it.
+# ORDER IS THE WHOLE POINT: kill, then delete. This runs as an EXIT trap, so the tree is deleted either way;
+# what matters is that nothing is still running under it at that moment.
+#
+# KILL THE PROCESS GROUP, NOT THE PID (agents-cpij). A worker that FORKS leaves a child that is not the pid
+# signalled, so killing the pid and waiting for THAT pid satisfies the wait while the child keeps running with
+# the deleted tree under it - the same husk mechanism one level down. The launcher already gives each worker its
+# own group: fleet-check runs it as `setsid nohup bash "$worker_script" ... &` (fleet-check:770), so the
+# worker is a session and group leader and kill -TERM -<pgid> reaches every descendant that has not left it.
+# Verified in the artefact rather than assumed.
+#
+# NEVER SIGNAL OUR OWN GROUP: if a pid's group is this shell's group, the launcher did not setsid it and
+# signalling that group would kill the suite. Those pids get a direct signal instead and are reported.
+suite_tied_pids() { # pids whose CMDLINE or CWD ties them to this tree, excluding this shell and its parent
+  local p pid me=$$ parent cwd
+  parent=$(ps -o ppid= -p "$$" 2>/dev/null | tr -d ' ')
+  for p in /proc/[0-9]*; do
+    pid=${p#/proc/}
+    [ "$pid" = "$me" ] && continue
+    [ -n "$parent" ] && [ "$pid" = "$parent" ] && continue
+    cwd=$(readlink "$p/cwd" 2>/dev/null) || cwd=""
+    case "$cwd" in *"$T"*) printf '%s\n' "$pid"; continue ;; esac
+    [ -r "$p/cmdline" ] || continue
+    { tr '\0' ' ' < "$p/cmdline" || true; } 2>/dev/null | grep -qF -- "$T" && printf '%s\n' "$pid"
   done
-  git add f.txt && git commit -qm "$1"
 }

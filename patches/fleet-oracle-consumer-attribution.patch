+def has_explicit_test_name(source_stem, test_stem):
+    """An affixed test name is intentional even when test and source languages differ."""
+    source = source_stem.replace("-", "_")
+    test = test_stem.replace("-", "_")
+    return test in (f"test_{source}", f"{source}_test")
+
+
+def has_package_import_reference(content, file_path, repo_dir, stem):
+    """A Python package importer loads a child only when its initializer imports that child."""
+    if not file_path.endswith(".py"):
+        return False
+    package_dir = os.path.dirname(file_path)
+    if not package_dir:
+        return False
+    package = package_dir.replace("/", ".")
+    parent, _, name = package.rpartition(".")
+    # All supported explicit imports spell the package name; avoid parsing every unrelated test.
+    if name not in content:
+        return False
+    init_path = os.path.join(repo_dir, package_dir, "__init__.py")
+    try:
+        with open(init_path, "r", errors="ignore") as fp:
+            if not has_import_reference(fp.read(), stem):
+                return False
+        tree = ast.parse(content)
+    except (OSError, SyntaxError, ValueError):
+        return False
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import) and any(alias.name == package for alias in node.names):
+            return True
+        if isinstance(node, ast.ImportFrom):
+            if node.module == package or (node.module == parent and
+                                          any(alias.name == name for alias in node.names)):
+                return True
+    return False
+
+
+def has_execution_path_reference(content, file_path, base, stem):
+    """Keep literal CLI entrypoints; do not mistake arbitrary run(...) text for a consumer."""
+    cleaned = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
+    cleaned = re.sub(r'""".*?"""|\'\'\'.*?\'\'\'', '', cleaned, flags=re.DOTALL)
+    cleaned = re.sub(r'`(?:\\.|[^`\\])*`', '', cleaned, flags=re.DOTALL)
+    cleaned = re.sub(r'//.*|#.*', '', cleaned)
+    process_call = (
+        r'\b(?:subprocess\s*\.\s*(?:run|call|check_call|check_output|Popen)|'
+        r'os\s*\.\s*(?:system|popen|spawn\w*|exec\w*)|'
+        r'Popen|check_output|execFile|execSync|spawnSync|spawn|exec|Deno\.Command|Bun\.spawn)\s*\('
+    )
+    module = os.path.splitext(file_path)[0].replace("/", ".")
+    for call in re.finditer(process_call, cleaned):
+        arguments = cleaned[call.end():].split(")", 1)[0]
+        for match in re.finditer(r'''(?:"([^"]*)"|'([^']*)')''', arguments):
+            literal = match.group(1) if match.group(1) is not None else match.group(2)
+            token = literal.replace("\\", "/")
+            if token.startswith("-"):
+                continue
+            if token in (file_path, base, module) or token.endswith("/" + file_path):
+                return True
+            # node scripts/api: an extensionless path may execute lib/api.py; a bare word
+            # such as `command` in subprocess.run(["command", ...]) is NOT that evidence.
+            if "/" in token and not os.path.splitext(token)[1] and os.path.basename(token) == stem:
+                return True
+    return False
+

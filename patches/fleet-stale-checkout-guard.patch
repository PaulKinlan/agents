diff --git a/remote/fleet-stale-checkout-guard.sh b/remote/fleet-stale-checkout-guard.sh
new file mode 100755
index 0000000..4332a34
--- /dev/null
+++ b/remote/fleet-stale-checkout-guard.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# fleet-stale-checkout-guard.sh - refuse a commit whose BRANCH and whose MESSAGE name different beads (agents-6rfp).
+#
+# THE HAZARD, measured on 2026-10-14 by impl-l2-0utp2 and reported rather than quietly repaired: this worktree
+# was still on the PREVIOUS bead's branch, so the next bead's commit landed on that branch locally and the push
+# failed with 'src refspec fleet/impl-l2-0utp2 does not match any'. Origin was verified untouched, so the only
+# cost was a repair - but had the push succeeded it would have MOVED A BRANCH UNDER A LIVE REVIEW, and clearance
+# is per-sha, so a cleared tip could have been invalidated by someone else's commit.
+#
+# WHY THE BRANCH GUARD CANNOT COVER THIS (agents-zwbk), measured with bash -x rather than reasoned: that guard
+# compares the WORKTREE's last dash token with the BRANCH's, and requires BOTH to look like 4-character bead ids.
+# In the lane layout the worktree's last token is the LANE: 'agents-factory-impl-l2-0utp2' ends in '0utp2', which
+# is FIVE characters, so is_bead_id returns 1 and the guard exits 0 silently - by design, and correctly, since a
+# lane worktree legitimately holds several beads. The name that actually went wrong is not in the worktree path
+# at all: the commit was ABOUT bead af3e and was heading for the branch for bead ufl3. Only the commit MESSAGE
+# carries the bead being worked, so the comparison must be branch-vs-message - and that is why this runs at
+# commit-msg time, where the message exists, rather than at pre-commit, where it does not.
+#
+# NARROW ON PURPOSE, because a guard that cries wolf gets disabled. It fires only when the branch is a fleet
+# branch, the worktree is one of ours, the BRANCH names a 4-character bead id, the MESSAGE names at least one
+# bead, and it names none that matches the branch. Silent for: a lane branch with no bead in its name, a message
+# that names no bead at all (a merge, a housekeeping commit), a message that names this branch's bead, and any
+# worktree outside the fleet root.
+#
+# Overridable deliberately: FLEET_ALLOW_STALE_CHECKOUT=1 for the intended case (landing one bead's work from a
+# worktree whose branch belongs to another), so the escape hatch is a decision that gets recorded, not a bypass.
+set -uo pipefail
+
+# THE WORKTREE IS AN EXPLICIT ARGUMENT, NOT THE CURRENT DIRECTORY. The first version took it from
+# `git rev-parse --show-toplevel`, which made the guard SILENTLY SILENT whenever it was invoked from outside the
+# repository - including from its own fixture, where it passed every case for the wrong reason. That is the same
+# family as the two defects agents-zwbk recorded (a branch parsed as a path, and a directory from an undefined
+# variable): a guard that cannot be driven cannot be shown to fire at all.
+MSG=${1:-}
+BR=${2:-}
+WT=${3:-}
+[ -n "$BR" ] || BR=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
+[ -n "$WT" ] || WT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
+[ -n "$BR" ] || exit 0
+case "$BR" in fleet/*) ;; *) exit 0 ;; esac
+case "$WT" in *"/worktrees/"*) ;; *) exit 0 ;; esac
+
+# A BRANCH is not a path: 'fleet/impl-l2-0utp2-af3e' has several dashes, so the bead id is the last
+# DASH-separated token. (agents-zwbk lost a version of this guard to ${BR##*/}; the same trap applies here.)
+br_last=${BR##*-}
+is_bead_id() { case "$1" in [a-z0-9][a-z0-9][a-z0-9][a-z0-9]) return 0 ;; *) return 1 ;; esac; }
+
+is_bead_id "$br_last" || exit 0     # a lane branch, or any branch not named for a bead: not our business
+[ -n "$MSG" ] && [ -f "$MSG" ] || exit 0
+
+subj=$(head -1 "$MSG" 2>/dev/null || echo "")
+ids=$(printf '%s' "$subj" | grep -oE 'agents-[a-z0-9]{4}|\([a-z0-9]{4}\)' 2>/dev/null | tr -d '()' | sed 's/^agents-//' | sort -u)
+[ -n "$ids" ] || exit 0             # a message that names no bead: silent
+printf '%s\n' "$ids" | grep -qx "$br_last" && exit 0   # it names this branch's bead: correct, silent
+
+if [ "${FLEET_ALLOW_STALE_CHECKOUT:-0}" = "1" ]; then
+  echo "fleet-stale-checkout-guard: allowing branch '$BR' for a commit naming $(printf '%s' "$ids" | tr '\n' ' ') because FLEET_ALLOW_STALE_CHECKOUT=1" >&2
+  exit 0
+fi
+
+cat >&2 <<MSG
+fleet-stale-checkout-guard: REFUSING this commit - branch '$BR' names bead '$br_last', but the message names $(printf '%s' "$ids" | tr '\n' ' ')- one of them is stale.
+For the record, in full:
+  branch:  $BR
+  message names: $(printf '%s' "$ids" | tr '\n' ' ')
+  worktree: $WT
+You are about to commit work for $(printf '%s' "$ids" | tr '\n' ' ') onto the branch for '$br_last'. That is how
+one bead's work lands on another bead's branch: the push usually fails with a refspec error, but if it succeeds
+it MOVES A BRANCH UNDER A LIVE REVIEW, and clearance is per-sha, so a reviewed tip can be invalidated from under
+its reviewer. The repair is always a NEW branch, so do it now:
+  git switch -c fleet/<lane-or-project>-$(printf '%s' "$ids" | head -1)
+If committing onto this branch is intended, re-run with FLEET_ALLOW_STALE_CHECKOUT=1 and know that you are deciding it.
+MSG
+exit 1
diff --git a/remote/provision.sh b/remote/provision.sh
index 8cead00..963a489 100755
--- a/remote/provision.sh
+++ b/remote/provision.sh
@@ -226,6 +226,31 @@ install_git_hooks() {
     done
   fi
 
+  # 4. Fleet stale-checkout guard (agents-6rfp): refuse a commit whose BRANCH and whose MESSAGE name different
+  # beads, which is what happens when a worktree is left on the previous bead's branch. The branch guard above
+  # cannot cover it: that one compares the WORKTREE's last token with the BRANCH's and requires both to be
+  # 4-character ids, while a lane worktree ends in a lane name (0utp2 is five characters), so it exits silently
+  # by design - and the name that actually goes wrong is in the commit MESSAGE, not in the path. This therefore
+  # needs a commit-msg hook: a pre-commit hook has no message to read. Appended OUTSIDE the beads managed block so
+  # bd hooks install cannot rewrite it, and idempotent by its own markers.
+  local sc_dir; sc_dir="$(cd "$(dirname "$0")" && pwd)"
+  if [ -f "$sc_dir/fleet-stale-checkout-guard.sh" ]; then
+    for hdir in "${target_dirs[@]}"; do
+      hf="$hdir/commit-msg"
+      [ -f "$hf" ] || printf '#!/usr/bin/env sh\n' > "$hf"
+      if ! grep -q 'BEGIN FLEET STALE CHECKOUT GUARD' "$hf" 2>/dev/null; then
+        {
+          printf '\n# --- BEGIN FLEET STALE CHECKOUT GUARD (agents-6rfp) ---\n'
+          printf 'if [ -f "%s/fleet-stale-checkout-guard.sh" ]; then\n' "$sc_dir"
+          printf '  bash "%s/fleet-stale-checkout-guard.sh" "$1" "$(git symbolic-ref --short HEAD 2>/dev/null)" "$(git rev-parse --show-toplevel 2>/dev/null)"\n' "$sc_dir"
+          printf 'fi\n'
+          printf '# --- END FLEET STALE CHECKOUT GUARD ---\n'
+        } >> "$hf"
+        chmod +x "$hf" 2>/dev/null || true
+      fi
+    done
+  fi
+
   # 1. Run repo-provided hook installer if present
   if [ -f "$pdir/scripts/install-hooks.mjs" ] && command -v node >/dev/null 2>&1; then
     ( cd "$pdir" && node scripts/install-hooks.mjs >/dev/null 2>&1 ) || true
diff --git a/tests/fleet-stale-checkout-guard.test.sh b/tests/fleet-stale-checkout-guard.test.sh
new file mode 100755
index 0000000..e95a344
--- /dev/null
+++ b/tests/fleet-stale-checkout-guard.test.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# tests/fleet-stale-checkout-guard.test.sh - the stale-checkout guard must refuse a commit whose branch and whose
+# message name different beads, let the override through, and stay SILENT on every legitimate shape (agents-6rfp).
+# Every case passes the message, the branch and the worktree EXPLICITLY, because an earlier version of the guard
+# derived the worktree from the current directory and was silently silent when run from anywhere else - a fixture
+# that had not done this would have passed for the wrong reason.
+set -uo pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+G=${FLEET_STALE_GUARD_BIN:-$HERE/remote/fleet-stale-checkout-guard.sh}
+W=${FLEET_STALE_GUARD_WORKTREE:-/home/exedev/worktrees/agents-factory-impl-l2-0utp2}
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+PASS=0; FAIL=0; N=0
+ok()  { N=$((N+1)); PASS=$((PASS+1)); printf 'ok %d - %s\n' "$N" "$1"; }
+bad() { N=$((N+1)); FAIL=$((FAIL+1)); printf 'not ok %d - %s\n' "$N" "$1"; }
+msg() { printf '%s\n' "$1" > "$TMP/m.txt"; printf '%s' "$TMP/m.txt"; }
+expect() { # expect <want-rc> <label> <message> <branch>
+  local want=$1 label=$2 text=$3 br=$4 f out rc
+  f=$(msg "$text"); out=$(bash "$G" "$f" "$br" "$W" 2>&1); rc=$?
+  if [ "$rc" = "$want" ]; then ok "$label (rc=$rc)"; else bad "$label - wanted rc=$want, got $rc: $(printf '%s' "$out" | head -1)"; fi
+}
+# the instance this bead was filed from, verbatim: an af3e commit on the ufl3 branch
+f=$(msg 'patches(af3e): a check that asserts an apply DID something')
+out=$(bash "$G" "$f" fleet/impl-l2-0utp2-ufl3 "$W" 2>&1); rc=$?
+[ "$rc" = 1 ] && ok "refuses the REAL instance (an af3e commit on the ufl3 branch)" || bad "did not refuse the real instance (rc=$rc)"
+case "$out" in *"'fleet/impl-l2-0utp2-ufl3'"*"af3e"*) ok "names BOTH the branch and the message's bead in one line" ;; *) bad "does not name both in one line" ;; esac
+case "$out" in *FLEET_ALLOW_STALE_CHECKOUT=1*) ok "the refusal offers the override" ;; *) bad "refusal does not name the override" ;; esac
+expect 0 "allows a matching commit (af3e on the af3e branch)"         'patches(af3e): work'               fleet/impl-l2-0utp2-af3e
+expect 0 "allows a matching commit (agents-ufl3 on the ufl3 branch)"  'fix(tests): move it (agents-ufl3)' fleet/impl-l2-0utp2-ufl3
+expect 0 "silent on a lane branch that names no bead"                 'patches(af3e): work'               fleet/impl-l2-0utp2
+expect 0 "silent on a message that names no bead"                     'chore: tidy up'                    fleet/impl-l2-0utp2-ufl3
+expect 0 "silent outside the fleet branch namespace"                  'patches(af3e): work'               main
+out=$(FLEET_ALLOW_STALE_CHECKOUT=1 bash "$G" "$(msg 'patches(af3e): work')" fleet/impl-l2-0utp2-ufl3 "$W" 2>&1); rc=$?
+[ "$rc" = 0 ] && ok "the override lets the real instance through (rc=0)" || bad "override did not pass (rc=$rc)"
+case "$out" in *FLEET_ALLOW_STALE_CHECKOUT=1*) ok "the override is reported, not silent" ;; *) bad "override produced no line" ;; esac
+echo "1..$N"; printf '%d passed, %d failed\n' "$PASS" "$FAIL"; [ "$FAIL" -eq 0 ]

+echo "36. tree-identical rebase keeps a valid clearance (agents-ivp7)"
+# THE DEFECT THIS SECTION PINS: fleet-land-message compared TIPS, so a commit that moved without changing the
+# TREE read as STALE and the landing refused - paying a full gate for content that was already gated. Every lane
+# is told to rebase onto landed main before handing over, so this is the common path, not an edge case. The fix
+# keys the CLEARANCE on the tree (what the gate measured) while the verdict keeps NAMING the commit it was
+# formed on. Both directions are asserted: a tree-identical move is CLEARED, a real change is still REFUSED
+# with both trees named. A fresh branch is used so the fixture cannot depend on what earlier sections moved.
+TT_BRANCH=fleet/treeident
+git -C "$ROOT/repo" checkout -q main
+git -C "$ROOT/repo" checkout -q -b "$TT_BRANCH"
+echo "ident" > ident.txt
+git -C "$ROOT/repo" add ident.txt
+git -C "$ROOT/repo" -c user.email=t@t -c user.name=t commit -q -m "feat: identified work"
+tt_tip=$(git -C "$ROOT/repo" rev-parse "$TT_BRANCH")
+tt_tree=$(git -C "$ROOT/repo" rev-parse "$TT_BRANCH^{tree}")
+tt_parent=$(git -C "$ROOT/repo" rev-parse "$TT_BRANCH^")
+rm -f "$FIX/bd-updates.log" "$FIX/bd-comments-added.log"
+cat > "$ROOT/fix/show.json" <<'J'
+[{"id":"tk-1","title":"Add the thing","description":"The thing was missing.","status":"open","priority":2,"labels":["merge-queue","cleared:abcd123"]}]
+J
+# A metadata-only rebase: same TREE, new commit object, and NOT an ancestor of the reviewed commit (the
+# sibling-commit shape a rebase onto a moved base actually produces).
+tt_new=$(git -C "$ROOT/repo" commit-tree "$tt_tree" -p "$tt_parent" -m "rebase: same tree, new commit")
+git -C "$ROOT/repo" checkout -q main
+git -C "$ROOT/repo" branch -f "$TT_BRANCH" "$tt_new"
+tt_short=$(git -C "$ROOT/repo" rev-parse --short "$TT_BRANCH")
+cat > "$B" <<J
+[{"author":"proj-lane-1","created_at":"2026-10-13T10:00:00Z",
+  "text":"LAND-SUMMARY\nWHAT: thing.\nWHY: why.\nEFFECT: effect."},
+ {"author":"proj-rev-1","created_at":"2026-10-13T11:00:00Z",
+  "text":"VERDICT: PASS\nDelta: tk-1 base..$tt_tip branch $TT_BRANCH\nGate: fleet-check PASS for $tt_tip"}]
+J

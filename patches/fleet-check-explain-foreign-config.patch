@@ -380,6 +380,72 @@ log_after_marker_empty() {
   ! awk "/^=== fleet-check gate started/ { active=1; found=0; next } active && /[^[:space:]]/ { found=1 } END { exit (found ? 0 : 1) }" "$log" 2>/dev/null
 }
 
+
+# ---------------------------------------------------------------------------
+# agents-0r1c, THIRD SHAPE: DO NOT REFUSE ON A PREDICTION - DIAGNOSE AFTER THE FAILURE.
+# (Ruling by coord, 2026-10-14T00:45Z, after three rounds of the previous guard failed in review. This file
+# does not call the in-repo reader at all, so it is the load-bearing half for a deployed VM. The guard that
+# used to live here refused the command BEFORE running it, on a parse of the shell command line, and review
+# broke that parse four times: it missed `bash ./tools/fast-gate.sh`; it refused an output redirection (`bash
+# tools/fast-gate.sh > logs/result.log`), refused `deno test` (deno's SUBCOMMAND read as a script path) and
+# refused `timeout -k 30 60s` (the wrapper's own option argument read as a command word). Every round was a
+# narrower parse and every round it was wrong about a construct it had not anticipated. A FALSE REFUSAL BREAKS
+# A WORKING GATE; a MISS only fails to explain a 127 that was going to happen anyway.)
+#
+# So nothing is refused here any more. The gate runs the command, and IF AND ONLY IF that command has already
+# failed by itself with a command-not-found exit does this name what is actually known: the config's own
+# '# Project:' stamp (who installed it - written by the installer since agents-ia3p), the tokens the command
+# names that do not resolve here, and the one-line repair. An observed fact cannot false-refuse anything,
+# because it speaks only after the failure. It does NOT change the verdict: a 127 is still the failure it is.
+#
+# THIS IS DEFINED INSIDE THE WORKER HEREDOC, and that is not an accident of layout: the worker is a generated
+# self-contained script whose stdout and stderr both go to /dev/null (see the setsid line that starts it), so
+# a diagnostic printed to stderr reaches nobody. The note is appended to $log instead - the log is what the
+# record embeds, what is preserved for a reviewer, and what the [check] notification quotes.
+_fc_command_tokens() {
+  # stdin: a command string. stdout: the first word, plus every word containing a slash. DELIBERATELY DUMB -
+  # it decides nothing, so a wrong name can only make an explanation of an already-observed failure less
+  # precise. No wrappers, no interpreter rules, no flag semantics: those were the three sources of the false
+  # refusals above, and none of them is needed to explain a 127.
+  awk '
+    {
+      n = split($0, w, /[ \t]+/)
+      first = ""
+      for (i = 1; i <= n; i++) {
+        t = w[i]
+        gsub(/^["\047]+/, "", t); gsub(/["\047]+$/, "", t)
+        if (t == "") continue
+        if (first == "") first = t
+        if (t ~ /\//) print t
+      }
+      if (first !~ /\//) print first
+    }'
+}
+_fc_provenance() { [ -r "$1" ] || return 0; grep -m1 -E '^# Project: ' "$1" 2>/dev/null | sed -E 's/^# Project: //' || true; }
+_fc_explain_failure() {   # $1 = observed exit code, $2 = the command, $3 = the config file, $4 = the worktree
+  local rc="${1:-}" cmd="${2:-}" conf="${3:-}" top="${4:-}" tok missing="" who prov
+  case "$rc" in 126|127) ;; *) return 0 ;; esac      # 127 command not found, 126 found but not executable
+  [ -n "$cmd" ] || return 0
+  for tok in $(printf '%s\n' "$cmd" | _fc_command_tokens | sort -u); do
+    tok="${tok#./}"
+    case "$tok" in
+      ".") continue ;;
+      /*)  [ -e "$tok" ]        || missing="${missing}${missing:+, }$tok" ;;
+      */*) [ -e "$top/$tok" ]   || missing="${missing}${missing:+, }$tok" ;;
+      *)   command -v "$tok" >/dev/null 2>&1 || missing="${missing}${missing:+, }$tok (not on PATH)" ;;
+    esac
+  done
+  who="carries no 'Project:' stamp"; prov="$(_fc_provenance "$conf")"
+  [ -n "$prov" ] && who="was installed by $prov"
+  if [ -n "$missing" ]; then
+    printf 'NOTE (agents-0r1c): this run exited %s and %s %s - it names [%s], which do not resolve in %s. That is what a foreign config looks like from here (a missing path reads as a MISSING TOOL). Repair: give this repo its own config (bash tools/check-cmd.sh --install writes $HOME/.fleet/<repo>-check.conf) and point the gate at it with FLEET_CHECK_CONF, or re-install the host-wide file from the repo that should own it.\n' \
+      "$rc" "${conf:-the config}" "$who" "$missing" "${top:-this worktree}"
+  else
+    printf 'NOTE (agents-0r1c): this run exited %s and %s %s, but every token it names DOES resolve in %s - so the %s came from another cause and must not be blamed on the config.\n' \
+      "$rc" "${conf:-the config}" "$who" "${top:-this worktree}" "$rc"
+  fi
+}
+
 finish() {
   [ "${finished:-0}" -eq 1 ] && return 0
   [ "${in_finish:-0}" -eq 1 ] && return 0
@@ -483,6 +549,18 @@ finish() {
     cov_err=$(printf "%s" "$cov_err" | tail -c 400 | tr "\n" " ")
   fi
 
+  # agents-0r1c, third shape: THE DIAGNOSTIC RUNS AFTER THE FAILURE, NEVER INSTEAD OF IT. $rc is what this
+  # worker just OBSERVED, so a command-not-found exit is evidence, not a prediction. It cannot change the
+  # verdict (the 127 stands as the failure it is) and it says nothing about any other exit code. The note goes
+  # to $log rather than to stderr, because this worker's stdout and stderr both go to /dev/null; appending it
+  # HERE - after the state has been derived and after the coverage extraction has read the log, but BEFORE the
+  # tail is captured - is what puts it in the record's tail and in the [check] notification exactly once.
+  local _fc_config_note=""
+  case "$rc" in
+    126|127) _fc_config_note="$(_fc_explain_failure "$rc" "${cmd:-}" "${CHECK_CONF:-${FLEET_CHECK_CONF:-$HOME/.fleet/check.conf}}" "$dir")" ;;
+  esac
+  [ -n "$_fc_config_note" ] && printf '%s\n' "$_fc_config_note" >> "$log" 2>/dev/null
+
   local tail
   if [ "$st" = FAIL ]; then
     local fail_lines

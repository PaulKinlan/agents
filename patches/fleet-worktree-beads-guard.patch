From 60ad100bb327ffe2213c76aa64b09f5d9ff69395 Mon Sep 17 00:00:00 2001
From: agents-factory-hubpatch <agents-factory-hubpatch@exe.xyz>
Date: Mon, 12 Oct 2026 15:58:22 +0000
Subject: [PATCH] fix(bd): refuse bd commands in linked worktrees containing
 decoy databases

---
 bin/bd                          | 32 +++++++++++
 tests/bd-worktree-decoy.test.sh | 96 +++++++++++++++++++++++++++++++++
 2 files changed, 128 insertions(+)
 create mode 100644 tests/bd-worktree-decoy.test.sh

diff --git a/bin/bd b/bin/bd
index 8c44e8f..b0a539c 100755
--- a/bin/bd
+++ b/bin/bd
@@ -208,6 +208,38 @@ guard_readonly_destruction() {
 
 guard_readonly_destruction "$@"
 
+# A linked git worktree must not hold its own .beads database.
+# Upstream bd checks hasBeadsDatabase(dir) before considering the git-common-dir fallback.
+# If an embeddeddolt/ or dolt/ directory exists in a linked worktree's .beads/, bd treats the
+# worktree as authoritative, reporting an empty ledger. Any subsequent push risks publishing
+# the empty database over the shared remote.
+#
+# The canonical checkout (.git is a directory) legitimately holds the database and is exempt.
+guard_worktree_beads_decoy() {
+  local dir="."
+  if [ "${1:-}" = "-C" ] && [ -n "${2:-}" ]; then
+    dir="$2"
+  fi
+  local toplevel
+  toplevel="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || return 0
+  if [ -f "$toplevel/.git" ]; then
+    local decoy=""
+    if [ -d "$toplevel/.beads/embeddeddolt" ]; then
+      decoy="$toplevel/.beads/embeddeddolt"
+    elif [ -d "$toplevel/.beads/dolt" ]; then
+      decoy="$toplevel/.beads/dolt"
+    fi
+    if [ -n "$decoy" ]; then
+      {
+        echo "bd: REFUSED: a worktree should hold no database; a decoy here means bd will report an empty ledger and a push from it would overwrite the shared one - move $decoy aside and re-run."
+      } >&2
+      exit 2
+    fi
+  fi
+}
+
+guard_worktree_beads_decoy "$@"
+
 if [ -n "${FLEET_BD_LOCKED:-}" ]; then
   "$real" "$@"
   rc=$?
diff --git a/tests/bd-worktree-decoy.test.sh b/tests/bd-worktree-decoy.test.sh
new file mode 100644
index 0000000..2fb15a5
--- /dev/null
+++ b/tests/bd-worktree-decoy.test.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+# Guard test: linked git worktrees must not hold a decoy .beads database.
+#
+# Upstream bd checks hasBeadsDatabase(dir) before considering the git-common-dir fallback.
+# If an embeddeddolt/ or dolt/ directory exists in a linked worktree's .beads/, bd treats the
+# worktree as authoritative, reporting an empty ledger.
+#
+# The canonical checkout (.git is a directory) legitimately holds the database and is exempt.
+set -uo pipefail
+
+HERE="$(cd "$(dirname "$0")/.." && pwd)"
+BD="$HERE/bin/bd"
+PASS=0 FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; }
+chk() { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1 (expected '$3', got '$2')"; fi; }
+
+ROOT="$(mktemp -d)"; trap 'rm -rf "$ROOT"' EXIT
+FHOME="$ROOT/home"; mkdir -p "$FHOME/.local/bin" "$FHOME/.fleet"
+LOG="$ROOT/calls.log"; : > "$LOG"
+
+cat > "$FHOME/.local/bin/bd" <<'FAKE'
+#!/usr/bin/env bash
+printf '%s\n' "$*" >> "$BD_LOG"
+exit 0
+FAKE
+chmod +x "$FHOME/.local/bin/bd"
+
+bdrun() {
+  local envs=("HOME=$FHOME" "PATH=$PATH" "BD_LOG=$LOG")
+  env -i "${envs[@]}" bash "$BD" "$@"
+}
+attempted() { grep -Fq -- "$1" "$LOG"; }
+
+# Set up git repo and linked worktree
+REPO="$ROOT/main-repo"
+mkdir -p "$REPO"
+git -C "$REPO" init -q -b main
+git -C "$REPO" config user.email "test@example.com"
+git -C "$REPO" config user.name "Test"
+mkdir -p "$REPO/.beads/embeddeddolt"
+touch "$REPO/file.txt"
+git -C "$REPO" add file.txt
+git -C "$REPO" commit -q -m "init"
+
+WT="$ROOT/worktree"
+git -C "$REPO" worktree add -q -b feat "$WT"
+mkdir -p "$WT/.beads"
+
+echo "1. canonical repo with embeddeddolt is exempt (legitimate database)"
+: > "$LOG"
+(cd "$REPO" && bdrun list) >/dev/null 2>&1; rc=$?
+chk "1a bd list succeeds in canonical repo (exit 0)" "$rc" "0"
+attempted "list" && ok "1b real bd was called" || bad "1b real bd was not called"
+
+echo "2. clean worktree (no database) succeeds and falls back"
+: > "$LOG"
+(cd "$WT" && bdrun list) >/dev/null 2>&1; rc=$?
+chk "2a bd list succeeds in clean worktree (exit 0)" "$rc" "0"
+attempted "list" && ok "2b real bd was called" || bad "2b real bd was not called"
+
+echo "3. worktree with decoy embeddeddolt is refused loudly"
+mkdir -p "$WT/.beads/embeddeddolt"
+: > "$LOG"
+out="$(cd "$WT" && bdrun list 2>&1)"; rc=$?
+chk "3a bd list in decoy worktree is refused (exit 2)" "$rc" "2"
+case "$out" in
+  *"a worktree should hold no database"*) ok "3b refusal explains the invariant" ;;
+  *) bad "3b refusal missing invariant explanation: $out" ;;
+esac
+case "$out" in
+  *"move "*"embeddeddolt aside and re-run"*) ok "3c refusal gives actionable remedy" ;;
+  *) bad "3c refusal missing actionable remedy: $out" ;;
+esac
+! attempted "list" && ok "3d real bd was never called" || bad "3d real bd was called"
+
+echo "4. -C <worktree> with decoy is also refused"
+: > "$LOG"
+out="$(bdrun -C "$WT" list 2>&1)"; rc=$?
+chk "4a bd -C <decoy_wt> list is refused (exit 2)" "$rc" "2"
+case "$out" in
+  *"a worktree should hold no database"*) ok "4b refusal explains invariant via -C" ;;
+  *) bad "4b missing invariant explanation: $out" ;;
+esac
+! attempted "list" && ok "4c real bd was never called" || bad "4c real bd was called"
+
+echo "5. moving decoy aside restores normal operation"
+mv "$WT/.beads/embeddeddolt" "$WT/.beads/embeddeddolt.aside"
+: > "$LOG"
+(cd "$WT" && bdrun list) >/dev/null 2>&1; rc=$?
+chk "5a bd list succeeds after decoy is moved aside (exit 0)" "$rc" "0"
+attempted "list" && ok "5b real bd was called" || bad "5b real bd was not called"
+
+echo
+printf 'bd worktree decoy guard: %d passed, %d failed\n' "$PASS" "$FAIL"
+[ "$FAIL" = 0 ]
-- 
2.43.0


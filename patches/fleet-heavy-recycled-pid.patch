+# WHICH PROCESS EACH CANDIDATE PID IS, CAPTURED WHILE THE SLOT FD IS STILL IN FRONT OF US (agents-7vbo,
+# agents-g966). slot_fd_holders lists WHO MIGHT hold the slot; that list is a claim about the past,
+# because a pid is a reusable number. So this re-observes the slot fd for each candidate and reads the
+# identity of the process holding it IN THE SAME PASS: only a pid that still has the slot open is given
+# an identity, so a number that was recycled between the candidate scan and this pass is REFUSED rather
+# than recorded as the expected process. Prints "<pid>:<pgrp>:<starttime>" - process group (field 5) and
+# start time (field 22) of /proc/<pid>/stat, the two fields this file already reads by number.
+slot_fd_holder_ids() {  # <i> -> "<pid>:<pgrp>:<starttime>" per line
+  local i=$1 p f t pg st slot="${dir:-/nonexistent}/slot$i"
+  for p in $(slot_fd_holders "$i"); do
+    p=${p%%:*}
+    case "$p" in ''|*[!0-9]*) continue ;; esac
+    [ "$p" = "$$" ] && continue
+    t=""
+    for f in "/proc/$p"/fd/*; do
+      t=$(readlink "$f" 2>/dev/null) || { t=""; continue; }
+      [ "$t" = "$slot" ] && break
+      t=""
+    done
+    if [ "$t" != "$slot" ]; then
+      echo "fleet-heavy: slot$i: REFUSING pid $p - it does not hold the slot now, so it is not the holder the scan saw (a stale or recycled pid)" >&2
+      continue
+    fi
+    pg=$(awk '{print $5}'  "/proc/$p/stat" 2>/dev/null)
+    st=$(awk '{print $22}' "/proc/$p/stat" 2>/dev/null)
+    printf '%s:%s:%s\n' "$p" "$pg" "$st"
+  done
+}
+
+# RELEASE A SLOT A FINISHED JOB LEFT TO ITS DESCENDANTS, WITHOUT SIGNALLING A PID THAT NO LONGER NAMES
+# THE PROCESS THE SWEEP FOUND (agents-7vbo, agents-g966).
+#
+# slot_fd_holders scans /proc, and the scan's own pipeline inherits the slot fd, so its list is usually
+# the scan's already-dead forks. The old `kill -TERM $leaked` aimed at those numbers, and the kernel may
+# RECYCLE one in between, so the line meant to recover a slot TERMs an unrelated process. Acting on a
+# remembered number is CHECK-THEN-ACT with TWO windows, and a re-read alone cannot close either:
+#   (a) SCAN-TO-CAPTURE: the pid is collected by the scan, then /proc/<pid>/stat is read separately; if
+#       the scanned process dies and its pid is reused before that read, the UNRELATED new process
+#       becomes the expected identity - exactly the bead agents-g966 reproduction.
+#   (b) CAPTURE-TO-SIGNAL: even a correctly captured identity is checked, then the kill lands; a pid that
+#       passed the check can still be recycled in that gap.
+# Window (a) is closed by capturing identity IN THE SAME PASS as the observation (slot_fd_holder_ids
+# above): a candidate gets an identity only while it still holds the slot fd, so a recycled number -
+# which does not hold the slot - is refused, not captured. Window (b) is closed by SIGNALLING THROUGH A
+# PIDFD: pidfd_open() binds the process OBJECT (not the number) and pidfd_send_signal() delivers to that
+# object, so once the handle is held a recycled pid CANNOT be signalled - the kernel answers ESRCH, it
+# never redirects to the number's new owner. Binding, checking and signalling happen in one pass in the
+# helper below, so the identity check cannot be separated from the signal by a recycle.
+#
+# Measured on this VM (python3 3.12.3): os.pidfd_open and signal.pidfd_send_signal are both present, and
+# a pidfd whose process has exited answers ESRCH to signal 0, to SIGTERM and to SIGKILL. On a host
+# without the primitive the helper exits 2 and the re-checked kill below runs instead, which keeps its
+# check-to-signal window.
+#
+# START TIME IS THE DISCRIMINATOR, process group is corroboration. Measured on this VM: a genuine leaked
+# descendant is often setsid-detached with its OWN process group (the reclaim test leaks exactly such a
+# holder), so keying on the JOB's pgid would REFUSE a real leak; the scan's own forks share OUR group, so
+# that same key would ACCEPT the phantom. Field 22 cannot change for a live process, so it is the
+# identity, and field 5 is checked alongside it as the file's other field. The pidfd is still validated
+# against BOTH the start time and the fd before use, so a number that recycled between the scan and the
+# bind is refused there too.
+#
+# Only the verified PIDS are signalled, never a process group: a group derived from a verified pid is
+# still a group, and widening one accused pid to its whole group takes bystanders the fd test never
+# accused.
+signal_leaked_holders() {  # <i> -> 0 if it signalled a live descendant
+  local i=$1 ids rc v p pg st np ng verified="" kill_list=""
+  ids=$(slot_fd_holder_ids "$i")
+  [ -n "$ids" ] || return 1
+  if command -v python3 >/dev/null 2>&1; then
+    SWEEP_IDS="$ids" SWEEP_SLOT="${dir:-/nonexistent}/slot$i" SWEEP_I="$i" python3 - <<'SWEEP_PIDFD_PY'
+import os, signal, sys, time
+
+slot = os.environ["SWEEP_SLOT"]
+idx = os.environ.get("SWEEP_I", "?")
+if not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
+    sys.exit(2)                        # primitive absent: the caller uses its re-checked-kill fallback
+
+def stat_fields(pid):
+    # fields after "comm)": rest[0] is field 3 (state), so field N is rest[N - 3]
+    try:
+        with open("/proc/%d/stat" % pid, "rb") as fh:
+            return fh.read().rsplit(b")", 1)[1].split()
+    except (OSError, IndexError):
+        return None
+
+def ancestors(pid):
+    seen = set()
+    cur = pid
+    while cur and cur not in seen:
+        seen.add(cur)
+        f = stat_fields(cur)
+        if f is None:
+            break
+        try:
+            cur = int(f[1])            # field 4 = ppid
+        except (IndexError, ValueError):
+            break
+    return seen
+
+def holds_slot(pid):
+    try:
+        for fd in os.listdir("/proc/%d/fd" % pid):
+            try:
+                if os.readlink("/proc/%d/fd/%s" % (pid, fd)) == slot:
+                    return True
+            except OSError:
+                pass
+    except OSError:
+        pass
+    return False
+
+me = ancestors(os.getpid())            # never signal ourselves or the shell that spawned us
+live = []
+for rec in os.environ.get("SWEEP_IDS", "").splitlines():
+    rec = rec.strip()
+    if not rec:
+        continue
+    parts = rec.split(":")
+    try:
+        pid = int(parts[0])
+    except ValueError:
+        continue
+    want = parts[2] if len(parts) > 2 else ""
+    if pid in me:
+        continue
+    try:
+        pfd = os.pidfd_open(pid)       # binds the process OBJECT; a dead pid answers OSError/ESRCH
+    except OSError:
+        sys.stderr.write("fleet-heavy: slot%s: pid %d held the slot when swept but no longer names a process - gone, not signalling it\n" % (idx, pid))
+        continue
+    f = stat_fields(pid)
+    now = f[19].decode() if f is not None and len(f) > 19 else ""
+    if not want or now != want or not holds_slot(pid):
+        sys.stderr.write("fleet-heavy: slot%s: REFUSING pid %d - not the process the sweep found or it no longer holds the slot now (start time was %s, now %s): a recycled or replaced pid\n" % (idx, pid, want or "?", now or "gone"))
+        os.close(pfd)
+        continue
+    live.append((pid, pfd))
+if not live:
+    sys.exit(3)                        # nothing left to signal; not an error, and not a kill
+sys.stderr.write("fleet-heavy: warning - descendants still held slot%s after the job finished (%s); killing them so the slot is released\n"
+                 % (idx, " ".join(str(p) for p, _ in live)))
+for _, pfd in live:
+    try:
+        signal.pidfd_send_signal(pfd, signal.SIGTERM)
+    except OSError:
+        pass
+time.sleep(1)
+for _, pfd in live:
+    try:
+        signal.pidfd_send_signal(pfd, signal.SIGKILL)
+    except OSError:
+        pass
+for _, pfd in live:
+    os.close(pfd)
+sys.exit(0)
+SWEEP_PIDFD_PY
+    rc=$?
+    case "$rc" in
+      0) return 0 ;;
+      2) : ;;                          # no pidfd primitive: fall through to the re-checked kill
+      3) return 1 ;;
+      *) : ;;                          # unexpected helper failure: do not leak the slot, fall back
+    esac
+  fi
+  # FALLBACK - only reached when the pidfd primitive is absent or the helper could not run. Identity is
+  # re-read IMMEDIATELY before EACH signal and only a match is killed. This NARROWS but does not close
+  # window (b): between this check and the kill the pid can still be recycled, which is why the pidfd
+  # path above is the one that runs when it is available.
+  while IFS=: read -r p pg st; do
+    [ -n "$p" ] || continue
+    np=$(awk '{print $5}'  "/proc/$p/stat" 2>/dev/null)
+    ng=$(awk '{print $22}' "/proc/$p/stat" 2>/dev/null)
+    if [ -z "$ng" ]; then
+      echo "fleet-heavy: slot$i: pid $p held the slot when swept but no longer names a process - gone, not signalling it" >&2
+      continue
+    fi
+    if [ -z "$st" ] || [ "$st" != "$ng" ] || [ "$pg" != "$np" ]; then
+      echo "fleet-heavy: slot$i: REFUSING pid $p - not the process the sweep found (pgrp/starttime was $pg/$st, now $np/$ng): a recycled or replaced pid" >&2
+      continue
+    fi
+    verified="$verified $p:$ng"
+  done <<<"$ids"
+  [ -n "${verified// /}" ] || return 1
+  for v in $verified; do kill_list="$kill_list ${v%%:*}"; done
+  kill_list=${kill_list# }
+  echo "fleet-heavy: warning - descendants still held slot$i after the job finished ($kill_list); killing them so the slot is released" >&2
+  kill -TERM $kill_list 2>/dev/null
+  sleep 1
+  kill_list=""
+  for v in $verified; do
+    p=${v%%:*}; st=${v#*:}
+    ng=$(awk '{print $22}' "/proc/$p/stat" 2>/dev/null)
+    [ "$ng" = "$st" ] && kill_list="$kill_list $p"
+  done
+  [ -n "${kill_list// /}" ] && kill -KILL $kill_list 2>/dev/null
+  return 0
+}

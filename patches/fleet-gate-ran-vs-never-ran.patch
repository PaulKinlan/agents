--- /dev/null
+++ b/tests/fleet-gate.test.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# tests/fleet-gate.test.sh - the wrapper's wake-up message must report what it OBSERVED (agents-wg7i).
+#
+# The defect this pins: a tool that exited 2 on a usage error was reported as "exit 0 after 0s". A message
+# with no RAN vs NEVER-RAN distinction cannot tell a finished run from one that never started, and 0s
+# elapsed plus exit 0 is not a pass. fleet-heavy and curl are shims on PATH, so both cases are DRIVEN rather
+# than hoped for: one shim runs the command, the other returns without ever starting it, and neither needs
+# the VM's heavy slot.
+set -uo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+GATE=${FLEET_GATE_BIN:-$(cd "$HERE/.." && pwd)/bin/fleet-gate}
+PASS=0; FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n      %s\n' "$1" "${2:-}"; }
+SHIM=$(mktemp -d); WORK=""
+trap 'rm -rf "$SHIM" $WORK' EXIT
+
+# curl shim: the wrapper POSTs the message to the lane inbox; capture the payload instead of sending it.
+cat > "$SHIM/curl" <<'SH'
+#!/usr/bin/env bash
+while [ $# -gt 0 ]; do
+  if [ "$1" = "--data-binary" ]; then shift; printf '%s' "$1" > "$FLEET_GATE_MSG"; fi
+  shift
+done
+exit 0
+SH
+chmod +x "$SHIM/curl"
+
+# run <label> <fleet-heavy-body> <command...>: drives the real wrapper with that shim, then reads the message.
+run() {
+  local label=$1 shim=$2; shift 2
+  WORK=$(mktemp -d); export FLEET_GATE_MSG="$WORK/msg.json"; BASE="/tmp/wg7i-test-case-$label"   # the wrapper derives base from $lane-$name, and name is case-$label
+  rm -f "$BASE.exit" "$BASE.ran" "$BASE.log"
+  printf '#!/usr/bin/env bash\n%s\n' "$shim" > "$SHIM/fleet-heavy"; chmod +x "$SHIM/fleet-heavy"
+  FLEET_LANE=wg7i-test PATH="$SHIM:$PATH" "$GATE" "case-$label" -t 30 -- "$@" >/dev/null 2>&1
+  local i=0
+  while [ ! -s "$FLEET_GATE_MSG" ] && [ $i -lt 150 ]; do sleep 0.1; i=$((i+1)); done
+  MSG=$(cat "$FLEET_GATE_MSG" 2>/dev/null)
+}
+
+echo "1. the command RAN and failed: the tool status must be the one reported (agents-wg7i, instance 3)"
+run ranfail 'exec "$@"' bash -c 'echo usage error >&2; exit 2'
+case "$MSG" in *"ran and exited 2 after"*) ok "1a a tool exiting 2 is reported as exiting 2";; *) bad "1a expected 'ran and exited 2 after'" "$MSG";; esac
+case "$MSG" in *"NEVER RAN"*) bad "1b a run that started must not be labelled NEVER RAN" "$MSG";; *) ok "1b ... and it is not labelled NEVER RAN";; esac
+[ "$(cat "$BASE.exit" 2>/dev/null)" = 2 ] && ok "1c the exit file carries the tool status" || bad "1c exit file should be 2" "$(cat "$BASE.exit" 2>/dev/null)"
+
+echo "2. the command RAN and succeeded - the control that keeps case 3 honest"
+run ranok 'exec "$@"' true
+case "$MSG" in *"ran and exited 0 after"*) ok "2a a successful run reads as ran";; *) bad "2a expected 'ran and exited 0 after'" "$MSG";; esac
+[ "$(cat "$BASE.exit" 2>/dev/null)" = 0 ] && ok "2b exit file 0" || bad "2b exit file should be 0" "$(cat "$BASE.exit" 2>/dev/null)"
+
+echo "3. the job returned WITHOUT starting the command: 0s plus exit 0 is not a pass"
+run neverran 'exit 0' true
+case "$MSG" in *"NEVER RAN"*) ok "3a the message says NEVER RAN";; *) bad "3a expected NEVER RAN" "$MSG";; esac
+case "$MSG" in *"NOT a verdict"*) ok "3b ... and says the status is not a verdict on the command";; *) bad "3b expected the 'not a verdict' clause" "$MSG";; esac
+[ "$(cat "$BASE.exit" 2>/dev/null)" = 125 ] && ok "3c the exit file is 125, not 0" || bad "3c exit file should be 125" "$(cat "$BASE.exit" 2>/dev/null)"
+[ -e "$BASE.ran" ] && bad "3d the never-ran case must leave no start record" || ok "3d no start record, which is what made it knowable"
+
+echo "4. the elapsed marker is still present (load-bearing evidence, not decoration)"
+case "$MSG" in *" after "*"s"*) ok "4a every message still carries the elapsed marker";; *) bad "4a the elapsed marker must stay" "$MSG";; esac
+
+if [ "$FAIL" -gt 0 ]; then echo "Failed tests: $FAIL"; fi
+printf '%s passed, %s failed\n' "$PASS" "$FAIL"
+[ "$FAIL" = 0 ]

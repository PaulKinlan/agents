+src=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('unmapped_source',{}).get('tools/deploy-thing.sh',''))" <<<"$out")
+[ "$src" = "gate" ] && ok "8c the gate's own marker records EVIDENCE, not inference" || bad "8c expected gate" "$out"
+
+# (c) UNKNOWN publishes no unmapped list, so the provenance map must not outlive the list it describes: a
+#     record naming sources for entries it does not publish is the defect this branch exists to prevent.

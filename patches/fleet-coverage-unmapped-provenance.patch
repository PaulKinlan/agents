+echo "8. agents-tpw5: WHERE each unmapped entry came from (gate marker vs reporter inference)"
+# The whole report rests on this distinction. An entry the gate's own `fast-gate: unmapped:` marker names is
+# EVIDENCE; an entry this tool could not PLACE is its INFERENCE. Both stay in .unmapped and both still make
+# the record PARTIAL - fail-loud is untouched - but the reader can tell them apart, which is what keeps this
+# warning worth reading (see the header: a warning that always fires is one everyone learns to ignore).
+R8=$ROOT/eight; mkdir -p "$R8/tools" "$R8/tests"; new_repo "$R8"
+  printf '#!/bin/sh\n' > "$R8/tools/deploy-thing.sh"; printf 'import unittest\n' > "$R8/tests/test_ops_contract.py"
+  git -C "$R8" add -A; git -C "$R8" -c user.email=t@t -c user.name=t commit -q -m base8
+  printf '# change\n' >> "$R8/tools/deploy-thing.sh"; git -C "$R8" add -A
+  git -C "$R8" -c user.email=t@t -c user.name=t commit -q -m change8
+  SHA8=$(git -C "$R8" rev-parse HEAD)
+
+# (a) the gate ran a suite for the delta but named no omission: the tool cannot PLACE the path -> INFERENCE.
+#     This is the case no stem normalisation can ever reach, because the path is placed by an ARM.
+printf 'fast-gate: running: tests/test_ops_contract.py\nfast-gate: passed: tests/test_ops_contract.py\n' > "$ROOT/log-eight-a.txt"
+out=$(run "$R8" "$ROOT/log-eight-a.txt" "$SHA8")
+src=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('unmapped_source',{}).get('tools/deploy-thing.sh',''))" <<<"$out")
+[ "$src" = "inference" ] && ok "8a an unplaced path is recorded as the tool's INFERENCE" || bad "8a expected inference" "$out"
+st=$(jq_field coverage <<<"$out"); u=$(jq_get unmapped <<<"$out")
+[ "$st" = "PARTIAL" ] && case " $u " in *" tools/deploy-thing.sh "*) ok "8b ... and it is still published and still PARTIAL (fail-loud untouched)";; *) bad "8b fail-loud must not change" "$out";; esac || bad "8b expected PARTIAL" "$out"
+
+# (b) the gate's own marker names it: same file, same run shape -> EVIDENCE. The control that makes 8a a
+#     measurement rather than a decoration.
+printf 'fast-gate: unmapped: tools/deploy-thing.sh\nfast-gate: running: tests/test_ops_contract.py\nfast-gate: passed: tests/test_ops_contract.py\n' > "$ROOT/log-eight-b.txt"

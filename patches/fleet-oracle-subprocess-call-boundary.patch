From a0eb8ce2f6644e222db3056c2f431611e5cc76f6 Mon Sep 17 00:00:00 2001
From: agents-factory-hubpatch <agents-factory-hubpatch@exe.xyz>
Date: Tue, 13 Oct 2026 12:03:51 +0000
Subject: [PATCH] fix(remote): the subprocess arm counts calls, not identifiers
 that end in a verb

1. In find_candidate_tests_for_file(), bound the subprocess/CLI call alternatives with a leading
   \b. `_run(`, `_exec(` and `store.process_run(` were read as `run(`/`exec(`, so a test helper
   whose SIGNATURE or CALL SITE names the changed stem was published as a consumer of it:
   `def _run(self, sandbox: Path, target: Path, findings)` and `self._run(sandbox, target)` were
   both counted as consumers of lib/findings.py. Measured on agents-factory's own tree: 9 phantom
   (suite, module) pairs, 2 of them naming lib/findings.py - the publication-boundary module whose
   omitted list is the signal this oracle exists to give.
2. Strip `def` parameter lists before the scan: a parameter list is never an invocation, so a
   helper named exactly `run(...)` that merely takes the stem as an argument is not a call either.
   Only the signature is removed; the body and every genuine invocation in the file are untouched.
3. Add tests/check-coverage-subprocess.test.sh, which pins both rules plus the four true positives
   they must not lose (a genuine executor, a genuine importer, a real omission still flagged, and
   every verb in the list - check_output included - still matching).

Measured: the reported case (lib/findings.py changed, only its namesake suite run) reports 4
omitted consumers before and 2 after - exactly the two non-consumers (tests/test_path_security.py,
tests/test_pr_fixer_prepass.py) - while `unmapped` keeps naming lib/findings.py, because the two
genuine omissions that remain are real. On the real 89-suite corpus the same case goes 12 -> 10.
---
 remote/check-coverage.py                |  10 +-
 tests/check-coverage-subprocess.test.sh | 181 ++++++++++++++++++++++++
 2 files changed, 190 insertions(+), 1 deletion(-)
 create mode 100755 tests/check-coverage-subprocess.test.sh

diff --git a/remote/check-coverage.py b/remote/check-coverage.py
index e0fda56..ba9e2dd 100755
--- a/remote/check-coverage.py
+++ b/remote/check-coverage.py
@@ -672,8 +672,16 @@ def extract_coverage(log_path, repo_dir, commit_sha, cmd_str=""):
                     cleaned = re.sub(r'`(?:\\.|[^`\\])*`', '', cleaned, flags=re.DOTALL)
                     cleaned = re.sub(r'//.*', '', cleaned)
                     cleaned = re.sub(r'#.*', '', cleaned)
+                    # agents-3avt: a subprocess alternative is a CALL only when it is a whole word, and a
+                    # parameter list is never a call. Without the leading \b, `_run(` and
+                    # `store.process_run(` are read as `run(`, so a test helper whose signature or call
+                    # site names the changed stem - `def _run(self, sandbox: Path, target: Path, findings)`,
+                    # `self._run(sandbox, target)` - was counted as a consumer. Measured on this repo's own
+                    # tree: 9 phantom (suite, module) pairs, 2 of them naming lib/findings.py, the
+                    # publication-boundary module whose omitted list is the signal this oracle exists to give.
+                    cleaned = re.sub(r'\b(?:async\s+)?def\s+[A-Za-z_]\w*\s*\([^)]*\)', ' ', cleaned)
                     subp_pattern = (
-                        r'(?:subprocess|Popen|exec|spawn|run|fork|call|check_output|system)\s*\([^)]*?'
+                        r'\b(?:subprocess|Popen|exec|spawn|run|fork|call|check_output|system)\s*\([^)]*?'
                         r'(?:' + re.escape(file_path) + r'|' + re.escape(base) + r'|\b' + re.escape(stem) + r'(?:\.[a-z]+)?\b)'
                     )
                     if re.search(subp_pattern, cleaned, re.DOTALL):
diff --git a/tests/check-coverage-subprocess.test.sh b/tests/check-coverage-subprocess.test.sh
new file mode 100755
index 0000000..a789545
--- /dev/null
+++ b/tests/check-coverage-subprocess.test.sh
@@ -0,0 +1,181 @@
+#!/usr/bin/env bash
+# tests/check-coverage-subprocess.test.sh — the subprocess/CLI arm of remote/check-coverage.py counts
+# CALLS, not identifiers that merely END in a call name (agents-3avt).
+#
+# THE REPORTED DEFECT, reproduced from agents-factory's own cached fast record for lib/findings.py:
+# the arm's alternatives were unbounded, so `run` matched inside `_run(`, `exec` inside `_exec(`, and so
+# on - and `store.process_run(` matched `run(`. A test helper whose signature or call site merely NAMES
+# the changed stem was therefore published as a consumer of it:
+#
+#     omitted: tests/test_factory_core.py tests/test_path_security.py tests/test_perf_review.py
+#              tests/test_pr_fixer_prepass.py
+#
+# two of those four not being consumers at all (`def _run(self, sandbox: Path, target: Path, findings)`
+# is a parameter list, and `self._run(sandbox, target)` passes a variable that happens to be named
+# `sandbox`). lib/findings.py holds the publication boundary, so omitted-consumer noise there is the
+# worst place to have it: the list this oracle publishes is the only signal that says "the arm is
+# incomplete", and a list with non-consumers in it is a list readers learn to discount.
+#
+# THE TWO RULES THIS FILE PINS, each with the case that fails without it:
+#   (1) a call alternative must be a WHOLE word - `_run(`/`process_run(` are not `run(` (cases 1b-1e);
+#   (2) a `def` parameter list is never an invocation - `def run(self, findings):` is a helper, not a
+#       call, and only the parameter list is removed, never the body (case 1f).
+# AND THE SIGNAL MUST SURVIVE (1f/1g/1h): a genuine invocation, a genuine importer, and a genuine
+# omission are all still reported. A patch that quiets the warning instead of the noise fails here.
+#
+#   bash tests/check-coverage-subprocess.test.sh
+#   COV_OVERRIDE=<other revision> bash tests/check-coverage-subprocess.test.sh   # same fixtures, other oracle
+set -uo pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+TOOL="${COV_OVERRIDE:-$HERE/remote/check-coverage.py}"
+PASS=0; FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n      %s\n' "$1" "${2:-}"; }
+
+# run <repo> <log> <sha> -> JSON from the tool (same call shape as check-coverage.test.sh)
+run() { python3 "$TOOL" "$2" "$1" "$3" "" 2>/dev/null; }
+jq_get() { python3 -c "import json,sys; d=json.load(sys.stdin); print(' '.join(d['$1']))"; }
+
+# new_repo <dir>: the fixtures land on MAIN, and the change under test goes on a work branch.
+# check-coverage.test.sh's new_repo commits the fixtures on the WORK branch instead, which makes every
+# fixture file part of the change set; that is deliberate there (section 7 pins the changed-test-file
+# rule) and wrong here, because this file's subject is the CANDIDATE SET for two changed lib files. A
+# fixture file in the change set is itself reported as an omitted consumer, which would mask the very
+# question case 1b-1e ask.
+new_repo() {
+  git -C "$1" init -q -b main 2>/dev/null || { git -C "$1" init -q; git -C "$1" branch -m main; }
+  git -C "$1" -c user.email=t@t -c user.name=t commit -q --allow-empty -m base
+}
+commit_all() { git -C "$1" add -A && git -C "$1" -c user.email=t@t -c user.name=t commit -q -m "$2"; }
+branch_for_change() { git -C "$1" checkout -q -b work; }
+
+ROOT=$(mktemp -d); trap 'rm -rf "$ROOT"' EXIT
+
+echo "1. the arm counts calls, not identifiers that end in one (agents-3avt)"
+R=$ROOT/one; mkdir -p "$R/lib" "$R/tests"; new_repo "$R"
+
+cat > "$R/lib/findings.py" <<'EOF'
+def bind_severity(value): return value
+EOF
+cat > "$R/lib/sandbox.py" <<'EOF'
+def isolate(): return True
+EOF
+
+# the namesake suites, and the ones the gate ran (so name correspondence can map both modules)
+cat > "$R/tests/test_findings.py" <<'EOF'
+from lib.findings import bind_severity
+EOF
+cat > "$R/tests/test_sandbox.py" <<'EOF'
+from lib.sandbox import isolate
+EOF
+
+# 1b: THE REPORTED SHAPE - a helper whose SIGNATURE names the stem. No import, no invocation of it.
+cat > "$R/tests/test_pr_fixer_prepass.py" <<'EOF'
+import subprocess
+import sys
+from pathlib import Path
+
+class Box:
+    def _run(self, sandbox: Path, target: Path, findings) -> dict:
+        cmd = [sys.executable, "scripts/collect.py", "--target", str(target)]
+        return subprocess.run(cmd, capture_output=True, text=True, timeout=60)
+EOF
+
+# 1c: a CALL SITE passing a variable named for the stem - `self._run(sandbox, target)` is not `run(...)`.
+cat > "$R/tests/test_path_security.py" <<'EOF'
+from pathlib import Path
+
+class Paths:
+    def check(self, sandbox: Path, target: Path):
+        return self._run(sandbox, target)
+
+    def _run(self, sandbox, target):
+        return sandbox
+EOF
+
+# 1d: `store.process_run(` - the verb is the TAIL of a method name, not a call.
+cat > "$R/tests/test_factory_truth.py" <<'EOF'
+class FakeStore:
+    def record(self, store):
+        return store.process_run("findings", [{"path": "x"}])
+EOF
+
+# 1e/1f: a helper named exactly `run` whose PARAMETER LIST names the stem: a parameter list is not an invocation.
+cat > "$R/tests/test_bare_verb_helper.py" <<'EOF'
+class Runner:
+    def run(self, findings):
+        self.seen = findings
+        return self.seen
+EOF
+
+# 1g: THE TRUE POSITIVE - a genuine executor of the module under a suffixed verb name must still be found.
+cat > "$R/tests/test_cli_runner.py" <<'EOF'
+import subprocess
+import sys
+
+class Cli:
+    def go(self):
+        return subprocess.run([sys.executable, "-m", "lib.findings"], capture_output=True, text=True)
+EOF
+
+# 1h: a genuine importer, which the import rule (not this arm) discovers.
+cat > "$R/tests/test_importer.py" <<'EOF'
+from lib.findings import bind_severity
+EOF
+
+commit_all "$R" "add suites"
+branch_for_change "$R"
+echo "# change" >> "$R/lib/findings.py"
+echo "# change" >> "$R/lib/sandbox.py"
+git -C "$R" -c user.email=t@t -c user.name=t commit -q -am "change findings.py and sandbox.py"
+SHA=$(git -C "$R" rev-parse HEAD)
+
+# the gate ran the two namesakes only: every other candidate is an omission, and the question is only
+# WHICH suites are candidates at all.
+printf 'fast-gate: passed: tests/test_findings.py tests/test_sandbox.py\n' > "$ROOT/log.txt"
+out=$(run "$R" "$ROOT/log.txt" "$SHA")
+u=$(jq_get unmapped <<<"$out"); om=$(jq_get omitted <<<"$out")
+
+case " $om " in *" tests/test_cli_runner.py "*) ok "1a a genuine executor under a suffixed name (self.go -> subprocess.run -m lib.findings) is still a candidate";; *) bad "1a genuine executor missed" "omitted: [$om]";; esac
+case " $om " in *" tests/test_pr_fixer_prepass.py "*) bad "1b a helper SIGNATURE naming the stem is published as a consumer (the reported defect)" "omitted: [$om]";; *) ok "1b a helper signature naming the stem is not a consumer";; esac
+case " $om " in *" tests/test_path_security.py "*) bad "1c a call site passing a variable named for the stem is published as a consumer" "omitted: [$om]";; *) ok "1c a suffixed call site naming the stem is not a consumer";; esac
+case " $om " in *" tests/test_factory_truth.py "*) bad "1d process_run( is read as run(" "omitted: [$om]";; *) ok "1d a method name ENDING in a call name is not a call";; esac
+case " $om " in *" tests/test_bare_verb_helper.py "*) bad "1e a def parameter list named for the stem is treated as an invocation" "omitted: [$om]";; *) ok "1e a parameter list is not an invocation";; esac
+case " $om " in *" tests/test_importer.py "*) ok "1f a genuine importer is still reported as an omitted consumer";; *) bad "1f genuine importer lost" "omitted: [$om]";; esac
+
+# THE WARNING MUST KEEP ITS MEANING IN BOTH DIRECTIONS. lib/findings.py really did omit a consumer
+# (test_cli_runner.py, and the importer), so it must STILL read unmapped - the patch removes noise, not
+# the signal. lib/sandbox.py's only "consumers" were the phantoms, and its namesake ran, so the phantom
+# had been publishing an unmapped file on every change to a fully covered module.
+case " $u " in *" lib/findings.py "*) ok "1g a module with a REAL omitted consumer is still flagged unmapped";; *) bad "1g real omission no longer flagged - the patch silenced the signal" "unmapped: [$u]";; esac
+case " $u " in *" lib/sandbox.py "*) bad "1h a covered module is still flagged unmapped (phantom consumers remain)" "unmapped: [$u]";; *) ok "1h a module whose only candidates were phantoms reads mapped";; esac
+
+echo "2. the alternative list is bounded, not narrowed: every verb still matches a genuine call"
+# The patch adds one boundary and one strip; it must not drop the alternatives themselves. `check_output`
+# is the least-used spelling in the list, so it is the one a hand-edit is most likely to lose.
+R2=$ROOT/two; mkdir -p "$R2/lib" "$R2/tests"; new_repo "$R2"
+cat > "$R2/lib/tool.py" <<'EOF'
+def size(): return 0
+EOF
+cat > "$R2/tests/test_tool.py" <<'EOF'
+from lib.tool import size
+EOF
+cat > "$R2/tests/test_check_output_user.py" <<'EOF'
+import subprocess
+import sys
+
+def measure():
+    return subprocess.check_output([sys.executable, "-m", "lib.tool"])
+EOF
+commit_all "$R2" "add suites"
+branch_for_change "$R2"
+echo "# change" >> "$R2/lib/tool.py"
+git -C "$R2" -c user.email=t@t -c user.name=t commit -q -am "change tool.py"
+SHA2=$(git -C "$R2" rev-parse HEAD)
+printf 'fast-gate: passed: tests/test_tool.py\n' > "$ROOT/log2.txt"
+out=$(run "$R2" "$ROOT/log2.txt" "$SHA2"); om=$(jq_get omitted <<<"$out")
+case " $om " in *" tests/test_check_output_user.py "*) ok "2a subprocess.check_output of the module is still a candidate";; *) bad "2a an alternative was dropped by narrowing the list" "omitted: [$om]";; esac
+
+if [ "$FAIL" -gt 0 ]; then echo "Failed tests: $FAIL"; fi
+printf '%s passed, %s failed\n' "$PASS" "$FAIL"
+[ "$FAIL" = 0 ]
-- 

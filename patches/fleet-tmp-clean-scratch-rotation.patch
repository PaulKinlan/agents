+total_reclaimed_kb=$((reclaimed_dead_pids_kb + reclaimed_stale_tmp_kb + reclaimed_scratch_kb + reclaimed_uv_kb + reclaimed_npx_kb + reclaimed_deps_kb + reclaimed_home_kb))
 total_reclaimed_mb=$((total_reclaimed_kb / 1024))
 

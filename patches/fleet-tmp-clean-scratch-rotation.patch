-summary="reclaimed=${total_reclaimed_mb}MB (dead_pids=${dead_pids_count} [${reclaimed_dead_pids_kb}KB], stale_tmp=${stale_tmp_count} [${reclaimed_stale_tmp_kb}KB], uv=${reclaimed_uv_kb}KB, npx=${reclaimed_npx_kb}KB, deps=${reclaimed_deps_kb}KB, home_caches=${reclaimed_home_kb}KB) tmp=${cur_tmp} disk_free=${cur_free} (${cur_pct})"
+summary="reclaimed=${total_reclaimed_mb}MB (dead_pids=${dead_pids_count} [${reclaimed_dead_pids_kb}KB], fleet_scratch=${scratch_count} [${reclaimed_scratch_kb}KB], stale_tmp=${stale_tmp_count} [${reclaimed_stale_tmp_kb}KB], uv=${reclaimed_uv_kb}KB, npx=${reclaimed_npx_kb}KB, deps=${reclaimed_deps_kb}KB, home_caches=${reclaimed_home_kb}KB) tmp=${cur_tmp} disk_free=${cur_free} (${cur_pct})"
 
 if [ "$DRY_RUN" -eq 1 ]; then
   echo "fleet-tmp-clean [dry-run]: $summary"

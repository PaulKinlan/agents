--- a/bin/fleet-gate
+++ b/bin/fleet-gate
@@ -5,7 +5,8 @@
 #   carrying the exit code and the log tail. So: start it, then END YOUR TURN (or do other work).
 #   Never poll it with sleep loops: each poll is a paid model turn on a starved CPU.
 #   Files: /tmp/$FLEET_LANE-<name>.{log,exit,pid,ran}. Exit 124/137/143 = killed by the bound (not a verdict).
-#   125 = the job returned WITHOUT the command ever starting (no .ran record): the message says NEVER RAN,
+#   125 = the job returned WITHOUT the command ever starting (no .ran record): the message says NEVER RAN and
+#   carries the JOB's own status alongside it (143 = killed while waiting, 0 = returned without starting),
 #   and neither 125 nor a 0s elapsed is a pass - read the message, which names which case it is.
 set -uo pipefail
 name=${1:?name}; shift; t=1800
@@ -44,7 +45,12 @@
     # without the command ever starting (a pruned ticket, a fleet-heavy usage error, a launcher that
     # never reached the command). The process that runs the command writes $base.ran as its first act, so "did it run" is an
     # OBSERVED fact rather than an inference from timing. The elapsed marker stays: it is load-bearing.
-    local ran=0
+    # agents-lyrw: keep the status of the JOB before 125 replaces it, because "killed while waiting for a slot"
+    # (143) and "returned without ever starting the command" (0) are different facts and a lane may need the
+    # difference. 125 still goes to .exit so this cannot read as a pass. NOTE for the next editor: this comment
+    # had an apostrophe in its first draft, and that terminates the single-quoted script this runs inside -
+    # the trap agents-wg7i documents - so the wording avoids them deliberately.
+    local ran=0 job_rc=$rc
     [ -e "$base.ran" ] && ran=1
     [ "$ran" = 0 ] && rc=125
     echo "$rc" > "$base.exit"
@@ -55,7 +61,7 @@
     if [ "$ran" = 1 ]; then
       ran_phrase="ran and exited $rc after ${elapsed}s"
     else
-      ran_phrase="NEVER RAN the command: the job returned after ${elapsed}s with no start record, so this is the status of the JOB and NOT a verdict on the command"
+      ran_phrase="NEVER RAN the command: the job returned $job_rc after ${elapsed}s with no start record, so $job_rc is the status of the JOB and NOT a verdict on the command (125 is written to .exit so this cannot read as a pass)"
     fi
     body=$(jq -nc --arg to "$lane" --arg t "[gate] '\''$name'\'' finished: $ran_phrase$pre$( [ "$rc" = 124 ] || [ "$rc" = 137 ] || [ "$rc" = 143 ] && [ -z "$pre" ] && echo " (KILLED by the ${t}s bound: not a pass or fail)"). Log: $base.log. Tail:
 $tail" '\''{to:$to,from_lane:"gate",text:$t}'\'')
--- a/tests/fleet-gate.test.sh
+++ b/tests/fleet-gate.test.sh
@@ -59,6 +59,14 @@
 echo "4. the elapsed marker is still present (load-bearing evidence, not decoration)"
 case "$MSG" in *" after "*"s"*) ok "4a every message still carries the elapsed marker";; *) bad "4a the elapsed marker must stay" "$MSG";; esac
 
+echo "5. a job that never ran names the JOB's own status, because the two cases differ"
+run jneverran 'exit 143' true
+case "$MSG" in *"the job returned 143"*) ok "5a the never-ran message carries the job's status (143 = killed while waiting)";; *) bad "5a expected 'the job returned 143'" "$MSG";; esac
+case "$MSG" in *"NEVER RAN"*) ok "5b ... and it still says NEVER RAN";; *) bad "5b expected NEVER RAN" "$MSG";; esac
+[ "$(cat "$BASE.exit" 2>/dev/null)" = 125 ] && ok "5c .exit is still 125, so it cannot read as a pass" || bad "5c .exit should stay 125" "$(cat "$BASE.exit" 2>/dev/null)"
+run jclean 'exit 0' true
+case "$MSG" in *"the job returned 0"*) ok "5d a clean return without starting is told apart from 143";; *) bad "5d expected 'the job returned 0'" "$MSG";; esac
+
 if [ "$FAIL" -gt 0 ]; then echo "Failed tests: $FAIL"; fi
 printf '%s passed, %s failed\n' "$PASS" "$FAIL"
 [ "$FAIL" = 0 ]

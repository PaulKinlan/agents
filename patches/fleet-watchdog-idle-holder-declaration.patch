diff -ruN a/tests/watchdog-smoke.test.sh b/tests/watchdog-smoke.test.sh
--- a/tests/watchdog-smoke.test.sh	2026-10-14 03:01:08.312003046 +0000
+++ b/tests/watchdog-smoke.test.sh	2026-10-14 03:01:04.647985744 +0000
@@ -480,6 +480,61 @@
 chmod +x "$TEST_DIR/home/fleet/bin/fleet"
 unset NONET_DIR
 
+echo "14. the idle-holder driver reads the lane's OWN declaration (agents-dbxo)"
+# agents-dbxo: THE NUDGE ASKS THE LANE TO DECLARE, THEN FAILS TO READ THE DECLARATION. The "IDLE LANE HOLDING
+# WORK" nudge tells the lane to "add `waiting` to the bead", and the two SIBLING consumers of `in_flight`
+# (`heldWork`, `held`) already exclude a bead carrying a label in EXCUSED (waiting/blocked/parked/...). The
+# nudge and its escalation did not, so a lane that did exactly what it was told was nudged every 20 min forever
+# and the escalation then said the session needed a fresh session or the bead reassigning - a false statement
+# about a lane that had said, in the record, that it was waiting.
+#
+# WHY THE ASSERTION IS ON THE NUDGE'S TEXT AND NOT ON A COUNT: the nudge's text is truncated to 80 chars in
+# the sweep's action list, so the bead LIST is not visible there - the escalation alert (which fires at n>=3)
+# carries `mine.map(i => i.id)` in full, and 14c reads the escalation for exactly that reason.
+idle_fixture() {   # <lane> <min> <beads-json>
+  printf '{"vm":"test-hub","autopilot":"on","lanes":[{"lane":"%s","stopped":false,"running":true,"busy":false,"pi_alive":true,"children":[],"gates":0,"last_event_min":%s,"turn_age_min":null,"last_turn_min":%s}],"beads":{"in_flight":%s,"in_review":[],"ready_unassigned":0,"ready_noauto":0,"merge_queue":[],"stages":{"working":1}},"host":{"disk_used_pct":50,"load1":0.5,"cpus":2}}' \
+    "$1" "$2" "$2" "$3" > "$TEST_DIR/status.json"
+}
+
+# 14a: a lane whose ONLY in-flight bead is `waiting` is NOT nudged, and nothing is armed for it. This is the
+# bead's live case: a lane genuinely waiting on a reviewer slot, parked by its own label.
+idle_fixture impl-wait 20 '[{"id":"b-wait","assignee":"test-hub-impl-wait","labels":["waiting"],"updated_min":20}]'
+run_wd >/dev/null
+nudge_14a=$(jq -r '[.actions[]? | select(.what | test("message impl-wait"))] | length' "$TEST_DIR/home/.fleet/watchdog/latest.json")
+armed_14a=$(jq -r '.idleHoldNudges["test-hub|test-hub-impl-wait"] // 0' "$TEST_DIR/home/.fleet/watchdog/state.json")
+[ "$nudge_14a" = "0" ] && [ "$armed_14a" = "0" ] && pass '14a a lane holding only a `waiting` bead is not nudged (the declaration is read)' \
+  || fail "14a waiting-declared lane was nudged ($nudge_14a) and armed ($armed_14a): actions=$(jq -c .actions "$TEST_DIR/home/.fleet/watchdog/latest.json")"
+
+# 14b CONTROL: an UNDECLARED idle holder is still nudged with the bead's own words, so the fix cannot pass by
+# deleting the driver. A change that simply stopped nudging anyone would turn 14b red.
+idle_fixture impl-idle 20 '[{"id":"b-idle","assignee":"test-hub-impl-idle","labels":[],"updated_min":20}]'
+run_wd >/dev/null
+act_14b=$(jq -r '.actions[]? | select(.what | test("message impl-idle: YOU ARE IDLE WITH WORK CLAIMED")) | .what' "$TEST_DIR/home/.fleet/watchdog/latest.json")
+[ -n "$act_14b" ] && pass "14b an undeclared idle holder IS still nudged (the driver still fires)" \
+  || fail "14b undeclared idle holder was not nudged: actions=$(jq -c .actions "$TEST_DIR/home/.fleet/watchdog/latest.json")"
+
+# 14c: a MIXED holder is still nudged, and the escalation names ONLY the bead it has not excused. Seed the
+# strike count at 2 so this single sweep crosses the n>=3 escalation threshold the way a real lane would after
+# three sweeps (the 20-min `idlehold:` cooldown otherwise keeps a second sweep from nudging again).
+idle_fixture impl-mix 20 '[{"id":"b-mix-keep","assignee":"test-hub-impl-mix","labels":[],"updated_min":20},{"id":"b-mix-wait","assignee":"test-hub-impl-mix","labels":["waiting"],"updated_min":20}]'
+jq '.idleHoldNudges["test-hub|test-hub-impl-mix"] = 2' "$TEST_DIR/home/.fleet/watchdog/state.json" > "$TEST_DIR/st.json" && mv "$TEST_DIR/st.json" "$TEST_DIR/home/.fleet/watchdog/state.json"
+run_wd >/dev/null
+esc_14c=$(jq -r '.alerts[]? | select(.key=="idlehold:test-hub:test-hub-impl-mix") | .text' "$TEST_DIR/home/.fleet/watchdog/latest.json")
+if [[ "$esc_14c" == *"b-mix-keep"* ]] && [[ "$esc_14c" != *"b-mix-wait"* ]]; then
+  pass "14c the escalation names only the bead the lane has NOT excused"
+else
+  fail "14c mixed holder escalation wrong (expected b-mix-keep and not b-mix-wait): '$esc_14c'"
+fi
+
+# 14d: the escalated lane's strike count is CLEARED once every bead it holds is excused, so the alert cannot
+# outlive the condition (the same statement the siblings' cleanup makes).
+idle_fixture impl-mix 20 '[{"id":"b-mix-keep","assignee":"test-hub-impl-mix","labels":["waiting"],"updated_min":20},{"id":"b-mix-wait","assignee":"test-hub-impl-mix","labels":["blocked"],"updated_min":20}]'
+run_wd >/dev/null
+armed_14d=$(jq -r '.idleHoldNudges["test-hub|test-hub-impl-mix"] // "cleared"' "$TEST_DIR/home/.fleet/watchdog/state.json")
+alert_14d=$(jq -r '.alerts["idlehold:test-hub:test-hub-impl-mix"] // "cleared"' "$TEST_DIR/home/.fleet/watchdog/state.json")
+[ "$armed_14d" = "cleared" ] && [ "$alert_14d" = "cleared" ] && pass "14d the strike count and alert clear once the lane has excused every bead it holds" \
+  || fail "14d excused lane kept its escalation (nudges=$armed_14d alert=$alert_14d)"
+
 echo
 echo "watchdog smoke: $passes passed, $fails failed"
 [ $fails -eq 0 ]

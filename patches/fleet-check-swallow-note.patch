   [ "$st" = INCONCLUSIVE ] && note=" - NOT a verdict (worktree vanished or inconclusive exit): not cached, run fleet-check again"
+  # agents-o7b8: A CONFIG THAT SWALLOWS ITS OWN FAILURE CAN STILL BE RECORDED AS PASS. The information is not
+  # hidden, it is GONE - `cmd || true` discards the status before any runner can observe it, and a trailing
+  # `echo`/`printf` also PRINTS, which is what makes a doomed gate look like one that ran. This is a NOTE: it
+  # refuses nothing and moves no state, exactly like the in-repo reader half in tools/check-cmd.sh (agents-xxgk),
+  # whose swallowing_tail() this is ported from. SELF-CONTAINED ON PURPOSE: finish() is extracted and run in
+  # isolation by an arm, and a dependency on anything outside this fragment is the defect that family finds.
+  local swallow_note="" _gate_cmd _st_tail _st_first _st_rest
+  _gate_cmd=$(jq -r '.cmd // ""' "$rec" 2>/dev/null || echo "")
+  if [ -n "$_gate_cmd" ]; then
+    _gate_cmd="${_gate_cmd%"${_gate_cmd##*[![:space:]]}"}"     # trailing whitespace would hide the tail
+    _st_tail="$_gate_cmd"
+    case "$_st_tail" in *'|| '*) _st_tail="${_st_tail##*|| }" ;; esac      # ## is greedy: the LAST one wins
+    case "$_st_tail" in *'; '*) _st_rest="${_st_tail##*; }"; [ -n "$_st_rest" ] && _st_tail="$_st_rest" ;; esac
+    _st_first="${_st_tail%% *}"; _st_rest="${_st_tail#"$_st_first"}"; _st_rest="${_st_rest# }"
+    case "$_st_first" in
+      true|:|/bin/true) ;;                                      # discards the status, says nothing
+      exit)             [ "${_st_rest% }" = "0" ] || _st_tail="" ;;   # exit 0 discards it explicitly
+      echo|printf)      ;;                                      # prints a plausible line AND succeeds
+      *)                _st_tail="" ;;                          # not a swallowing shape: stay silent
+    esac
+    if [ -n "$_st_tail" ]; then
+      swallow_note=" [SWALLOWING CONFIG: the gate command ends with '$_st_tail', which DISCARDS the failure of what precedes it, so a PASS here may be unfounded - agents-o7b8]"
+    fi
+  fi

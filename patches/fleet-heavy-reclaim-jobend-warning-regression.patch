--- a/tests/fleet-heavy-reclaim.test.sh
+++ b/tests/fleet-heavy-reclaim.test.sh
@@ -111,6 +111,32 @@
   || fail "one.txt is gone: the archive destroyed the only copy"
 rm -rf "$D"
 
+echo "8. the job-end sweep warns on a REAL leak and NEVER on its own instrument (agents-lhnb / agents-s7vx)"
+# The false positive this guards: at job end the release sweep listed its OWN pipeline - the fork, the
+# `grep -v ^<pid>$` and the `tr \n` - as leaked descendants, so every gate that ran printed a warning that
+# nothing had leaked. Section 6 above does NOT catch a regression: it asserts only that the command
+# substitution SURVIVES the sweep, and it never looks at the warning at all.
+# TWO assertions, because either one alone is satisfied by a broken tool: a sweep that was DELETED passes the
+# silent half, and a sweep that fires on everything passes the leak half.
+newdir; export FLEET_HEAVY_DIR=$D
+out=$(timeout 30 bash "$H" true 2>&1); rc=$?
+[ "$rc" = 0 ] && pass "8a a clean job exits 0" || fail "a clean job exited $rc: $out"
+case "$out" in *"descendants still held"*)
+    fail "8b a clean job printed the FALSE job-end warning: $(printf '%s' "$out" | head -1)" ;;
+  *) pass "8b a clean job prints NO job-end warning" ;; esac
+out=$(timeout 30 bash "$H" bash -c 'setsid sleep 297 >/dev/null 2>&1 & echo "HUSK=$!"; echo JOB_RAN' 2>&1)
+husk=$(printf '%s\n' "$out" | sed -n 's/^HUSK=\([0-9][0-9]*\).*/\1/p' | head -1)
+case "$out" in *JOB_RAN*) pass "8c the leaking job ran" ;; *) fail "the leaking job did not run: $out" ;; esac
+case "$out" in *"descendants still held"*) pass "8d a real leaked descendant DOES produce the job-end warning" ;;
+  *) fail "8d no warning for a real leaked husk: $out" ;; esac
+if [ -n "$husk" ]; then
+  case "$out" in *"$husk"*) pass "8e the warning names the leaked husk (pid $husk)" ;;
+    *) fail "8e the warning does not name the leaked husk $husk: $out" ;; esac
+else fail "8e could not read the husk pid from: $out"; fi
+sleep 2
+st=$(timeout 10 bash "$H" --status 2>&1 | head -1)
+case "$st" in *free*) pass "8f and the slot is free afterwards" ;; *) fail "slot leaked: $st" ;; esac
+kill "$husk" 2>/dev/null; rm -rf "$D"
 echo
-printf 'fleet-heavy reclaim: %s passed, %s failed\n' "$((14-fails))" "$fails"
+printf 'fleet-heavy reclaim: %s passed, %s failed\n' "$((20-fails))" "$fails"
 [ "$fails" -eq 0 ]

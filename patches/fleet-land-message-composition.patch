+. "$LIB"
+if [ "$(type -t fleet_verdict_transcribed_run_status)" != "function" ]; then
+  echo "FAIL: fleet_verdict_transcribed_run_status is not defined in $LIB"; exit 2
+fi
+
+pass=0; fail=0
+ck() {  # ck <name> <expected-prefix> <actual>
+  case "$3" in
+    "$2"*) echo "  ok   $1"; pass=$((pass + 1)) ;;
+    *)     echo "  FAIL $1"; echo "         expected prefix: $2"; echo "         got:             $3"; fail=$((fail + 1)) ;;
+  esac
+}
+ckempty() {  # a case whose correct answer is SILENCE: ckempty <name> <actual>
+  if [ -z "$2" ]; then echo "  ok   $1"; pass=$((pass + 1));
+  else echo "  FAIL $1: expected no output, got '$2'"; fail=$((fail + 1)); fi
+}
+
+root=$(mktemp -d); trap 'rm -rf "$root"' EXIT
+mkrun() {  # mkrun <root> <id> <agent> <model>
+  mkdir -p "$1/pi-subagents-uid-0/async-subagent-runs/$2"
+  printf '{"agent":"%s","model":"%s"}\n' "$3" "$4" \
+    > "$1/pi-subagents-uid-0/async-subagent-runs/$2/recovery-descriptor.json"
+}
+
+RID=ffc6fb50-d7de-4f8f-a290-21a818b4df13
+RID2=57240566-a1b8-4a09-8480-2339ba04a583
+NOREAD=11111111-2222-3333-4444-555555555555
+OUTSIDE=99999999-8888-7777-6666-555555555555
+
+mkrun "$root" "$RID"  reviewer "antigravity/gemini-3.8-flash:high"
+mkrun "$root" "$RID2" worker   "openai-codex/gpt-6-sol:high"
+mkdir -p "$root/pi-subagents-uid-0/async-subagent-runs/$NOREAD"   # directory, no descriptor file
+
+echo "fleet_verdict_transcribed_run_status:"
+
+# 1. The ordinary case: a real reviewer run, named the way a hand-off would name it (no suffix).
+ck "1 a retained reviewer run of the named family" "verified" \
+  "$(fleet_verdict_transcribed_run_status "$RID" "antigravity/gemini-3.8-flash" "$root")"
+
+# 2. Family, not exact string: the fleet compares the provider segment, so a version difference
+#    within the same provider still resolves. Stated because it is a deliberate leniency.
+ck "2 same family, different version" "verified" \
+  "$(fleet_verdict_transcribed_run_status "$RID" "antigravity/gemini-3.9-pro" "$root")"
+
+# 3. The falsifiable direction: a fabricated run id must NOT verify. This is the case that makes the
+#    check worth having - before this, any model string at all cleared a same-lane verdict.
+ck "3 a fabricated run id does not verify" "unverified:" \
+  "$(fleet_verdict_transcribed_run_status "$OUTSIDE" "antigravity/gemini-3.8-flash" "$root")"
+
+# 4. A run that exists but is not a review.
+ck "4 a worker run is not a review" "unverified:" \
+  "$(fleet_verdict_transcribed_run_status "$RID2" "openai-codex/gpt-6-sol" "$root")"
+
+# 5. A reviewer run of the WRONG family must not back a claim of a different one.
+ck "5 reviewer run of another family" "unverified:" \
+  "$(fleet_verdict_transcribed_run_status "$RID" "openai-codex/gpt-6-sol" "$root")"
+
+# 6. A run directory without a descriptor is not evidence.
+ck "6 run directory with no descriptor" "unverified:" \
+  "$(fleet_verdict_transcribed_run_status "$NOREAD" "antigravity/gemini-3.8-flash" "$root")"
+
+# 7. No run id at all is silence from the helper - the CALLER decides that silence means unverified,
+#    so the helper must not invent a reason here.
+ckempty "7 no run id produces no verdict from the helper" \
+  "$(fleet_verdict_transcribed_run_status "" "antigravity/gemini-3.8-flash" "$root")"
+
+# 8. Roots are searched, not assumed: a run in a second root resolves. A helper that only looked at
+#    one hardcoded path would pass cases 1-7 and fail here.
+root2=$(mktemp -d); mkdir -p "$root2"
+mkrun "$root2" "$RID" reviewer "antigravity/gemini-3.8-flash"
+# the function globs <root>/pi-subagents-*/, so nesting the root one level deeper must still be found
+ck "8 a second run root is searched" "verified" \
+  "$(fleet_verdict_transcribed_run_status "$RID" "antigravity/gemini-3.8-flash" "$root2")"
+
+echo
+echo "$pass passed, $fail failed"
+[ "$fail" -eq 0 ]

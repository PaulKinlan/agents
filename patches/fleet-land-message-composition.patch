+
+HERE=$(cd "$(dirname "$0")" && pwd)
+LIB=${FLEET_VERDICT_WORDS_LIB:-$(dirname "$HERE")/bin/fleet-verdict-words.sh}
+if [ ! -r "$LIB" ]; then echo "cannot read $LIB"; exit 2; fi
+# shellcheck source=/dev/null
+. "$LIB"
+if [ "$(type -t fleet_verdict_transcribed_run_status)" != "function" ]; then
+  echo "FAIL: fleet_verdict_transcribed_run_status is not defined in $LIB"; exit 2
+fi
+
+pass=0; fail=0
+ck() {  # ck <name> <expected-prefix> <actual>
+  case "$3" in
+    "$2"*) echo "  ok   $1"; pass=$((pass + 1)) ;;
+    *)     echo "  FAIL $1"; echo "         expected prefix: $2"; echo "         got:             $3"; fail=$((fail + 1)) ;;
+  esac
+}
+ckempty() {  # a case whose correct answer is SILENCE: ckempty <name> <actual>
+  if [ -z "$2" ]; then echo "  ok   $1"; pass=$((pass + 1));
+  else echo "  FAIL $1: expected no output, got '$2'"; fail=$((fail + 1)); fi

--- a/bin/bd
+++ b/bin/bd
@@ -35,0 +36,79 @@
+# agents-gb2w: the plural comment command has NO --stdin flag. A positional '-' is
+# stored literally (a successful, empty-looking verdict), so route only that text
+# argument through its supported --file option. The real bd 1.3.1 accepts
+# --file - as stdin, preserving trailing newlines and refusing empty bodies.
+if [ "${1:-}" = comments ] && [ "${2:-}" = add ]; then
+  __i=3
+  while [ "$__i" -le "$#" ]; do
+    eval "__a=\${$__i}"
+    case "$__a" in
+      -a|--author|-f|--file|--actor|--db|--database|-C|--directory|--dolt-auto-commit|--mem-profile)
+        __i=$((__i+2)); continue ;;  # '-' may be a FLAG VALUE, not comment text
+      -)
+        if [ -t 0 ]; then
+          echo "bd: REFUSED (agents-gb2w): 'bd comments add <id> -' needs piped/file stdin; use --file <path> for a terminal." >&2
+          exit 2
+        fi
+        set -- "${@:1:$((__i-1))}" --file - "${@:$((__i+1))}"
+        break ;;
+    esac
+    __i=$((__i+1))
+  done
+fi
+
+# `note` (unlike plural comments) documents --stdin. The dash in its body is
+# otherwise stored literally, so give it the same safe route as singular comment.
+if [ "${1:-}" = note ]; then
+  __i=2
+  while [ "$__i" -le "$#" ]; do
+    eval "__a=\${$__i}"
+    case "$__a" in
+      --file|--actor|--db|--database|-C|--directory|--dolt-auto-commit|--mem-profile)
+        __i=$((__i+2)); continue ;;  # --file - is already an explicit stdin route
+      -)
+        if [ -t 0 ]; then
+          echo "bd: REFUSED (agents-gb2w): 'bd note <id> -' needs piped/file stdin; use --stdin or --file <path>." >&2
+          exit 2
+        fi
+        set -- "${@:1:$((__i-1))}" --stdin "${@:$((__i+1))}"
+        break ;;
+    esac
+    __i=$((__i+1))
+  done
+fi
+
+# String flags do not interpret '-' as stdin. Refuse rather than silently store
+# it, and never rewrite --notes to --stdin: bd uses THAT flag for description.
+# Explicit --reason-file - / --body-file - forms remain the caller's choice.
+case "${1:-}" in
+  create|update|close)
+    __previous=""
+    for __a in "$@"; do
+      case "$__a" in
+        --notes=-|--append-notes=-|--reason=-|-r=-|-r-|--description=-|-d=-|-d-|--design=-|--acceptance=-|--context=-|--title=-)
+          echo "bd: REFUSED (agents-gb2w): '$__a' stores a literal dash, not stdin; pass text explicitly, or use a documented file/stdin flag for that field." >&2
+          exit 2 ;;
+        -)
+          case "$__previous" in
+            --notes|--append-notes|--reason|-r|--description|-d|--design|--acceptance|--context|--title)
+              echo "bd: REFUSED (agents-gb2w): '$__previous -' stores a literal dash, not stdin; pass text explicitly, or use a documented file/stdin flag for that field." >&2
+              exit 2 ;;
+          esac ;;
+      esac
+      __previous="$__a"
+    done ;;
+esac
+
+# An initial global flag can hide the subcommand from the narrow dispatch
+# above. Fail loudly for any remaining bare '-' rather than letting it reach
+# a text-writing verb as a successful one-character body.
+case "${1:-}" in
+  -*) for __a in "$@"; do
+        case "$__a" in
+          -|--notes=-|--append-notes=-|--reason=-|-r-|--description=-|-d-|--design=-|--acceptance=-|--context=-|--title=-)
+            echo "bd: REFUSED (agents-gb2w): dash text with leading global flags is ambiguous; put the subcommand first and use its explicit stdin flag." >&2
+            exit 2 ;;
+        esac
+      done ;;
+esac
+
--- /dev/null
+++ b/tests/bd-comments-dash.test.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+# agents-gb2w: bare '-' never silently becomes comment, note, or flag text.
+# Hermetic: temp HOME + stub real bd. The real embedded-Dolt persistence proof is
+# on the bead, not executed in this suite or against any live database.
+set -u -o pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+SHIM=${BD_SHIM_OVERRIDE:-$HERE/bin/bd}
+PASS=0 FAIL=0
+ok() { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s: %s\n' "$1" "$2"; }
+assert() { if eval "$1"; then ok "$2"; else bad "$2" "$1"; fi; }
+ROOT=$(mktemp -d); trap 'rm -rf "$ROOT"' EXIT
+T="$ROOT/home"; mkdir -p "$T/.local/bin" "$T/.fleet"
+export BD_ARGV="$ROOT/argv" BD_BODY="$ROOT/body" BD_CALLED="$ROOT/called"
+cat > "$T/.local/bin/bd" <<'STUB'
+#!/usr/bin/env bash
+: > "$BD_CALLED"
+printf 'ARG:%s\n' "$@" > "$BD_ARGV"
+: > "$BD_BODY"
+for (( i=1; i<=$#; i++ )); do
+  a=${!i}
+  if [ "$a" = --file ] || [ "$a" = --stdin ]; then
+    if [ "$a" = --file ]; then next=$((i+1)); [ "${!next:-}" = - ] || continue; fi
+    cat > "$BD_BODY"
+    # Match the real CLI's verified empty/whitespace comment+note refusal.
+    if ! grep -q '[^[:space:]]' "$BD_BODY"; then echo 'Error: text cannot be empty' >&2; exit 1; fi
+    break
+  fi
+done
+printf 'stub bd ok\n'
+STUB
+chmod +x "$T/.local/bin/bd"
+shim() { HOME="$T" FLEET_ROLE=implementer bash "$SHIM" "$@"; }
+reset() { rm -f "$BD_ARGV" "$BD_BODY" "$BD_CALLED"; }
+
+printf '1. plural add rewrites only the body, preserves bytes and author\n'
+reset
+printf 'VERDICT: PASS\nDelta: base..tip\n' | shim comments add bead-1 - > "$ROOT/out" 2> "$ROOT/err"
+rc=$?
+assert '[ "$rc" -eq 0 ]' 'plural piped verdict succeeds'
+assert 'grep -qx "ARG:--file" "$BD_ARGV" && grep -qx "ARG:-" "$BD_ARGV"' 'plural uses its supported --file - stdin route'
+assert '[ "$(grep -c "^ARG:-$" "$BD_ARGV")" -eq 1 ]' 'only one dash reaches bd, as the --file value, not comment text'
+assert 'cmp -s "$BD_BODY" <(printf "VERDICT: PASS\nDelta: base..tip\n")' 'multiline body incl trailing newline is byte-exact'
+reset
+printf 'with author\n' | shim comments add -a reviewer bead-1 - > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:reviewer" "$BD_ARGV" && grep -qx "ARG:--file" "$BD_ARGV"' 'author option before id stays intact'
+
+printf '2. stdin empty/whitespace or tty is refused without a stored dash\n'
+for content in empty whitespace; do
+  reset
+  if [ "$content" = empty ]; then printf '' | shim comments add bead-1 - > "$ROOT/out" 2> "$ROOT/err"; else printf ' \n\t' | shim comments add bead-1 - > "$ROOT/out" 2> "$ROOT/err"; fi
+  rc=$?
+  assert '[ "$rc" -ne 0 ] && ! grep -qx "ARG:VERDICT: PASS" "${BD_ARGV:-/dev/null}" 2>/dev/null' "$content plural body refuses instead of storing dash"
+done
+reset
+script -qec "HOME='$T' BD_ARGV='$BD_ARGV' BD_CALLED='$BD_CALLED' FLEET_ROLE=implementer bash '$SHIM' comments add bead-1 -" /dev/null > "$ROOT/tty" 2>&1
+rc=$?
+assert '[ "$rc" -ne 0 ] && grep -q "REFUSED" "$ROOT/tty" && [ ! -f "$BD_CALLED" ]' 'tty dash refuses before real bd'
+
+printf '3. flag values and ordinary invocations are NOT reinterpreted\n'
+reset
+shim comments add bead-1 -f - > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:-f" "$BD_ARGV" && grep -qx "ARG:-" "$BD_ARGV" && ! grep -qx "ARG:--file" "$BD_ARGV"' 'dash that is a -f value stays an unchanged flag value'
+reset
+shim comments add bead-1 'plain body' > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:plain body" "$BD_ARGV" && ! grep -qx "ARG:--file" "$BD_ARGV"' 'plain plural body untouched'
+reset
+shim comments bead-1 --json > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:--json" "$BD_ARGV" && ! grep -qx "ARG:--file" "$BD_ARGV"' 'plural listing untouched'
+
+printf '4. note uses its own documented stdin route\n'
+reset
+printf 'review note\n' | shim note bead-1 - > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:--stdin" "$BD_ARGV" && ! grep -qx "ARG:-" "$BD_ARGV" && cmp -s "$BD_BODY" <(printf "review note\n")' 'note body read from stdin byte-exact'
+reset
+script -qec "HOME='$T' BD_ARGV='$BD_ARGV' BD_CALLED='$BD_CALLED' FLEET_ROLE=implementer bash '$SHIM' note bead-1 -" /dev/null > "$ROOT/tty-note" 2>&1
+rc=$?
+assert '[ "$rc" -ne 0 ] && [ ! -f "$BD_CALLED" ]' 'note tty dash refused before real bd'
+reset
+printf 'note with actor\n' | shim note --actor reviewer bead-1 - > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:reviewer" "$BD_ARGV" && grep -qx "ARG:--stdin" "$BD_ARGV" && cmp -s "$BD_BODY" <(printf "note with actor\n")' 'note scans past a value flag before the body'
+reset
+printf 'explicit note file stdin\n' | shim note bead-1 --file - > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:--file" "$BD_ARGV" && grep -qx "ARG:-" "$BD_ARGV" && ! grep -qx "ARG:--stdin" "$BD_ARGV"' 'explicit note --file - value is not rewritten'
+
+printf '5. string flags cannot silently store a dash (wrong-field rewrite is forbidden)\n'
+for spec in 'update bead-1 --notes -' 'update bead-1 --append-notes=-' 'close bead-1 --reason -' 'close bead-1 -r-' 'create --description=-'; do
+  reset
+  # Only constant fixture tokens, no external input/eval in a live command.
+  read -r -a args <<< "$spec"
+  shim "${args[@]}" > "$ROOT/out" 2> "$ROOT/err"
+  rc=$?
+  assert '[ "$rc" -eq 2 ] && grep -q "REFUSED" "$ROOT/err" && [ ! -f "$BD_CALLED" ]' "$spec fails loudly before real bd"
+done
+reset
+shim close bead-1 --reason-file - > "$ROOT/out" 2> "$ROOT/err"
+assert 'grep -qx "ARG:--reason-file" "$BD_ARGV" && grep -qx "ARG:-" "$BD_ARGV"' 'documented reason-file stdin route untouched'
+reset
+shim --no-color comments add bead-1 - > "$ROOT/out" 2> "$ROOT/err"
+rc=$?
+assert '[ "$rc" -eq 2 ] && grep -q "REFUSED" "$ROOT/err" && [ ! -f "$BD_CALLED" ]' 'leading-global-flag ambiguity refuses rather than dropping verdict'
+reset
+shim --no-color update bead-1 --notes=- > "$ROOT/out" 2> "$ROOT/err"
+rc=$?
+assert '[ "$rc" -eq 2 ] && grep -q "REFUSED" "$ROOT/err" && [ ! -f "$BD_CALLED" ]' 'leading global flag with --notes=- cannot hide the dash'
+
+printf '%s passed, %s failed\n' "$PASS" "$FAIL"
+[ "$FAIL" -eq 0 ]

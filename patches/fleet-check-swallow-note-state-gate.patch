--- a/bin/fleet-check
+++ b/bin/fleet-check
@@ -532,7 +532,13 @@
       echo|printf)      ;;                                      # prints a plausible line AND succeeds
       *)                _st_tail="" ;;                          # not a swallowing shape: stay silent
     esac
-    if [ -n "$_st_tail" ]; then
+    # agents-nuyw: THE NOTE IS GATED ON THE STATE, NOT ONLY ON THE SHAPE. The sentence is a claim about a PASS
+    # being unfounded, so it must not be attached to a row that is not a PASS. FAIL cannot carry a swallowing
+    # shape at all - st comes from `case $rc in 0) PASS;; 124|137|143|126|127|254|255) KILLED;; *) FAIL;;` and every
+    # shape this detector accepts exits 0 - but UNKNOWN, KILLED, INCONCLUSIVE and STALE CAN, and on those the
+    # sentence would be about a PASS that does not exist. No reworded variant is emitted for them: the note exists
+    # to stop a FALSE GREEN, and a non-PASS row is already not a green, so a second sentence there is noise.
+    if [ -n "$_st_tail" ] && [ "$st" = PASS ]; then
       swallow_note=" [SWALLOWING CONFIG: the gate command ends with '$_st_tail', which DISCARDS the failure of what precedes it, so a PASS here may be unfounded - agents-o7b8]"
     fi
   fi

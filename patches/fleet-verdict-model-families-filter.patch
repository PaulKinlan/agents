+# 36i: FLEET_VERDICT_MODEL_FAMILIES allows custom family in REV_CAND and VPFX
+cat > "$B" <<J
+[{"author":"test-vm-imp-x","created_at":"2026-10-12T10:00:00Z",
+  "text":"LAND-SUMMARY\nWHAT: guard\nWHY: safety\nEFFECT: none"},
+ {"author":"test-vm-imp-x","created_at":"2026-10-12T11:00:00Z",
+  "text":"Independent Reviewer: customfamily/model-x (run 11111111-2222-3333-4444-555555555555) -> VERDICT: PASS\nDelta: tk-5br9 main..$t_new branch fleet/rebase5br9"}]
+J
+j36i_default=$(run --print-json tk-5br9 fleet/rebase5br9)
+eq "$(jq -r '.review.state' <<<"$j36i_default")" "NONE" "36i1 off-list custom family not recognized by default"
+
+j36i_custom=$(FLEET_VERDICT_MODEL_FAMILIES="customfamily|deepseek|zai|kimi|kimi-coding|antigravity|openai-codex|qwen-token-plan-individual|pi-claude-code-provider|qwen|gemini|openai|anthropic|claude" run --print-json tk-5br9 fleet/rebase5br9)

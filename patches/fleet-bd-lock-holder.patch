 tests/bd-lock-holder.test.sh | 297 +++++++++++++++++++++++++++++++++
 2 files changed, 605 insertions(+), 1 deletion(-)
 create mode 100644 tests/bd-lock-holder.test.sh

diff --git a/bin/bd b/bin/bd
index 723856f..3c8e909 100755
--- a/bin/bd
+++ b/bin/bd
@@ -246,6 +246,286 @@ guard_worktree_beads_decoy() {
 
 guard_worktree_beads_decoy "$@"
 
+# ------------------------------------------------ agents-elu6 ------------------------------------------------
+# A CONTENDED LOCK MUST NAME ITS HOLDER, AND THE WAIT MUST BE VISIBLE AND BOUNDED.
+#
+# Measured 2026-10-13 (rev-fnko): a COMPLETE review could not record its verdict for more than four minutes
+# because another lane's `bd dolt push` held this lock for the whole network round-trip of its child
+# `git push --force-with-lease refs/dolt/data` against origin. `flock -w 300` waits in SILENCE and then
+# exits 1 with NO OUTPUT AT ALL (measured), so a lane holding a finished result produces no output for
+# minutes and looks IDLE: neither the lane nor the fleet board can tell a slow holder from a hang. It is
+# the zombie-lane and silent-spawn failure shape, one layer lower.
+#
+# THE HOLDER NAMES ITSELF. While it holds the lock, the holder writes one record line into the lock FILE
+# (a lock object, never a data file: flock's lock is on the fd/inode, so writing the record does not
+# disturb it) and clears it before releasing. A waiter that cannot take the lock reads that record and
+# reports the holder's lane, pid and operation, and how long it has held it - plus, while it waits, the
+# holder's descendant processes, which is where the minutes actually go (`git`).
+#
+# A DIAGNOSTIC MUST NOT NEED THE CONTENT IT IS DIAGNOSING (agents-zoch), AND THAT HAS TO HOLD FOR EVERY
+# FIELD AND EVERY POSITION. rev-elu6 defeated the first version - which stored the holder's full argv - by
+# DRIVING it rather than reading it: `bd comment issue-x SENTINEL-PRIVATE-PAYLOAD` put that text into the
+# shared lock file AND into the waiting lane's stderr. Both surfaces are other people's: the lock file is
+# shared by every lane on the VM and the report is written into a lane that is not the one that typed the
+# text, and bead text can be anything an operator or an agent typed. So there is no filtering anywhere
+# below: EVERY reported value is either a fixed vocabulary word (operations, process names, roles), a
+# validated integer (pid, timestamp), or a lane name that the fleet's own registry on this VM vouches for.
+# Anything else becomes the literal `unrecognised` / `other` / `unregistered` / `unknown`.
+#
+# Why vocabulary rather than sanitising: a filter has to anticipate the payload, a vocabulary cannot
+# express one. That is the same fail-closed shape the reviewer guard above uses. It also has to cover the
+# positions that look harmless - the adversarial pairs that a filter-shaped fix misses, each measured
+# against the first version of this patch:
+#   * the SUBCOMMAND position can hold freeform text:      `bd "<private text>" ...`
+#   * `FLEET_LANE`/`FLEET_ROLE` are ENVIRONMENT, so the holder copies what an actor set: lane=<private text>
+#   * the RECORD ITSELF is writable by anyone (0644), so a planted line's pid/lane/role/since/cmd all reach
+#     another lane's stderr
+#   * a DESCENDANT's argv is freeform too (`ps -o args=`): `git commit -m '<private text>'`
+# Validating on both sides - the writer only writes validated values, the waiter only prints validated
+# values - is what makes a planted record no more dangerous than an honest one.
+#
+# Reports go to STDERR: bd writes JSON on stdout for callers such as `bd show --json`, and a message there
+# would corrupt a parse.
+#
+# The wait keeps its 300s of patience by default (FLEET_BD_LOCK_WAIT overrides it), but is no longer silent:
+# one report on first contention, then at most one every FLEET_BD_LOCK_REPORT seconds (default 30), so a
+# waiting lane has visible progress instead of a dead tool call. On expiry it fails FAST with EX_TEMPFAIL
+# (75) and the holder named, so the caller can retry in seconds rather than block for minutes - and the
+# durable order is `bd comment` (the artefact) BEFORE the label and status writes (the state), so a retry
+# never loses the thing that matters.
+fleet_bd_lock_word() {
+  # ONE vocabulary word, or a literal that says "not in the vocabulary". Never a copy of the input.
+  case "$1" in
+    show|comments|list|search|ready|query|children|blocked|provenance|prime|status|url|help|version|\
+    create|comment|note|dep|link|label|q|remember|update|close|reopen|delete|\
+    sync|worktree|gate|heartbeat|compact|batch|init|setup|doctor|stats|history|import|export)
+      printf '%s' "$1" ;;
+    "") printf 'unknown' ;;
+    *) printf 'unrecognised' ;;
+  esac
+}
+
+fleet_bd_lock_shape() {
+  # THE OPERATION OF A bd CALL, FROM THE VOCABULARY. Never an argument, never an id, never a body.
+  # The subcommand position is scanned for the first bare word (skipping flags and the value of a known
+  # value-taking flag, because a global flag can sit before it), then reduced by fleet_bd_lock_word.
+  local sub="" op="" a expect_value=0
+  for a in "$@"; do
+    if [ "$expect_value" = 1 ]; then expect_value=0; continue; fi
+    case "$a" in
+      --actor|--database|--db|--dolt-auto-commit|--mem-profile|--directory|-C) expect_value=1; continue ;;
+      -*) continue ;;
+    esac
+    if [ -z "$sub" ]; then sub="$a"; elif [ -z "$op" ]; then op="$a"; fi
+  done
+  if [ "$sub" = dolt ]; then
+    case "$op" in
+      push|pull|status|fetch|log|show|version|remote) printf 'dolt %s' "$op" ;;
+      "") printf 'dolt' ;;
+      *) printf 'dolt unrecognised' ;;
+    esac
+    return 0
+  fi
+  fleet_bd_lock_word "$sub"
+}
+
+fleet_bd_lock_cmd() {
+  # Re-validate a `cmd=` value READ FROM THE RECORD. Anyone can write the record, so the waiter never
+  # trusts it: only vocabulary shapes survive.
+  case "$1" in
+    "dolt "*) local op="${1#dolt }"
+      case "$op" in
+        push|pull|status|fetch|log|show|version|remote) printf 'dolt %s' "$op" ;;
+        "") printf 'dolt' ;;
+        *) printf 'dolt unrecognised' ;;
+      esac ;;
+    *) fleet_bd_lock_word "$1" ;;
+  esac
+}
+
+fleet_bd_lock_int() {
+  # A validated positive integer, or nothing at all. pid and since are printed into another lane's log.
+  case "$1" in
+    ""|*[!0-9]*) return 1 ;;
+  esac
+  printf '%s' "$1"
+}
+
+fleet_bd_lock_role() {
+  # Roles come from the environment and the record; both are text until they match this list.
+  case "$1" in
+    implementer|reviewer|merger|architect|designer|coordinator|coord|hub|operator|planner|investigator)
+      printf '%s' "$1" ;;
+    "") printf 'unknown' ;;
+    *) printf 'other' ;;
+  esac
+}
+
+fleet_bd_lock_lane() {
+  # A LANE NAME MUST BE ONE THE FLEET ITSELF REGISTERED ON THIS VM (~/.fleet/lanes/<name>.model|.conf).
+  # FLEET_LANE is environment and the record is writable by anyone, so the name is unvalidated text until
+  # the fleet's own registry vouches for it; measured before this check: lane=SENTINEL-PRIVATE-PAYLOAD
+  # reached both the shared record and another lane's stderr.
+  #
+  # THE CHARACTER CLASS IS CHECKED FIRST, AND THE ORDER IS LOAD-BEARING. `..` is resolved by the KERNEL
+  # inside an otherwise-quoted path, so a name like `../../etc/passwd` would be vouched for by a file OUTSIDE
+  # the registry; and `*` is a legal filename character even though it is not glob-expanded inside quotes, so
+  # `impl-*` would be vouched for by a file literally named `impl-*.model`. Measured against a reordered copy
+  # of this function (lookup first) with those exact files planted: tests/bd-lock-holder.test.sh case 15 goes
+  # red in all nine of its places - the four outcome pairs and the order assertion together.
+  local name="$1"
+  case "$name" in
+    ""|*[!A-Za-z0-9._-]*) printf 'unregistered'; return 0 ;;
+  esac
+  [ "${#name}" -le 64 ] || { printf 'unregistered'; return 0; }
+  if [ -e "$HOME/.fleet/lanes/$name.model" ] || [ -e "$HOME/.fleet/lanes/$name.conf" ]; then
+    printf '%s' "$name"
+  else
+    printf 'unregistered'
+  fi
+}
+
+fleet_bd_lock_procname() {
+  # A PROCESS NAME, FROM A FIXED VOCABULARY - never its argument vector. comm can be set to arbitrary
+  # short text by any program, so it is filtered to the characters a program name uses and then matched
+  # against this list; anything else is `other`, and `gone` when the process has exited.
+  local name
+  name="$(tr -dc '[:alnum:]._+-' <"/proc/$1/comm" 2>/dev/null | cut -c1-16)"
+  case "$name" in
+    "") printf 'gone' ;;
+    bd|git|git-remote-https|git-remote-http|ssh|flock|sleep|sh|bash|dash|timeout|python3|node|ps|sed|head|jq|awk|grep)
+      printf '%s' "$name" ;;
+    *) printf 'other' ;;
+  esac
+}
+
+fleet_bd_lock_field() {
+  # One key=value field out of a holder record. Tokens are split first, so a field at the START of the
+  # line (pid= is first) matches exactly like one in the middle - a regex needing a leading space before
+  # the key silently returned UNNAMED for every holder until the test in tests/bd-lock-holder.test.sh
+  # caught it. `cmd=` is the LAST field and may hold two words (`dolt push`), so it is read to
+  # end-of-line: token-splitting it returned `cmd=dolt` and the operation silently lost its verb
+  # (caught by the test's `running: bd dolt push` assertion, which is why that assertion names both words).
+  if [ "$2" = cmd ]; then
+    printf '%s' "$1" | tr '\n' ' ' | sed -n 's/.*[[:space:]]cmd=//p' | sed 's/[[:space:]]*$//'
+    return 0
+  fi
+  printf '%s' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1
+}
+
+fleet_bd_lock_note() {
+  # Our own holder record, written while we hold the lock and cleared before we release it. Never fails the
+  # call: a lock file we cannot annotate is not a reason to refuse to run bd. EVERY value is validated
+  # here as well as on read, so the shared file never holds unvalidated text even if this lane's
+  # environment does. `printf '%(%s)T'` is a shell builtin: a `$(date +%s)` fork here cost 8ms on EVERY bd
+  # call on the VM (measured), which is not worth paying on the path that never contends.
+  local lock="$1"; shift
+  printf -v fleet_bd_now '%(%s)T' -1 2>/dev/null || fleet_bd_now=0
+  {
+    # cmd LAST: it is the only field that can contain a space (`dolt push`), and fleet_bd_lock_field reads
+    # it to end-of-line.
+    printf 'pid=%s lane=%s role=%s since=%s cmd=%s\n' \
+      "$(fleet_bd_lock_int "$$" || printf '0')" \
+      "$(fleet_bd_lock_lane "${FLEET_LANE:-}")" \
+      "$(fleet_bd_lock_role "${FLEET_ROLE:-}")" \
+      "$(fleet_bd_lock_int "${fleet_bd_now:-0}" || printf '0')" \
+      "$(fleet_bd_lock_shape "$@")"
+  } >"$lock" 2>/dev/null || true
+}
+
+fleet_bd_lock_descendants() {
+  # The holder's whole descendant tree, which is where a dolt push spends its minutes: the holder runs bd,
+  # which runs git, which runs git-remote-https for the round-trip to origin. Bounded to 4 levels so a
+  # pathological or cyclic parent graph can never turn a report into an unbounded walk. Each entry is a pid
+  # and a VOCABULARY process name - no argument vectors (agents-zoch).
+  local frontier="$1" level=0 next kids p k all
+  while [ -n "$frontier" ] && [ "$level" -lt 4 ]; do
+    next=""
+    for p in $frontier; do
+      kids="$(ps -o pid= --ppid "$p" 2>/dev/null | tr -d ' ' | tr '\n' ' ')"
+      for k in $kids; do all="$all $k"; next="$next $k"; done
+    done
+    frontier="$next"
+    level=$((level + 1))
+  done
+  for k in $all; do
+    printf 'bd:     %s %s\n' "$k" "$(fleet_bd_lock_procname "$k")"
+  done
+}
+
+fleet_bd_lock_report() {
+  # $1 lock file, $2 seconds held, $3 mode: wait|timeout, $4 quiet_holder=1 to skip the holder block
+  # (the timeout of an invocation that already reported the holder must not repeat all of it)
+  local lock="$1" held="$2" mode="$3" rec pid lane role since cmd human kids
+  local quiet_holder="${4:-}"
+  rec="$(head -c 400 "$lock" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
+  human="$((held / 60))m$((held % 60))s"
+  if [ "$mode" = timeout ]; then
+    echo "bd: TIMEOUT (agents-elu6): the VM-wide bd lock was held for ${human}. THIS CALL DID NOT RUN and changed nothing." >&2
+  else
+    echo "bd: WAITING ${human} for the VM-wide bd lock (one Dolt write at a time; a dolt push holds it for its git round-trip to origin)." >&2
+  fi
+  if [ "$quiet_holder" = 1 ]; then
+    if [ "$mode" = timeout ]; then
+      echo "bd:   retry in a few seconds, or allow a longer wait with FLEET_BD_LOCK_WAIT=<seconds>." >&2
+      echo "bd:   Posting a verdict? The COMMENT first, then the labels: a retry then never loses the verdict." >&2
+    fi
+    return 0
+  fi
+  # EVERY field is re-validated on read: the record is a shared file that any process can write, so this is
+  # the difference between a diagnostic and an injection channel (agents-zoch).
+  pid="$(fleet_bd_lock_int "$(fleet_bd_lock_field "$rec" pid)")" || pid=""
+  if [ -n "$pid" ]; then
+    lane="$(fleet_bd_lock_lane "$(fleet_bd_lock_field "$rec" lane)")"
+    role="$(fleet_bd_lock_role "$(fleet_bd_lock_field "$rec" role)")"
+    since="$(fleet_bd_lock_int "$(fleet_bd_lock_field "$rec" since)")" || since=""
+    cmd="$(fleet_bd_lock_cmd "$(fleet_bd_lock_field "$rec" cmd)")"
+    echo "bd:   holder: lane=${lane} role=${role} pid=$pid${since:+ since $(date -d "@$since" -u +%H:%M:%SZ 2>/dev/null || printf '?')}" >&2
+    echo "bd:   running: bd ${cmd}   (operation only: arguments can hold bead text - agents-zoch)" >&2
+    if [ -d "/proc/$pid" ]; then
+      kids="$(fleet_bd_lock_descendants "$pid")"
+      [ -n "$kids" ] && printf '%s\n' "$kids" >&2
+    else
+      echo "bd:   (that pid is gone, so the record is stale - the lock is still held)" >&2
+    fi
+  else
+    echo "bd:   holder: UNNAMED - the lock file has no usable holder record (a holder from before agents-elu6, a record written by something else, or one that has not been written yet). The lock releases automatically when the holder exits, so a holder that has died cannot hold it." >&2
+  fi
+  if [ "$mode" = timeout ]; then
+    echo "bd:   retry in a few seconds, or allow a longer wait with FLEET_BD_LOCK_WAIT=<seconds>." >&2
+    echo "bd:   Posting a verdict? The COMMENT first, then the labels: a retry then never loses the verdict." >&2
+  fi
+}
+
+fleet_bd_lock_acquire() {
+  # $1 lock file, $2 lock fd, $3... the bd argv (reduced to its operation by fleet_bd_lock_shape)
+  # 0 = held, 75 = timed out and reported.
+  local lock="$1" fd="$2" wait="${FLEET_BD_LOCK_WAIT:-300}" every="${FLEET_BD_LOCK_REPORT:-30}"
+  local start=$SECONDS held next=0 reported=0
+  shift 2
+  if flock -n "$fd"; then            # uncontended: no output, no report, one record write
+    fleet_bd_lock_note "$lock" "$@"
+    return 0
+  fi
+  while :; do
+    held=$((SECONDS - start))
+    if [ "$held" -ge "$next" ]; then
+      next=$((held + every))
+      fleet_bd_lock_report "$lock" "$held" wait
+      reported=1
+    fi
+    if [ "$held" -ge "$wait" ]; then
+      fleet_bd_lock_report "$lock" "$held" timeout "$reported"
+      return 75
+    fi
+    sleep 1
+    if flock -n "$fd"; then
+      fleet_bd_lock_note "$lock" "$@"
+      return 0
+    fi
+  done
+}
+
 if [ -n "${FLEET_BD_LOCKED:-}" ]; then
   "$real" "$@"
   rc=$?
@@ -254,7 +534,34 @@ if [ -n "${FLEET_BD_LOCKED:-}" ]; then
 fi
 
 export FLEET_BD_LOCKED=1
-flock -w 300 "$HOME/.fleet/bd.lock" "$real" "$@"
+fleet_bd_lock="$HOME/.fleet/bd.lock"
+if ! exec {fleet_bd_lock_fd}>>"$fleet_bd_lock"; then
+  echo "bd: cannot open the VM-wide bd lock $fleet_bd_lock - refusing to run bd without it, because two writers on this embedded Dolt DB fail ambiguously. Check that $(dirname "$fleet_bd_lock") exists and is writable." >&2
+  exit 1
+fi
+fleet_bd_lock_acquire "$fleet_bd_lock" "$fleet_bd_lock_fd" "$@"
+rc=$?
+if [ "$rc" -ne 0 ]; then
+  exit "$rc"          # timed out: the holder was named on stderr, and nothing ran
+fi
+# THE LOCK MUST BE HELD BY THE WORK, NOT BY THIS SHELL'S LIFETIME (P1 - found by review of this patch, bead agents-elu6). bd INHERITS the
+# lock fd, so the lock stays held for as long as the work does, even if this shim is SIGKILLed - and this
+# fleet SIGKILLs shims all day (bounded gates, the reaper, lane restarts), so that is normal operation
+# rather than an exotic case. The earlier revision closed the fd for bd (`{fleet_bd_lock_fd}>&-`) to stop a
+# stray descendant holding the lock after bd exited; the reviewer's probe measured what that cost:
+#
+#   SIGKILL the shim while `bd` is still writing, then run a second call:
+#     as deployed (flock(1)'s child inherits):  waits 5s for the work, then runs   -> serialised
+#     with the fd closed for the child:         runs IMMEDIATELY, 0s, rc=0         -> BYPASS, two writers
+#
+# The two failure directions are not symmetric, which is what decides this: OVER-holding (a descendant that
+# outlives bd keeps the lock) delays other lanes, while UNDER-holding (the lock released while bd writes)
+# breaks the one invariant this whole shim exists for. So the inheritance stays, and the over-hold is
+# reported instead of prevented - a record whose pid is gone while the lock is still held is exactly that
+# case, and the waiter says so.
+"$real" "$@"
 rc=$?
+: >"$fleet_bd_lock" 2>/dev/null || true     # clear our record while we still hold the lock
+exec {fleet_bd_lock_fd}>&-                  # release
 check_push_failure "$rc" "$@"
 exit "$rc"
diff --git a/tests/bd-lock-holder.test.sh b/tests/bd-lock-holder.test.sh
new file mode 100644
index 0000000..a6706d4
--- /dev/null
+++ b/tests/bd-lock-holder.test.sh
@@ -0,0 +1,297 @@
+#!/usr/bin/env bash
+# tests/bd-lock-holder.test.sh — bin/bd: a contended lock NAMES ITS HOLDER, and the wait is bounded (agents-elu6).
+#
+# THE DEFECT (measured 2026-10-13, rev-fnko): a complete review could not record its verdict for more than
+# four minutes because another lane's `bd dolt push` held this VM's shared lock for the whole network
+# round-trip of its child `git push --force-with-lease refs/dolt/data`. The old tail was
+#
+#     flock -w 300 "$HOME/.fleet/bd.lock" "$real" "$@"
+#
+# which waits in SILENCE and then exits 1 with NO OUTPUT AT ALL (measured against util-linux 2.39.3:
+# `rc=1 output=[]`). So a lane with a finished result produces nothing for minutes and looks IDLE - the
+# zombie-lane failure shape one layer down - and the failure itself carries no reason.
+#
+# WHAT IS PINNED HERE: the holder writes a one-line record into the lock file while it holds it; a waiter
+# reports lane, pid, command, how long it has been held, and the holder's descendant tree (where a push
+# actually spends its time); the wait keeps 300s of patience by default and is overridable; on expiry it
+# fails FAST with EX_TEMPFAIL (75) without running the call; and NOTHING of this appears on stdout, which
+# carries bd's JSON for callers like `bd show --json`. THE LOCK IS HELD BY THE WORK, NOT BY THE SHIM'S
+# LIFETIME (P1, found by review): bd inherits the lock fd, so SIGKILLing the shim while bd is writing does
+# not release the lock - this fleet kills shims all day, and an earlier revision of this patch closed that
+# fd and was measured letting two bd processes write concurrently. Case 9 pins it.
+#
+# Hermetic by construction: a stub $HOME/.local/bin/bd means no real bead and no real lock is touched -
+# the lock under test is $HOME/.fleet/bd.lock inside a throwaway home. The one real-lock measurement (a
+# genuine `bd dolt push` holding it while a second call reports the holder) lives on the bead as evidence,
+# not here, so a gate re-run never contends with the fleet.
+#
+#   bash tests/bd-lock-holder.test.sh
+set -uo pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+SHIM="${BD_SHIM_OVERRIDE:-$HERE/bin/bd}"
+PASS=0; FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n      %s\n' "$1" "${2:-}"; }
+eq()  { [ "$1" = "$2" ] && ok "$3" || bad "$3" "got [$1] want [$2]"; }
+has() { grep -q -- "$2" "$1" && ok "$3" || bad "$3" "not found in $1: $(tr '\n' '|' < "$1" | cut -c1-220)"; }
+hasnt() { grep -q -- "$2" "$1" && bad "$3" "unexpectedly found: $2" || ok "$3"; }
+
+ROOT=$(mktemp -d); KIDS=""
+cleanup() { [ -n "$KIDS" ] && kill $KIDS 2>/dev/null; rm -rf "$ROOT"; }
+trap cleanup EXIT
+T="$ROOT/home"; mkdir -p "$T/.local/bin" "$T/.fleet"
+LOCK="$T/.fleet/bd.lock"
+# The shim only reports a lane name that THIS VM's registry vouches for (~/.fleet/lanes/<name>.model), so a
+# hermetic run registers its own lanes. That is the property cases 13-14 attack.
+mkdir -p "$T/.fleet/lanes"
+for l in impl-other impl-secret impl-ozmt probe-A probe-B probe-C; do : > "$T/.fleet/lanes/$l.model"; done
+
+# stub real bd: echo its argv, optionally spawn a git-shaped child and sleep (the shape of the real latency)
+cat > "$T/.local/bin/bd" <<'STUB'
+#!/usr/bin/env bash
+echo "REAL-BD:$*"
+if [ "${STUB_SLEEP:-0}" -gt 0 ]; then
+  if [ "${STUB_SECRET_ARGV:-0}" -gt 0 ]; then
+    ( exec -a "SENTINEL-PRIVATE-PAYLOAD" sleep "$STUB_SLEEP" ) &
+  else
+    ( exec -a "git push --force-with-lease refs/dolt/data" sleep "$STUB_SLEEP" ) &
+  fi
+  wait $!
+fi
+exit "${STUB_RC:-0}"
+STUB
+chmod +x "$T/.local/bin/bd"
+
+shim() { HOME="$T" FLEET_LANE="${LANE:-impl-ozmt}" FLEET_ROLE="${ROLE:-implementer}" bash "$SHIM" "$@"; }
+# a holder from BEFORE agents-elu6: it takes the lock and writes no record
+hold_raw() { ( exec 9>>"$LOCK"; flock -n 9 || exit 1; sleep "$1" ) & KIDS="$KIDS $!"; }
+# a holder that goes through the shim, so it writes the holder record a waiter reads
+hold_shim() { local secs="$1"; shift; STUB_SLEEP="$secs" HOME="$T" FLEET_LANE="${HOLDER_LANE:-impl-other}" bash "$SHIM" "$@" & KIDS="$KIDS $!"; }
+release() {
+  [ -n "$KIDS" ] && { kill $KIDS 2>/dev/null; wait $KIDS 2>/dev/null; }
+  KIDS=""
+  for _ in $(seq 1 50); do flock -n "$LOCK" true 2>/dev/null && break; sleep 0.1; done
+  : > "$LOCK"
+}
+
+echo "1. uncontended: no report, no record left behind, the call runs and its exit code survives"
+out=$(shim version 2>"$ROOT/e1"); rc=$?
+eq "$out" "REAL-BD:version" "1a the call reached bd"
+eq "$rc" "0" "1b exit 0"
+[ -s "$ROOT/e1" ] && bad "1c stderr on the uncontended path" "$(cat "$ROOT/e1")" || ok "1c silent when uncontended"
+[ -s "$LOCK" ] && bad "1d a holder record was left behind" "$(cat "$LOCK")" || ok "1d the record is cleared before release"
+out=$(STUB_RC=7 shim version 2>"$ROOT/e1b"); rc=$?
+eq "$rc" "7" "1e a failing bd exit code is passed through"
+[ -s "$LOCK" ] && bad "1f record left after a failing call" "$(cat "$LOCK")" || ok "1f record cleared even when bd fails"
+
+echo "2. contended: the holder is named at once, and the call still runs"
+hold_shim 3 dolt push; sleep 0.5
+out=$(shim version 2>"$ROOT/e2"); rc=$?
+eq "$out" "REAL-BD:version" "2a the call ran after the wait"
+eq "$rc" "0" "2b exit 0"
+has "$ROOT/e2" "WAITING 0m0s" "2c the report is immediate, not after a threshold"
+has "$ROOT/e2" "lane=impl-other" "2d the holder's LANE is named"
+has "$ROOT/e2" "running: bd dolt push" "2e the holder's OPERATION is named (dolt push - the shape of the real incident)"
+has "$ROOT/e2" "pid=" "2f a pid is named"
+release
+
+echo "3. beyond the bound: fail fast with EX_TEMPFAIL, holder named, call NOT run"
+hold_shim 6 dolt push; sleep 0.5
+out=$(FLEET_BD_LOCK_WAIT=1 shim version 2>"$ROOT/e3"); rc=$?
+eq "$rc" "75" "3a EX_TEMPFAIL (75), not an unexplained 1"
+has "$ROOT/e3" "TIMEOUT (agents-elu6)" "3b it says TIMEOUT"
+has "$ROOT/e3" "lane=impl-other" "3c the holder is still named"
+has "$ROOT/e3" "THIS CALL DID NOT RUN" "3d it is explicit that nothing was attempted"
+has "$ROOT/e3" "FLEET_BD_LOCK_WAIT" "3e the bound is overridable, and the message says how"
+[ -n "$out" ] && bad "3f bd ran after a timeout" "$out" || ok "3f bd did not run"
+has "$ROOT/e3" "COMMENT first" "3g it points at the durable order for posting a verdict"
+eq "$(grep -c 'running: bd dolt push' "$ROOT/e3")" "1" "3h the holder block is printed once, not repeated by the timeout"
+release
+
+echo "4. a holder that left no record (one from before this change) is reported as UNNAMED, not as a mystery"
+hold_raw 2; sleep 0.4
+FLEET_BD_LOCK_WAIT=1 shim version >"$ROOT/o4" 2>"$ROOT/e4"
+has "$ROOT/e4" "UNNAMED" "4a unnamed holder is stated plainly"
+has "$ROOT/e4" "no usable holder record" "4b and the reason is given"
+has "$ROOT/e4" "releases automatically" "4c with the fact that a dead holder cannot hold it forever"
+release
+
+echo "5. a record naming a dead pid is reported as STALE, never as a live holder"
+hold_raw 2; sleep 0.3
+printf 'pid=999999 lane=impl-other role=reviewer since=%s cmd=dolt push\n' "$(date +%s)" > "$LOCK"
+FLEET_BD_LOCK_WAIT=1 shim version >"$ROOT/o5" 2>"$ROOT/e5"
+has "$ROOT/e5" "lane=impl-other" "5a the stale record is shown"
+has "$ROOT/e5" "pid is gone" "5b and called stale"
+release
+
+echo "6. the nested escape (FLEET_BD_LOCKED=1) still bypasses the lock entirely"
+hold_raw 2; sleep 0.3
+out=$(FLEET_BD_LOCKED=1 shim version 2>"$ROOT/e6"); rc=$?
+eq "$out" "REAL-BD:version" "6a a nested call does not queue behind the lock"
+eq "$rc" "0" "6b exit 0"
+[ -s "$ROOT/e6" ] && bad "6c a nested call reported a wait" "$(cat "$ROOT/e6")" || ok "6c no report on the nested path"
+release
+
+echo "7. the holder's DESCENDANTS are named - the git push is where the minutes are"
+hold_shim 4 dolt push; sleep 1
+FLEET_BD_LOCK_WAIT=1 shim version >"$ROOT/o7" 2>"$ROOT/e7"
+has "$ROOT/e7" "sleep" "7a the process doing the waiting is named"
+hasnt "$ROOT/e7" "git push" "7b and its ARGUMENT VECTOR is not copied (agents-zoch)"
+release
+
+echo "8. stdout carries only bd's own output: the report goes to stderr"
+hold_shim 3 dolt push; sleep 0.5
+shim show bead-x --json >"$ROOT/o8" 2>"$ROOT/e8"
+eq "$(cat "$ROOT/o8")" "REAL-BD:show bead-x --json" "8a stdout is exactly bd's output (no report mixed in)"
+has "$ROOT/e8" "WAITING" "8b while the report went to stderr"
+release
+
+echo "9. P1 REGRESSION (found by review, reproduced here): the lock outlives a KILLED shim for as long as the work lasts"
+# This case REPLACES an assertion that pinned the OPPOSITE (that bd's children do NOT inherit the lock fd).
+# That assertion was the bypass: it made the lock depend on the shim's lifetime, so SIGKILLing the shim while
+# bd was still writing released it and a second bd ran concurrently - measured here as 0s vs the 5s the work
+# still needed. A lock released while the work continues breaks the one invariant this shim exists for; a lock
+# held slightly too long only delays other lanes. That asymmetry decides the direction of the fix.
+: > "$LOCK"
+cat > "$T/.local/bin/bd" <<'WORKSTUB'
+#!/usr/bin/env bash
+if [ "$1" = work ]; then echo $$ > "$WORK_PID"; touch "$WORK_STARTED"; sleep 4; touch "$WORK_DONE"; fi
+echo "REAL-BD:$*"
+WORKSTUB
+chmod +x "$T/.local/bin/bd"
+WORK_PID="$ROOT/wpid" WORK_STARTED="$ROOT/wstarted" WORK_DONE="$ROOT/wdone" \
+  HOME="$T" FLEET_LANE=impl-other bash "$SHIM" work >/dev/null 2>&1 & KIDS="$KIDS $!"
+sleep 0.7
+kill -9 $(pgrep -f "bash $SHIM work" | head -1) 2>/dev/null    # SIGKILL the shim; bd is STILL writing
+sleep 0.3
+FLEET_BD_LOCK_WAIT=1 shim probe >"$ROOT/o9" 2>"$ROOT/e9"; rc=$?
+eq "$rc" "75" "9a a second call could NOT acquire the lock after the shim was killed"
+has "$ROOT/e9" "TIMEOUT" "9b it timed out rather than running concurrently"
+[ -f "$ROOT/wdone" ] && bad "9c the first work had already finished (the overlap would not have been real)" "" \
+  || ok "9c the first bd was STILL WRITING when the second call was refused"
+[ -f "$ROOT/wpid" ] && kill -9 "$(cat "$ROOT/wpid")" 2>/dev/null
+for _ in $(seq 1 60); do [ -f "$ROOT/wdone" ] && break; sleep 0.2; done
+FLEET_BD_LOCK_WAIT=2 shim probe >"$ROOT/o9b" 2>"$ROOT/e9b"; rc=$?
+eq "$rc" "0" "9d once the work ended the lock was released and the next call ran"
+# restore the standard stub for the later cases
+cat > "$T/.local/bin/bd" <<'STUB'
+#!/usr/bin/env bash
+echo "REAL-BD:$*"
+if [ "${STUB_SLEEP:-0}" -gt 0 ]; then
+  if [ "${STUB_SECRET_ARGV:-0}" -gt 0 ]; then
+    ( exec -a "SENTINEL-PRIVATE-PAYLOAD" sleep "$STUB_SLEEP" ) &
+  else
+    ( exec -a "git push --force-with-lease refs/dolt/data" sleep "$STUB_SLEEP" ) &
+  fi
+  wait $!
+fi
+exit "${STUB_RC:-0}"
+STUB
+chmod +x "$T/.local/bin/bd"
+release
+
+echo "10. PRIVACY (agents-zoch, the reviewer's probe): bead text must reach neither the shared record nor another lane's stderr"
+# rev-elu6 drove this: `bd comment issue-x SENTINEL-PRIVATE-PAYLOAD` used to appear in the lock file AND in
+# the waiter's stderr. The fix reports the OPERATION from a fixed vocabulary instead of the arguments.
+: > "$LOCK"
+STUB_SLEEP=3 HOME="$T" FLEET_LANE=impl-secret bash "$SHIM" comment issue-x SENTINEL-PRIVATE-PAYLOAD & KIDS="$KIDS $!"
+sleep 0.5
+hasnt "$LOCK" "SENTINEL" "10a the SHARED lock record carries no argument text"
+hasnt "$LOCK" "issue-x" "10b nor the bead id"
+has "$LOCK" "cmd=comment" "10c but it does name the OPERATION, which is the diagnostic need"
+FLEET_BD_LOCK_WAIT=1 shim show bead-x >"$ROOT/o10" 2>"$ROOT/e10"
+hasnt "$ROOT/e10" "SENTINEL" "10d the WAITING LANE's stderr carries no argument text"
+hasnt "$ROOT/e10" "issue-x" "10e nor the bead id"
+has "$ROOT/e10" "running: bd comment" "10f but it names the holder's operation"
+release
+
+echo "11. a freeform subcommand position cannot smuggle text in either (the vocabulary is fail-closed)"
+: > "$LOCK"
+STUB_SLEEP=2 HOME="$T" FLEET_LANE=impl-secret bash "$SHIM" "SENTINEL-PRIVATE-PAYLOAD" x & KIDS="$KIDS $!"
+sleep 0.5
+hasnt "$LOCK" "SENTINEL" "11a a freeform subcommand is not echoed into the record"
+has "$LOCK" "cmd=unrecognised" "11b it is reported as the fixed word 'unrecognised'"
+release
+
+echo "12. descendant reporting names processes, not their argument vectors"
+: > "$LOCK"
+STUB_SECRET_ARGV=1 STUB_SLEEP=4 HOME="$T" FLEET_LANE=impl-secret bash "$SHIM" slow-run & KIDS="$KIDS $!"
+sleep 1
+FLEET_BD_LOCK_WAIT=1 shim show bead-x >"$ROOT/o12" 2>"$ROOT/e12"
+hasnt "$ROOT/e12" "SENTINEL" "12a a descendant's ARGV is not copied"
+has "$ROOT/e12" "sleep" "12b the descendant is named by process name"
+release
+
+echo "13. ADVERSARIAL: the ENVIRONMENT cannot inject text through lane/role (they are validated, not copied)"
+: > "$LOCK"
+STUB_SLEEP=2 HOME="$T" FLEET_LANE='SENTINEL-PRIVATE-PAYLOAD' FLEET_ROLE='SENTINEL-ROLE-PAYLOAD' \
+  bash "$SHIM" comment issue-y SEKRIT & KIDS="$KIDS $!"
+sleep 0.5
+hasnt "$LOCK" "SENTINEL" "13a an unregistered lane name never reaches the shared record"
+has "$LOCK" "lane=unregistered" "13b it is reported as the fixed word 'unregistered'"
+has "$LOCK" "role=other" "13c a non-vocabulary role is reported as 'other'"
+FLEET_BD_LOCK_WAIT=1 shim show y >"$ROOT/o13" 2>"$ROOT/e13"
+hasnt "$ROOT/e13" "SENTINEL" "13d nor another lane's stderr"
+release
+
+echo "14. ADVERSARIAL: a PLANTED record cannot inject text either (any process can write the 0644 lock file)"
+: > "$LOCK"
+hold_raw 2; sleep 0.3
+printf 'pid=SENTINEL-PRIVATE-PAYLOAD lane=SENTINEL-LANE role=SENTINEL-ROLE since=SENTINEL-SINCE cmd=SENTINEL-CMD\n' > "$LOCK"
+FLEET_BD_LOCK_WAIT=1 shim show y >"$ROOT/o14" 2>"$ROOT/e14"
+hasnt "$ROOT/e14" "SENTINEL" "14a a planted record's fields are never echoed"
+has "$ROOT/e14" "UNNAMED" "14b a non-numeric pid makes the holder unnamed rather than trusted"
+: > "$LOCK"; hold_raw 2; sleep 0.3
+printf 'pid=999999 lane=SENTINEL-LANE role=SENTINEL-ROLE since=SENTINEL-SINCE cmd=SENTINEL-CMD\n' > "$LOCK"
+FLEET_BD_LOCK_WAIT=1 shim show y >"$ROOT/o14b" 2>"$ROOT/e14b"
+hasnt "$ROOT/e14b" "SENTINEL" "14c a numeric-but-bogus pid with planted text still leaks nothing"
+has "$ROOT/e14b" "unregistered" "14d the planted lane name is replaced by 'unregistered'"
+has "$ROOT/e14b" "unrecognised" "14e the planted operation is replaced by 'unrecognised'"
+has "$ROOT/e14b" "pid is gone" "14f and the bogus pid is called out as stale"
+release
+
+echo "15. the character-class check precedes the registry lookup, so a glob-shaped lane name can never be trusted"
+# The OUTCOMES below are only discriminating because the harness registers impl-other/impl-ozmt: 'impl-*'
+# WOULD match a real registry entry if the lookup ran first, and the name would be reported as trusted.
+# PLANT the exact files a LOOKUP-FIRST order would accept, so these outcomes discriminate the order rather
+# than merely agreeing with it: a literal file named 'impl-*.model', and a registry-escaping '../../etc/passwd'
+# (the kernel resolves '..' inside an otherwise-quoted path, so without the character check a name can reach a
+# file OUTSIDE the registry - and quoting does not stop that, only the character class does).
+: > "$T/.fleet/lanes/impl-*.model"; : > "$T/.fleet/lanes/a b.model"; : > "$T/.fleet/lanes/*.model"
+mkdir -p "$T/etc"; : > "$T/etc/passwd.model"
+for pair in "impl-*|a glob-shaped name is reported unregistered even though impl-other.model IS registered" \
+            "../../etc/passwd|a path-shaped name is rejected" \
+            "a b|a name containing a space is rejected" \
+            "*|a bare glob is rejected"; do
+  name="${pair%%|*}"; what="${pair#*|}"
+  : > "$LOCK"
+  STUB_SLEEP=2 HOME="$T" FLEET_LANE="$name" bash "$SHIM" comment issue-z X >/dev/null 2>&1 & KIDS="$KIDS $!"
+  sleep 0.5
+  has "$LOCK" "lane=unregistered" "15 $what"
+  grep -Fq -- "lane=$name" "$LOCK" \
+    && bad "15b the name itself is never trusted into the record: [$name]" "unexpectedly found: lane=$name" \
+    || ok "15b the name itself is never trusted into the record: [$name]"
+  release
+done
+: > "$LOCK"
+STUB_SLEEP=2 HOME="$T" FLEET_LANE=impl-other bash "$SHIM" comment issue-z X >/dev/null 2>&1 & KIDS="$KIDS $!"
+sleep 0.5
+has "$LOCK" "lane=impl-other" "15c a genuinely registered name still passes through (the check rejects nothing it should keep)"
+release
+# AND THE ORDER ITSELF, because that is WHY it holds: if the registry lookup ran FIRST, 'impl-*' would match
+# impl-other.model and a glob-shaped name would be reported as trusted. A future reader could reorder these
+# two statements innocently, so the order is asserted structurally rather than left to the outcomes above.
+# Read the CODE only: this function's own docstring names ~/.fleet/lanes/<name>.model, so grepping the raw body
+# numbers a COMMENT as the lookup and the pin fails on its own prose (it did, in the first draft of this case).
+body=$(sed -n '/^fleet_bd_lock_lane()/,/^}/p' "$SHIM" | grep -v '^[[:space:]]*#')
+n_case=$(grep -n 'case "\$name" in' <<<"$body" | head -1 | cut -d: -f1)
+n_look=$(grep -n 'lanes/\$name' <<<"$body" | head -1 | cut -d: -f1)
+if [ -n "$n_case" ] && [ -n "$n_look" ] && [ "$n_case" -lt "$n_look" ]; then
+  ok "15d the character-class check is the FIRST statement in fleet_bd_lock_lane, before the registry lookup"
+else
+  bad "15d the character-class check no longer precedes the registry lookup (charset line=$n_case, lookup line=$n_look)" \
+      "restore the order: with a lookup-first order a glob-shaped name matches a real registry entry and is reported as trusted"
+fi
+
+printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
+[ "$FAIL" -eq 0 ]
-- 

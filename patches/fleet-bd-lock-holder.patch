 bin/bd                       | 288 ++++++++++++++++++++++++++++++++-
 tests/bd-lock-holder.test.sh | 301 +++++++++++++++++++++++++++++++++++
 2 files changed, 588 insertions(+), 1 deletion(-)
 create mode 100644 tests/bd-lock-holder.test.sh

diff --git a/bin/bd b/bin/bd
index 723856f..311687e 100755
--- a/bin/bd
+++ b/bin/bd
@@ -246,6 +246,265 @@ guard_worktree_beads_decoy() {
 
 guard_worktree_beads_decoy "$@"
 
+# ------------------------------------------------ agents-elu6 ------------------------------------------------
+# A CONTENDED LOCK MUST NAME ITS HOLDER, AND THE WAIT MUST BE VISIBLE AND BOUNDED.
+#
+# Measured 2026-10-13 (rev-fnko): a COMPLETE review could not record its verdict for more than four minutes
+# because another lane's `bd dolt push` held this lock for the whole network round-trip of its child
+# `git push --force-with-lease refs/dolt/data` against origin. `flock -w 300` waits in SILENCE and then
+# exits 1 with NO OUTPUT AT ALL (measured), so a lane holding a finished result produces no output for
+# minutes and looks IDLE: neither the lane nor the fleet board can tell a slow holder from a hang. It is
+# the zombie-lane and silent-spawn failure shape, one layer lower.
+#
+# THE HOLDER NAMES ITSELF. While it holds the lock, the holder writes one record line into the lock FILE
+# (a lock object, never a data file: flock's lock is on the fd/inode, so writing the record does not
+# disturb it) and clears it before releasing. A waiter that cannot take the lock reads that record and
+# reports the holder's lane, pid and operation, and how long it has held it - plus, while it waits, the
+# holder's descendant processes, which is where the minutes actually go (`git`).
+#
+# A DIAGNOSTIC MUST NOT NEED THE CONTENT IT IS DIAGNOSING (agents-zoch), AND THAT HAS TO HOLD FOR EVERY
+# FIELD AND EVERY POSITION. rev-elu6 defeated the first version - which stored the holder's full argv - by
+# DRIVING it rather than reading it: `bd comment issue-x SENTINEL-PRIVATE-PAYLOAD` put that text into the
+# shared lock file AND into the waiting lane's stderr. Both surfaces are other people's: the lock file is
+# shared by every lane on the VM and the report is written into a lane that is not the one that typed the
+# text, and bead text can be anything an operator or an agent typed. So there is no filtering anywhere
+# below: EVERY reported value is either a fixed vocabulary word (operations, process names, roles), a
+# validated integer (pid, timestamp), or a lane name that the fleet's own registry on this VM vouches for.
+# Anything else becomes the literal `unrecognised` / `other` / `unregistered` / `unknown`.
+#
+# Why vocabulary rather than sanitising: a filter has to anticipate the payload, a vocabulary cannot
+# express one. That is the same fail-closed shape the reviewer guard above uses. It also has to cover the
+# positions that look harmless - the adversarial pairs that a filter-shaped fix misses, each measured
+# against the first version of this patch:
+#   * the SUBCOMMAND position can hold freeform text:      `bd "<private text>" ...`
+#   * `FLEET_LANE`/`FLEET_ROLE` are ENVIRONMENT, so the holder copies what an actor set: lane=<private text>
+#   * the RECORD ITSELF is writable by anyone (0644), so a planted line's pid/lane/role/since/cmd all reach
+#     another lane's stderr
+#   * a DESCENDANT's argv is freeform too (`ps -o args=`): `git commit -m '<private text>'`
+# Validating on both sides - the writer only writes validated values, the waiter only prints validated
+# values - is what makes a planted record no more dangerous than an honest one.
+#
+# Reports go to STDERR: bd writes JSON on stdout for callers such as `bd show --json`, and a message there
+# would corrupt a parse.
+#
+# The wait keeps its 300s of patience by default (FLEET_BD_LOCK_WAIT overrides it), but is no longer silent:
+# one report on first contention, then at most one every FLEET_BD_LOCK_REPORT seconds (default 30), so a
+# waiting lane has visible progress instead of a dead tool call. On expiry it fails FAST with EX_TEMPFAIL
+# (75) and the holder named, so the caller can retry in seconds rather than block for minutes - and the
+# durable order is `bd comment` (the artefact) BEFORE the label and status writes (the state), so a retry
+# never loses the thing that matters.
+fleet_bd_lock_word() {
+  # ONE vocabulary word, or a literal that says "not in the vocabulary". Never a copy of the input.
+  case "$1" in
+    show|comments|list|search|ready|query|children|blocked|provenance|prime|status|url|help|version|\
+    create|comment|note|dep|link|label|q|remember|update|close|reopen|delete|\
+    sync|worktree|gate|heartbeat|compact|batch|init|setup|doctor|stats|history|import|export)
+      printf '%s' "$1" ;;
+    "") printf 'unknown' ;;
+    *) printf 'unrecognised' ;;
+  esac
+}
+
+fleet_bd_lock_shape() {
+  # THE OPERATION OF A bd CALL, FROM THE VOCABULARY. Never an argument, never an id, never a body.
+  # The subcommand position is scanned for the first bare word (skipping flags and the value of a known
+  # value-taking flag, because a global flag can sit before it), then reduced by fleet_bd_lock_word.
+  local sub="" op="" a expect_value=0
+  for a in "$@"; do
+    if [ "$expect_value" = 1 ]; then expect_value=0; continue; fi
+    case "$a" in
+      --actor|--database|--db|--dolt-auto-commit|--mem-profile|--directory|-C) expect_value=1; continue ;;
+      -*) continue ;;
+    esac
+    if [ -z "$sub" ]; then sub="$a"; elif [ -z "$op" ]; then op="$a"; fi
+  done
+  if [ "$sub" = dolt ]; then
+    case "$op" in
+      push|pull|status|fetch|log|show|version|remote) printf 'dolt %s' "$op" ;;
+      "") printf 'dolt' ;;
+      *) printf 'dolt unrecognised' ;;
+    esac
+    return 0
+  fi
+  fleet_bd_lock_word "$sub"
+}
+
+fleet_bd_lock_cmd() {
+  # Re-validate a `cmd=` value READ FROM THE RECORD. Anyone can write the record, so the waiter never
+  # trusts it: only vocabulary shapes survive.
+  case "$1" in
+    "dolt "*) local op="${1#dolt }"
+      case "$op" in
+        push|pull|status|fetch|log|show|version|remote) printf 'dolt %s' "$op" ;;
+        "") printf 'dolt' ;;
+        *) printf 'dolt unrecognised' ;;
+      esac ;;
+    *) fleet_bd_lock_word "$1" ;;
+  esac
+}
+
+fleet_bd_lock_int() {
+  # A validated positive integer, or nothing at all. pid and since are printed into another lane's log.
+  case "$1" in
+    ""|*[!0-9]*) return 1 ;;
+  esac
+  printf '%s' "$1"
+}
+
+fleet_bd_lock_role() {
+  # Roles come from the environment and the record; both are text until they match this list.
+  case "$1" in
+    implementer|reviewer|merger|architect|designer|coordinator|coord|hub|operator|planner|investigator)
+      printf '%s' "$1" ;;
+    "") printf 'unknown' ;;
+    *) printf 'other' ;;
+  esac
+}
+
+fleet_bd_lock_procname() {
+  # A PROCESS NAME, FROM A FIXED VOCABULARY - never its argument vector. comm can be set to arbitrary
+  # short text by any program, so it is filtered to the characters a program name uses and then matched
+  # against this list; anything else is `other`, and `gone` when the process has exited.
+  local name
+  name="$(tr -dc '[:alnum:]._+-' <"/proc/$1/comm" 2>/dev/null | cut -c1-16)"
+  case "$name" in
+    "") printf 'gone' ;;
+    bd|git|git-remote-https|git-remote-http|ssh|flock|sleep|sh|bash|dash|timeout|python3|node|ps|sed|head|jq|awk|grep)
+      printf '%s' "$name" ;;
+    *) printf 'other' ;;
+  esac
+}
+
+fleet_bd_lock_field() {
+  # One key=value field out of a holder record. Tokens are split first, so a field at the START of the
+  # line (pid= is first) matches exactly like one in the middle - a regex needing a leading space before
+  # the key silently returned UNNAMED for every holder until the test in tests/bd-lock-holder.test.sh
+  # caught it. `cmd=` is the LAST field and may hold two words (`dolt push`), so it is read to
+  # end-of-line: token-splitting it returned `cmd=dolt` and the operation silently lost its verb
+  # (caught by the test's `running: bd dolt push` assertion, which is why that assertion names both words).
+  if [ "$2" = cmd ]; then
+    printf '%s' "$1" | tr '\n' ' ' | sed -n 's/.*[[:space:]]cmd=//p' | sed 's/[[:space:]]*$//'
+    return 0
+  fi
+  printf '%s' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1
+}
+
+fleet_bd_lock_note() {
+  # Our own holder record, written while we hold the lock and cleared before we release it. Never fails the
+  # call: a lock file we cannot annotate is not a reason to refuse to run bd. EVERY value is validated
+  # here as well as on read, so the shared file never holds unvalidated text even if this lane's
+  # environment does. `printf '%(%s)T'` is a shell builtin: a `$(date +%s)` fork here cost 8ms on EVERY bd
+  # call on the VM (measured), which is not worth paying on the path that never contends.
+  local lock="$1"; shift
+  printf -v fleet_bd_now '%(%s)T' -1 2>/dev/null || fleet_bd_now=0
+  {
+    # cmd LAST: it is the only field that can contain a space (`dolt push`), and fleet_bd_lock_field reads
+    # it to end-of-line.
+    printf 'pid=%s role=%s since=%s cmd=%s\n' \
+      "$(fleet_bd_lock_int "$$" || printf '0')" \
+      "$(fleet_bd_lock_role "${FLEET_ROLE:-}")" \
+      "$(fleet_bd_lock_int "${fleet_bd_now:-0}" || printf '0')" \
+      "$(fleet_bd_lock_shape "$@")"
+  } >"$lock" 2>/dev/null || true
+}
+
+fleet_bd_lock_descendants() {
+  # The holder's whole descendant tree, which is where a dolt push spends its minutes: the holder runs bd,
+  # which runs git, which runs git-remote-https for the round-trip to origin. Bounded to 4 levels so a
+  # pathological or cyclic parent graph can never turn a report into an unbounded walk. Each entry is a pid
+  # and a VOCABULARY process name - no argument vectors (agents-zoch).
+  local frontier="$1" level=0 next kids p k all
+  while [ -n "$frontier" ] && [ "$level" -lt 4 ]; do
+    next=""
+    for p in $frontier; do
+      kids="$(ps -o pid= --ppid "$p" 2>/dev/null | tr -d ' ' | tr '\n' ' ')"
+      for k in $kids; do all="$all $k"; next="$next $k"; done
+    done
+    frontier="$next"
+    level=$((level + 1))
+  done
+  for k in $all; do
+    printf 'bd:     %s %s\n' "$k" "$(fleet_bd_lock_procname "$k")"
+  done
+}
+
+fleet_bd_lock_report() {
+  # $1 lock file, $2 seconds held, $3 mode: wait|timeout, $4 quiet_holder=1 to skip the holder block
+  # (the timeout of an invocation that already reported the holder must not repeat all of it)
+  local lock="$1" held="$2" mode="$3" rec pid role since cmd human kids
+  local quiet_holder="${4:-}"
+  rec="$(head -c 400 "$lock" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
+  human="$((held / 60))m$((held % 60))s"
+  if [ "$mode" = timeout ]; then
+    echo "bd: TIMEOUT (agents-elu6): the VM-wide bd lock was held for ${human}. THIS CALL DID NOT RUN and changed nothing." >&2
+  else
+    echo "bd: WAITING ${human} for the VM-wide bd lock (one Dolt write at a time; a dolt push holds it for its git round-trip to origin)." >&2
+  fi
+  if [ "$quiet_holder" = 1 ]; then
+    if [ "$mode" = timeout ]; then
+      echo "bd:   retry in a few seconds, or allow a longer wait with FLEET_BD_LOCK_WAIT=<seconds>." >&2
+      echo "bd:   Posting a verdict? The COMMENT first, then the labels: a retry then never loses the verdict." >&2
+    fi
+    return 0
+  fi
+  # EVERY field is re-validated on read: the record is a shared file that any process can write, so this is
+  # the difference between a diagnostic and an injection channel (agents-zoch).
+  pid="$(fleet_bd_lock_int "$(fleet_bd_lock_field "$rec" pid)")" || pid=""
+  if [ -n "$pid" ]; then
+    role="$(fleet_bd_lock_role "$(fleet_bd_lock_field "$rec" role)")"
+    since="$(fleet_bd_lock_int "$(fleet_bd_lock_field "$rec" since)")" || since=""
+    cmd="$(fleet_bd_lock_cmd "$(fleet_bd_lock_field "$rec" cmd)")"
+    # NO LANE NAME IS CLAIMED (agents-6e77). On a shared-uid VM there is no trust boundary for one: the lane
+    # registry is writable by every lane, FLEET_LANE is environment, and a process names itself - so a lane
+    # name would be attacker-chosen text arriving in ANOTHER lane's log, which is the class agents-zoch
+    # closed. Everything printed here is a closed vocabulary (role, operation, process names) or an integer
+    # (pid, age), so nothing an attacker writes into the shared file can carry text.
+    echo "bd:   holder: role=${role} pid=$pid${since:+ since $(date -d "@$since" -u +%H:%M:%SZ 2>/dev/null || printf '?')}" >&2
+    echo "bd:   running: bd ${cmd}   (operation only: arguments can hold bead text - agents-zoch)" >&2
+    if [ -d "/proc/$pid" ]; then
+      kids="$(fleet_bd_lock_descendants "$pid")"
+      [ -n "$kids" ] && printf '%s\n' "$kids" >&2
+    else
+      echo "bd:   (that pid is gone, so the record is stale - the lock is still held)" >&2
+    fi
+  else
+    echo "bd:   holder: UNNAMED - the lock file has no usable holder record (a holder from before agents-elu6, a record written by something else, or one that has not been written yet). The lock releases automatically when the holder exits, so a holder that has died cannot hold it." >&2
+  fi
+  if [ "$mode" = timeout ]; then
+    echo "bd:   retry in a few seconds, or allow a longer wait with FLEET_BD_LOCK_WAIT=<seconds>." >&2
+    echo "bd:   Posting a verdict? The COMMENT first, then the labels: a retry then never loses the verdict." >&2
+  fi
+}
+
+fleet_bd_lock_acquire() {

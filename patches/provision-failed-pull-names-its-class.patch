diff --git a/remote/provision.sh b/remote/provision.sh
index ab53778..9db681c 100755
--- a/remote/provision.sh
+++ b/remote/provision.sh
@@ -87,6 +87,30 @@ rm -f "$HOME/.fleet/provision-warnings"
 step() { echo; echo "=== $(date -u +%H:%M:%S) $*"; }
 warn() { echo "WARN: $*"; echo "$(date -u +%FT%TZ) $*" >> "$HOME/.fleet/provision-warnings"; }
 say()  { echo "$*"; }
+# agents-rn78: name the CLASS of a failed `git pull --ff-only` from git's own message, so one warning line
+# is enough to tell a transient outage from a diverged checkout. The classes and their wording mirror
+# install.sh (agents-a1ko) deliberately - an operator should read the same vocabulary in provision.log and
+# in the installer's own output - and the THIRD case is the default, so a failure git words in a way this
+# script has never seen is reported as unrecognised rather than guessed into one of the two that need
+# opposite responses.
+agents_pull_failure_class() {
+  local why=${1//$'\n'/ }
+  case "$why" in
+    # agents-uvzh (found reviewing agents-a1ko): AUTHENTICATION IS NOT A NETWORK OUTAGE, and git's text for
+    # the two OVERLAPS - a refused key prints "Permission denied (publickey)." immediately followed by
+    # "fatal: Could not read from remote repository." (MEASURED with a real pull against an ssh:// remote and
+    # a refusing GIT_SSH_COMMAND stub). So this arm must come FIRST: below the unreachable arm, a wrong
+    # credential was reported as transient and the operator was told to retry a failure retrying cannot fix.
+    *"Permission denied"*|*"Authentication failed"*|*"publickey"*|*"could not read Username"*|*"terminal prompts disabled"*|*"Host key verification failed"*)
+      printf 'remote-auth-denied: the remote was reachable and REFUSED this host - credentials or permissions - and that is NOT transient, so retrying cannot fix it; check what ~/agents authenticates with (ssh key or agent, a token in the remote URL) and that the files it writes are writable' ;;
+    *"does not appear to be a git repository"*|*"Could not read from remote repository"*|*"Could not resolve host"*|*"unable to access"*|*"Connection refused"*|*"Connection timed out"*|*"No route to host"*|*"Temporary failure in name resolution"*)
+      printf 'remote-unreachable: the remote could not be reached, and that is usually transient - retrying the pull later is safe and no local state was changed' ;;
+    *"Not possible to fast-forward"*|*"Diverging branches"*|*"non-fast-forward"*)
+      printf 'checkout-diverged: ~/agents has local commits or a rewritten history the remote does not have, so the pull cannot fast-forward - investigate the checkout on the host, retrying fails the same way' ;;
+    *)
+      printf 'checkout-local-state-or-unrecognised: the checkout has uncommitted changes or a git config routes the pull through a rebase, OR git failed in a way this script has never produced - read the git text at the end of this line rather than assuming' ;;
+  esac
+}
 
 step "fleet env"
 # Serialize env file writes with an exclusive lock against concurrent push-env (fleet-hhrd)
@@ -985,7 +1009,20 @@ printf '  deno: %s (pinned %s)\n  zip:  %s\n' \
   || warn "effective deno is '${deno_effective:-MISSING}' but the pin is '$deno_want' — check PATH order"
 
 step "software factory (~/agents)"
-if [ -d "$HOME/agents/.git" ]; then git -C "$HOME/agents" pull --ff-only -q || warn "agents pull failed"
+if [ -d "$HOME/agents/.git" ]; then
+  # agents-rn78: THE PULL THAT FAILS IN REAL PROVISIONING IS THIS ONE, so the class has to be named HERE.
+  # install.sh classifies its own failed pull (agents-yow5, agents-a1ko), but provisioning never reaches
+  # that code: this step pulls first, and :995 then runs ./install.sh from INSIDE the checkout, where
+  # install.sh:59-61 takes the checked-out-factory shortcut and does not pull at all. MEASURED on a real
+  # clone whose bare origin was deleted (agents-rn78): the installer run from outside the checkout exits 1
+  # with "FAILURE CLASS: remote-unreachable", while the way provisioning invokes it exits 0 and prints no
+  # class. So "agents pull failed" was the only account an operator got, and it cannot tell a transient
+  # network outage from a diverged checkout - two failures that want opposite responses. Severity is
+  # UNCHANGED (this stays non-fatal, as it was): the class is the fix asked for, and whether a stale
+  # checkout should now fail provisioning is a separate decision, recorded in the patch write-up.
+  if ! agents_pull_error=$(git -C "$HOME/agents" pull --ff-only -q 2>&1); then
+    warn "agents pull failed [$(agents_pull_failure_class "$agents_pull_error")] - git said: ${agents_pull_error//$'\n'/ }"
+  fi
 else git clone -q --depth 1 "$FLEET_FACTORY_REPO" "$HOME/agents" || warn "agents clone failed"; fi
 # fleet-24zj: the installer's output is NO LONGER DISCARDED. Because line 65 redirects this script's whole
 # output into ~/.fleet/provision.log, PRINTING IS WHAT MAKES IT DURABLE - the caller (bin/fleet) starts
diff --git a/tests/provision.test.sh b/tests/provision.test.sh
index 4e3b99d..c12e97b 100755
--- a/tests/provision.test.sh
+++ b/tests/provision.test.sh
@@ -2200,6 +2200,43 @@ ae_dolt_remote=$( ( cd "$canon_ae" && bd dolt remote list 2>/dev/null | awk '$1
 [ "$ae_dolt_remote" = "git+https://github.int.exe.xyz/PaulKinlan/audio-feed.git" ] && ok "16u3 dolt remote retains int mirror after ahead>0 reset (fleet-6cu7)" || bad "16u3 dolt remote reverted: got '$ae_dolt_remote'" ""
 hasnt "$ae_out" "reset reverted beads config sync.remote" "16u4 no warning about reverted sync.remote emitted"
 
+# 17. a failed agents pull names its class (agents-rn78)
+echo "17. a failed agents pull names its failure class (agents-rn78)"
+
+# The classifier is EXTRACTED FROM THE REAL provision.sh and driven here, in the harness's own style
+# ("test against actual script source"): a copy of the function would pass while the shipped one rotted.
+ap_class_fn=$(sed -n '/^agents_pull_failure_class() {/,/^}/p' "$PROVISION")
+if [ -n "$ap_class_fn" ]; then ok "17a provision.sh defines the agents pull-failure classifier"; else bad "17a classifier missing from provision.sh" ""; fi
+eval "$ap_class_fn" 2>/dev/null || true
+if declare -f agents_pull_failure_class >/dev/null 2>&1; then ok "17b the extracted classifier is callable"; else bad "17b the extracted classifier did not define" ""; fi
+
+# MEASURED, not invented (2026-10-13, real git on a project VM): the first is what git prints when the
+# bare origin behind a clone is deleted, the second what it prints for a diverged checkout under
+# --ff-only. Both are the failures this step exists to report.
+ap_net='fatal: '"'"'/tmp/v/agents'"'"' does not appear to be a git repository
+fatal: Could not read from remote repository.
+
+Please make sure you have the correct access rights and the repository exists.'
+ap_div='fatal: Not possible to fast-forward, aborting.'
+
+ap_net_class=$(agents_pull_failure_class "$ap_net" 2>/dev/null || true)
+ap_div_class=$(agents_pull_failure_class "$ap_div" 2>/dev/null || true)
+has "$ap_net_class" "remote-unreachable" "17c a network failure is named remote-unreachable"
+has "$ap_div_class" "checkout-diverged" "17d a diverged checkout is named checkout-diverged"
+if [ -n "$ap_net_class" ] && [ "$ap_net_class" != "$ap_div_class" ]; then ok "17e the two classes are distinguishable from the message alone"; else bad "17e the two classes are not distinguishable" "net='$ap_net_class' div='$ap_div_class'"; fi
+has "$(agents_pull_failure_class 'fatal: something git has never said before' 2>/dev/null || true)" "unrecognised" "17f an unseen failure is not guessed into the network or divergence class"
+
+# agents-uvzh: the auth text OVERLAPS the unreachable arm's text (git prints "Permission denied (publickey)."
+# and then "fatal: Could not read from remote repository."), so this is the pair that decides the arm order.
+ap_auth='Permission denied (publickey).
+fatal: Could not read from remote repository.'
+ap_auth_class=$(agents_pull_failure_class "$ap_auth" 2>/dev/null || true)
+has "$ap_auth_class" "remote-auth-denied" "17h a refused credential is NOT classed as a network outage (agents-uvzh)"
+hasnt "$ap_auth_class" "retrying the pull later is safe" "17i the auth class must not carry the unreachable wording, which is an instruction to retry"
+
+# THE WIRING, so the classifier cannot be decoration: the failure branch of the agents pull must call it.
+if grep -q 'agents_pull_failure_class "\$agents_pull_error"' "$PROVISION"; then ok "17g the agents pull failure branch calls the classifier"; else bad "17g the classifier is not wired into the pull failure branch" ""; fi
+
 echo
 if [ "$FAIL" -gt 0 ]; then
   echo "Failed tests ($FAIL):"

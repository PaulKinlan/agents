+        if [ -n "$md_headers" ]; then
+          local sec_match=true
+          while IFS= read -r hdr; do
+            [ -n "$hdr" ] || continue
+            local s_rev s_tip
+            s_rev=$(flm_extract_md_section "$rev_full" "$f" "$hdr")
+            s_tip=$(flm_extract_md_section "$tip_full" "$f" "$hdr")
+            if [ -z "$s_rev" ] || [ "$s_rev" != "$s_tip" ]; then

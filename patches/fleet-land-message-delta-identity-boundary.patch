+# Extract a named markdown section (from '## <heading>' up to next '## ' or EOF) (delta-identity-boundary, Shape A)
+flm_extract_md_section() {
+  local commit="$1" file="$2" heading="$3"
+  git show "$commit:$file" 2>/dev/null | awk -v h="$heading" '
+    BEGIN { found = 0 }
+    /^## / {
+      line = substr($0, 4)
+      if (line == h || index(line, h) == 1) {
+        found = 1
+        print $0
+        next
+      } else if (found) {
+        exit
+      }
+    }
+    found { print }
+  '
+}

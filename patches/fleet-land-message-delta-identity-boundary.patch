+    n_rev_b=${n_rev_b//[!0-9]/}
+    n_rev_f=${n_rev_f//[!0-9]/}
+    n_tip_b=${n_tip_b//[!0-9]/}
+    n_tip_f=${n_tip_f//[!0-9]/}
+    : "${n_rev_b:=0}" "${n_rev_f:=0}" "${n_tip_b:=0}" "${n_tip_f:=0}"
+    if [ "$n_rev_f" -gt "$n_rev_b" ] && [ "$n_tip_f" -gt "$n_tip_b" ]; then

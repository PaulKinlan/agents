+# Normalize diff hunks by stripping hunk headers and context lines per file (fleet-6ihq).
+# Preserves all substantive added/removed lines (including blank lines), binary patch content,
+# postimage blob identities (POSTIMAGE:<hash>), file mode changes, and file boundaries. Pure offset
+# moves and context line shifts evaluate as content-identical while altered text (including blank additions)
+# or binary payloads refuse delta identity.
+flm_normalize_diff() {
+  awk '
+    /^diff --git / {
+      cur_file = $3
+      cur_post = ""
+      print "FILE:" cur_file
+      next
+    }
+    /^index [0-9a-fA-F]+\.\.[0-9a-fA-F]+/ {
+      val = $2
+      sub(/^[0-9a-fA-F]+\.\./, "", val)
+      cur_post = val
+      next
+    }
+    /^@@/ { next }
+    index($0, "+++") == 1 || index($0, "---") == 1 { next }
+    /^(old mode|new mode|deleted file mode|new file mode)/ {
+      print $0
+      next
+    }
+    /^(GIT binary patch|Binary files|literal |delta )/ || in_binary {
+      if (!in_binary) {
+        in_binary = 1
+        if (cur_post != "") print "POSTIMAGE:" cur_post
+      }
+      print $0
+      next
+    }
+    /^[+-]/ {
+      print $0
+    }
+  '
+}

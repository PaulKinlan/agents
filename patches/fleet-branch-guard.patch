--- /dev/null
+++ b/remote/fleet-branch-guard.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+# fleet-branch-guard.sh - refuse a commit that is about to land on ANOTHER BEAD'S BRANCH (agents-zwbk).
+#
+# THE HAZARD, measured three times in one session by one lane: the worktree you are standing in is not
+# necessarily the branch the bead belongs to, and `git commit` accepts whatever HEAD is. Each instance cost a
+# manual repair, and one briefly voided a clearance: a commit landed on a branch that was already cleared and
+# inside a gating union. The repair was always "a new branch", so the cheap time to say so is BEFORE the commit.
+#
+# THE RULE IS NARROW ON PURPOSE, because a guard that cries wolf gets disabled. It fires only when BOTH sides
+# name a bead id: the worktree's last path component and the branch's last component must each look like a
+# 4-character bead id (agents-xxxx), and they must DIFFER. That is exactly the signature of all three
+# instances (worktree 8b05 on branch 3gk3, worktree lyrw on branch shua, worktree shua on branch rirf) while
+# staying silent on legitimate shapes: a lane worktree with no bead suffix, a branch with extra words after
+# the id, or a worktree outside the ~/worktrees convention.
+#
+# Overridable deliberately: FLEET_ALLOW_BRANCH_MISMATCH=1 for the case where landing another bead's work from
+# this worktree is intended. Discipline becomes a machine refusal, and an override is a decision you record.
+set -uo pipefail
+
+WT=${1:-}
+BR=${2:-}
+[ -n "$WT" ] || WT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
+[ -n "$BR" ] || BR=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
+
+[ -n "$WT" ] && [ -n "$BR" ] || exit 0
+case "$BR" in fleet/*) ;; *) exit 0 ;; esac   # only fleet branches are ours to police
+case "$WT"  in *"/worktrees/"*) ;; *) exit 0 ;; esac   # only the fleet's own worktree root
+
+# A WORKTREE is a path, so its last component is after the last slash. A BRANCH is not a path: 'fleet/x-8b05'
+# has one slash, so ${BR##*/} is the whole branch after 'fleet/' and the bead id is the last DASH-separated
+# token instead. Getting this wrong made the guard silently allow every mismatch it exists to catch - measured
+# with bash -x, after the fixture had already told me it was broken.
+dir=${WT##*/}
+wt_last=${dir##*-}
+br_last=${BR##*-}
+
+is_bead_id() { case "$1" in [a-z0-9][a-z0-9][a-z0-9][a-z0-9]) return 0 ;; *) return 1 ;; esac; }
+is_bead_id "$wt_last" && is_bead_id "$br_last" || exit 0
+[ "$wt_last" = "$br_last" ] && exit 0
+
+if [ "${FLEET_ALLOW_BRANCH_MISMATCH:-0}" = "1" ]; then
+  echo "fleet-branch-guard: allowing a known mismatch ($wt_last worktree, $br_last branch) because FLEET_ALLOW_BRANCH_MISMATCH=1" >&2
+  exit 0
+fi
+
+cat >&2 <<MSG
+fleet-branch-guard: REFUSING this commit - worktree '$(basename "$WT")' on branch '$BR' - those name different beads.
+For the record, in full:
+  worktree: $WT
+  branch:   $BR
+  worktree: $WT
+  branch:   $BR
+You are about to commit '$wt_last' work on the branch for '$br_last'. That is how a bead's work lands on
+another bead's branch, which costs a manual split and can void a clearance that was already recorded
+(clearance is per-sha). The repair is always a NEW branch, so do it now:
+  git switch -c fleet/<project>-$wt_last
+If the mismatch is intended, re-run with FLEET_ALLOW_BRANCH_MISMATCH=1 and know that you are deciding it.
+MSG
+exit 1

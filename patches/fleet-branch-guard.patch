+#!/usr/bin/env bash
+# tests/fleet-branch-guard.test.sh - the guard must refuse the three REAL mismatches and stay silent on the
+# legitimate shapes (agents-zwbk). Driven: every case passes its worktree and branch explicitly.
+set -uo pipefail
+HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+G=${FLEET_BRANCH_GUARD_BIN:-$HERE/remote/fleet-branch-guard.sh}
+PASS=0; FAIL=0; N=0
+ok()  { N=$((N+1)); PASS=$((PASS+1)); printf 'ok %d - %s\n' "$N" "$1"; }
+bad() { N=$((N+1)); FAIL=$((FAIL+1)); printf 'not ok %d - %s\n' "$N" "$1"; }
+W=/home/exedev/worktrees/agents-factory
+# the three instances, exactly as they happened
+for case in "$W-impl-guard-8b05:fleet/impl-guard-3gk3" "$W-impl-guard-lyrw:fleet/impl-guard-shua" "$W-impl-guard-shua:fleet/impl-guard-rirf"; do
+  wt=${case%%:*}; br=${case##*:}
+  bash "$G" "$wt" "$br" >/dev/null 2>&1; rc=$?
+  [ "$rc" != 0 ] && ok "refuses ${wt##*-} committing on ${br##*/}" || bad "should have refused ${wt##*-} on ${br##*/}"
+done
+# the matched case and the shapes that must stay silent
+bash "$G" "$W-impl-guard-i4u9" fleet/impl-guard-i4u9 >/dev/null 2>&1 && ok "allows a matched worktree and branch" || bad "a matched pair must pass"
+bash "$G" "$W-impl-l2-0utp2" fleet/impl-l2-0utp2-5q0w-rerun-ruling >/dev/null 2>&1 && ok "silent when the worktree names no bead id" || bad "must stay silent when no bead id is present"
+bash "$G" "$W-impl-guard" fleet/impl-guard-3gak >/dev/null 2>&1 && ok "silent when the worktree has no bead suffix" || bad "must stay silent without a bead suffix"
+bash "$G" /tmp/whatever-wt fleet/impl-guard-3gk3 >/dev/null 2>&1 && ok "silent outside the fleet worktree root" || bad "must not police worktrees outside ~/worktrees"
+bash "$G" "$W-impl-guard-8b05" main >/dev/null 2>&1 && ok "silent on a non-fleet branch" || bad "must not police main"
+FLEET_ALLOW_BRANCH_MISMATCH=1 bash "$G" "$W-impl-guard-8b05" fleet/impl-guard-3gk3 >/dev/null 2>&1 && ok "the mismatch is overridable deliberately" || bad "the override must work"
+[ "$FAIL" = 0 ] || echo "FAILED $FAIL"
+[ "$FAIL" = 0 ]
